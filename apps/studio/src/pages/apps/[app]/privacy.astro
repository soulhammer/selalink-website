---
import { appsLegalData } from '../../../data/appsLegalData';

export function getStaticPaths() {
  const apps = Object.keys(appsLegalData);
  return apps.map((app) => ({ params: { app } }));
}

const { app } = Astro.params;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, follow" />
  <meta http-equiv="refresh" content={`0;url=/en/apps/${app}/privacy/`} />
  <title>Redirecting...</title>
</head>
<body>
  <script is:inline define:vars={{ app }}>
    (function() {
      var validLangs = ['en', 'ko', 'ja', 'zh', 'es', 'fr', 'de', 'pt', 'id'];
      var lang = navigator.language || navigator.userLanguage || "en";
      lang = lang.split('-')[0]; // ko-KR -> ko
      
      var searchParams = window.location.search || "";
      var hash = window.location.hash || "";
      
      var targetLang = validLangs.indexOf(lang) !== -1 ? lang : "en";
      var targetUrl = '/' + targetLang + '/apps/' + app + '/privacy/' + searchParams + hash;
      
      window.location.replace(targetUrl);
    })();
  </script>
</body>
</html>

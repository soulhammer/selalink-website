---
import { ingredients } from '../../../data/apps/freshsnap';

export function getStaticPaths() {
  const paths = [];
  
  // 1. 인덱스 페이지 리다이렉션 (/apps/storeself/ -> /apps/freshsnap/)
  paths.push({
    params: { redirect: undefined }
  });
  
  // 2. 개별 식재료 페이지 리다이렉션 (/apps/storeself/[ingredient]/ -> /apps/freshsnap/[ingredient]/)
  for (const item of ingredients) {
    paths.push({
      params: { redirect: item.id }
    });
  }
  return paths;
}

return Astro.redirect(
  Astro.params.redirect 
    ? `/apps/freshsnap/${Astro.params.redirect}/`
    : `/apps/freshsnap/`,
  301
);
---

---
// Language-neutral redirect page for FreshSnap ingredient pages
import { ingredients } from '../../../data/apps/freshsnap';

export function getStaticPaths() {
  return ingredients.map((item) => ({
    params: { ingredient: item.id }
  }));
}

const { ingredient } = Astro.params;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, follow" />
  <!-- Fallback meta refresh for crawlers/AI bots with JS disabled -->
  <meta http-equiv="refresh" content={`0;url=/en/apps/freshsnap/${ingredient}/`} />
  <title>Redirecting...</title>
</head>
<body>
  <script is:inline define:vars={{ ingredient }}>
    (function() {
      var validLangs = ['en', 'ko', 'ja', 'zh', 'es', 'fr', 'de', 'pt', 'id'];
      var lang = navigator.language || navigator.userLanguage || "en";
      lang = lang.split('-')[0]; // ko-KR -> ko
      
      var searchParams = window.location.search || "";
      var hash = window.location.hash || "";
      
      var targetLang = validLangs.indexOf(lang) !== -1 ? lang : "en";
      var targetUrl = '/' + targetLang + '/apps/freshsnap/' + ingredient + '/' + searchParams + hash;
      
      window.location.replace(targetUrl);
    })();
  </script>
</body>
</html>

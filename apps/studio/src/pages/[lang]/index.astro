---
import Layout from '../../layouts/Layout.astro';
import { useTranslations, languages } from '../../i18n/ui';
import AppStories from '../../components/AppStories.astro';
import { getCollection } from 'astro:content';
import BlogPostCard from '../../components/BlogPostCard.astro';
import LineupBadge from '../../components/LineupBadge.astro';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as keyof typeof languages);
const isKo = lang === 'ko';
const imgBase = '/assets/images/apps/freshself/en';

// 다국어 블로그 포스트 중에서 현재 언어 경로에 속하는 최신 3개 글 조회
const allPosts = await getCollection('blog');
const langPosts = allPosts
  .filter((post) => post.id.startsWith(`${lang}/`))
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 3);
---
<Layout title={`SelaLink Studio | ${t('hero.title')}`} description={t('hero.meta.desc')} lang={lang} image="/assets/images/og/selalink_studio.png">
	<main class="max-w-[1400px] mx-auto px-6 py-8 min-h-screen">
		
		<!-- Hero -->
		<section class="mb-10 md:mb-16 mt-2 md:mt-6 text-center md:text-left relative overflow-hidden rounded-[2rem] p-8 md:p-12 border border-slate-200/50 dark:border-white/5 bg-slate-100/30 dark:bg-slate-950/40 backdrop-blur-md">
			<div class="absolute inset-0 bg-[url('/images/banner.webp')] bg-cover bg-center opacity-[0.15] mix-blend-multiply filter invert-[0.95] hue-rotate-[180deg] dark:opacity-30 dark:mix-blend-screen dark:filter-none pointer-events-none"></div>
			<div class="relative z-10">
				<h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black tracking-tighter leading-[1.15] md:leading-[1.1] mb-4 md:mb-6 whitespace-pre-wrap text-slate-900 dark:text-white">{t('hero.title')}</h1>
				<p class="text-lg md:text-xl lg:text-2xl text-slate-600 dark:text-slate-300 font-medium tracking-tight max-w-2xl mx-auto md:mx-0 mb-8">{t('hero.desc')}</p>
				
				<!-- Category Quick Chips -->
				<div class="flex flex-wrap justify-center md:justify-start gap-2.5">
					<span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-emerald-100 text-emerald-800 border-emerald-200/50 dark:bg-emerald-500/10 dark:text-emerald-400 dark:border-emerald-500/20 text-xs md:text-sm font-semibold shadow-sm backdrop-blur-md">
						<span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>{t('blog.filter.buildself')}
					</span>
					<span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-purple-100 text-purple-800 border-purple-200/50 dark:bg-purple-500/10 dark:text-purple-400 dark:border-purple-500/20 text-xs md:text-sm font-semibold shadow-sm backdrop-blur-md">
						<span class="w-1.5 h-1.5 rounded-full bg-purple-500 animate-pulse"></span>{t('blog.filter.freshsnap')}
					</span>
					<span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-indigo-100 text-indigo-800 border-indigo-200/50 dark:bg-indigo-500/10 dark:text-indigo-400 dark:border-indigo-500/20 text-xs md:text-sm font-semibold shadow-sm backdrop-blur-md">
						<span class="w-1.5 h-1.5 rounded-full bg-indigo-500 animate-pulse"></span>{t('blog.filter.logself')}
					</span>
				</div>
			</div>
		</section>

		<!-- Dynamic App Stories (Full Screen Shorts Hook) -->
		<AppStories lang={lang} />

		<!-- SelaLink Product Series Guide Section -->
		<section class="my-16 md:my-24 relative z-20">
			<div class="text-center md:text-left mb-10">
				<h2 class="text-3xl md:text-4xl lg:text-5xl font-black tracking-tighter text-slate-900 dark:text-white mb-3">
					{t('lineup.guide.title') || 'SelaLink Product Series'}
				</h2>
				<p class="text-sm md:text-base text-slate-600 dark:text-slate-400 font-medium max-w-2xl">
					{t('lineup.guide.subtitle')}
				</p>
			</div>
			
			<div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
				<!-- SELF Card -->
				<div class="relative overflow-hidden rounded-3xl p-6 sm:p-8 bg-white/40 dark:bg-slate-800/30 backdrop-blur-md border border-slate-200/50 dark:border-slate-800/60 shadow-sm transition-all duration-300 hover:shadow-lg flex flex-col justify-between">
					<div>
						<div class="mb-4">
							<LineupBadge type="self" lang={lang} showTooltip={false} />
						</div>
						<h3 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white mb-2">{t('lineup.self.title')}</h3>
						<p class="text-sm text-slate-600 dark:text-slate-300 font-medium leading-relaxed">{t('lineup.self.desc')}</p>
					</div>
					<div class="mt-6 flex items-center gap-2">
						<span class="w-2 h-2 rounded-full bg-purple-500 animate-pulse"></span>
						<span class="text-[11px] font-bold text-purple-600 dark:text-purple-400 uppercase tracking-wider">{t('lineup.guide.active3')}</span>
					</div>
				</div>

				<!-- SNAP Card -->
				<div class="relative overflow-hidden rounded-3xl p-6 sm:p-8 bg-white/40 dark:bg-slate-800/30 backdrop-blur-md border border-slate-200/50 dark:border-slate-800/60 shadow-sm transition-all duration-300 hover:shadow-lg flex flex-col justify-between">
					<div>
						<div class="mb-4">
							<LineupBadge type="snap" lang={lang} showTooltip={false} />
						</div>
						<h3 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white mb-2">{t('lineup.snap.title')}</h3>
						<p class="text-sm text-slate-600 dark:text-slate-300 font-medium leading-relaxed">{t('lineup.snap.desc')}</p>
					</div>
					<div class="mt-6 flex items-center gap-2">
						<span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
						<span class="text-[11px] font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider">{t('lineup.guide.active1')}</span>
					</div>
				</div>

				<!-- SHARE Card -->
				<div class="relative overflow-hidden rounded-3xl p-6 sm:p-8 bg-white/40 dark:bg-slate-800/30 backdrop-blur-md border border-slate-200/50 dark:border-slate-800/60 shadow-sm transition-all duration-300 hover:shadow-lg flex flex-col justify-between opacity-80 hover:opacity-100 transition-opacity">
					<div>
						<div class="mb-4">
							<LineupBadge type="share" lang={lang} showTooltip={false} />
						</div>
						<h3 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white mb-2">{t('lineup.share.title')}</h3>
						<p class="text-sm text-slate-600 dark:text-slate-300 font-medium leading-relaxed">{t('lineup.share.desc')}</p>
					</div>
					<div class="mt-6 flex items-center gap-2">
						<span class="w-2 h-2 rounded-full bg-amber-500"></span>
						<span class="text-[11px] font-bold text-amber-600 dark:text-amber-400 uppercase tracking-wider">{t('lineup.guide.upcoming')}</span>
					</div>
				</div>
			</div>
		</section>

		<!-- Bento Grid 2.0 -->
		<section class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 auto-rows-auto md:auto-rows-auto">
			
			<!-- FreshSelf Card (Horizontal Bento - Z-10) -->
			<div class="bento-card cursor-pointer col-span-1 md:col-span-2 row-span-2 p-5 sm:p-8 md:p-12 flex flex-col justify-between group overflow-hidden relative min-h-[480px] md:min-h-[536px]" style="--glow-color: rgba(139,92,246,0.15);">
				<div class="bento-glow top-0 left-0"></div>
				<a href={`/${lang}/apps/freshself/`} aria-label={t('app.freshself.title')} class="absolute inset-0 z-20"></a>

				<!-- Gradient Shield Overlay (Z-15) for Readability -->
				<div class="absolute inset-y-0 left-0 w-full md:w-[60%] bg-gradient-to-r from-white via-white/95 to-transparent dark:from-slate-950 dark:via-slate-950/90 dark:to-transparent z-15 pointer-events-none transition-opacity duration-500"></div>

				<!-- Left Side Content (Z-20) -->
				<div class="z-20 relative pointer-events-none max-w-md lg:max-w-xl xl:max-w-2xl space-y-6 dark:drop-shadow-[0_2px_8px_rgba(0,0,0,0.85)]">
				<div class="flex flex-wrap gap-2 mb-4 md:mb-6">
					<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-100 text-purple-700 dark:bg-purple-500/20 dark:text-purple-400 text-xs md:text-sm font-semibold border border-purple-500/20 shadow-sm backdrop-blur-md">
						<span class="w-1.5 h-1.5 rounded-full bg-purple-500 animate-pulse"></span>{t('app.freshself.status')}
					</div>
					<div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/60 dark:bg-white/10 text-slate-800 dark:text-slate-300 text-xs md:text-sm font-semibold border border-white/40 dark:border-white/10 shadow-sm backdrop-blur-md">
						{t('platform.mobile')}
					</div>
				</div>
					<div class="space-y-4">
						<h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black mb-2 text-slate-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors drop-shadow-sm flex items-center gap-3">
							<img src={`${import.meta.env.BASE_URL}freshself/invite/icon.png`} alt="FreshSelf Logo" class="w-10 h-10 sm:w-12 sm:h-12 object-contain rounded-xl shadow-sm border border-purple-500/10" />
							{t('app.freshself.title')}
							<LineupBadge type="self" lang={lang} className="ml-2 scale-95 origin-left" tooltipPosition="right" />
						</h2>
						<p class="text-base sm:text-lg md:text-xl lg:text-2xl text-slate-800 dark:text-slate-200 font-medium leading-relaxed max-w-xl">{t('app.freshself.desc')}</p>
					</div>
				</div>

				<!-- Right Side 3D Spatial Mockup (Z-10) -->
				<div class="absolute bottom-[-10px] md:bottom-[-20px] right-[-15px] md:right-[5%] w-[60%] sm:w-[45%] md:w-[35%] h-[240px] sm:h-[280px] md:h-[95%] z-10 pointer-events-none perspective-[1000px] flex items-end justify-end opacity-25 sm:opacity-50 md:opacity-40 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700">
					<!-- Back Left Image (Device Frame) -->
					<div class="absolute right-[35%] bottom-2 w-[55%] rounded-[1.4rem] border-[5px] border-slate-950 dark:border-slate-850 bg-slate-950 shadow-xl transform -rotate-12 translate-y-4 group-hover:-translate-x-4 group-hover:-translate-y-2 group-hover:-rotate-16 transition-all duration-700 overflow-hidden">
						<img src={`${imgBase}/5.jpg`} alt="FreshSelf Rescue Reports" class="w-full h-auto rounded-[1rem] object-cover" loading="lazy" />
					</div>
					<!-- Front Right Image (Device Frame) -->
					<div class="relative right-0 bottom-4 w-[60%] rounded-[1.6rem] border-[6px] border-slate-900 dark:border-slate-800 bg-slate-900 shadow-[0_25px_60px_-15px_rgba(0,0,0,0.4)] dark:shadow-[0_25px_60px_-15px_rgba(0,0,0,0.8)] transform rotate-[-4deg] group-hover:rotate-0 transition-all duration-700 z-20 overflow-hidden">
						<img src={`${imgBase}/1.jpg`} alt="FreshSelf Storage List" class="w-full h-auto rounded-[1.2rem] object-cover" loading="lazy" />
					</div>
				</div>

				<div class="relative flex justify-between items-end transition-transform mt-auto pt-8">
					<div class="flex flex-wrap items-center gap-x-2 gap-y-1.5">
						<div class="z-30 relative inline-flex items-center gap-1.5 text-xs font-bold text-emerald-700 dark:text-emerald-300 bg-emerald-50/80 dark:bg-emerald-950/60 px-3 py-1.5 rounded-full border border-emerald-200 dark:border-emerald-500/40 backdrop-blur-md shadow-sm leading-none" style="height: 28px; line-height: 1; display: inline-flex; align-items: center; font-size: 12px;">
							{t('app.freshself.supported')}
						</div>
						<span 
							role="link"
							tabindex="0"
							onclick={`event.stopPropagation(); window.open('https://play.google.com/store/apps/details?id=com.selalink.freshself&hl=${lang}', '_blank');`}
							class="z-30 relative pointer-events-auto inline-flex items-center gap-1.5 text-xs font-bold bg-purple-600 hover:bg-purple-700 text-white dark:bg-purple-500/20 dark:text-purple-300 dark:border-purple-500/30 px-3.5 py-1.5 rounded-full border border-purple-500/20 shadow-sm transition-all duration-300 hover:scale-105 active:scale-95 cursor-pointer"
						>
							<svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
								<path d="M3 20.5v-17c0-.83.67-1.5 1.5-1.5.34 0 .66.12.92.33l13.62 10.15c.67.5.76 1.45.19 2.06l-13.62 10.15a1.5 1.5 0 01-2.42-1.2v-1.92z"/>
							</svg>
							<span>Google Play</span>
						</span>
					</div>
					<a href={`/${lang}/apps/freshself/`} class="z-30 relative w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-slate-900 text-white dark:bg-white dark:text-slate-900 flex items-center justify-center group-hover:scale-110 group-hover:bg-purple-600 dark:group-hover:bg-purple-400 group-hover:text-white dark:group-hover:text-black transition-all duration-500 shadow-[0_0_30px_rgba(0,0,0,0.1)] dark:shadow-[0_0_30px_rgba(255,255,255,0.3)]">
						<svg class="w-6 h-6 sm:w-8 sm:h-8 transform group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25"/></svg>
					</a>
				</div>

				<!-- Purple Light Bloom Effect -->
				<div class="absolute -bottom-32 -right-32 w-[500px] h-[500px] bg-purple-400/10 dark:bg-purple-600/10 blur-[100px] rounded-full group-hover:bg-purple-400/20 dark:group-hover:bg-purple-500/15 transition-colors duration-700 z-0 pointer-events-none"></div>
			</div>

			<!-- logSelf Card (Encrypted Personal Log) -->
			<div class="bento-card cursor-pointer col-span-1 md:col-span-1 row-span-2 p-5 sm:p-8 md:p-12 flex flex-col justify-between group overflow-hidden relative min-h-[480px] md:min-h-[536px]" style="--glow-color: rgba(99,102,241,0.2);">
				<div class="bento-glow top-0 left-0"></div>
				<a href={`/${lang}/apps/logself/`} aria-label={t('app.logself.title')} class="absolute inset-0 z-20"></a>
				
				<!-- Gradient Shield Overlay (Z-15) for Readability -->
				<div class="absolute inset-x-0 top-0 w-full h-[70%] bg-gradient-to-b from-white via-white/95 to-transparent dark:from-slate-950 dark:via-slate-950/90 dark:to-transparent z-15 pointer-events-none transition-opacity duration-500"></div>

				<!-- Top Content (Z-20) -->
				<div class="z-20 relative pointer-events-none dark:drop-shadow-[0_2px_8px_rgba(0,0,0,0.85)]">
					<div class="flex flex-wrap gap-2 mb-4 md:mb-6">
						<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-100 text-indigo-700 dark:bg-indigo-500/20 dark:text-indigo-400 text-xs md:text-sm font-semibold border border-indigo-500/20 shadow-sm backdrop-blur-md">
							<span class="w-1.5 h-1.5 rounded-full bg-indigo-500 animate-pulse"></span>{t('app.logself.status')}
						</div>
						<div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/60 dark:bg-white/10 text-slate-800 dark:text-slate-300 text-xs md:text-sm font-semibold border border-white/40 dark:border-white/10 shadow-sm backdrop-blur-md">
							{t('platform.mobile')}
						</div>
					</div>
					<h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black mb-3 md:mb-4 text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors drop-shadow-sm flex items-center gap-3">
						<img src={`${import.meta.env.BASE_URL}images/logself/icon.png`} alt="logSelf Logo" class="w-10 h-10 sm:w-12 sm:h-12 object-contain rounded-xl shadow-sm border border-indigo-500/10" />
						{t('app.logself.title')}
						<LineupBadge type="self" lang={lang} className="ml-2 scale-95 origin-left" tooltipPosition="right" />
					</h2>
					<p class="text-base sm:text-lg md:text-xl text-slate-800 dark:text-slate-200 font-medium leading-relaxed max-w-sm drop-shadow-md relative z-20">{t('app.logself.desc')}</p>
				</div>
                
				<!-- Spatial 3D Collage Mock (Z-10) -->
				<div class="absolute bottom-[-5%] md:bottom-[-8%] right-[-5%] md:right-[-2%] w-[60%] sm:w-[45%] md:w-[70%] h-[55%] sm:h-[60%] md:h-[80%] z-10 pointer-events-none perspective-[1200px] flex items-end justify-end opacity-25 sm:opacity-50 md:opacity-40 group-hover:opacity-100 transition-all duration-700">
					<!-- Back Left Image (Device Frame) -->
					<div class="absolute left-[5%] sm:left-[0%] bottom-[20%] w-[55%] rounded-[1.4rem] border-[5px] border-slate-950 dark:border-slate-850 bg-slate-950 shadow-xl transform -rotate-12 translate-y-4 group-hover:-translate-x-4 group-hover:-translate-y-2 group-hover:-rotate-16 transition-all duration-700 opacity-60 dark:opacity-45 overflow-hidden">
						<img src={`/images/logself/${isKo ? 'ko' : 'en'}/3.jpeg`} alt="logSelf Stats Screen" class="w-full h-auto rounded-[1rem] object-cover" loading="lazy" />
					</div>
					<!-- Front Right Image (Device Frame) -->
					<div class="relative w-[65%] sm:w-[55%] mb-2 sm:mb-8 mr-6 sm:mr-12 rounded-[1.6rem] border-[6px] border-slate-900 dark:border-slate-800 bg-slate-900 shadow-[0_25px_60px_-15px_rgba(0,0,0,0.4)] dark:shadow-[0_25px_60px_-15px_rgba(0,0,0,0.8)] transform rotate-[-4deg] group-hover:rotate-0 group-hover:scale-105 group-hover:-translate-y-2 transition-all duration-700 z-20 opacity-95 dark:opacity-90 overflow-hidden">
						<img src={`/images/logself/${isKo ? 'ko' : 'en'}/1.jpeg`} alt="logSelf Main Screen" class="w-full h-auto rounded-[1.2rem] object-cover" loading="lazy" />
					</div>
				</div>

				<div class="relative flex justify-between items-end transition-transform mt-auto pt-8">
					<div class="flex flex-wrap items-center gap-x-2 gap-y-1.5">
						<div class="z-30 relative inline-flex items-center gap-1.5 text-xs font-bold text-indigo-700 dark:text-indigo-300 bg-indigo-50/80 dark:bg-indigo-950/60 px-3 py-1.5 rounded-full border border-indigo-200 dark:border-indigo-500/40 backdrop-blur-md shadow-sm leading-none" style="height: 28px; line-height: 1; display: inline-flex; align-items: center; font-size: 12px;">
							{t('app.logself.supported')}
						</div>
						<span 
							role="link"
							tabindex="0"
							onclick={`event.stopPropagation(); window.open('https://play.google.com/store/apps/details?id=com.selalink.logself&lang=${lang}', '_blank');`}
							class="z-30 relative pointer-events-auto inline-flex items-center gap-1.5 text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white dark:bg-indigo-500/20 dark:text-indigo-300 dark:border-indigo-500/30 px-3.5 py-1.5 rounded-full border border-indigo-500/20 shadow-sm transition-all duration-300 hover:scale-105 active:scale-95 cursor-pointer"
						>
							<svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
								<path d="M3 20.5v-17c0-.83.67-1.5 1.5-1.5.34 0 .66.12.92.33l13.62 10.15c.67.5.76 1.45.19 2.06l-13.62 10.15a1.5 1.5 0 01-2.42-1.2v-1.92z"/>
							</svg>
							<span>Google Play</span>
						</span>
					</div>
					<a href={`/${lang}/apps/logself/`} class="z-30 relative w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-slate-900 text-white dark:bg-white dark:text-slate-900 flex items-center justify-center group-hover:scale-110 group-hover:bg-indigo-600 dark:group-hover:bg-indigo-400 group-hover:text-white dark:group-hover:text-black transition-all duration-500 shadow-[0_0_30px_rgba(0,0,0,0.1)] dark:shadow-[0_0_30px_rgba(255,255,255,0.3)]">
						<svg class="w-6 h-6 sm:w-8 sm:h-8 transform group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25"/></svg>
					</a>
				</div>
				<!-- Background Gradient Effect -->
				<div class="absolute -bottom-32 -right-32 w-[600px] h-[600px] bg-indigo-300/20 dark:bg-indigo-700/20 blur-[120px] rounded-full group-hover:bg-indigo-400/30 dark:group-hover:bg-indigo-500/20 transition-colors duration-700 z-0 pointer-events-none"></div>
			</div>

			<!-- BuildSelf Card (Large Spatial Canvas) -->
			<div class="bento-card cursor-pointer col-span-1 md:col-span-1 row-span-2 p-5 sm:p-8 md:p-12 flex flex-col justify-between group overflow-hidden relative min-h-[480px] md:min-h-[536px]" style="--glow-color: rgba(16,185,129,0.2);">
				<div class="bento-glow top-0 left-0"></div>
				<a href={`/${lang}/apps/buildself/`} aria-label={t('app.buildself.title')} class="absolute inset-0 z-20"></a>

				<!-- Gradient Shield Overlay (Z-15) for Readability -->
				<div class="absolute inset-x-0 top-0 w-full h-[70%] bg-gradient-to-b from-white via-white/95 to-transparent dark:from-slate-950 dark:via-slate-950/90 dark:to-transparent z-15 pointer-events-none transition-opacity duration-500"></div>
				
				<!-- Top Content (Z-20) -->
				<div class="z-20 relative pointer-events-none dark:drop-shadow-[0_2px_8px_rgba(0,0,0,0.85)]">
					<div class="flex flex-wrap gap-2 mb-4 md:mb-6">

---
import Layout from '../../../../layouts/Layout.astro';
import { languages, useTranslations } from '../../../../i18n/ui';
import { ingredients } from '../../../../data/apps/freshsnap';

export function getStaticPaths() {
  const paths = [];
  const langKeys = Object.keys(languages);
  for (const lang of langKeys) {
    for (const item of ingredients) {
      paths.push({
        params: { lang, ingredient: item.id }
      });
    }
  }
  return paths;
}

const { lang, ingredient } = Astro.params;
const currentLang = (lang as string) || 'en';
const tUi = useTranslations(currentLang as any);
const currentItem = ingredients.find((item) => item.id === ingredient);

if (!currentItem) {
  return Astro.redirect(`/${currentLang}/apps/freshsnap/`);
}

const localName = currentItem.names[currentLang] || currentItem.names['en'];

import { getFreshSnapDetailData } from '../../../../utils/freshsnap/detailHelper';

const {
  recommendedMethod,
  initialGuide,
  initialDays,
  initialBuyDateStr,
  initialBuyDateFormatted,
  initialEatUntil,
  initialDDayText,
  dynamicDescription,
  dynamicKeywords,
  combinedSchemas,
  pageTitle,
  localTranslations,
  sourceTranslations
} = getFreshSnapDetailData(currentItem, currentLang);

const t = (key: string, variables: Record<string, string> = {}) => {
  let text = localTranslations[currentLang]?.[key] || localTranslations['en']?.[key] || key;
  Object.entries(variables).forEach(([k, val]) => {
    text = text.replace(`{${k}}`, val);
  });
  return text;
};

const tSource = (key: string) => {
  return sourceTranslations[currentLang]?.[key] || sourceTranslations['en']?.[key] || key;
};
---

<Layout 
  title={pageTitle} 
  lang={currentLang}
  description={dynamicDescription}
  keywords={dynamicKeywords}
  canonicalUrl={`https://selalink.net/${currentLang}/apps/freshsnap/${currentItem.id}/`}
  ogType="website"
  image={currentItem.iconImage || "/assets/images/og/freshself.png"}
  appId="freshsnap"
  structuredData={combinedSchemas}
>
  <main 
    id="freshsnap-detail-app"
    data-item={JSON.stringify(currentItem)}
    data-lang={currentLang}
    data-local-translations={JSON.stringify(localTranslations)}
    data-source-translations={JSON.stringify(sourceTranslations)}
    data-initial-buy-date-str={initialBuyDateStr}
    class="max-w-[1000px] mx-auto px-4 pt-24 pb-8 md:pt-28 md:pb-16" 
    itemscope 
    itemtype="https://schema.org/HowTo"
  >
    <!-- Back button -->
    <a 
      href={`/${currentLang}/apps/freshsnap/`} 
      class="inline-flex items-center gap-2 text-sm font-bold text-slate-500 hover:text-emerald-600 dark:text-slate-400 dark:hover:text-emerald-400 mb-5 transition-colors duration-300"
    >
      {t('detail.back')}
    </a>

    <!-- Bento Header: Ingredient Name -->
    <div class="bento-card p-5 sm:p-6 mb-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4" style="--glow-color: rgba(16,185,129,0.15);">
      <div class="flex items-center gap-4">
        {currentItem.iconImage ? (
          <img 
            src={currentItem.iconImage} 
            alt={localName}
            class="w-[64px] h-[64px] sm:w-[80px] sm:h-[80px] object-contain select-none"
            id="ingredientImage"
          />
        ) : (
          <span class="text-5xl sm:text-6xl select-none" id="ingredientEmoji">{currentItem.emoji}</span>
        )}
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-800 dark:text-slate-100 mb-0.5" id="ingredientName" itemprop="name">
            {localName}
          </h1>
          <meta itemprop="description" content={dynamicDescription} />
          <span class="text-[10px] font-bold uppercase tracking-widest bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 px-2.5 py-0.5 rounded-full border border-slate-200/50 dark:border-slate-700/50">
            {t(`util.category.${currentItem.category}`).split(' ').slice(1).join(' ') || t(`util.category.${currentItem.category}`)}
          </span>
        </div>
      </div>
      

    </div>

    <!-- 2-Column Side-by-Side Layout for Desktop (PC) / Stacked for Mobile -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 items-start">
      
      <!-- LEFT COLUMN: Storage Tabs, Gauge & Guides (2/3 width on PC) -->
      <div class="md:col-span-2 flex flex-col gap-5">
        
        <!-- Tab Selection & Duration Gauge -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <!-- 1. Selection Tab -->
          <div class="bento-card p-4 flex flex-col gap-2" style="--glow-color: rgba(16,185,129,0.12);">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">{t('detail.storage.type')}</span>
            
            {['room', 'fridge', 'freezer'].map((method) => {
              const hasMethod = !!currentItem.storage[method as keyof typeof currentItem.storage];
              const isRecommended = recommendedMethod === method;
              
              return (
                <button
                  id={`tab-${method}`}
                  data-method={method}
                  disabled={!hasMethod}
                  class={`method-tab w-full px-3.5 py-2.5 rounded-xl font-bold flex items-center justify-between text-xs sm:text-sm transition-all duration-300 border ${
                    !hasMethod 
                      ? 'opacity-30 cursor-not-allowed border-transparent bg-slate-50/50 dark:bg-slate-900/30 text-slate-400 line-through' 
                      : isRecommended
                        ? 'active-tab bg-emerald-600 text-white border-emerald-600 shadow-sm shadow-emerald-600/15'
                        : 'bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 hover:border-emerald-500/50 cursor-pointer'
                  }`}
                >
                  <span>{t(`detail.storage.${method}`)}</span>
                  {isRecommended && hasMethod && (
                    <span class="recommend-badge text-[8px] px-1.5 py-0.5 rounded font-black tracking-tighter uppercase">
                      {t('detail.recommended.badge')}
                    </span>
                  )}
                </button>
              );
            })}
          </div>

          <!-- 2. Gauge Bar Display -->
          <div class="bento-card p-4 sm:p-5 sm:col-span-2 flex flex-col justify-between" style="--glow-color: rgba(16,185,129,0.12);">
            <div>
              <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-1">{t('detail.recommend.days')}</span>
              <div class="flex items-baseline gap-1">
                <span id="daysCount" class="text-4xl font-black text-emerald-600 dark:text-emerald-400 font-outfit">{initialDays}</span>
                <span id="daysUnit" class="text-sm font-bold text-slate-500 dark:text-slate-400">
                  {initialDays === 1 ? t('detail.days') : t('detail.days.plural')}
                </span>
              </div>
            </div>

            <!-- Animated Gauge Bar Container (다크/라이트 모드 대비 및 입체감 극대화) -->
            <div class="my-4">
              <div class="h-3.5 w-full bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden shadow-[inset_0_1px_3px_rgba(0,0,0,0.1)] dark:shadow-[inset_0_1px_5px_rgba(0,0,0,0.3)] p-[2.5px] border border-slate-200/60 dark:border-slate-700/40">
                <div 
                  id="gaugeFill" 
                  class="h-full bg-gradient-to-r from-emerald-500 to-teal-500 rounded-full transition-all duration-700 ease-out shadow-[0_1px_2px_rgba(0,0,0,0.15)]"
                  style={`width: ${Math.min(100, (initialDays / 45) * 100)}%`}
                ></div>
              </div>
              <div class="flex justify-between text-[10px] text-slate-400 dark:text-slate-500 font-extrabold mt-2 px-1 select-none">
                <span>0</span>
                <span>15</span>
                <span>30</span>
                <span>45+ {t('detail.days.plural')}</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Storage Tips Guide Bento Card -->
        <div class="bento-card p-5" style="--glow-color: rgba(16,185,129,0.15);">
          <h2 class="text-base sm:text-lg font-bold text-slate-800 dark:text-slate-100 mb-4 flex items-center gap-1.5">
            💡 {t('detail.guide.title')}
          </h2>
          <div id="tipsContainer" class="text-sm sm:text-base leading-relaxed text-slate-600 dark:text-slate-300 space-y-3">
            {/* Initial Tip load in SSR */}
            {initialGuide && (
              <div class="p-4 rounded-xl bg-emerald-50/50 dark:bg-emerald-950/10 border border-emerald-500/10 transition-opacity duration-300" itemprop="step" itemscope itemtype="https://schema.org/HowToStep">
                <p class="font-semibold text-slate-700 dark:text-slate-200" itemprop="text">
                  {initialGuide.tips[currentLang] || initialGuide.tips['en']}
                </p>
              </div>
            )}
          </div>

          <!-- Sources display area (배지 고대비 가독성 향상) -->
          <div id="sourcesContainer" class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 text-[11px] text-slate-400 dark:text-slate-500">
            {initialGuide && initialGuide.sources && initialGuide.sources.length > 0 && (
              <div class="flex flex-wrap items-center gap-1.5">
                <span class="font-bold mr-1">{tSource('detail.source.label')}:</span>
                {initialGuide.sources.map((src: string) => (
                  <span class="bg-emerald-50 dark:bg-emerald-950/20 border border-emerald-200 dark:border-emerald-900/50 px-2 py-0.5 rounded-md font-bold text-emerald-800 dark:text-emerald-300">
                    {tSource(`source.${src}`)}
                  </span>
                ))}
              </div>
            )}
          </div>
        </div>

      </div>

      <!-- RIGHT COLUMN: D-Day Calculator & App Promo (1/3 width on PC, Sticky) -->
      <div class="md:col-span-1 flex flex-col gap-5 md:sticky md:top-28">
        
        <!-- D-Day Interactive Calculator Bento Card -->
        <div class="bento-card p-5 relative z-20 !overflow-visible" style="--glow-color: rgba(16,185,129,0.15);">
          <h2 class="text-base sm:text-lg font-bold text-slate-800 dark:text-slate-100 mb-4">
            {t('detail.calc.title')}
          </h2>
          <div class="flex flex-col gap-4">


            <!-- Input buying date (Hybrid Custom UI) -->
            <div class="flex flex-col gap-1.5 relative">
              <label class="text-[11px] font-bold text-slate-500 dark:text-slate-400">
                {t('detail.calc.buy_date')}
              </label>
              
              <input type="hidden" id="buyDate" value={initialBuyDateStr} />
              
              <!-- Custom Date Input Trigger Button -->
              <button 
                type="button"
                id="buyDateTrigger" 
                class="w-full px-3.5 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-sm text-slate-800 dark:text-slate-100 font-bold flex items-center justify-between hover:border-emerald-500/50 transition-all cursor-pointer select-none active:scale-[0.99]"
              >
                <span id="buyDateFormatted" class="font-outfit font-bold">{initialBuyDateFormatted}</span>
                <span class="text-slate-400 shrink-0 text-sm">📅</span>
              </button>

              <!-- Quick Preset Chips -->
              <div class="flex items-center gap-1 mt-1 flex-wrap">
                <button type="button" data-preset="0" class="preset-chip px-2 py-0.5 text-[10px] font-bold rounded-lg border border-slate-200 dark:border-slate-800/80 bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 hover:border-emerald-500/50 hover:text-emerald-600 dark:hover:text-emerald-400 active:scale-95 transition-all cursor-pointer select-none">
                  {t('detail.calc.preset.today')}
                </button>
                <button type="button" data-preset="1" class="preset-chip px-2 py-0.5 text-[10px] font-bold rounded-lg border border-slate-200 dark:border-slate-800/80 bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 hover:border-emerald-500/50 hover:text-emerald-600 dark:hover:text-emerald-400 active:scale-95 transition-all cursor-pointer select-none">
                  {t('detail.calc.preset.yesterday')}
                </button>
                <button type="button" data-preset="3" class="preset-chip px-2 py-0.5 text-[10px] font-bold rounded-lg border border-slate-200 dark:border-slate-800/80 bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 hover:border-emerald-500/50 hover:text-emerald-600 dark:hover:text-emerald-400 active:scale-95 transition-all cursor-pointer select-none">
                  {t('detail.calc.preset.3days')}
                </button>
              </div>

              <!-- Glassmorphism Custom Calendar Popover -->
              <div 
                id="customCalendarPopover" 
                class="absolute left-0 top-[105%] z-50 w-[260px] p-3.5 rounded-2xl bg-white/95 dark:bg-slate-900/95 border border-slate-200/60 dark:border-slate-800/80 shadow-[0_20px_50px_rgba(0,0,0,0.15)] dark:shadow-[0_20px_50px_rgba(0,0,0,0.5)] backdrop-blur-xl transition-all duration-300 scale-95 opacity-0 pointer-events-none origin-top-left"
              >
                <!-- Calendar Header -->
                <div class="flex items-center justify-between mb-2">
                  <button type="button" id="prevMonthBtn" class="p-1 px-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-500 dark:text-slate-400 font-black cursor-pointer transition-all active:scale-90 select-none">&lt;</button>
                  <span id="currentMonthYear" class="font-bold text-[11px] text-slate-700 dark:text-slate-200 font-outfit uppercase tracking-wider">June 2026</span>
                  <button type="button" id="nextMonthBtn" class="p-1 px-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-500 dark:text-slate-400 font-black cursor-pointer transition-all active:scale-90 select-none">&gt;</button>
                </div>

                <!-- Weekdays Row -->
                <div class="grid grid-cols-7 gap-1 text-[8px] font-black text-center text-slate-400 dark:text-slate-500 uppercase mb-1.5 select-none">
                  <span>Su</span>
                  <span>Mo</span>
                  <span>Tu</span>
                  <span>We</span>
                  <span>Th</span>
                  <span>Fr</span>
                  <span>Sa</span>
                </div>

                <!-- Days Grid -->
                <div id="calendarDaysGrid" class="grid grid-cols-7 gap-1 text-[11px]">
                  <!-- Dynamically populated via JS -->
                </div>
              </div>
            </div>
            
            <!-- Live result feedback bubble -->
            <div id="resultFeedbackCard" class={`p-4 rounded-xl border flex flex-col justify-between min-h-[90px] transition-all duration-300 ${
              initialDays > 0 
                ? 'bg-emerald-50/60 dark:bg-emerald-950/15 border-emerald-500/40' 
                : 'bg-rose-50/60 dark:bg-rose-950/15 border-rose-500/40'
            }`}>
              <div>
                <p id="calcEatUntil" class="text-xs font-semibold text-slate-500 dark:text-slate-400 mb-1">{initialEatUntil}</p>
                <p id="calcDDay" class={initialDays > 0 ? "text-lg font-extrabold text-emerald-600 dark:text-emerald-400 leading-snug" : "text-base font-bold text-rose-600 dark:text-rose-400 leading-snug"}>{initialDDayText}</p>
              </div>
            </div>

            <!-- 나의 냉장고 등록 버튼 -->
            <button
              type="button"
              id="keepInFridgeBtn"
              class="w-full px-4 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-750 dark:bg-indigo-600 dark:hover:bg-indigo-500 text-white font-extrabold text-sm sm:text-base flex items-center justify-center gap-2 cursor-pointer shadow-md shadow-indigo-600/15 active:scale-[0.98] hover:scale-[1.01] transition-all duration-300"
            >
              <span>{t('detail.calc.keep_fridge')}</span>
            </button>
          </div>
        </div>

        <!-- App Installation Promotional CTA (FreshSnap Emerald Premium Banner) -->
        <div class="bento-card p-6 relative overflow-hidden rounded-3xl border border-emerald-100 dark:border-emerald-500/20 bg-gradient-to-br from-emerald-50/80 via-emerald-50/30 to-transparent dark:from-emerald-950/20 dark:via-emerald-950/10 dark:to-slate-900/30 backdrop-blur-md transition-all duration-300 hover:shadow-lg">
          <!-- Subtle spatial gradient -->
          <div class="absolute -right-16 -bottom-16 w-40 h-40 bg-emerald-600/10 rounded-full blur-[60px] pointer-events-none"></div>
          
          <div class="relative z-10 flex flex-col justify-between h-full space-y-4">
            <div class="space-y-3">
              <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-extrabold border shadow-xs bg-emerald-100 dark:bg-emerald-500/20 text-emerald-800 dark:text-emerald-300 border-emerald-200 dark:border-emerald-500/30">
                <span class="truncate">{t('detail.promo.sub')}</span>
              </div>
              
              <div class="flex items-center gap-2 pt-1">
                <img src={`${import.meta.env.BASE_URL}images/freshself/icon.png`} alt="FreshSelf App Icon" class="w-6 h-6 rounded-lg object-cover shadow-xs border border-emerald-200 dark:border-emerald-500/30 m-0 shrink-0" />
                <span class="text-xs font-black text-emerald-600 dark:text-emerald-400 tracking-wider uppercase">FreshSelf</span>
              </div>

              <h2 class="text-base sm:text-lg font-black text-slate-900 dark:text-white leading-snug m-0">
                {currentItem.isProcessed ? t('detail.promo.title.processed') : t('detail.promo.title.fresh')}
              </h2>
              
              <p class="text-xs text-slate-600 dark:text-slate-400 font-medium leading-relaxed m-0">
                {currentItem.isProcessed ? t('detail.promo.processed') : t('detail.promo.fresh')}
              </p>
            </div>

            <!-- Single Google Play Downloader button -->
            <div class="space-y-2 pt-2">
              <a 
                href={`https://play.google.com/store/apps/details?id=com.selalink.freshself&hl=${currentLang}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white w-full py-3 rounded-2xl font-semibold text-xs sm:text-sm shadow-sm hover:shadow hover:scale-[1.01] active:scale-[0.99] transition-all duration-200 no-underline text-center"
              >
                <img src={`${import.meta.env.BASE_URL}images/google_play_icon.webp`} alt="Google Play Icon" class="w-4 h-4 sm:w-5 sm:h-5 shrink-0 object-contain drop-shadow-sm m-0" />
                <span class="whitespace-nowrap">{tUi('app.download_google_play')}</span>
              </a>

              <div class="text-[10px] font-semibold text-slate-500 dark:text-slate-400 text-center w-full leading-relaxed pt-1">
                {t('detail.promo.badge_subtext')}
              </div>
            </div>
          </div>
        </div>

      </div>

    </div>

    <!-- Legal Disclaimer -->
    <div class="mt-10 p-5 rounded-2xl bg-slate-100/50 dark:bg-slate-900/30 border border-slate-200/50 dark:border-slate-800/50 max-w-3xl mx-auto flex items-start gap-2.5 select-none">
      <span class="text-sm text-slate-400 dark:text-slate-500 shrink-0">ℹ️</span>
      <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-relaxed text-left">
        {t('detail.disclaimer')}
      </p>
    </div>
  </main>

  <script src="../../../../utils/freshsnapDetail.ts"></script>

  <style>
    /* 추천 뱃지 기본 스타일 (비활성 상태) */
    .recommend-badge {
      background-color: rgba(16, 185, 129, 0.1);
      color: #059669; /* emerald-600 */
      transition: all 0.3s ease;
    }
    
    :global(.dark) .recommend-badge {
      background-color: rgba(52, 211, 153, 0.15);
      color: #34d399; /* emerald-400 */
    }

    /* 활성화된 탭 내부의 추천 뱃지 스타일 */
    :global(.active-tab) .recommend-badge {
      background-color: rgba(255, 255, 255, 0.2) !important;
      color: #ffffff !important;
    }


  </style>
</Layout>

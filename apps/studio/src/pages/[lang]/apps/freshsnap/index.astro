---
import Layout from '../../../../layouts/Layout.astro';
import { languages } from '../../../../i18n/ui';
import { ingredients } from '../../../../data/ingredients';
import BackToStudioButton from '../../../../components/BackToStudioButton.astro';
import AppBackgroundBlurs from '../../../../components/AppBackgroundBlurs.astro';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
const currentLang = (lang as string) || 'en';

import { 
  localTranslations, 
  categories, 
  getLocalizedIngredients, 
  getCategoryCounts 
} from '../../../../utils/freshsnap/indexHelper';

const t = (key: string) => {
  return localTranslations[currentLang]?.[key] || localTranslations['en']?.[key] || key;
};

// 현재 로케일에 최적화된 식재료 정보 생성
const localizedIngredients = getLocalizedIngredients(ingredients, currentLang);

const categoryCounts = getCategoryCounts(ingredients);
---

<Layout 
  title={t('util.title')} 
  lang={currentLang}
  description={t('util.subtitle')}
  canonicalUrl={`https://selalink.net/${currentLang}/apps/freshsnap/`}
  ogType="software"
  image="/assets/images/og/freshself.png"
  appId="freshsnap"
>
  <main class="max-w-[1200px] mx-auto px-4 pt-24 pb-8 md:pt-28 md:pb-16 relative">
    <AppBackgroundBlurs appId="freshsnap" />

    <!-- Navigation / Header Breadcrumb -->
    <div class="relative z-10">
      <BackToStudioButton lang={currentLang} class="mb-6" />
    </div>

    <!-- Hero Section (모바일 세로 높이 최소화 설계) -->
    <div class="text-center mb-6 md:mb-12">
      <h1 class="text-2xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-2 md:mb-4 bg-gradient-to-r from-emerald-600 to-teal-600 dark:from-emerald-400 dark:to-teal-400 bg-clip-text text-transparent">
        {t('util.title')}
      </h1>
      <p class="hidden md:block text-base md:text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed">
        {t('util.subtitle')}
      </p>

      <!-- 글로벌 신뢰성 뱃지 그룹 (모바일에서 팝오버로 전환) -->
      <div class="flex flex-col items-center gap-2 mt-4 md:mt-6 select-none relative">
        <div 
          id="trustBadgeContainer" 
          class="hidden md:flex flex-wrap justify-center gap-1.5 max-w-xl transition-all duration-300"
        >
          {[
            'WHO / FAO',
            'EFSA (EU)',
            'USDA (U.S.)',
            'FSA (UK)',
            'CDC (U.S.)',
            'MFDS (KR)',
            'RDA (KR)',
            'NIFS (KR)',
            'KCA (KR)'
          ].map((org) => (
            <span class="text-[10px] md:text-xs font-bold uppercase tracking-wider bg-slate-200/50 dark:bg-slate-800/80 text-slate-700 dark:text-slate-200 px-3 py-1.5 rounded-full border border-slate-300/80 dark:border-slate-700/80 hover:border-emerald-500 dark:hover:border-emerald-400 transition-colors duration-300">
              {org}
            </span>
          ))}
        </div>

        <!-- 모바일 전용 콤팩트 라벨 (신뢰 기관 토글 버튼) -->
        <button 
          type="button"
          id="mobileTrustTrigger" 
          class="flex md:hidden items-center gap-1.5 bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-750 px-3 py-2 rounded-xl text-[10px] font-extrabold text-slate-600 dark:text-slate-400 hover:border-emerald-500/50 dark:hover:border-emerald-400/50 transition-all cursor-pointer select-none active:scale-95"
        >
          <span>{t('util.trust.mobile')}</span>
          <span id="mobileTrustArrow" class="text-[8px] text-slate-400 inline-block transition-transform duration-300">▼</span>
        </button>

        <p class="hidden md:block text-[11px] md:text-xs text-slate-500 dark:text-slate-400 font-semibold tracking-tight">
          {t('util.trust.sub')}
        </p>
      </div>
    </div>

    <!-- 📌 긴급 보관주의 상단 핀 쉘프 (Pinned Actionable Shelf) -->
    <div 
      id="urgentAlertShelf" 
      class="hidden p-4 sm:p-5 mb-6 rounded-[1.6rem] bg-gradient-to-r from-amber-500/10 via-rose-500/10 to-indigo-500/10 dark:from-amber-950/40 dark:via-rose-950/40 dark:to-indigo-950/40 border border-amber-500/30 dark:border-amber-500/40 shadow-sm backdrop-blur-xl transition-all duration-300 select-none"
    >
      <div class="flex items-center justify-between gap-3 mb-3">
        <div class="flex items-center gap-2">
          <span class="flex h-2.5 w-2.5 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-amber-500"></span>
          </span>
          <h3 class="text-xs sm:text-sm font-extrabold text-amber-800 dark:text-amber-300 uppercase tracking-wider flex items-center gap-1.5">
            📌 오늘 꼭 확인하세요! (소비 임박 식재료)
          </h3>
        </div>
        <span id="urgentCountBadge" class="text-[10px] font-black bg-amber-500/20 text-amber-800 dark:text-amber-200 px-2 py-0.5 rounded-full">0개</span>
      </div>
      <div id="urgentAlertGrid" class="flex flex-wrap gap-2 sm:gap-3">
        <!-- 핀 아이템 동적 바인딩 -->
      </div>
    </div>

    <!-- 나의 냉장고 대시보드 섹션 (가이드 문구가 있는 Empty State 상시 노출) -->
    <div 
      id="myFridgeSection" 
      class="app-card-neon p-4 md:p-6 mb-6 border-indigo-500/20 dark:border-indigo-500/30" 
      style="--theme-color-light: rgba(99, 102, 241, 0.15); --theme-color-brand: #6366F1; --theme-color-glow: rgba(99, 102, 241, 0.15); --theme-color-glow-secondary: rgba(99, 102, 241, 0.05);"
    >
      <!-- 헤더 및 성취도 통계 -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5 pb-4 border-b border-slate-200/50 dark:border-slate-800/50 select-none">
        <div>
          <h2 class="text-lg sm:text-xl font-bold text-slate-800 dark:text-slate-100 flex items-center gap-2">
            🧊 {t('util.myfridge.title')}
            <span id="myFridgeCount" class="bg-indigo-600 text-white text-xs px-2.5 py-0.5 rounded-full font-black font-outfit">0</span>
            <button 
              id="myFridgeToggleBtn" 
              class="p-1 text-slate-450 hover:text-slate-600 dark:text-slate-500 dark:hover:text-slate-300 transition-colors select-none cursor-pointer focus:outline-none"
              aria-expanded="true"
            >
              <span id="myFridgeToggleArrow" class="inline-block transition-transform duration-300">▲</span>
            </button>
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
            {t('util.myfridge.subtitle')}
          </p>
        </div>
        
        <!-- 제로 웨이스트 성취도 스코어 및 초기화 버튼 -->
        <div class="flex flex-col items-end gap-1.5">
          <div class="flex items-center gap-3 bg-slate-100/80 dark:bg-slate-900/50 px-3 py-2 rounded-2xl border border-slate-200/40 dark:border-slate-800/40">
            <div class="text-right">
              <div class="text-[9px] font-black uppercase text-slate-400 dark:text-slate-500 tracking-wider">{t('util.myfridge.score')}</div>
              <div class="text-sm font-black text-indigo-600 dark:text-indigo-400 font-outfit leading-tight" id="zeroWasteScore">100%</div>
            </div>
            <div class="w-16 h-2 bg-slate-200 dark:bg-slate-800 rounded-full overflow-hidden p-[1px]">
              <div id="zeroWasteProgress" class="h-full bg-gradient-to-r from-indigo-500 to-emerald-500 rounded-full transition-all duration-500" style="width: 100%"></div>
            </div>
          </div>
          <button 
            id="myFridgeResetBtn" 
            class="text-[10px] font-extrabold text-slate-400 hover:text-indigo-600 dark:text-slate-500 dark:hover:text-indigo-400 cursor-pointer transition-colors select-none active:scale-95"
          >
            {t('util.myfridge.reset')}
          </button>
        </div>
      </div>

      <!-- 보관 식재료 그리드 리스트 -->
      <div 
        id="myFridgeGrid" 
        class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 md:gap-4"
      >
        <!-- 동적 바인딩 -->
      </div>
    </div>

    <!-- 커스텀 리셋 컨펌 모달 (인디고 네온 테마 - myFridgeSection 밖으로 분리) -->
    <div 
      id="myFridgeResetModal" 
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/60 backdrop-blur-sm hidden select-none"
    >
      <div class="w-full max-w-sm bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800/80 rounded-3xl p-6 shadow-2xl flex flex-col items-center text-center animate-fade-in">
        <!-- 리셋 원형 아이콘 -->
        <div class="w-12 h-12 rounded-full bg-indigo-50 dark:bg-indigo-950/30 flex items-center justify-center mb-4 border border-indigo-100/50 dark:border-indigo-900/50 text-indigo-600 dark:text-indigo-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 stroke-[2]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 1121.21 7.89M9 11l3-3 3 3" />
          </svg>
        </div>
        
        <h3 class="text-base font-bold text-slate-800 dark:text-slate-100 mb-2">
          {t('util.myfridge.reset')}
        </h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed mb-6">
          {t('util.myfridge.reset.confirm')}
        </p>
        
        <!-- 액션 단추 -->
        <div class="flex items-center gap-3 w-full">
          <button 
            type="button" 
            id="myFridgeCancelResetBtn" 
            class="flex-1 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-650 dark:text-slate-350 font-extrabold text-xs text-center transition-colors cursor-pointer select-none active:scale-95"
          >
            {t('util.myfridge.reset.cancel')}
          </button>
          <button 
            type="button" 
            id="myFridgeConfirmResetBtn" 
            class="flex-1 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-extrabold text-xs text-center shadow-lg shadow-indigo-600/20 transition-colors cursor-pointer select-none active:scale-95"
          >
            {t('util.myfridge.reset')}
          </button>
        </div>
      </div>
    </div>

    <div 
      class="app-card-neon p-4 md:p-6 mb-6" 
      style="--theme-color-light: rgba(16, 185, 129, 0.15); --theme-color-brand: #10B981; --theme-color-glow: rgba(16, 185, 129, 0.15); --theme-color-glow-secondary: rgba(16, 185, 129, 0.05);"
    >
      <!-- Search Input Container with Ambient Glow -->
      <div class="relative max-w-2xl mx-auto mb-5 group/search">
        <div class="absolute -inset-0.5 bg-gradient-to-r from-emerald-500 to-teal-500 rounded-2xl blur-md opacity-0 group-focus-within/search:opacity-20 dark:group-focus-within/search:opacity-30 transition duration-500"></div>
        <div class="relative">
          <span class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400 text-lg">
            🔍
          </span>
          <input 
            type="text" 
            id="searchInput" 
            placeholder={t('util.search.placeholder')}
            class="w-full pl-12 pr-4 py-3.5 rounded-2xl bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/80 text-base focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-all font-semibold text-slate-800 dark:text-slate-100"
          />
        </div>
      </div>

      <!-- Categories Filter Slider -->
      <div class="flex items-center gap-2 overflow-x-auto pb-3.5 scrollbar-none scroll-smooth border-b border-slate-200/50 dark:border-slate-800/50">
        {categories.map((cat) => (
          <button
            data-category={cat}
            class={`category-btn flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs sm:text-sm font-semibold cursor-pointer whitespace-nowrap transition-all duration-300 border ${
              cat === 'all' 
                ? 'bg-emerald-600 border-emerald-600 text-white shadow-md shadow-emerald-600/20' 
                : 'bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 hover:border-emerald-500 dark:hover:border-emerald-500'
            }`}
          >
            <span>{t(`util.category.${cat}`)}</span>
            <span class={`count-badge px-1.5 py-0.5 text-[10px] rounded-md transition-colors ${
              cat === 'all'
                ? 'bg-emerald-700/50 text-emerald-100'
                : 'bg-slate-100 dark:bg-slate-800/80 text-slate-500 dark:text-slate-400'
            }`}>
              {categoryCounts[cat]}
            </span>
          </button>
        ))}
      </div>

      <!-- 3rd Row: Advanced Filters & Layout Controls -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mt-4">
        <div class="flex flex-wrap items-center gap-3">
          <!-- Storage Method Filter -->
          <div id="methodFilterContainer" class="flex bg-slate-100 dark:bg-slate-800/80 p-0.5 rounded-xl border border-slate-200 dark:border-slate-700/60 select-none">
            <button data-method-filter="all" class="method-filter-btn active px-3 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer">
              {t('util.filter.method.all')}
            </button>
            <button data-method-filter="room" class="method-filter-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200">
              {t('util.card.room')} 🟡
            </button>
            <button data-method-filter="fridge" class="method-filter-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200">
              {t('util.card.fridge')} 🟢
            </button>
            <button data-method-filter="freezer" class="method-filter-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200">
              {t('util.card.freezer')} 🔵
            </button>
          </div>

        </div>

        <div class="flex items-center gap-3 justify-end md:justify-start">
          <!-- Layout View Toggle -->
          <div class="flex bg-slate-100 dark:bg-slate-800/80 p-0.5 rounded-xl border border-slate-200 dark:border-slate-700/60 select-none">
            <button id="viewGridBtn" class="view-toggle-btn active px-3 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer flex items-center gap-1.5" title={t('util.view.grid')}>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 shrink-0"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
              <span class="hidden sm:inline">{t('util.view.grid')}</span>
            </button>
            <button id="viewFridgeBtn" class="view-toggle-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 flex items-center gap-1.5" title={t('util.view.fridge')}>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 shrink-0"><path d="M5 10h14M5 15h14M5 20h14"></path><rect x="3" y="3" width="18" height="18" rx="2"></rect></svg>
              <span class="hidden sm:inline">{t('util.view.fridge')}</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Grid Container with Bento Layout -->
    <div 
      id="ingredientsGrid" 
      class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-5 transition-all duration-300"
    >
      {localizedIngredients.map((item) => {
        return (
          <div class="ingredient-item-wrapper relative group select-none col-span-1">
            <a 
              href={`/${currentLang}/apps/freshsnap/${item.id}/`}
              data-item-id={item.id}
              data-item-category={item.category}
              data-search-index={item.searchIndex}
              data-has-room={item.storage.room ? "true" : "false"}
              data-has-fridge={item.storage.fridge ? "true" : "false"}
              data-has-freezer={item.storage.freezer ? "true" : "false"}
              data-duration-room={item.storage.room?.durationDays || 0}
              data-duration-fridge={item.storage.fridge?.durationDays || 0}
              data-duration-freezer={item.storage.freezer?.durationDays || 0}
              data-recommended-method={item.recommendedMethod}
              data-recommended-label={t(`util.card.${item.recommendedMethod}.recommended`)}
              class="ingredient-item p-4 sm:p-5 w-full flex flex-col justify-between group overflow-hidden rounded-[1.6rem] border border-slate-200/80 dark:border-slate-800/80 bg-white/90 dark:bg-slate-900/90 backdrop-blur-xl shadow-sm hover:shadow-[0_12px_32px_rgba(16,185,129,0.18)] dark:hover:shadow-[0_12px_32px_rgba(16,185,129,0.12)] hover:-translate-y-1.5 transition-all duration-300 relative"
            >
              <!-- 모던 글래스모피즘 비주얼 & 추천보관 네온 캡슐 -->
              <div class="flex items-start justify-between gap-3 w-full mb-3">
                <!-- 글래스모피즘 부유 이모지 서클 -->
                <div class="w-13 h-13 sm:w-15 sm:h-15 rounded-2xl bg-gradient-to-br from-emerald-500/10 to-teal-500/5 dark:from-emerald-500/15 dark:to-teal-500/10 border border-emerald-500/20 dark:border-emerald-500/30 flex items-center justify-center shrink-0 shadow-inner group-hover:scale-110 group-hover:border-emerald-500/40 transition-all duration-300">
                  {item.iconImage ? (
                    <img 
                      src={item.iconImage} 
                      alt={item.localName}
                      class="w-8 h-8 sm:w-10 sm:h-10 object-contain select-none block"
                      loading="lazy"
                    />
                  ) : (
                    <span class="text-2xl sm:text-3xl select-none block">
                      {item.emoji}
                    </span>
                  )}
                </div>

                <!-- 9개 기관 신뢰 출처 마이크로 뱃지 -->
                {item.sources && item.sources.length > 0 && (
                  <div class="flex flex-col items-end gap-1 select-none">
                    <span class="text-[9px] font-extrabold uppercase tracking-tight bg-slate-100/80 dark:bg-slate-800/80 text-slate-500 dark:text-slate-400 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 px-2 py-0.5 rounded-full border border-slate-200/80 dark:border-slate-700/80 transition-colors duration-300">
                      {item.sources[0]}
                    </span>
                  </div>
                )}
              </div>

              <!-- 식재료 명칭 및 카테고리 -->
              <div class="mb-3">
                <h2 class="text-base sm:text-lg font-extrabold text-slate-800 dark:text-slate-100 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors leading-snug">
                  {item.localName}
                </h2>
                <span class="text-[10px] sm:text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">
                  {t(`util.category.${item.category}`).split(' ').slice(1).join(' ') || t(`util.category.${item.category}`)}
                </span>
              </div>

              <!-- 보관 기한 캡슐 뱃지 리스트 & 상세보기 안내 -->
              <div class="mt-auto pt-3 border-t border-slate-100 dark:border-slate-800/80 flex flex-col gap-2">
                <div class="flex flex-wrap gap-1 text-[10px] font-bold text-slate-600 dark:text-slate-400 duration-badges">
                  {item.storage.room && (
                    <span data-badge-method="room" class="room-badge bg-amber-50 dark:bg-amber-950/40 text-amber-800 dark:text-amber-300 px-2 py-0.5 rounded-full border border-amber-200/60 dark:border-amber-900/40 transition-all">
                      {t('util.card.room')}{' '}
                      <strong class="badge-days font-black text-amber-950 dark:text-amber-100">
                        {item.storage.room.durationDays >= 1095 ? t('util.card.infinite') : item.storage.room.durationDays}
                      </strong>
                      {item.storage.room.durationDays < 1095 && t('util.card.days')}
                    </span>
                  )}
                  {item.storage.fridge && (
                    <span data-badge-method="fridge" class="fridge-badge bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300 px-2 py-0.5 rounded-full border border-emerald-200/60 dark:border-emerald-900/40 transition-all">
                      {t('util.card.fridge')}{' '}
                      <strong class="badge-days font-black text-emerald-950 dark:text-emerald-100">
                        {item.storage.fridge.durationDays >= 1095 ? t('util.card.infinite') : item.storage.fridge.durationDays}
                      </strong>
                      {item.storage.fridge.durationDays < 1095 && t('util.card.days')}
                    </span>
                  )}
                  {item.storage.freezer && (
                    <span data-badge-method="freezer" class="freezer-badge bg-blue-50 dark:bg-blue-950/40 text-blue-800 dark:text-blue-300 px-2 py-0.5 rounded-full border border-blue-200/60 dark:border-blue-900/40 transition-all">
                      {t('util.card.freezer')}{' '}
                      <strong class="badge-days font-black text-blue-950 dark:text-blue-100">
                        {item.storage.freezer.durationDays >= 1095 ? t('util.card.infinite') : item.storage.freezer.durationDays}
                      </strong>
                      {item.storage.freezer.durationDays < 1095 && t('util.card.days')}
                    </span>
                  )}
                </div>


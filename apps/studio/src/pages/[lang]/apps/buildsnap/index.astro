---
import Layout from '../../../../layouts/Layout.astro';
import { languages } from '../../../../i18n/ui';
import BackToStudioButton from '../../../../components/BackToStudioButton.astro';
import AppBackgroundBlurs from '../../../../components/AppBackgroundBlurs.astro';

// 원천 데이터 및 번역 사전 임포트
import { habits } from '../../../../data/habits';
import { buildsnapTranslations } from '../../../../i18n/buildsnapTranslations';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
const currentLang = (lang as string) || 'ko';

const t = (key: string) => {
  return buildsnapTranslations[currentLang]?.[key] || buildsnapTranslations['ko']?.[key] || key;
};

// 1. 빌드 타임 통계 사전 분석 (Pre-aggregation)
const totalHabits = habits.length;

// A. timeOfDay 집계
const timeOfDayCounts = { morning: 0, afternoon: 0, evening: 0, night: 0, anytime: 0 };
habits.forEach(h => {
  const key = h.timeOfDay === 'evening' ? 'evening' :
              h.timeOfDay === 'night' ? 'night' :
              h.timeOfDay === 'afternoon' ? 'afternoon' :
              h.timeOfDay === 'morning' ? 'morning' : 'anytime';
  timeOfDayCounts[key]++;
});

// B. era 집계
const eraCounts = { ancient: 0, renaissance: 0, earlyModern: 0, modern: 0, contemporary: 0 };
habits.forEach(h => {
  const eraStr = (h.era || '').toLowerCase();
  if (eraStr.includes('고대')) eraCounts.ancient++;
  else if (eraStr.includes('르네상스')) eraCounts.renaissance++;
  else if (eraStr.includes('근세')) eraCounts.earlyModern++;
  else if (eraStr.includes('근대')) eraCounts.modern++;
  else eraCounts.contemporary++; // 현대 및 contemporary 통합
});

// C. 각 시대별 매칭 위인 명단 빌드타임 전처리
const eraMentors = {
  ancient: habits.filter(h => (h.era || '').toLowerCase().includes('고대')).map(h => h.name),
  renaissance: habits.filter(h => (h.era || '').toLowerCase().includes('르네상스')).map(h => h.name),
  earlyModern: habits.filter(h => (h.era || '').toLowerCase().includes('근세')).map(h => h.name),
  modern: habits.filter(h => (h.era || '').toLowerCase().includes('근대')).map(h => h.name),
  contemporary: habits.filter(h => !(h.era || '').toLowerCase().includes('고대') && !(h.era || '').toLowerCase().includes('르네상스') && !(h.era || '').toLowerCase().includes('근세') && !(h.era || '').toLowerCase().includes('근대')).map(h => h.name)
};

// D. 준비 난이도 (requiredItems 개수 기준)
let easyCount = 0;
let hardCount = 0;
habits.forEach(h => {
  const itemsLen = h.requiredItems ? h.requiredItems.length : 0;
  if (itemsLen <= 1 || h.tags.includes('#쉬움')) {
    easyCount++;
  } else {
    hardCount++;
  }
});

const easyPercent = Math.round((easyCount / totalHabits) * 100);
const hardPercent = 100 - easyPercent; // 보정 완료

// E. 행동 카테고리 집계 (태그 키워드 매핑)
let focusCount = 0;      // 집중력 및 생산성
let creativeCount = 0;   // 창의성 및 아이디어
let simplicityCount = 0; // 단순화 및 의사결정
let mindCount = 0;       // 휴식 및 사색

habits.forEach(h => {
  const tagsStr = h.tags.join(' ');
  if (tagsStr.includes('집중') || tagsStr.includes('몰입') || tagsStr.includes('생산성')) focusCount++;
  if (tagsStr.includes('창의') || tagsStr.includes('아이디어') || tagsStr.includes('글쓰기') || tagsStr.includes('기록') || tagsStr.includes('메모')) creativeCount++;
  if (tagsStr.includes('단순') || tagsStr.includes('의사결정')) simplicityCount++;
  if (tagsStr.includes('휴식') || tagsStr.includes('사색') || tagsStr.includes('명상') || tagsStr.includes('수면') || tagsStr.includes('이완')) mindCount++;
});

const totalCategorySum = (focusCount + creativeCount + simplicityCount + mindCount) || 1;
const focusPercent = Math.round((focusCount / totalCategorySum) * 100);
const creativePercent = Math.round((creativeCount / totalCategorySum) * 100);
const simplicityPercent = Math.round((simplicityCount / totalCategorySum) * 100);
const mindPercent = 100 - (focusPercent + creativePercent + simplicityPercent); // 카테고리 총합 100% 보정 완료

// F. 시간대별 반올림 오차 보정 완료형 변수 선언
const morningPercent = Math.round((timeOfDayCounts.morning / totalHabits) * 100);
const afternoonPercent = Math.round((timeOfDayCounts.afternoon / totalHabits) * 100);
const eveningPercent = Math.round((timeOfDayCounts.evening / totalHabits) * 100);
const nightPercent = Math.round((timeOfDayCounts.night / totalHabits) * 100);
const anytimePercent = 100 - (morningPercent + afternoonPercent + eveningPercent + nightPercent); // 5대 시간대 총합 100% 보정 완료

// 클라이언트 사이드 스크립트 전달용 번역 상수
const runtimeTranslations = {
  routineSuffix: t('buildsnap.routine.suffix'),
  calendarSuffix: t('buildsnap.calendar.suffix'),
  step1: t('buildsnap.milestone.step1'),
  step2: t('buildsnap.milestone.step2'),
  step3: t('buildsnap.milestone.step3'),
  canvasStep1: t('buildsnap.milestone.canvas.step1'),
  canvasStep2: t('buildsnap.milestone.canvas.step2'),
  canvasStep3: t('buildsnap.milestone.canvas.step3'),
  canvasBranding: 'Designed by SelaLink Studio',
  timeMorning: t('buildsnap.time.morning'),
  timeAfternoon: t('buildsnap.time.afternoon'),
  timeEvening: t('buildsnap.time.evening'),
  timeNight: t('buildsnap.time.night'),
  timeAnytime: t('buildsnap.time.anytime'),
  statsBadge: t('buildsnap.matcher.stats.badge'),
  statsBadgeNone: t('buildsnap.matcher.stats.badge.none'),
  cycleGuide: t('buildsnap.matcher.cycle.guide')
};
---

<Layout 
  title={t('buildsnap.title')} 
  lang={currentLang}
  description={t('buildsnap.subtitle')}
  canonicalUrl={`https://selalink.net/${currentLang}/apps/buildsnap/`}
  ogType="software"
  image="/assets/images/og/buildself.png"
  appId="buildsnap"
>
  <!-- CSS Animations for premium charts -->
  <style is:global>
    @keyframes waveMove {
      0% { transform: translateX(0) translateZ(0) scaleY(1); }
      50% { transform: translateX(-25%) translateZ(0) scaleY(1.05); }
      100% { transform: translateX(-50%) translateZ(0) scaleY(1); }
    }
    .animate-wave {
      animation: waveMove 4s cubic-bezier(0.36, 0.45, 0.63, 0.53) infinite;
    }
    @keyframes rotateSpin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
    .animate-spin-glow {
      animation: rotateSpin 20s linear infinite;
    }
  </style>

  <main class="max-w-[1250px] mx-auto px-4 pt-24 pb-8 md:pt-28 md:pb-16 relative">
    <AppBackgroundBlurs appId="buildsnap" />

    <!-- Header / Go Back Button -->
    <div class="relative z-10">
      <BackToStudioButton lang={currentLang} class="mb-8" />
    </div>

    <!-- Title Header -->
    <div class="text-center mb-10 md:mb-16 relative z-10 select-none">
      <h1 class="text-3xl sm:text-5xl md:text-6xl font-black tracking-tight mb-3 bg-gradient-to-r from-indigo-600 to-indigo-400 dark:from-indigo-500 dark:to-indigo-300 bg-clip-text text-transparent">
        {t('buildsnap.title')}
      </h1>
      <p class="text-sm sm:text-base md:text-lg text-slate-650 dark:text-slate-200 max-w-3xl mx-auto leading-relaxed">
        {t('buildsnap.subtitle')}
      </p>
    </div>

    <!-- 1. Stats Dashboard Section (Premium UI with High Contrast & Perfect Consistency) -->
    <section class="app-card-neon p-6 md:p-8 mb-8 md:mb-12 relative z-10 border border-slate-200 dark:border-slate-800/80 rounded-3xl bg-slate-50/50 dark:bg-slate-900/10">
      <div class="mb-6 md:mb-8 text-center md:text-left">
        <h2 class="text-2xl font-black text-slate-855 dark:text-slate-100 flex items-center justify-center md:justify-start gap-2">
          <span>{t('buildsnap.stats.title')}</span>
        </h2>
        <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-400 mt-1 font-bold">
          {t('buildsnap.stats.desc').replace('$1', habits.length.toString())}
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Chart A: timeOfDay Distribution (Radial Time Dial with High Contrast) -->
        <div class="bg-white/70 dark:bg-slate-900/40 backdrop-blur-md border border-slate-200 dark:border-slate-800/80 p-5 rounded-2xl flex flex-col justify-between select-none relative group transition-all duration-300 hover:border-indigo-500/40 shadow-sm">
          <h3 class="text-sm font-black text-slate-855 dark:text-slate-200 tracking-tight border-b border-slate-200 dark:border-slate-800 pb-2 mb-4">
            🕒 {t('buildsnap.stats.time')}
          </h3>
          <div class="flex flex-col items-center justify-center flex-1 py-3">
            <div class="relative w-40 h-40">
              <svg viewBox="0 0 200 200" class="w-full h-full transform -rotate-90">
                <!-- Clock background circle -->
                <circle cx="100" cy="100" r="80" class="stroke-slate-200 dark:stroke-slate-855 fill-none" stroke-width="12" />
                
                <!-- Anytime outline glow circle -->
                <circle cx="100" cy="100" r="90" class="stroke-indigo-500/20 fill-none" stroke-width="2" stroke-dasharray="6 4" />

                <!-- 1. Morning Arc -->
                <circle cx="100" cy="100" r="80" 
                  class="stroke-violet-500 fill-none transition-all duration-350 cursor-pointer hover:stroke-violet-400" 
                  stroke-width="14" 
                  stroke-dasharray="502.6" 
                  stroke-dashoffset={502.6 * (1 - (morningPercent / 100))} 
                  transform="rotate(0, 100, 100)"
                  id="arcMorning"
                />

                <!-- 2. Afternoon Arc -->
                <circle cx="100" cy="100" r="80" 
                  class="stroke-amber-500 fill-none transition-all duration-350 cursor-pointer hover:stroke-amber-400" 
                  stroke-width="14" 
                  stroke-dasharray="502.6" 
                  stroke-dashoffset={502.6 * (1 - (afternoonPercent / 100))} 
                  transform={`rotate(${360 * (morningPercent / 100)}, 100, 100)`}
                  id="arcAfternoon"
                />

                <!-- 3. Evening Arc -->
                <circle cx="100" cy="100" r="80" 
                  class="stroke-pink-500 fill-none transition-all duration-350 cursor-pointer hover:stroke-pink-400" 
                  stroke-width="14" 
                  stroke-dasharray="502.6" 
                  stroke-dashoffset={502.6 * (1 - (eveningPercent / 100))} 
                  transform={`rotate(${360 * ((morningPercent + afternoonPercent) / 100)}, 100, 100)`}
                  id="arcEvening"
                />

                <!-- 4. Night Arc -->
                <circle cx="100" cy="100" r="80" 
                  class="stroke-blue-500 fill-none transition-all duration-350 cursor-pointer hover:stroke-blue-400" 
                  stroke-width="14" 
                  stroke-dasharray="502.6" 
                  stroke-dashoffset={502.6 * (1 - (nightPercent / 100))} 
                  transform={`rotate(${360 * ((morningPercent + afternoonPercent + eveningPercent) / 100)}, 100, 100)`}
                  id="arcNight"
                />

                <!-- 5. Anytime Arc (Completes the 100% MECE circle) -->
                <circle cx="100" cy="100" r="80" 
                  class="stroke-indigo-500 fill-none transition-all duration-350 cursor-pointer hover:stroke-indigo-400" 
                  stroke-width="14" 
                  stroke-dasharray="502.6" 
                  stroke-dashoffset={502.6 * (1 - (anytimePercent / 100))} 
                  transform={`rotate(${360 * ((morningPercent + afternoonPercent + eveningPercent + nightPercent) / 100)}, 100, 100)`}
                  opacity="0.45"
                  id="arcAnytime"
                />
              </svg>
              <!-- Info text inside clock -->
              <div class="absolute inset-0 flex flex-col items-center justify-center text-center pointer-events-none">
                <span class="text-[11px] font-black text-slate-600 dark:text-slate-400 uppercase tracking-widest" id="radialLabel">Total</span>
                <span class="text-xl font-black text-slate-855 dark:text-white mt-0.5" id="radialValue">{totalHabits}</span>
              </div>
            </div>
          </div>

          <!-- Restructured Grid Card Tabs with Unified Wrapper & SVG Icons (Lucide Specification, Open Layout) -->
          <div class="flex gap-1.5 mt-3 border-t border-slate-200/50 dark:border-slate-800/80 pt-2.5 overflow-x-auto no-scrollbar whitespace-nowrap pb-1 sm:grid sm:grid-cols-5 sm:gap-2 sm:overflow-visible sm:whitespace-normal sm:pb-0">
            <!-- Morning Card -->
            <div id="btnMorning" class="flex flex-col items-center justify-center p-2 sm:px-1 rounded-xl border border-violet-200 dark:border-violet-900/40 bg-violet-50/30 dark:bg-violet-950/10 cursor-pointer hover:translate-y-[-2px] transition-all hover:border-violet-500 text-violet-600 dark:text-violet-400 shrink-0 min-w-[80px] sm:min-w-0 sm:shrink sm:w-full flex-1" title={t('buildsnap.time.morning')}>
              <span class="text-[9px] xs:text-[10px] sm:text-[10px] md:text-xs font-black text-center leading-tight break-keep whitespace-nowrap sm:whitespace-normal sm:break-all btn-text">{t('buildsnap.time.morning')}</span>
              <span class="text-[8px] sm:text-[9px] opacity-75 font-bold mt-0.5">{morningPercent}%</span>
            </div>
            <!-- Afternoon Card -->
            <div id="btnAfternoon" class="flex flex-col items-center justify-center p-2 sm:px-1 rounded-xl border border-amber-200 dark:border-amber-900/40 bg-amber-50/30 dark:bg-amber-950/10 cursor-pointer hover:translate-y-[-2px] transition-all hover:border-amber-500 text-amber-600 dark:text-amber-400 shrink-0 min-w-[80px] sm:min-w-0 sm:shrink sm:w-full flex-1" title={t('buildsnap.time.afternoon')}>
              <span class="text-[9px] xs:text-[10px] sm:text-[10px] md:text-xs font-black text-center leading-tight break-keep whitespace-nowrap sm:whitespace-normal sm:break-all btn-text">{t('buildsnap.time.afternoon')}</span>
              <span class="text-[8px] sm:text-[9px] opacity-75 font-bold mt-0.5">{afternoonPercent}%</span>
            </div>
            <!-- Evening Card -->
            <div id="btnEvening" class="flex flex-col items-center justify-center p-2 sm:px-1 rounded-xl border border-pink-200 dark:border-pink-900/40 bg-pink-50/30 dark:bg-pink-950/10 cursor-pointer hover:translate-y-[-2px] transition-all hover:border-pink-500 text-pink-600 dark:text-pink-400 shrink-0 min-w-[80px] sm:min-w-0 sm:shrink sm:w-full flex-1" title={t('buildsnap.time.evening')}>
              <span class="text-[9px] xs:text-[10px] sm:text-[10px] md:text-xs font-black text-center leading-tight break-keep whitespace-nowrap sm:whitespace-normal sm:break-all btn-text">{t('buildsnap.time.evening')}</span>
              <span class="text-[8px] sm:text-[9px] opacity-75 font-bold mt-0.5">{eveningPercent}%</span>
            </div>
            <!-- Night Card -->
            <div id="btnNight" class="flex flex-col items-center justify-center p-2 sm:px-1 rounded-xl border border-blue-200 dark:border-blue-900/40 bg-blue-50/30 dark:bg-blue-950/10 cursor-pointer hover:translate-y-[-2px] transition-all hover:border-blue-500 text-blue-600 dark:text-blue-400 shrink-0 min-w-[80px] sm:min-w-0 sm:shrink sm:w-full flex-1" title={t('buildsnap.time.night')}>
              <span class="text-[9px] xs:text-[10px] sm:text-[10px] md:text-xs font-black text-center leading-tight break-keep whitespace-nowrap sm:whitespace-normal sm:break-all btn-text">{t('buildsnap.time.night')}</span>
              <span class="text-[8px] sm:text-[9px] opacity-75 font-bold mt-0.5">{nightPercent}%</span>
            </div>
            <!-- Anytime Card -->
            <div id="btnAnytime" class="flex flex-col items-center justify-center p-2 sm:px-1 rounded-xl border border-indigo-200 dark:border-indigo-900/40 bg-indigo-50/30 dark:bg-indigo-950/10 cursor-pointer hover:translate-y-[-2px] transition-all hover:border-indigo-500 text-indigo-600 dark:text-indigo-400 shrink-0 min-w-[80px] sm:min-w-0 sm:shrink sm:w-full flex-1" title={t('buildsnap.time.anytime')}>
              <span class="text-[9px] xs:text-[10px] sm:text-[10px] md:text-xs font-black text-center leading-tight break-keep whitespace-nowrap sm:whitespace-normal sm:break-all btn-text">{t('buildsnap.time.anytime')}</span>
              <span class="text-[8px] sm:text-[9px] opacity-75 font-bold mt-0.5">{anytimePercent}%</span>
            </div>
          </div>
        </div>

        <!-- Chart B: Category Share (Layered Horizontal Bar Chart with Unified Legends) -->
        <div class="bg-white/70 dark:bg-slate-900/40 backdrop-blur-md border border-slate-200 dark:border-slate-800/80 p-5 rounded-2xl flex flex-col justify-between select-none transition-all duration-300 hover:border-indigo-500/40 shadow-sm">
          <h3 class="text-sm font-black text-slate-855 dark:text-slate-200 tracking-tight border-b border-slate-200 dark:border-slate-800 pb-2 mb-4">
            🧬 {t('buildsnap.stats.category')}
          </h3>
          <div class="space-y-4 my-auto py-2 w-full">
            <!-- Focus -->
            <div id="legendFocus" class="group cursor-pointer p-2.5 rounded-xl border border-slate-100 dark:border-slate-900 bg-slate-50/50 dark:bg-slate-900/30 hover:border-violet-500/50 hover:translate-y-[-1px] transition-all duration-300">
              <div class="flex justify-between items-center text-xs font-bold text-slate-800 dark:text-slate-200 mb-1.5">
                <div class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-violet-500 shrink-0"></span>
                  <span class="text-xs sm:text-sm font-extrabold text-slate-800 dark:text-slate-200 leading-tight">{t('buildsnap.matcher.q1.a')}</span>
                </div>
                <span class="text-xs sm:text-sm font-black text-slate-900 dark:text-slate-100 shrink-0">{focusPercent}%</span>
              </div>
              <div class="w-full h-3 bg-slate-200 dark:bg-slate-850 rounded-full overflow-hidden border border-slate-300/30 dark:border-slate-800/30">
                <div id="barFocus" class="h-full bg-violet-500 rounded-full transition-all duration-1000 ease-out shadow-sm shadow-violet-500/25" style={`width: ${focusPercent}%`}></div>
              </div>
            </div>
            <!-- Creative -->
            <div id="legendCreative" class="group cursor-pointer p-2.5 rounded-xl border border-slate-100 dark:border-slate-900 bg-slate-50/50 dark:bg-slate-900/30 hover:border-fuchsia-500/50 hover:translate-y-[-1px] transition-all duration-300">
              <div class="flex justify-between items-center text-xs font-bold text-slate-800 dark:text-slate-200 mb-1.5">
                <div class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-fuchsia-500 shrink-0"></span>
                  <span class="text-xs sm:text-sm font-extrabold text-slate-800 dark:text-slate-200 leading-tight">{t('buildsnap.matcher.q1.b')}</span>
                </div>
                <span class="text-xs sm:text-sm font-black text-slate-900 dark:text-slate-100 shrink-0">{creativePercent}%</span>
              </div>
              <div class="w-full h-3 bg-slate-200 dark:bg-slate-850 rounded-full overflow-hidden border border-slate-300/30 dark:border-slate-800/30">
                <div id="barCreative" class="h-full bg-fuchsia-500 rounded-full transition-all duration-1000 ease-out shadow-sm shadow-fuchsia-500/25" style={`width: ${creativePercent}%`}></div>
              </div>
            </div>
            <!-- Simplicity -->
            <div id="legendSimplicity" class="group cursor-pointer p-2.5 rounded-xl border border-slate-100 dark:border-slate-900 bg-slate-50/50 dark:bg-slate-900/30 hover:border-indigo-500/50 hover:translate-y-[-1px] transition-all duration-300">
              <div class="flex justify-between items-center text-xs font-bold text-slate-800 dark:text-slate-200 mb-1.5">
                <div class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-indigo-500 shrink-0"></span>
                  <span class="text-xs sm:text-sm font-extrabold text-slate-800 dark:text-slate-200 leading-tight">{t('buildsnap.matcher.q1.c')}</span>
                </div>
                <span class="text-xs sm:text-sm font-black text-slate-900 dark:text-slate-100 shrink-0">{simplicityPercent}%</span>
              </div>
              <div class="w-full h-3 bg-slate-200 dark:bg-slate-850 rounded-full overflow-hidden border border-slate-300/30 dark:border-slate-800/30">
                <div id="barSimplicity" class="h-full bg-indigo-500 rounded-full transition-all duration-1000 ease-out shadow-sm shadow-indigo-500/25" style={`width: ${simplicityPercent}%`}></div>
              </div>
            </div>
            <!-- Mind -->
            <div id="legendMind" class="group cursor-pointer p-2.5 rounded-xl border border-slate-100 dark:border-slate-900 bg-slate-50/50 dark:bg-slate-900/30 hover:border-teal-500/50 hover:translate-y-[-1px] transition-all duration-300">
              <div class="flex justify-between items-center text-xs font-bold text-slate-800 dark:text-slate-200 mb-1.5">
                <div class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-teal-500 shrink-0"></span>
                  <span class="text-xs sm:text-sm font-extrabold text-slate-800 dark:text-slate-200 leading-tight">{t('buildsnap.matcher.q1.d')}</span>
                </div>
                <span class="text-xs sm:text-sm font-black text-slate-900 dark:text-slate-100 shrink-0">{mindPercent}%</span>
              </div>
              <div class="w-full h-3 bg-slate-200 dark:bg-slate-850 rounded-full overflow-hidden border border-slate-300/30 dark:border-slate-800/30">
                <div id="barMind" class="h-full bg-teal-500 rounded-full transition-all duration-1000 ease-out shadow-sm shadow-teal-500/25" style={`width: ${mindPercent}%`}></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Chart C: Difficulty Barrier (Liquid Wave Balance Gauge) -->
        <div class="bg-white/70 dark:bg-slate-900/40 backdrop-blur-md border border-slate-200 dark:border-slate-800/80 p-5 rounded-2xl flex flex-col justify-between select-none transition-all duration-300 hover:border-indigo-500/40 shadow-sm">
          <h3 class="text-sm font-black text-slate-855 dark:text-slate-200 tracking-tight border-b border-slate-200 dark:border-slate-800 pb-2 mb-4">
            🛡️ {t('buildsnap.stats.difficulty')}
          </h3>
          <div class="space-y-6 my-auto py-3">
            <!-- Liquid wave bar container -->
            <div class="relative w-full h-12 bg-slate-200 dark:bg-slate-850 rounded-2xl overflow-hidden border border-slate-300/60 dark:border-slate-850 flex">
              <!-- Easy Liquid Wave (Emerald Gradient) -->
              <div class="h-full bg-gradient-to-r from-emerald-500 to-teal-400 relative overflow-hidden transition-all duration-1000 ease-out" style={`width: ${easyPercent}%`}>

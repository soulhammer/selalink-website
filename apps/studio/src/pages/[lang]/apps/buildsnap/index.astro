  <!-- Client-side logic for diagnostics & canvas generator -->
  <script is:inline define:vars={{ habits, currentLang, runtimeTranslations, eraMentors, timeOfDayCounts, totalHabits, focusPercent, creativePercent, simplicityPercent, mindPercent }}>
    window.__BUILDSNAP_DATA__ = { habits, currentLang, runtimeTranslations, eraMentors, timeOfDayCounts, totalHabits, focusPercent, creativePercent, simplicityPercent, mindPercent };
  </script>

  <script>
    import { matchHabit } from '../../../../utils/buildsnapMatcher';

    document.addEventListener('DOMContentLoaded', () => {
      const data = (window as any).__BUILDSNAP_DATA__;
      if (!data) return;
      const { habits, currentLang, runtimeTranslations, eraMentors, timeOfDayCounts, totalHabits, focusPercent, creativePercent, simplicityPercent, mindPercent } = data;

      const btnDiagnose = document.getElementById('btnDiagnose') as HTMLButtonElement;
      const resultContainer = document.getElementById('resultContainer') as HTMLDivElement;
      const matcherEmptyState = document.getElementById('matcherEmptyState') as HTMLDivElement;

      // Result DOM nodes
      const resultName = document.getElementById('resultName');
      const resultHabitName = document.getElementById('resultHabitName');
      const resultTags = document.getElementById('resultTags');
      const resultLocation = document.getElementById('resultLocation');
      const resultEra = document.getElementById('resultEra');
      const resultLifespan = document.getElementById('resultLifespan');
      const resultTime = document.getElementById('resultTime');
      const resultHeroImage = document.getElementById('resultHeroImage');
      const resultQuote = document.getElementById('resultQuote');
      const btnReadStory = document.getElementById('btnReadStory');
      const matcherStatsBadge = document.getElementById('matcherStatsBadge') as HTMLDivElement;
      const matcherCycleGuide = document.getElementById('matcherCycleGuide') as HTMLDivElement;

      let currentMatchedHabit = null;
      let lastQ1 = '';
      let lastQ2 = '';
      let lastQ3 = '';
      let currentPool = [];
      let currentIndex = 0;

      // ----------------------------------------------------
      // 1. Dashboard Interactive Chart Events (Visual Highlights Coupling)
      // ----------------------------------------------------
      // A. Radial Time Clock hover actions & coupling
      const radialLabel = document.getElementById('radialLabel');
      const radialValue = document.getElementById('radialValue');
      
      const arcMorning = document.getElementById('arcMorning');
      const arcAfternoon = document.getElementById('arcAfternoon');
      const arcEvening = document.getElementById('arcEvening');
      const arcNight = document.getElementById('arcNight');
      const arcAnytime = document.getElementById('arcAnytime');
      const allArcs = [arcMorning, arcAfternoon, arcEvening, arcNight, arcAnytime];

      const setRadialInfo = (label, val, percent, activeArc) => {
        radialLabel.textContent = label;
        radialValue.textContent = `${val} (${percent}%)`;
        
        // Highlight active arc and dim others
        allArcs.forEach(arc => {
          if (arc) {
            if (arc === activeArc) {
              arc.setAttribute('stroke-width', '22');
              arc.setAttribute('opacity', '1');
            } else {
              arc.setAttribute('stroke-width', '10');
              if (arc === arcAnytime) {
                arc.setAttribute('opacity', '0.15'); // Anytime은 비활성 시 더 흐리게 축소
              } else {
                arc.setAttribute('opacity', '0.25');
              }
            }
          }
        });
      };

      const resetRadialInfo = () => {
        radialLabel.textContent = 'Total';
        radialValue.textContent = totalHabits;
        
        // Restore all arcs to default
        allArcs.forEach(arc => {
          if (arc) {
            arc.setAttribute('stroke-width', '14');
            if (arc === arcAnytime) {
              arc.setAttribute('opacity', '0.45'); // Anytime은 평소에 보조적인 흐릿함 유지
            } else {
              arc.setAttribute('opacity', '1');
            }
          }
        });
      };

      let activeTimeId = null;

      const updateTimeHighlightState = () => {
        resetRadialInfo();
        const timeTabs = [
          { id: 'btnMorning', activeBorder: 'border-violet-500', defaultBorder: 'border-violet-200 dark:border-violet-900/40', arc: arcMorning },
          { id: 'btnAfternoon', activeBorder: 'border-amber-500', defaultBorder: 'border-amber-200 dark:border-amber-900/40', arc: arcAfternoon },
          { id: 'btnEvening', activeBorder: 'border-pink-500', defaultBorder: 'border-pink-200 dark:border-pink-900/40', arc: arcEvening },
          { id: 'btnNight', activeBorder: 'border-blue-500', defaultBorder: 'border-blue-200 dark:border-blue-900/40', arc: arcNight },
          { id: 'btnAnytime', activeBorder: 'border-indigo-500', defaultBorder: 'border-indigo-200 dark:border-indigo-900/40', arc: arcAnytime }
        ];

        timeTabs.forEach(tab => {
          const el = document.getElementById(tab.id);
          if (el) {
            el.classList.remove(tab.activeBorder, 'scale-[1.03]', 'shadow-md');
            tab.defaultBorder.split(' ').forEach(cls => {
              if (cls) el.classList.add(cls);
            });
          }
        });

        if (activeTimeId) {
          const activeTab = timeTabs.find(t => t.id === activeTimeId);
          if (activeTab) {
            const el = document.getElementById(activeTab.id);
            if (el) {
              activeTab.defaultBorder.split(' ').forEach(cls => {
                if (cls) el.classList.remove(cls);
              });
              el.classList.add(activeTab.activeBorder, 'scale-[1.03]', 'shadow-md');
            }
            
            let countVal = 0;
            let translationKey = '';
            if (activeTimeId === 'btnMorning') { countVal = timeOfDayCounts.morning; translationKey = runtimeTranslations.timeMorning; }
            else if (activeTimeId === 'btnAfternoon') { countVal = timeOfDayCounts.afternoon; translationKey = runtimeTranslations.timeAfternoon; }
            else if (activeTimeId === 'btnEvening') { countVal = timeOfDayCounts.evening; translationKey = runtimeTranslations.timeEvening; }
            else if (activeTimeId === 'btnNight') { countVal = timeOfDayCounts.night; translationKey = runtimeTranslations.timeNight; }
            else if (activeTimeId === 'btnAnytime') { countVal = timeOfDayCounts.anytime; translationKey = runtimeTranslations.timeAnytime; }

            const pct = Math.round((countVal / totalHabits) * 100);
            setRadialInfo(translationKey, countVal, pct, activeTab.arc);
          }
        }
      };

      const bindTimeEvent = (elId, activeBorderClass, translationKey, countVal, activeArc, isBtn = false, defaultBorderClasses = '', targetBtnId = null) => {
        const el = document.getElementById(elId);
        if (el) {
          const pct = Math.round((countVal / totalHabits) * 100);
          
          el.addEventListener('mouseenter', () => {
            if (activeTimeId) return;
            setRadialInfo(translationKey, countVal, pct, activeArc);
            if (isBtn) {
              defaultBorderClasses.split(' ').forEach(cls => {
                if (cls) el.classList.remove(cls);
              });
              el.classList.add(activeBorderClass, 'scale-[1.03]', 'shadow-md');
            }
          });
          
          el.addEventListener('mouseleave', () => {
            if (activeTimeId) return;
            resetRadialInfo();
            if (isBtn) {
              el.classList.remove(activeBorderClass, 'scale-[1.03]', 'shadow-md');
              defaultBorderClasses.split(' ').forEach(cls => {
                if (cls) el.classList.add(cls);
              });
            }
          });

          el.addEventListener('click', () => {
            const clickTargetId = isBtn ? elId : targetBtnId;
            if (!clickTargetId) return;

            if (activeTimeId === clickTargetId) {
              activeTimeId = null; 
            } else {
              activeTimeId = clickTargetId; 
            }
            updateTimeHighlightState();
          });
        }
      };

      // Bidirectional connection: clock arcs & card buttons with unified hover colors
      bindTimeEvent('arcMorning', 'border-violet-500', runtimeTranslations.timeMorning, timeOfDayCounts.morning, arcMorning, false, '', 'btnMorning');
      bindTimeEvent('arcAfternoon', 'border-amber-500', runtimeTranslations.timeAfternoon, timeOfDayCounts.afternoon, arcAfternoon, false, '', 'btnAfternoon');
      bindTimeEvent('arcEvening', 'border-pink-500', runtimeTranslations.timeEvening, timeOfDayCounts.evening, arcEvening, false, '', 'btnEvening');
      bindTimeEvent('arcNight', 'border-blue-500', runtimeTranslations.timeNight, timeOfDayCounts.night, arcNight, false, '', 'btnNight');
      bindTimeEvent('arcAnytime', 'border-indigo-500', runtimeTranslations.timeAnytime, timeOfDayCounts.anytime, arcAnytime, false, '', 'btnAnytime');

      bindTimeEvent('btnMorning', 'border-violet-500', runtimeTranslations.timeMorning, timeOfDayCounts.morning, arcMorning, true, 'border-violet-200 dark:border-violet-900/40');
      bindTimeEvent('btnAfternoon', 'border-amber-500', runtimeTranslations.timeAfternoon, timeOfDayCounts.afternoon, arcAfternoon, true, 'border-amber-200 dark:border-amber-900/40');
      bindTimeEvent('btnEvening', 'border-pink-500', runtimeTranslations.timeEvening, timeOfDayCounts.evening, arcEvening, true, 'border-pink-200 dark:border-pink-900/40');
      bindTimeEvent('btnNight', 'border-blue-500', runtimeTranslations.timeNight, timeOfDayCounts.night, arcNight, true, 'border-blue-200 dark:border-blue-900/40');
      bindTimeEvent('btnAnytime', 'border-indigo-500', runtimeTranslations.timeAnytime, timeOfDayCounts.anytime, arcAnytime, true, 'border-indigo-200 dark:border-indigo-900/40');


      // B. Horizontal Bar Graph Legend Hover Actions & Coupling
      const setBarInfo = (activeBarId) => {
        const bars = ['legendFocus', 'legendCreative', 'legendSimplicity', 'legendMind'];
        bars.forEach(id => {
          const el = document.getElementById(id);
          if (el) {
            if (el.id === activeBarId) {
              el.classList.add('scale-[1.02]', 'shadow-md');
              el.classList.add('border-violet-500/50', 'dark:border-violet-500/30');
              el.classList.remove('border-slate-100', 'dark:border-slate-900');
            } else {
              el.classList.add('opacity-40');
            }
          }
        });
      };

      const resetBarInfo = () => {
        const bars = ['legendFocus', 'legendCreative', 'legendSimplicity', 'legendMind'];
        bars.forEach(id => {
          const el = document.getElementById(id);
          if (el) {
            el.classList.remove('scale-[1.02]', 'shadow-md', 'opacity-40');
            el.classList.remove('border-violet-500/50', 'dark:border-violet-500/30');
            el.classList.add('border-slate-100', 'dark:border-slate-900');
          }
        });
      };

      const bindBarEvent = (legendId) => {
        const legend = document.getElementById(legendId);
        if (legend) {
          legend.addEventListener('mouseenter', () => setBarInfo(legendId));
          legend.addEventListener('mouseleave', resetBarInfo);
        }
      };

      bindBarEvent('legendFocus');
      bindBarEvent('legendCreative');
      bindBarEvent('legendSimplicity');
      bindBarEvent('legendMind');


      // C. Chronological Wave Timeline Tooltips & Coupling
      const eraTooltip = document.getElementById('eraTooltip');
      const eraTooltipTitle = document.getElementById('eraTooltipTitle');
      const eraTooltipMentors = document.getElementById('eraTooltipMentors');
      const waveTimelineSvg = document.getElementById('waveTimelineSvg');
      const waveAreaPath = document.getElementById('waveAreaPath');
      const waveCurveLine = document.getElementById('waveCurveLine');

      let activeEraId = null;

      const updateEraHighlightState = () => {
        eraTooltip.style.opacity = '0';
        const guide = document.getElementById('waveGuideline');
        if (guide) guide.remove();
        if (waveCurveLine) {
          waveCurveLine.setAttribute('stroke', '#8b5cf6');
          waveCurveLine.setAttribute('stroke-width', '3');
        }
        if (waveAreaPath) waveAreaPath.removeAttribute('fill-opacity');

        const eraTabs = [
          { id: 'lblAncient', dotId: 'dotAncient', x: '10', name: 'Ancient Era', mentors: eraMentors.ancient },
          { id: 'lblRenaissance', dotId: 'dotRenaissance', x: '105', name: 'Renaissance', mentors: eraMentors.renaissance },
          { id: 'lblEarlyModern', dotId: 'dotEarlyModern', x: '200', name: 'Early Modern', mentors: eraMentors.earlyModern },
          { id: 'lblModern', dotId: 'dotModern', x: '295', name: 'Modern Era', mentors: eraMentors.modern },
          { id: 'lblContemporary', dotId: 'dotContemporary', x: '390', name: 'Contemporary', mentors: eraMentors.contemporary }
        ];

        eraTabs.forEach(tab => {
          const dot = document.getElementById(tab.dotId);
          if (dot) {
            dot.setAttribute('r', '5.5');
            dot.classList.remove('fill-violet-400');
          }
          const lbl = document.getElementById(tab.id);
          if (lbl) {
            lbl.classList.remove('border-indigo-500', 'translate-y-[-2px]', 'text-indigo-600', 'dark:text-indigo-400');
            lbl.classList.add('border-slate-250', 'dark:border-slate-800', 'text-slate-500', 'dark:text-slate-400');
            const txtSpan = lbl.querySelector('.btn-text');
            if (txtSpan) {
              txtSpan.classList.remove('text-indigo-600', 'dark:text-indigo-400');
            }
          }
        });

        if (activeEraId) {
          const activeTab = eraTabs.find(t => t.id === activeEraId || t.dotId === activeEraId);
          if (activeTab) {
            const dot = document.getElementById(activeTab.dotId);
            if (dot) {
              dot.setAttribute('r', '12');
              dot.classList.add('fill-violet-400');
            }
            const lbl = document.getElementById(activeTab.id);
            if (lbl) {
              lbl.classList.add('border-indigo-500', 'translate-y-[-2px]', 'text-indigo-600', 'dark:text-indigo-400');
              lbl.classList.remove('border-slate-250', 'dark:border-slate-800', 'text-slate-500', 'dark:text-slate-400');
              const txtSpan = lbl.querySelector('.btn-text');
              if (txtSpan) {
                txtSpan.classList.add('text-indigo-600', 'dark:text-indigo-400');
              }
            }
            if (waveCurveLine) {
              waveCurveLine.setAttribute('stroke', '#a78bfa');
              waveCurveLine.setAttribute('stroke-width', '5');
            }
            if (waveAreaPath) waveAreaPath.setAttribute('fill-opacity', '0.65');

            let guide = document.getElementById('waveGuideline');
            if (!guide) {
              guide = document.createElementNS('http://www.w3.org/2000/svg', 'line');
              guide.setAttribute('id', 'waveGuideline');
              guide.setAttribute('class', 'stroke-indigo-500/60 stroke-2');
              guide.setAttribute('stroke-dasharray', '5 4');
              waveTimelineSvg.appendChild(guide);
            }
            guide.setAttribute('x1', activeTab.x);
            guide.setAttribute('y1', '10');
            guide.setAttribute('x2', activeTab.x);
            guide.setAttribute('y2', '110');

            const activeLbl = document.getElementById(activeTab.id);
            const activeTxtSpan = activeLbl ? activeLbl.querySelector('.btn-text') : null;
            eraTooltipTitle.textContent = activeTxtSpan ? activeTxtSpan.textContent : activeTab.name;
            eraTooltipMentors.textContent = '';
            eraTooltip.style.opacity = '1';
          }
        }
      };

      const setEraHighlight = (dotId, lblId, eraName, mentorList, xCoord, yCoord) => {
        const dot = document.getElementById(dotId);
        if (dot) {
          dot.setAttribute('r', '12');
          dot.classList.add('fill-violet-400');
        }

        const lbl = document.getElementById(lblId);
        if (lbl) {
          lbl.classList.add('border-indigo-500', 'translate-y-[-2px]', 'text-indigo-600', 'dark:text-indigo-400');
          lbl.classList.remove('border-slate-250', 'dark:border-slate-800', 'text-slate-500', 'dark:text-slate-400');
          const txtSpan = lbl.querySelector('.btn-text');
          if (txtSpan) {
            txtSpan.classList.remove('text-slate-500', 'dark:text-slate-400');
            txtSpan.classList.add('text-indigo-600', 'dark:text-indigo-400');
          }
        }

        if (waveCurveLine) {
          waveCurveLine.setAttribute('stroke', '#a78bfa');
          waveCurveLine.setAttribute('stroke-width', '5');
        }
        if (waveAreaPath) {
          waveAreaPath.setAttribute('fill-opacity', '0.65');
        }

        let guide = document.getElementById('waveGuideline');
        if (!guide) {
          guide = document.createElementNS('http://www.w3.org/2000/svg', 'line');
          guide.setAttribute('id', 'waveGuideline');
          guide.setAttribute('class', 'stroke-indigo-500/60 stroke-2');
          guide.setAttribute('stroke-dasharray', '5 4');
          waveTimelineSvg.appendChild(guide);
        }
        guide.setAttribute('x1', xCoord);
        guide.setAttribute('y1', '10');
        guide.setAttribute('x2', xCoord);
        guide.setAttribute('y2', '110');

        const activeTxtSpan = lbl ? lbl.querySelector('.btn-text') : null;
        eraTooltipTitle.textContent = activeTxtSpan ? activeTxtSpan.textContent : eraName;
        eraTooltipMentors.textContent = '';
        eraTooltip.style.opacity = '1';
      };

      const resetEraHighlight = (dotId, lblId) => {
        const dot = document.getElementById(dotId);
        if (dot) {
          dot.setAttribute('r', '5.5');
          dot.classList.remove('fill-violet-400');
        }

        const lbl = document.getElementById(lblId);
        if (lbl) {
          lbl.classList.remove('border-indigo-500', 'translate-y-[-2px]', 'text-indigo-600', 'dark:text-indigo-400');
          lbl.classList.add('border-slate-250', 'dark:border-slate-800', 'text-slate-500', 'dark:text-slate-400');
          const txtSpan = lbl.querySelector('.btn-text');
          if (txtSpan) {
            txtSpan.classList.remove('text-indigo-600', 'dark:text-indigo-400');
          }
        }

        if (waveCurveLine) {
          waveCurveLine.setAttribute('stroke', '#8b5cf6');
          waveCurveLine.setAttribute('stroke-width', '3');
        }
        if (waveAreaPath) {
          waveAreaPath.removeAttribute('fill-opacity');
        }

        const guide = document.getElementById('waveGuideline');
        if (guide) {
          guide.remove();
        }

        eraTooltip.style.opacity = '0';
      };

      const bindEraEvent = (dotId, lblId, eraName, mentorList, xCoord, yCoord) => {
        const dot = document.getElementById(dotId);
        const lbl = document.getElementById(lblId);

        const enterHandler = () => {
          if (activeEraId) return;
          setEraHighlight(dotId, lblId, eraName, mentorList, xCoord, yCoord);
        };
        const leaveHandler = () => {
          if (activeEraId) return;
          resetEraHighlight(dotId, lblId);
        };

        if (dot) {
          dot.addEventListener('mouseenter', enterHandler);
          dot.addEventListener('mouseleave', leaveHandler);
          dot.addEventListener('click', () => {
            activeEraId = activeEraId === dotId ? null : dotId;
            updateEraHighlightState();
          });
        }
        if (lbl) {
          lbl.addEventListener('mouseenter', enterHandler);
          lbl.addEventListener('mouseleave', leaveHandler);
          lbl.addEventListener('click', () => {
            activeEraId = activeEraId === lblId ? null : lblId;
            updateEraHighlightState();
          });
        }
      };

      // Coordinates mapping on timeline curve: Ancient(10, 85), Renaissance(105, 100), EarlyModern(200, 92), Modern(295, 20), Contemporary(390, 75)
      bindEraEvent('dotAncient', 'lblAncient', 'Ancient Era', eraMentors.ancient, '10', '85');
      bindEraEvent('dotRenaissance', 'lblRenaissance', 'Renaissance', eraMentors.renaissance, '105', '100');
      bindEraEvent('dotEarlyModern', 'lblEarlyModern', 'Early Modern', eraMentors.earlyModern, '200', '92');
      bindEraEvent('dotModern', 'lblModern', 'Modern Era', eraMentors.modern, '295', '20');
      bindEraEvent('dotContemporary', 'lblContemporary', 'Contemporary', eraMentors.contemporary, '390', '75');


      // ----------------------------------------------------
      // 2. Habit Diagnoser & Matcher Logic
      // ----------------------------------------------------
      btnDiagnose.addEventListener('click', () => {
        // Get values
        const q1Element = document.querySelector('input[name="q1"]:checked') as HTMLInputElement;
        const q2Element = document.querySelector('input[name="q2"]:checked') as HTMLInputElement;
        const q3Element = document.querySelector('input[name="q3"]:checked') as HTMLInputElement;

        if (!q1Element || !q2Element || !q3Element) return;

        const q1Val = q1Element.value;
        const q2Val = q2Element.value;
        const q3Val = q3Element.value;

        // 조건 변경 확인
        const isConditionChanged = q1Val !== lastQ1 || q2Val !== lastQ2 || q3Val !== lastQ3;

        if (isConditionChanged) {
          currentPool = matchHabit(habits, q1Val, q2Val, q3Val);
          currentIndex = 0;
          lastQ1 = q1Val;
          lastQ2 = q2Val;
          lastQ3 = q3Val;
        } else {
          if (currentPool.length > 0) {
            currentIndex = (currentIndex + 1) % currentPool.length;
          }
        }

        // 렌더링 로직 처리
        if (currentPool.length > 0) {
          const item = currentPool[currentIndex];
          currentMatchedHabit = item;

          if (resultHeroImage) {
            resultHeroImage.src = `/images/blog/${item.id.replace(/-/g, '_')}.png`;
          }

          // 블로그 상세 가이드 딥링크 바인딩
          btnReadStory.href = `/${currentLang}/blog/${item.id}/`;

          // 결과 요약 배지 업데이트
          if (matcherStatsBadge) {
            matcherStatsBadge.textContent = runtimeTranslations.statsBadge.replace('$1', currentPool.length.toString());
          }

          // 순환 가이드 업데이트 (매칭 위인이 2명 이상일 때만 노출하여 인지 부하 감소)
          if (matcherCycleGuide) {
            if (currentPool.length > 1) {
              matcherCycleGuide.classList.remove('hidden');
              matcherCycleGuide.textContent = runtimeTranslations.cycleGuide
                .replace('$1', (currentIndex + 1).toString())
                .replace('$2', currentPool.length.toString());
            } else {
              matcherCycleGuide.classList.add('hidden');
            }
          }

          // UI 토글 처리
          resultContainer.classList.remove('hidden');
          matcherEmptyState.classList.add('hidden');
        } else {
          resultContainer.classList.add('hidden');
          matcherEmptyState.classList.remove('hidden');
          currentMatchedHabit = null;
        }
      });
    });
  </script>
</Layout>

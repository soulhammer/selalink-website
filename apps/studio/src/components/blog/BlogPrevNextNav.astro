---
import { getCategoryMeta } from '../../utils/blogNavigation';

export interface Props {
  prevPost?: any;
  nextPost?: any;
  lang: string;
  t: (key: any) => string;
}

const { prevPost, nextPost, lang, t } = Astro.props;

const prevMeta = prevPost ? getCategoryMeta(prevPost.data.app) : null;
const nextMeta = nextPost ? getCategoryMeta(nextPost.data.app) : null;

const getCategoryLabel = (meta: any) => {
  if (!meta) return '';
  return t(`blog.filter.${meta.categoryKey}` as any) || 'SelaLink';
};
---

{(prevPost || nextPost) && (
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 my-10 pt-10 border-t border-slate-200/80 dark:border-white/10">
    {prevPost ? (
      <a 
        href={`/${lang}/blog/${prevPost.id.split('/').pop()}/`} 
        class="group flex flex-col p-6 rounded-[2rem] border border-slate-200/60 dark:border-white/5 bg-slate-50/50 dark:bg-slate-900/30 hover:border-slate-300 dark:hover:border-white/20 transition-all duration-300 shadow-sm hover:shadow-md"
      >
        <div class="flex items-center gap-2 mb-2">
          <span class={`inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-bold border ${prevMeta?.badgeClass}`}>
            {prevMeta?.icon} {getCategoryLabel(prevMeta)}
          </span>
          <span class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">
            ← {t('blog.prev')}
          </span>
        </div>
        <h4 class="text-sm font-bold text-slate-800 dark:text-slate-200 group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors line-clamp-2 leading-snug">
          {prevPost.data.title}
        </h4>
      </a>
    ) : (
      <div class="hidden sm:block"></div>
    )}
    
    {nextPost && (
      <a 
        href={`/${lang}/blog/${nextPost.id.split('/').pop()}/`} 
        class="group flex flex-col p-6 rounded-[2rem] border border-slate-200/60 dark:border-white/5 bg-slate-50/50 dark:bg-slate-900/30 hover:border-slate-300 dark:hover:border-white/20 transition-all duration-300 shadow-sm hover:shadow-md text-right"
      >
        <div class="flex items-center justify-end gap-2 mb-2">
          <span class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">
            {t('blog.next')} →
          </span>
          <span class={`inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-bold border ${nextMeta?.badgeClass}`}>
            {nextMeta?.icon} {getCategoryLabel(nextMeta)}
          </span>
        </div>
        <h4 class="text-sm font-bold text-slate-800 dark:text-slate-200 group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors line-clamp-2 leading-snug">
          {nextPost.data.title}
        </h4>
      </a>
    )}
  </div>
)}

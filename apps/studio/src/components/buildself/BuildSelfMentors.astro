---
import { useTranslations, languages } from '../../i18n/ui';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang as keyof typeof languages);
---

<!-- Historical Mentors Mapping & Interaction -->
<section class="mb-20 md:mb-28">
	<div class="text-center max-w-2xl mx-auto mb-12">
		<h2 class="text-3xl md:text-4xl font-black text-slate-900 dark:text-white tracking-tight mb-4">
			{t('bs.mentors_dialogue.title')}
		</h2>
		<p class="text-slate-600 dark:text-slate-400 font-medium px-4">
			{t('bs.mentors_dialogue.desc')}
		</p>
	</div>
	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
		{([
			{ nameKey: 'bs.mentor.lincoln.full', roleKey: 'bs.mentor.lincoln.role', lifespan: '1809 - 1865', avatar: '/images/buildself/mentors/lincoln.webp', quoteKey: 'bs.mentors_dialogue.lincoln', color: 'from-amber-500/10 to-amber-500/5', styleVars: '--theme-color-light: rgba(245, 158, 11, 0.05); --theme-color-border-hover: rgba(245, 158, 11, 0.35); --theme-color-glow: rgba(245, 158, 11, 0.18);' },
			{ nameKey: 'bs.mentor.franklin.full', roleKey: 'bs.mentor.franklin.role', lifespan: '1706 - 1790', avatar: '/images/buildself/mentors/franklin.webp', quoteKey: 'bs.mentors_dialogue.franklin', color: 'from-teal-500/10 to-teal-500/5', styleVars: '--theme-color-light: rgba(20, 184, 166, 0.05); --theme-color-border-hover: rgba(20, 184, 166, 0.35); --theme-color-glow: rgba(20, 184, 166, 0.18);' },
			{ nameKey: 'bs.mentor.nightingale.full', roleKey: 'bs.mentor.nightingale.role', lifespan: '1820 - 1910', avatar: '/images/buildself/mentors/nightingale.webp', quoteKey: 'bs.mentors_dialogue.nightingale', color: 'from-rose-500/10 to-rose-500/5', styleVars: '--theme-color-light: rgba(244, 63, 94, 0.05); --theme-color-border-hover: rgba(244, 63, 94, 0.35); --theme-color-glow: rgba(244, 63, 94, 0.18);' },
			{ nameKey: 'bs.mentor.einstein.full', roleKey: 'bs.mentor.einstein.role', lifespan: '1879 - 1955', avatar: '/images/buildself/mentors/einstein.webp', quoteKey: 'bs.mentors_dialogue.einstein', color: 'from-indigo-500/10 to-indigo-500/5', styleVars: '--theme-color-light: rgba(99, 102, 241, 0.05); --theme-color-border-hover: rgba(99, 102, 241, 0.35); --theme-color-glow: rgba(99, 102, 241, 0.18);' }
		] as const).map((mentor) => (
			<div 
				class={`app-card-interactive flex flex-col p-6 rounded-3xl bg-gradient-to-b ${mentor.color} border border-slate-200/50 dark:border-slate-800/50 backdrop-blur-xl shadow-sm text-left group hover:scale-[1.03] hover:-translate-y-2 transition-all duration-500`}
				style={mentor.styleVars}
			>
				<div class="flex items-center gap-4 mb-5">
					<div class="w-14 h-14 rounded-2xl overflow-hidden border border-slate-200/50 dark:border-slate-700/80 shadow-md flex-shrink-0">
						<img src={mentor.avatar} alt={t(mentor.nameKey)} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" loading="lazy" />
					</div>
					<div>
						<h4 class="text-base font-black text-slate-900 dark:text-white leading-snug">{t(mentor.nameKey)}</h4>
						<p class="text-[10px] text-slate-400 dark:text-slate-500 font-bold uppercase tracking-wider mt-0.5 flex flex-wrap items-center gap-1">
							<span>{t(mentor.roleKey)}</span>
							<span class="text-slate-300 dark:text-slate-700">|</span>
							<span class="text-slate-500 dark:text-slate-400 font-mono font-medium lowercase tracking-normal">{mentor.lifespan}</span>
						</p>
					</div>
				</div>
				<div class="relative flex-1 bg-white/60 dark:bg-slate-900/50 rounded-2xl p-4 border border-slate-150/40 dark:border-slate-800/40">
					<span class="absolute -top-3 left-4 text-2xl text-slate-350 dark:text-slate-750 font-serif">“</span>
					<p class="text-xs sm:text-sm text-slate-650 dark:text-slate-300 font-medium leading-relaxed italic">{t(mentor.quoteKey)}</p>
				</div>
			</div>
		))}
	</div>
</section>

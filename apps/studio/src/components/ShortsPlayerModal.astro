---
import { useTranslations } from '../i18n/ui';
const { lang } = Astro.props;
const t = useTranslations(lang);

const downloadBuildSelfText = t('shorts.modal.download.buildself');
const downloadFreshSelfText = t('shorts.modal.download.freshself');
---

<!-- Shorts Player Modal (Overlay) -->
<div 
  id="shorts-modal" 
  class="fixed inset-0 z-[999] hidden flex items-center justify-center bg-black/90 backdrop-blur-xl transition-opacity opacity-0 duration-300"
  data-trans-buildself={downloadBuildSelfText}
  data-trans-freshself={downloadFreshSelfText}
>
  <div class="absolute inset-0 z-0 cursor-pointer" id="shorts-modal-bg"></div>
  
  <div class="relative z-10 w-full max-w-sm h-full max-h-[85vh] sm:max-h-[90vh] bg-black rounded-[2rem] overflow-hidden shadow-2xl flex flex-col border border-white/10 transform scale-95 transition-transform duration-300" id="shorts-modal-content">
    
    <!-- Header with Close Button -->
    <div class="absolute top-0 inset-x-0 h-16 bg-gradient-to-b from-black/80 to-transparent flex items-center justify-between px-4 z-20 pointer-events-none">
       <div class="text-white/80 font-bold text-sm tracking-widest uppercase pointer-events-auto">SelaLink UI</div>
       <button id="close-shorts-btn" class="w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 backdrop-blur-md flex items-center justify-center text-white pointer-events-auto transition-colors">
         <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
       </button>
    </div>

    <!-- Video Iframe Container -->
    <div class="flex-1 w-full bg-slate-900 relative">
       <div class="absolute inset-0 flex items-center justify-center text-white/50 z-0">
          <svg class="w-8 h-8 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
       </div>
       <iframe
          id="shorts-iframe"
          class="w-full h-full relative z-10"
          src=""
          title="YouTube Shorts Player"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen>
       </iframe>
    </div>

    <!-- CTA Footer Overlay (Persistent Download Action) -->
    <div class="absolute bottom-6 inset-x-6 z-20">
      <a id="modal-cta-btn" href="https://play.google.com/store/apps/details?id=com.selalink.buildself" target="_blank" rel="noopener noreferrer" class="w-full flex items-center justify-center gap-2 bg-gradient-to-r from-sky-500 to-sky-600 hover:from-sky-400 hover:to-sky-500 text-white font-bold py-3.5 px-4 rounded-full shadow-[0_10px_30px_rgba(2,132,199,0.4)] transition-all transform hover:scale-[1.02] active:scale-95 group">
         <svg class="w-5 h-5 group-hover:-translate-y-1 transition-transform" fill="currentColor" viewBox="0 0 24 24"><path d="M3 20.5v-17c0-.83.67-1.5 1.5-1.5.34 0 .66.12.92.33l13.62 10.15c.67.5.76 1.45.19 2.06l-13.62 10.15a1.5 1.5 0 01-2.42-1.2v-1.92z"/></svg>
         <span id="modal-cta-text" class="tracking-wide">{downloadBuildSelfText}</span>
      </a>
    </div>

  </div>
</div>

<script is:inline>
  window.openShortsModal = function(videoId, appType = 'buildself') {
    const modal = document.getElementById('shorts-modal');
    const iframe = document.getElementById('shorts-iframe');
    const content = document.getElementById('shorts-modal-content');
    const ctaBtn = document.getElementById('modal-cta-btn');
    const ctaText = document.getElementById('modal-cta-text');
    
    if (modal && iframe && content) {
      // 1. App store URL routing by type
      const storeUrl = appType === 'buildself'
        ? 'https://play.google.com/store/apps/details?id=com.selalink.buildself'
        : 'https://play.google.com/store/apps/details?id=com.selalink.freshself';
        
      const transBuildSelf = modal.getAttribute('data-trans-buildself') || 'Download BuildSelf';
      const transFreshSelf = modal.getAttribute('data-trans-freshself') || 'Download FreshSelf';
      const text = appType === 'buildself' ? transBuildSelf : transFreshSelf;
      
      // 2. Apply theme colors by app type
      const commonClasses = 'w-full flex items-center justify-center gap-2 bg-gradient-to-r text-white font-bold py-3.5 px-4 rounded-full transition-all transform hover:scale-[1.02] active:scale-95 group ';
      const activeClasses = appType === 'buildself'
        ? 'from-sky-500 to-sky-600 hover:from-sky-400 hover:to-sky-500 shadow-[0_10px_30px_rgba(2,132,199,0.4)]'
        : 'from-purple-500 to-purple-600 hover:from-purple-400 hover:to-purple-500 shadow-[0_10px_30px_rgba(139,92,246,0.4)]';
        
      if (ctaBtn && ctaText) {
        ctaBtn.href = storeUrl;
        ctaBtn.className = commonClasses + activeClasses;
        ctaText.textContent = text;
      }

      // 3. YouTube Shorts embed parameters (autoplay, loop)
      iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0&modestbranding=1&loop=1&playlist=${videoId}&controls=0`;
      
      modal.classList.remove('hidden');
      void modal.offsetWidth; // trigger reflow
      
      modal.classList.remove('opacity-0');
      content.classList.remove('scale-95');
      document.body.style.overflow = 'hidden';
    }
  };

  const closeModal = () => {
    const modal = document.getElementById('shorts-modal');
    const iframe = document.getElementById('shorts-iframe');
    const content = document.getElementById('shorts-modal-content');
    
    if (modal && iframe && content) {
      modal.classList.add('opacity-0');
      content.classList.add('scale-95');
      document.body.style.overflow = '';
      
      setTimeout(() => {
        modal.classList.add('hidden');
        iframe.src = ''; 
      }, 300);
    }
  };

  document.getElementById('close-shorts-btn')?.addEventListener('click', closeModal);
  document.getElementById('shorts-modal-bg')?.addEventListener('click', closeModal);
</script>

---
import { useTranslations, languages } from '../i18n/ui';

interface Props {
  lang: string;
  class?: string;
}

const { lang, class: className = '' } = Astro.props;
const t = useTranslations(lang as keyof typeof languages);
---

<div class={className}>
  <a 
    href={`/${lang}/`} 
    class="group inline-flex items-center space-x-2 font-semibold transition-all duration-300 opacity-80 hover:opacity-100"
    style="color: var(--theme-accent, #0D9488);"
  >
    <svg 
      xmlns="http://www.w3.org/2000/svg" 
      width="20" 
      height="20" 
      viewBox="0 0 24 24" 
      fill="none" 
      stroke="currentColor" 
      stroke-width="2" 
      stroke-linecap="round" 
      stroke-linejoin="round" 
      class="transition-transform group-hover:-translate-x-1"
    >
      <path d="m15 18-6-6 6-6"/>
    </svg>
    <span class="text-sm tracking-wide">{t('app.back_to_studio') || 'Back to SelaLink Studio'}</span>
  </a>
</div>

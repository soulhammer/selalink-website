---
import { useTranslations, languages } from '../i18n/ui';
import { themeColors } from '../utils/layoutHelper';
import { hexToRgb } from '../utils/color';

interface Props {
  lang: string;
  appId: 'buildself' | 'logself' | 'freshself';
}

const { lang, appId } = Astro.props;
const t = useTranslations(lang as keyof typeof languages);

// 각 앱별 정보 설정
const appConfig = {
  buildself: {
    iosTriggerId: 'bsIosDownloadBtn',
    playStoreId: 'com.selalink.buildself',
    qrCode: '/assets/images/qr/qr_buildself.svg',
  },
  logself: {
    iosTriggerId: 'lsIosDownloadBtn',
    playStoreId: 'com.selalink.logself',
    qrCode: '/assets/images/qr/qr_logself.svg',
  },
  freshself: {
    iosTriggerId: 'iosDownloadBtn',
    playStoreId: 'com.selalink.freshself',
    qrCode: '/assets/images/qr/qr_freshself.svg',
  }
};

const config = appConfig[appId];
const appHexColor = themeColors[appId] || '#0D9488';
const appRgbColor = hexToRgb(appHexColor);

const qrTitle = t('app.qr.title');
const qrDesc = t('app.qr.desc');
const ctaText = t(`${appId === 'buildself' ? 'bs' : appId === 'logself' ? 'ls' : 'fs'}.hero.cta`);
---

<div class="space-y-6 md:space-y-8 w-full">
  <div class="flex flex-col sm:flex-row gap-3 md:gap-4 pt-2 justify-center lg:justify-start w-full relative z-20">
    <!-- App Store (Coming Soon) -->
    <button 
      id={config.iosTriggerId} 
      class="flex items-center justify-center gap-3 bg-slate-200/50 dark:bg-slate-800/50 border border-slate-300 dark:border-slate-700 text-slate-500 dark:text-slate-400 px-6 md:px-8 py-3 md:py-4 rounded-xl md:rounded-2xl font-bold text-base md:text-lg opacity-70 cursor-pointer w-full sm:w-auto transition-all duration-300 hover:scale-[1.01] app-button"
    >
      <svg class="w-5 h-5 md:w-6 md:h-6 opacity-70" fill="currentColor" viewBox="0 0 24 24">
        <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.253 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.04 2.26-.79 3.59-.76 2.6.04 4.19 1.45 4.8 1.8-3.1 1.76-2.58 5.86.37 6.94-1.04 2.45-2.51 3.5-3.84 4.19zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>
      </svg>
      <div class="flex flex-col items-start leading-tight">
        <span class="text-[10px] md:text-xs text-slate-400 font-medium uppercase tracking-wider font-sans">App Store</span>
        <span class="text-xs md:text-sm font-bold text-slate-500 font-sans">{t('app.coming_soon') || 'Coming Soon'}</span>
      </div>
    </button>
    
    <!-- Google Play -->
    <a 
      href={`https://play.google.com/store/apps/details?id=${config.playStoreId}&hl=${lang}`} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="group/btn flex items-center justify-center gap-3 text-white px-6 md:px-8 py-3 md:py-4 rounded-xl md:rounded-2xl font-bold text-base md:text-lg cursor-pointer shadow-lg hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 w-full sm:w-auto hover:opacity-90"
      style={`background-color: var(--theme-accent, ${appHexColor}); --tw-shadow-color: rgba(${appRgbColor}, 0.2);`}
    >
      <svg class="w-5 h-5 md:w-6 md:h-6" fill="currentColor" viewBox="0 0 24 24">
        <path d="M3 20.5v-17c0-.83.67-1.5 1.5-1.5.34 0 .66.12.92.33l13.62 10.15c.67.5.76 1.45.19 2.06l-13.62 10.15a1.5 1.5 0 01-2.42-1.2v-1.92z"/>
      </svg>
      <div class="flex flex-col items-start leading-tight">
        <span class="text-[10px] md:text-xs text-white/70 font-medium uppercase tracking-wider font-sans">Google Play</span>
        <span class="text-xs md:text-sm font-bold text-white font-sans">{ctaText}</span>
      </div>
    </a>
  </div>

  <!-- Frictionless QR Code Card (Desktop Only) -->
  <div class="hidden md:flex items-center gap-4 p-4 rounded-2xl bg-white/70 dark:bg-slate-900/50 backdrop-blur-2xl border border-white/80 dark:border-white/10 shadow-md w-max mt-6 relative z-20">
    <div class="w-32 h-32 bg-white dark:bg-white p-3 rounded-2xl border border-slate-200 flex items-center justify-center shadow-inner">
      <img src={config.qrCode} alt={`${appId} Play Store QR Code`} class="w-full h-full object-contain" />
    </div>
    <div class="flex flex-col text-left font-sans">
      <span class="text-xs font-bold text-slate-800 dark:text-slate-200">{qrTitle}</span>
      <span class="text-[10px] text-slate-500 dark:text-slate-400 font-medium mt-0.5 leading-tight" set:html={qrDesc}></span>
    </div>
  </div>
</div>

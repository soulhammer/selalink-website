---
import { useTranslations, languages } from '../i18n/ui';

interface Props {
  lang: string;
  app: string;
}

const { lang, app } = Astro.props;
const currentLang = (lang in languages ? lang : 'en') as keyof typeof languages;
const t = useTranslations(currentLang);

// 앱별 브랜드 컬러 및 안내 텍스트 분기
const appDetails = {
  freshsnap: {
    icon: '/favicon.webp',
    title: t('cta.freshsnap.title'),
    desc: t('cta.freshsnap.desc'),
    btnText: t('cta.freshsnap.btn'),
    link: `/${currentLang}/apps/freshsnap/`,
    bgColor: 'bg-emerald-50/50 border-emerald-100 dark:bg-emerald-950/10 dark:border-emerald-500/20',
    btnBg: 'bg-emerald-600 hover:bg-emerald-700 text-white focus:ring-emerald-500/20',
    badgeText: t('cta.badge.free'),
    badgeStyle: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-500/20 dark:text-emerald-300 border-emerald-200/50 dark:border-emerald-500/20',
    playStoreId: null
  },
  freshself: {
    icon: '/images/freshself/icon.webp',
    title: t('cta.freshself.title'),
    desc: t('cta.freshself.desc'),
    btnText: t('cta.freshself.btn'),
    link: `/${currentLang}/apps/freshself/`,
    bgColor: 'bg-purple-50/50 border-purple-100 dark:bg-purple-950/10 dark:border-purple-500/20',
    btnBg: 'bg-purple-600 hover:bg-purple-700 text-white focus:ring-purple-500/20',
    badgeText: t('cta.badge.free_app'),
    badgeStyle: 'bg-purple-100 text-purple-800 dark:bg-purple-500/20 dark:text-purple-300 border-purple-200/50 dark:border-purple-500/20',
    playStoreId: 'com.selalink.freshself'
  },
  buildself: {
    icon: '/images/buildself/icon.webp',
    title: t('cta.buildself.title'),
    desc: t('cta.buildself.desc'),
    btnText: t('cta.buildself.btn'),
    link: `/${currentLang}/apps/buildself/`,
    bgColor: 'bg-sky-50/50 border-sky-100 dark:bg-sky-950/10 dark:border-sky-500/20',
    btnBg: 'bg-sky-600 hover:bg-sky-700 text-white focus:ring-sky-500/20',
    badgeText: t('cta.badge.free_app'),
    badgeStyle: 'bg-sky-100 text-sky-800 dark:bg-sky-500/20 dark:text-sky-300 border-sky-200/50 dark:border-sky-500/20',
    playStoreId: 'com.selalink.buildself'
  },
  logself: {
    icon: '/images/logself/icon.webp',
    title: t('app.logself.title') || 'logSelf',
    desc: t('app.logself.desc') || 'The safest way to log yourself.',
    btnText: t('cta.general.btn') || 'Learn More',
    link: `/${currentLang}/apps/logself/`,
    bgColor: 'bg-indigo-50/50 border-indigo-100 dark:bg-indigo-950/10 dark:border-indigo-500/20',
    btnBg: 'bg-indigo-600 hover:bg-indigo-700 text-white focus:ring-indigo-500/20',
    badgeText: t('cta.badge.free_app'),
    badgeStyle: 'bg-indigo-100 text-indigo-800 dark:bg-indigo-500/20 dark:text-indigo-300 border-indigo-200/50 dark:border-indigo-500/20',
    playStoreId: 'com.selalink.logself'
  },
  general: {
    icon: '/favicon.webp',
    title: t('cta.general.title'),
    desc: t('cta.general.desc'),
    btnText: t('cta.general.btn'),
    link: `/${currentLang}/`,
    bgColor: 'bg-slate-50/50 border-slate-100 dark:bg-slate-950/10 dark:border-slate-500/20',
    btnBg: 'bg-slate-700 hover:bg-slate-800 text-white focus:ring-slate-500/20',
    badgeText: t('cta.badge.studio'),
    badgeStyle: 'bg-slate-100 text-slate-800 dark:bg-slate-500/20 dark:text-slate-300 border-slate-200/50 dark:border-slate-500/20',
    playStoreId: null
  },
  petself: {
    icon: '/images/freshself/icon.webp',
    title: t('cta.petself.title'),
    desc: t('cta.petself.desc'),
    btnText: t('cta.petself.btn'),
    link: `/${currentLang}/apps/freshself/`,
    bgColor: 'bg-rose-50/50 border-rose-100 dark:bg-rose-950/10 dark:border-rose-500/20',
    btnBg: 'bg-rose-600 hover:bg-rose-700 text-white focus:ring-rose-500/20',
    badgeText: t('cta.badge.free_app'),
    badgeStyle: 'bg-rose-100 text-rose-800 dark:bg-rose-500/20 dark:text-rose-300 border-rose-200/50 dark:border-rose-500/20',
    playStoreId: 'com.selalink.freshself'
  }
};

const activeDetails = (appDetails as Record<string, any>)[app] || appDetails.general;

// BuildSelf 무한 롤링 마키용 위인 멘토 목록 (38+ 중 주요 16인)
const buildselfMentors = [
  { id: 'einstein', name: '아인슈타인', file: 'einstein.webp' },
  { id: 'kingsejong', name: '세종대왕', file: 'kingsejong.webp' },
  { id: 'nikola_tesla', name: '니콜라 테슬라', file: 'nikola_tesla.webp' },
  { id: 'yisunsin', name: '이순신 장군', file: 'yisunsin.webp' },
  { id: 'shin_saimdang', name: '신사임당', file: 'shin_saimdang.webp' },
  { id: 'abraham_lincoln', name: '에이브러햄 링컨', file: 'abraham_lincoln.webp' },
  { id: 'leonardo_da_vinci', name: '다 빈치', file: 'leonardo_da_vinci.webp' },
  { id: 'isaac_newton', name: '아이작 뉴턴', file: 'isaac_newton.webp' },
  { id: 'marie_sklodowska_curie', name: '마리 퀴리', file: 'marie_sklodowska_curie.webp' },
  { id: 'florence_nightingale', name: '나이팅게일', file: 'florence_nightingale.webp' },
  { id: 'galileo_galilei', name: '갈릴레이', file: 'galileo_galilei.webp' },
  { id: 'thomas_edison', name: '에디슨', file: 'thomas_edison.webp' },
  { id: 'immanuel_kant', name: '칸트', file: 'immanuel_kant.webp' },
  { id: 'ludwig_van_beethoven', name: '베토벤', file: 'ludwig_van_beethoven.webp' },
  { id: 'benjamin_franklin', name: '프랭클린', file: 'benjamin_franklin.webp' },
  { id: 'socrates', name: '소크라테스', file: 'socrates.webp' }
];

// 앱 테마에 어울리는 글로우 스타일 변수 주입
const styleVars = app === 'freshsnap'
  ? '--theme-color-light: rgba(16, 185, 129, 0.05); --theme-color-border-hover: rgba(16, 185, 129, 0.3); --theme-color-glow: rgba(16, 185, 129, 0.15);'
  : app === 'freshself'
  ? '--theme-color-light: rgba(139, 92, 246, 0.05); --theme-color-border-hover: rgba(139, 92, 246, 0.3); --theme-color-glow: rgba(139, 92, 246, 0.15);'
  : app === 'buildself'
  ? '--theme-color-light: rgba(2, 132, 199, 0.05); --theme-color-border-hover: rgba(2, 132, 199, 0.3); --theme-color-glow: rgba(2, 132, 199, 0.15);'
  : app === 'logself'
  ? '--theme-color-light: rgba(99, 102, 241, 0.05); --theme-color-border-hover: rgba(99, 102, 241, 0.3); --theme-color-glow: rgba(99, 102, 241, 0.15);'
  : app === 'petself'
  ? '--theme-color-light: rgba(244, 63, 94, 0.05); --theme-color-border-hover: rgba(244, 63, 94, 0.3); --theme-color-glow: rgba(244, 63, 94, 0.15);'
  : '--theme-color-light: rgba(13, 148, 136, 0.05); --theme-color-border-hover: rgba(13, 148, 136, 0.3); --theme-color-glow: rgba(13, 148, 136, 0.15);';
---

<div 
  class={`relative overflow-hidden rounded-3xl border p-6 md:p-8 bg-gradient-to-br ${activeDetails.bgColor} backdrop-blur-md transition-all duration-300 hover:shadow-lg app-card-interactive`}
  style={styleVars}
>
  {app === 'buildself' || app === 'freshself' || app === 'freshsnap' || app === 'petself' ? (
    <div class="flex flex-col lg:flex-row items-center justify-between gap-6 md:gap-8 relative z-10">
      <!-- Left Content Area (Speech Tag + Title + Description: Fully Centered & Isolated) -->
      <div class="space-y-3.5 flex-1 min-w-0 max-w-xl w-full flex flex-col items-center text-center">
        <!-- Speech Bubble Tag -->
        <div class={`inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-extrabold border shadow-xs max-w-full mx-auto ${
          app === 'buildself' ? 'bg-sky-100 dark:bg-sky-500/20 text-sky-800 dark:text-sky-300 border-sky-200 dark:border-sky-500/30' :
          app === 'petself' ? 'bg-rose-100 dark:bg-rose-500/20 text-rose-800 dark:text-rose-300 border-rose-200 dark:border-rose-500/30' :
          'bg-purple-100 dark:bg-purple-500/20 text-purple-800 dark:text-purple-300 border-purple-200 dark:border-purple-500/30'
        }`}>
          <span>💬</span>
          <span class="truncate">
            {app === 'buildself' ? t('cta.buildself.tag') :
             app === 'petself' ? (t('cta.petself.tag') || t('cta.freshself.tag')) :
             (t('cta.freshself.tag') || t('cta.freshsnap.desc'))}
          </span>
        </div>

        <!-- Title & Description Block -->
        <div class="space-y-1.5 w-full text-center">
          {app === 'buildself' && activeDetails.title.includes(' - ') ? (
            <h3 class="text-xl md:text-2xl font-black text-slate-900 dark:text-white tracking-tight leading-snug text-center flex flex-col items-center">
              <span class="inline-flex items-center gap-2 text-sky-600 dark:text-sky-400 font-black text-base md:text-lg tracking-wider uppercase">
                <img 
                  src={`${import.meta.env.BASE_URL}images/buildself/icon.webp`} 
                  alt="BuildSelf App Icon" 
                  class="w-5 h-5 md:w-6 md:h-6 rounded-lg object-cover shadow-xs border border-sky-200 dark:border-sky-500/30" 
                />
                <span>{activeDetails.title.split(' - ')[0]}</span>
              </span>
              <span class="block text-base md:text-xl font-extrabold text-slate-900 dark:text-white leading-snug mt-0.5">
                {activeDetails.title.split(' - ').slice(1).join(' - ')}
              </span>
            </h3>
          ) : (
            <h3 class="text-xl md:text-2xl font-black text-slate-900 dark:text-white tracking-tight leading-snug text-center">
              {activeDetails.title}
            </h3>
          )}
          {app !== 'buildself' && (
            <p class="text-xs md:text-sm text-slate-600 dark:text-slate-300 leading-relaxed font-medium text-center">
              {activeDetails.desc}
            </p>
          )}
        </div>
      </div>
      
      <!-- Right Action Group (Width 360px & Generous Vertical Spacing) -->
      <div class="flex flex-col items-center justify-center gap-4 md:gap-5 shrink-0 w-full lg:w-[360px] pt-5 lg:pt-0 border-t lg:border-t-0 border-slate-200/50 dark:border-slate-700/40">
        <!-- 3D Mentor Avatar Infinite Seamless Marquee (BuildSelf) vs 3D Fruit Buddy Ensemble Stack (FreshSelf / PetSelf) -->
        {app === 'buildself' ? (
          <div class="relative w-full max-w-[360px] overflow-hidden py-3">
            <!-- Left/Right Fade Out Gradient Masks for Smooth Edges -->
            <div class="absolute left-0 top-0 bottom-0 w-8 bg-gradient-to-r from-sky-100/90 dark:from-slate-900/80 to-transparent z-20 pointer-events-none"></div>
            <div class="absolute right-0 top-0 bottom-0 w-8 bg-gradient-to-l from-sky-100/90 dark:from-slate-900/80 to-transparent z-20 pointer-events-none"></div>
            
            <!-- Infinite Seamless Marquee Loop Track -->
            <div class="marquee-mentor-container flex w-max animate-mentor-marquee hover:[animation-play-state:paused] py-1.5">
              <!-- Track Copy 1 -->
              <div class="flex items-center gap-3.5 px-2 shrink-0">
                {buildselfMentors.map((mentor) => (
                  <div class="relative group shrink-0 py-1">
                    <img 
                      src={`${import.meta.env.BASE_URL}images/buildself/mentors/${mentor.file}`} 
                      alt={`${mentor.name} 멘토`} 
                      class="w-14 h-14 md:w-16 md:h-16 rounded-full border-2 border-white dark:border-slate-800 ring-2 ring-amber-400/50 dark:ring-amber-400/40 group-hover:ring-amber-400 dark:group-hover:ring-amber-300 object-cover shadow-md transition-all duration-300 group-hover:scale-125 group-hover:z-30 group-hover:shadow-amber-500/40 dark:group-hover:shadow-amber-500/50 group-hover:shadow-xl cursor-pointer" 
                      loading="lazy"
                    />
                  </div>
                ))}
              </div>

              <!-- Track Copy 2 (Identical Duplicate for Smooth Infinite Seamless Loop) -->
              <div class="flex items-center gap-3.5 px-2 shrink-0" aria-hidden="true">
                {buildselfMentors.map((mentor) => (
                  <div class="relative group shrink-0 py-1">
                    <img 
                      src={`${import.meta.env.BASE_URL}images/buildself/mentors/${mentor.file}`} 
                      alt="" 
                      class="w-14 h-14 md:w-16 md:h-16 rounded-full border-2 border-white dark:border-slate-800 ring-2 ring-amber-400/50 dark:ring-amber-400/40 group-hover:ring-amber-400 dark:group-hover:ring-amber-300 object-cover shadow-md transition-all duration-300 group-hover:scale-125 group-hover:z-30 group-hover:shadow-amber-500/40 dark:group-hover:shadow-amber-500/50 group-hover:shadow-xl cursor-pointer" 
                      loading="lazy"
                    />
                  </div>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <div class="flex items-center justify-center -space-x-2.5 py-1" title="귀여운 3D 신선 과일/식재료 캐릭터들과 함께하세요">
            <img 
              src={`${import.meta.env.BASE_URL}images/freshself/fruits/apple.webp`} 
              alt="Apple Buddy" 
              class="w-11 h-11 md:w-12 md:h-12 rounded-full border-2 border-white dark:border-slate-800 object-cover shadow-md z-30 hover:scale-110 transition-transform bg-rose-50 dark:bg-rose-950/40" 
            />
            <img 
              src={`${import.meta.env.BASE_URL}images/freshself/fruits/avocado.webp`} 
              alt="Avocado Buddy" 
              class="w-11 h-11 md:w-12 md:h-12 rounded-full border-2 border-white dark:border-slate-800 object-cover shadow-md z-20 hover:scale-110 transition-transform bg-emerald-50 dark:bg-emerald-950/40" 
            />
            <img 
              src={`${import.meta.env.BASE_URL}images/freshself/fruits/banana.webp`} 
              alt="Banana Buddy" 
              class="w-11 h-11 md:w-12 md:h-12 rounded-full border-2 border-white dark:border-slate-800 object-cover shadow-md z-10 hover:scale-110 transition-transform bg-amber-50 dark:bg-amber-950/40" 
            />
            <img 
              src={`${import.meta.env.BASE_URL}images/freshself/fruits/strawberry.webp`} 
              alt="Strawberry Buddy" 
              class="w-11 h-11 md:w-12 md:h-12 rounded-full border-2 border-white dark:border-slate-800 object-cover shadow-md z-0 hover:scale-110 transition-transform bg-red-50 dark:bg-red-950/40" 
            />
            <img 
              src={`${import.meta.env.BASE_URL}images/freshself/fruits/orange.webp`} 
              alt="Orange Buddy" 
              class="w-11 h-11 md:w-12 md:h-12 rounded-full border-2 border-white dark:border-slate-800 object-cover shadow-md z-0 hover:scale-110 transition-transform bg-orange-50 dark:bg-orange-950/40" 
            />
            <img 
              src={`${import.meta.env.BASE_URL}images/freshself/fruits/broccoli.webp`} 
              alt="Broccoli Buddy" 
              class="w-11 h-11 md:w-12 md:h-12 rounded-full border-2 border-white dark:border-slate-800 object-cover shadow-md z-0 hover:scale-110 transition-transform bg-green-50 dark:bg-green-950/40" 
            />
          </div>
        )}

        <!-- Download & Learn More Buttons (Flex Wrap & Compact Padding) -->
        <div class="flex flex-col sm:flex-row gap-2.5 items-stretch sm:items-center justify-center w-full">
          {activeDetails.playStoreId ? (
            <a 
              href={`https://play.google.com/store/apps/details?id=${activeDetails.playStoreId}&hl=${currentLang}`}
              target="_blank"
              rel="noopener noreferrer"
              class={`inline-flex items-center justify-center gap-2 px-6 py-3 rounded-2xl font-semibold text-xs sm:text-sm transition-all duration-200 focus:outline-none focus:ring-4 shadow-sm hover:shadow hover:scale-[1.01] active:scale-[0.99] text-center whitespace-nowrap shrink-0 ${activeDetails.btnBg}`}
            >
              <!-- Official Cropped 4-Color Google Play Store Icon Image -->
              <img 
                src={`${import.meta.env.BASE_URL}images/google_play_icon.webp`} 
                alt="Google Play Icon" 
                class="w-4 h-4 sm:w-5 sm:h-5 shrink-0 object-contain drop-shadow-sm" 
              />
              <span class="whitespace-nowrap">{t('cta.action.download_free')}</span>
            </a>
          ) : null}
          {app !== 'buildself' && (
            <a 
              href={activeDetails.link}
              class="inline-flex items-center justify-center px-4 py-3 rounded-2xl font-semibold text-xs sm:text-sm transition-all duration-200 border border-slate-300 dark:border-slate-700 hover:bg-slate-100/50 dark:hover:bg-slate-800/50 text-slate-800 dark:text-slate-200 text-center bg-white/60 dark:bg-slate-800/40 whitespace-nowrap shrink-0"
            >
              {activeDetails.btnText || t('cta.action.learn_more')}
            </a>
          )}
        </div>

        <!-- Integrated 2-Line Subtext (Clean Responsive Wrapping & No Clipping) -->
        <div class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 text-center w-full max-w-[320px] leading-relaxed px-1">
          {t('cta.subtext.free')}
        </div>
      </div>
    </div>
  ) : (
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 relative z-10">
      <div class="flex items-start sm:items-center gap-4 max-w-xl">
        {activeDetails.icon && (
          <img 
            src={activeDetails.icon} 
            alt={activeDetails.title} 
            class="w-12 h-12 md:w-14 md:h-14 rounded-2xl shadow-sm border border-black/5 dark:border-white/10 object-cover shrink-0" 
          />
        )}
        <div class="space-y-2">
          <span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold border tracking-wider uppercase ${activeDetails.badgeStyle}`}>
            {activeDetails.playStoreId && (
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            )}
            {activeDetails.badgeText}
          </span>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white tracking-tight">{activeDetails.title}</h3>
          <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{activeDetails.desc}</p>
        </div>
      </div>
      
      <div class="flex flex-col gap-2 shrink-0 w-full lg:w-auto">
        <div class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-center w-full lg:w-auto">
          {activeDetails.playStoreId ? (
            <!-- 모바일 앱인 경우: Play Store 직접 다운로드 + 상세 보기 병렬 제공 -->
            <a 
              href={`https://play.google.com/store/apps/details?id=${activeDetails.playStoreId}&hl=${currentLang}`}
              target="_blank"
              rel="noopener noreferrer"
              class={`inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-2xl font-semibold text-sm transition-all duration-200 focus:outline-none focus:ring-4 shadow-sm hover:shadow hover:scale-[1.01] active:scale-[0.99] text-center ${activeDetails.btnBg}`}
            >
              <!-- Official Cropped 4-Color Google Play Store Icon Image -->
              <img 
                src={`${import.meta.env.BASE_URL}images/google_play_icon.webp`} 
                alt="Google Play Icon" 
                class="w-5 h-5 shrink-0 object-contain drop-shadow-sm" 
              />
              <span class="whitespace-nowrap">{t('cta.action.download_free')}</span>
            </a>
          ) : null}
          <a 
            href={activeDetails.link}
            class="inline-flex items-center justify-center px-6 py-3.5 rounded-2xl font-semibold text-sm transition-all duration-200 border border-slate-350 dark:border-slate-700 hover:bg-slate-100/50 dark:hover:bg-slate-800/50 text-slate-800 dark:text-slate-200 text-center"
          >
            {activeDetails.btnText || t('cta.action.learn_more')}
          </a>
        </div>
        {activeDetails.playStoreId && (
          <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400 text-center lg:text-right mt-0.5">
            {t('cta.subtext.free')}
          </p>
        )}
      </div>
    </div>
  )}
</div>

<style>
  .animate-mentor-marquee {
    animation: mentor-marquee-scroll 28s linear infinite;
    will-change: transform;
  }
  @keyframes mentor-marquee-scroll {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .animate-mentor-marquee {
      animation: none;
    }
  }
</style>


const texts = textMap[currentLang] || textMap['en'];
---

<section class="relative z-10 w-full max-w-7xl mx-auto px-6 py-12 md:py-20 border-t border-slate-200/50 dark:border-slate-800/40">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
    
    <!-- Left Copy -->
    <div class="lg:col-span-6 space-y-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 text-xs font-bold">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
        <span>{texts.badge}</span>
      </div>

      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-slate-900 dark:text-white leading-[1.15] whitespace-pre-line">
        {texts.title}
      </h2>

      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 font-medium leading-relaxed">
        {texts.desc}
      </p>

      <div class="grid grid-cols-2 gap-4 pt-2">
        <div class="p-4 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800 space-y-1 shadow-sm">
          <span class="text-xl">📸</span>
          <h4 class="text-sm font-extrabold text-slate-900 dark:text-white">{texts.ocrTitle}</h4>
          <p class="text-xs text-slate-500 dark:text-slate-400">{texts.ocrDesc}</p>
        </div>

        <div class="p-4 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800 space-y-1 shadow-sm">
          <span class="text-xl">🏷️</span>
          <h4 class="text-sm font-extrabold text-slate-900 dark:text-white">{texts.bcTitle}</h4>
          <p class="text-xs text-slate-500 dark:text-slate-400">{texts.bcDesc}</p>
        </div>
      </div>
    </div>

    <!-- Right Graphic: Interactive Laser Scan Simulation Box -->
    <div class="lg:col-span-6 relative flex justify-center">
      <div class="relative w-full max-w-[420px] p-6 rounded-[2.5rem] bg-gradient-to-b from-slate-900 via-slate-950 to-slate-900 border border-emerald-500/30 shadow-2xl overflow-hidden group">
        <!-- Laser Scan Line Effect -->
        <div class="absolute inset-x-0 h-1 bg-gradient-to-r from-transparent via-emerald-400 to-transparent shadow-[0_0_15px_#34d399] laser-scan z-30 pointer-events-none"></div>

        <!-- Header Status Mockup -->
        <div class="flex items-center justify-between border-b border-slate-800 pb-4 mb-4">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
            <span class="text-xs font-bold text-slate-300 font-outfit">AI SCANNER READY</span>
          </div>
          <span class="text-[10px] font-mono text-emerald-400 bg-emerald-950/60 px-2 py-0.5 rounded border border-emerald-500/30">100% AUTO MATCH</span>
        </div>

        <!-- Scanned Item Receipt Card Demo -->
        <div class="space-y-3 relative z-10">
          <div class="p-4 rounded-2xl bg-slate-800/80 border border-emerald-500/20 flex items-center justify-between transform transition-transform duration-300 group-hover:scale-[1.02]">
            <div class="flex items-center gap-3">
              <span class="text-3xl">🥛</span>
              <div>
                <h5 class="text-sm font-bold text-white">{texts.item1}</h5>
                <span class="text-[10px] text-emerald-400 font-mono">BC: 8801115011012</span>
              </div>
            </div>
            <div class="text-right">
              <span class="text-xs font-black text-rose-400 block font-outfit">D-5</span>
              <span class="text-[10px] text-slate-400">2026.08.06</span>
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-slate-800/80 border border-slate-700/60 flex items-center justify-between opacity-85">
            <div class="flex items-center gap-3">
              <span class="text-3xl">🧀</span>
              <div>
                <h5 class="text-sm font-bold text-white">{texts.item2}</h5>
                <span class="text-[10px] text-teal-400 font-mono">BC: 8801047120345</span>
              </div>
            </div>
            <div class="text-right">
              <span class="text-xs font-black text-teal-400 block font-outfit">D-45</span>
              <span class="text-[10px] text-slate-400">2026.09.15</span>
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-slate-800/80 border border-slate-700/60 flex items-center justify-between opacity-70">
            <div class="flex items-center gap-3">
              <span class="text-3xl">🥩</span>
              <div>
                <h5 class="text-sm font-bold text-white">{texts.item3}</h5>
                <span class="text-[10px] text-amber-400 font-mono">BC: 8801999201923</span>
              </div>
            </div>
            <div class="text-right">
              <span class="text-xs font-black text-amber-400 block font-outfit">D-2</span>
              <span class="text-[10px] text-slate-400">2026.08.03</span>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .laser-scan {
    animation: scan-move 3s ease-in-out infinite alternate;
  }

  @keyframes scan-move {
    0% { top: 10%; opacity: 0.3; }
    50% { opacity: 1; }
    100% { top: 90%; opacity: 0.3; }
  }
</style>

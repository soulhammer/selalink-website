    item3: 'Faux-filet de Bœuf Premium'
  },
  de: {
    badge: '⚡ 1-Sekunden-Smart-Scan-System',
    title: 'Kein Manuelles Tippen.\nBarcode & Beleg Sofort Scannen',
    desc: 'Geben Sie Mindesthaltbarkeitsdaten nie wieder manuell ein. Ein Barcode-Scan erfasst automatisch Lebensmittelnamen, Kategorien und MHD-Benachrichtigungen.',
    ocrTitle: 'Kamera-Datum-OCR',
    ocrDesc: 'Erkennt gedruckte Daten',
    bcTitle: 'Barcode-Datenbank',
    bcDesc: 'Verknüpft Lebensmittelnamen',
    item1: 'Frische Milch 1000ml',
    item2: 'Cheddar-Scheibenkäse',
    item3: 'Premium-Rinderlende'
  },
  pt: {
    badge: '⚡ Sistema de Escaneamento Inteligente em 1 Segundo',
    title: 'Zero Digitação Manual.\nEscaneie Códigos de Barras Instantaneamente',
    desc: 'Não digite manualmente datas de validade. Um escaneamento de código de barras registra automaticamente nomes, categorias e alertas de validade.',
    ocrTitle: 'OCR de Data por Câmera',
    ocrDesc: 'Reconhece datas impressas',
    bcTitle: 'Banco de Códigos de Barras',
    bcDesc: 'Vincula nomes de alimentos',
    item1: 'Leite Fresco 1000ml',
    item2: 'Queijo Cheddar Fatiado',
    item3: 'Lomo de Novilho Premium'

---
import { useTranslations, languages } from '../../i18n/ui';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const currentLang = (lang && languages[lang as keyof typeof languages]) ? lang : 'en';

const textMap: Record<string, {
  badge: string;
  title: string;
  desc: string;
  ocrTitle: string;
  ocrDesc: string;
  bcTitle: string;
  bcDesc: string;
  item1: string;
  item2: string;
  item3: string;
}> = {

  id: {
    badge: '⚡ Sistem Pemindaian Pintar 1 Detik',
    title: 'Tanpa Ketik Manual.\nPindai Barcode & Struk Seketika',
    desc: 'Jangan ketik tanggal kedaluwarsa secara manual. Satu pemindaian barcode otomatis mencatat nama bahan makanan, kategori, dan pengingat D-Day.',
    ocrTitle: 'OCR Tanggal Kamera',
    ocrDesc: 'Membaca tanggal cetak',
    bcTitle: 'Database Barcode Global',

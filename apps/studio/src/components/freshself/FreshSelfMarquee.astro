---

<section class="relative z-10 w-full py-8 md:py-12 overflow-hidden border-y border-slate-200/60 dark:border-slate-800/60 bg-slate-100/50 dark:bg-slate-950/40 backdrop-blur-md">
  {/* Side Gradients for Seamless Fading */}
  <div class="absolute left-0 top-0 bottom-0 w-24 md:w-40 bg-gradient-to-r from-slate-50 dark:from-[#0B0F19] to-transparent z-20 pointer-events-none"></div>
  <div class="absolute right-0 top-0 bottom-0 w-24 md:w-40 bg-gradient-to-l from-slate-50 dark:from-[#0B0F19] to-transparent z-20 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 mb-6 text-center space-y-2">
    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-purple-500/10 text-purple-600 dark:text-purple-400 text-xs font-extrabold border border-purple-500/20">
      <span class="w-2 h-2 rounded-full bg-purple-500 animate-ping"></span>
      <span>{labels.badge}</span>
    </div>
    <h3 class="text-lg sm:text-2xl font-black text-slate-900 dark:text-slate-100 tracking-tight">
      {labels.main}
    </h3>
  </div>

  <!-- Marquee Row 1 (Left to Right) -->
  <div class="flex gap-4 w-max marquee-track hover:[animation-play-state:paused]">
    {[...itemsRow1, ...itemsRow1, ...itemsRow1].map((item) => (
      <div class="flex items-center gap-3 px-4 py-3 rounded-2xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 shadow-sm backdrop-blur-md shrink-0 cursor-default transition-all duration-300 hover:scale-105">
        <span class="text-2xl">{item.emoji}</span>
        <div class="flex flex-col">
          <div class="flex items-center gap-2">
            <span class="text-xs font-extrabold text-slate-900 dark:text-slate-100">{item.name}</span>
            <span class={`text-[10px] font-black font-outfit px-2 py-0.5 rounded-full ${
              item.status.includes('🚨') ? 'bg-rose-500/10 text-rose-500 border border-rose-500/20' :
              item.status.includes('⚠️') ? 'bg-amber-500/10 text-amber-500 border border-amber-500/20' :
              'bg-emerald-500/10 text-emerald-500 border border-emerald-500/20'
            }`}>
              {item.status}
            </span>
          </div>
          <span class="text-[10px] text-slate-500 dark:text-slate-400 font-medium">📍 {item.location}</span>
        </div>
      </div>
    ))}
  </div>

  <!-- Marquee Row 2 (Right to Left) -->
  <div class="flex gap-4 w-max marquee-track-reverse hover:[animation-play-state:paused] mt-4">
    {[...itemsRow2, ...itemsRow2, ...itemsRow2].map((item) => (
      <div class="flex items-center gap-3 px-4 py-3 rounded-2xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 shadow-sm backdrop-blur-md shrink-0 cursor-default transition-all duration-300 hover:scale-105">
        <span class="text-2xl">{item.emoji}</span>
        <div class="flex flex-col">
          <div class="flex items-center gap-2">
            <span class="text-xs font-extrabold text-slate-900 dark:text-slate-100">{item.name}</span>
            <span class={`text-[10px] font-black font-outfit px-2 py-0.5 rounded-full ${
              item.status.includes('🚨') ? 'bg-rose-500/10 text-rose-500 border border-rose-500/20' :
              item.status.includes('⚠️') ? 'bg-amber-500/10 text-amber-500 border border-amber-500/20' :
              'bg-emerald-500/10 text-emerald-500 border border-emerald-500/20'
            }`}>
              {item.status}
            </span>
          </div>
          <span class="text-[10px] text-slate-500 dark:text-slate-400 font-medium">📍 {item.location}</span>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .marquee-track {
    animation: marquee-left 35s linear infinite;
  }
  .marquee-track-reverse {
    animation: marquee-right 35s linear infinite;
  }

  @keyframes marquee-left {
    0% { transform: translateX(0); }
    100% { transform: translateX(-33.333%); }
  }

  @keyframes marquee-right {
    0% { transform: translateX(-33.333%); }
    100% { transform: translateX(0); }
  }
</style>

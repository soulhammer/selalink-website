---
import Layout from '../../../../layouts/Layout.astro';
import { useTranslations } from '../../../../i18n/ui';

// NO getStaticPaths() - This is HARDCODED to /ko/ only based on DeepMood's actual language support!
const lang = 'ko';
const t = useTranslations('ko');
---
<Layout title={`DeepMood | 한국어 전용`} lang="ko">
	<main class="max-w-[1400px] mx-auto px-6 py-24 min-h-screen text-center flex flex-col items-center">
		<a href={`/ko/`} class="text-purple-600 dark:text-purple-400 hover:underline mb-8 inline-block font-semibold self-start">← SelaLink 홈으로 돌아가기</a>
		
		<div class="mt-16 relative">
			<div class="absolute inset-0 bg-purple-500/20 blur-[100px] rounded-full"></div>
			<h1 class="text-7xl md:text-9xl font-black mb-6 text-purple-600 dark:text-purple-400 tracking-tighter relative z-10">{t('app.deepmood.title')}</h1>
		</div>
		
		<p class="text-2xl text-slate-600 dark:text-slate-400 font-light mb-16">{t('app.deepmood.desc')}</p>
        
		<div class="p-8 bg-purple-50 dark:bg-purple-500/10 border border-purple-200 dark:border-purple-500/20 rounded-3xl text-left max-w-2xl shadow-sm">
            <h2 class="text-2xl font-bold mb-4 text-purple-900 dark:text-purple-100 flex items-center gap-3">
				<span class="text-3xl">🇰🇷</span> DeepMood는 한국어만 지원합니다.
			</h2>
            <p class="text-purple-700 dark:text-purple-300 text-lg leading-relaxed">이 페이지는 `/ko/` 폴더 하위에만 물리적으로 <strong>빌드 락(Build Lock)</strong>이 걸려 있습니다. 영어나 스페인어 등 다른 8개 언어 URL로는 빌드 자체가 되지 않으며 원천적으로 접근이 불가능하도록 설계된 특수한 격리 환경입니다.</p>
        </div>
	</main>
</Layout>

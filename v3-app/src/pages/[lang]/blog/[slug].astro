---
import Layout from '../../../layouts/Layout.astro';
import BlogAppCta from '../../../components/BlogAppCta.astro';
import YoutubeEmbed from '../../../components/YoutubeEmbed.astro';
import ShortsPlayerModal from '../../../components/ShortsPlayerModal.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => {
    const parts = post.id.split('/');
    const lang = parts[0];
    const slug = parts.slice(1).join('/');
    return {
      params: { lang, slug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { lang } = Astro.params;
const { title, description, pubDate, heroImage, app, youtubeId } = post.data;

const { Content } = await render(post);

// SEO를 위한 구조화된 데이터(JSON-LD) 생성
const formattedUrl = new URL(Astro.url.pathname, Astro.site).href;
const structuredDataList = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": title,
    "description": description,
    "image": heroImage ? new URL(heroImage, Astro.site).href : undefined,
    "datePublished": new Date(pubDate).toISOString(),
    "author": {
      "@type": "Organization",
      "name": "SelaLink Studio",
      "url": "https://selalink.net/"
    },
    "publisher": {
      "@type": "Organization",
      "name": "SelaLink Studio",
      "logo": {
        "@type": "ImageObject",
        "url": "https://selalink.net/favicon.png"
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": formattedUrl
    }
  }
];

// 12종 식재료별 다국어 HowTo 스키마 단계 데이터정의
const howToData = {
  'how-to-store-bananas': {
    ko: [
      { name: "바나나 공중에 매달기", text: "바나나 걸이 또는 옷걸이에 매달아 공중에 띄워 멍이 드는 것을 방지하고 신선도를 지킵니다." },
      { name: "꼭지 알루미늄 호일 감싸기", text: "바나나 에틸렌 가스 배출의 핵심인 꼭지(줄기) 부분을 랩이나 은박지로 꽁꽁 묶어 숙성을 지연시킵니다." },
      { name: "완숙 시 개별 포장 후 냉장실 보관", text: "바나나가 노랗게 완전히 익고 슈가스팟이 생기면 낱개로 랩핑하여 냉장고 야채칸에 보관해 노화를 멈춥니다." }
    ],
    en: [
      { name: "Hang Bananas Up", text: "Hang bananas on a hanger to distribute weight evenly and prevent soft bruising spots." },
      { name: "Wrap Stems with Foil", text: "Wrap the banana stems tightly with aluminum foil or plastic wrap to lock ethylene gas." },
      { name: "Refrigerate When Fully Ripe", text: "Wrap ripe bananas individually and store them in the crisper drawer to retard further ripening." }
    ]
  },
  'how-to-store-apples': {
    ko: [
      { name: "씻지 않고 랩으로 개별 포장", text: "수분 증발을 막고 에틸렌 가스 노출을 차단하기 위해 씻지 않은 사과를 랩으로 감쌉니다." },
      { name: "저온 냉장 보관", text: "사과의 호흡과 에틸렌 방출을 억제하여 신선도를 오래 지키도록 냉장고 야채칸(0~4℃)에 보관합니다." },
      { name: "다른 식재료와 완벽 격리", text: "사과의 에틸렌 가스가 다른 채소와 과일을 부패시키지 않도록 지퍼백 등에 밀봉해 격리 보관합니다." }

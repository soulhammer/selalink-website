---
import Layout from '../../../layouts/Layout.astro';
import BlogAppCta from '../../../components/BlogAppCta.astro';
import YoutubeEmbed from '../../../components/YoutubeEmbed.astro';
import ShareToolkit from '../../../components/ShareToolkit.astro';
import { getCollection, render } from 'astro:content';
import { useTranslations } from '../../../i18n/ui';
import { getFormattedDate, getPrevNextPost, generateStructuredData } from '../../../utils/blogDetailHelper';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => {
    const parts = post.id.split('/');
    const lang = parts[0];
    const slug = parts.slice(1).join('/');
    return {
      params: { lang, slug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { lang } = Astro.params;
const { title, description, pubDate, heroImage, app, youtubeId, updatedDate } = post.data;

const t = useTranslations(lang as any);
const { Content, headings } = await render(post);

// SEO를 위한 구조화된 데이터(JSON-LD) 생성
const formattedUrl = new URL(Astro.url.pathname, Astro.site).href;
const structuredDataList = generateStructuredData({
  title,
  description,
  heroImage,
  pubDate,
  updatedDate,
  postBody: post.body || '',
  postSteps: post.data.steps,
  postFaqs: post.data.faqs,
  formattedUrl,
  siteOrigin: Astro.site?.origin || 'https://selalink.net'
});

const formattedDate = getFormattedDate(pubDate, lang || 'en');

// 이전 글 / 다음 글 계산
const allPosts = await getCollection('blog');
const { prevPost, nextPost } = getPrevNextPost(allPosts, post.id, lang || 'en');

// 앱 타입별 테마 스타일링 바인딩
const themeAccents: Record<string, string> = {
  freshsnap: 'prose-a:text-emerald-600 dark:prose-a:text-emerald-400 hover:prose-a:text-emerald-700 dark:hover:prose-a:text-emerald-300 border-emerald-500/10 dark:border-emerald-500/20 bg-emerald-500/5',
  freshself: 'prose-a:text-purple-600 dark:prose-a:text-purple-400 hover:prose-a:text-purple-700 dark:hover:prose-a:text-purple-300 border-purple-500/10 dark:border-purple-500/20 bg-purple-500/5',
  buildself: 'prose-a:text-indigo-600 dark:prose-a:text-indigo-400 hover:prose-a:text-indigo-700 dark:hover:prose-a:text-indigo-300 border-indigo-500/10 dark:border-indigo-500/20 bg-indigo-500/5',
  logself: 'prose-a:text-blue-600 dark:prose-a:text-blue-400 hover:prose-a:text-blue-700 dark:hover:prose-a:text-blue-300 border-blue-500/10 dark:border-blue-500/20 bg-blue-500/5',
  petself: 'prose-a:text-rose-600 dark:prose-a:text-rose-400 hover:prose-a:text-rose-700 dark:hover:prose-a:text-rose-300 border-rose-500/10 dark:border-rose-500/20 bg-rose-500/5',
  general: 'prose-a:text-teal-600 dark:prose-a:text-teal-400 hover:prose-a:text-teal-700 dark:hover:prose-a:text-teal-300 border-teal-500/10 dark:border-teal-500/20 bg-teal-500/5'
};
const activeAccent = themeAccents[app] || themeAccents.general;
---

<Layout 
  title={title} 
  lang={lang as string} 
  description={description} 
  appId={app === 'general' ? undefined : app} 
  image={heroImage}
  ogType="website"
  structuredData={structuredDataList}
  keywords={post.data.tags.join(', ')}
>
  {/* Reading Progress Bar */}
  <div 
    id="reading-progress" 
    class="fixed top-0 left-0 h-1 bg-gradient-to-r from-[var(--theme-accent,#10B981)] to-teal-400 z-50 transition-all duration-100" 
    style={`width: 0%; --theme-accent: ${
      app === 'freshsnap' ? '#10B981' : 
      app === 'freshself' ? '#A855F7' : 
      app === 'buildself' ? '#6366F1' : 
      app === 'logself' ? '#3B82F6' : '#14B8A6'
    };`}
  ></div>

  <main class="max-w-[1080px] mx-auto px-6 py-12 md:py-20">
    <!-- Breadcrumb -->
    <nav class="flex text-xs font-semibold text-slate-500 mb-8" aria-label="Breadcrumb">
      <ol class="inline-flex items-center space-x-1 md:space-x-2">
        <li class="inline-flex items-center">
          <a href={`/${lang}/`} class="hover:text-slate-900 dark:hover:text-white transition-colors">{t('nav.home')}</a>
        </li>
        <li>
          <div class="flex items-center">
            <span class="mx-2 text-slate-400 dark:text-slate-700">/</span>
            <a href={`/${lang}/blog/`} class="hover:text-slate-900 dark:hover:text-white transition-colors">{t('nav.blog')}</a>
          </div>
        </li>
        <li aria-current="page">
          <div class="flex items-center">
            <span class="mx-2 text-slate-400 dark:text-slate-700">/</span>
            <span class="text-slate-400 dark:text-slate-500 max-w-[200px] md:max-w-xs truncate">{title}</span>
          </div>
        </li>
      </ol>
    </nav>

    <!-- Article Header -->
    <header class="space-y-6 mb-12">
      <div class="space-y-3">
        <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-tight">
          {title}
        </h1>
        <div class="flex items-center gap-4 text-xs font-bold text-slate-400 dark:text-slate-500 pt-1">
          <time datetime={new Date(pubDate).toISOString()}>{formattedDate}</time>
          <span>•</span>
          <span class="capitalize tracking-widest text-emerald-600 dark:text-emerald-400">{app}</span>
        </div>
      </div>

      {heroImage && (
        <div 
          id="hero-image-trigger"
          class="relative rounded-[2rem] overflow-hidden border border-slate-200/80 dark:border-white/10 bg-slate-100 dark:bg-slate-950/20 shadow-xl dark:shadow-2xl max-h-[420px] md:max-h-[480px] aspect-video flex items-center justify-center cursor-zoom-in hover:brightness-95 active:scale-[0.99] transition-all duration-200"
          aria-label="View full image"
          role="button"
          tabindex="0"
        >
          {/* Blurred background shadow for aesthetic depth */}
          <img 
            src={heroImage} 
            alt=""
            class="absolute inset-0 w-full h-full object-cover blur-3xl opacity-25 dark:opacity-35 pointer-events-none scale-105"
            aria-hidden="true"
          />
          {/* Main Contain Image to prevent cutting */}
          <img 
            src={heroImage} 
            alt={title}
            class="relative z-10 max-h-[420px] md:max-h-[480px] w-auto object-contain mx-auto pointer-events-none"
          />
        </div>
      )}
    </header>

    <!-- Layout Grid: Content + Desktop TOC -->
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_260px] gap-12 items-start">
      <div class="w-full min-w-0">
        <!-- YouTube Shorts Embed Section (Interactive & Cinematic) -->
        {youtubeId && (
          <div class={`p-6 md:p-8 rounded-[2rem] border ${activeAccent} mb-12 flex flex-col md:flex-row items-center gap-8 justify-between shadow-sm dark:shadow-none`}>
            <div class="space-y-4 max-w-sm text-center md:text-left">
              <span class="px-2.5 py-1 rounded-full bg-red-600 text-white font-bold text-[10px] tracking-widest uppercase">YOUTUBE SHORTS</span>
              <h4 class="text-xl font-extrabold text-slate-900 dark:text-white leading-snug tracking-tight">
                {t('blog.shorts.title')}
              </h4>
              <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed font-medium">
                {t('blog.shorts.desc')}
              </p>
            </div>
            <div class="w-full md:w-auto flex justify-center shrink-0">
              <YoutubeEmbed id={youtubeId} title={title} isShorts={true} app={app} />
            </div>
          </div>
        )}

        <!-- Mobile Table of Contents (TOC) -->
        {headings.length > 0 && (
          <details class="lg:hidden mb-8 bg-slate-500/5 dark:bg-slate-900/10 p-5 rounded-[1.5rem] border border-slate-200/50 dark:border-white/5 backdrop-blur-sm shadow-sm select-none group">
            <summary class="flex justify-between items-center text-xs font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400 cursor-pointer list-none">
              <span>{t('blog.toc')}</span>
              <svg class="w-4 h-4 transition-transform group-open:rotate-180 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <nav class="mt-3.5 space-y-2.5 text-xs border-t border-slate-200/40 dark:border-white/5 pt-3">
              {headings.filter(h => h.depth <= 3).map(h => (
                <a 
                  href={`#${h.slug}`} 
                  class={`block text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-white transition-colors duration-150 py-0.5 ${h.depth === 3 ? 'pl-4 text-[11px]' : 'font-bold'}`}
                >
                  {h.text}
                </a>
              ))}
            </nav>
          </details>
        )}

        <!-- Article Body (Refined Premium Typography) -->
        <article 
          class={`prose prose-slate dark:prose-invert max-w-none mb-16 tracking-tight text-slate-800/95 dark:text-slate-200/95 ${themeAccents[app] || ''}
            prose-headings:text-slate-900 dark:prose-headings:text-white prose-headings:font-extrabold prose-headings:tracking-tight
            prose-h2:text-2xl prose-h2:md:text-3xl prose-h2:mt-14 prose-h2:mb-6 prose-h2:pb-3.5 prose-h2:border-b prose-h2:border-slate-200/80 dark:prose-h2:border-white/5
            prose-h3:text-lg prose-h3:md:text-xl prose-h3:mt-10 prose-h3:mb-4
            prose-p:my-5 prose-p:text-[16px] prose-p:md:text-[17px] prose-p:leading-[1.75] prose-p:text-slate-700 dark:prose-p:text-slate-300
            ${lang === 'ko' ? 'prose-p:break-keep prose-li:break-keep' : 'prose-p:break-words prose-li:break-words'}
            prose-p:overflow-wrap-anywhere
            prose-strong:text-slate-900 dark:prose-strong:text-white prose-strong:font-extrabold
            prose-hr:my-12 prose-hr:border-slate-200 dark:prose-hr:border-white/5
            prose-ul:list-none prose-ul:pl-0 prose-ul:my-6
            prose-li:relative prose-li:pl-7 prose-li:my-3 prose-li:text-[15px] prose-li:md:text-[16px] prose-li:text-slate-700 dark:prose-li:text-slate-300
            prose-li:before:content-["•"] prose-li:before:absolute prose-li:before:left-2 prose-li:before:text-[var(--theme-accent,#10B981)] prose-li:before:font-extrabold prose-li:before:text-lg
            prose-blockquote:border-l-4 prose-blockquote:border-[var(--theme-accent,#10B981)] prose-blockquote:bg-[var(--theme-accent,#10B981)]/5 prose-blockquote:py-5 prose-blockquote:px-7 prose-blockquote:rounded-r-3xl prose-blockquote:my-8 prose-blockquote:text-slate-700 dark:prose-blockquote:text-slate-300 prose-blockquote:not-italic`}
          style={`--theme-accent: ${
            app === 'freshsnap' ? '#10B981' : 
            app === 'freshself' ? '#A855F7' : 
            app === 'buildself' ? '#6366F1' : 
            app === 'logself' ? '#3B82F6' : '#14B8A6'
          };`}
        >
          <Content />
        </article>
        
        <ShareToolkit lang={lang as string} />
      </div>

      <!-- Desktop Table of Contents (TOC) -->
      {headings.length > 0 && (
        <aside class="hidden lg:block sticky top-28 self-start bg-slate-500/5 dark:bg-slate-900/20 p-6 rounded-[2rem] border border-slate-200/50 dark:border-white/5 backdrop-blur-sm max-h-[calc(100vh-160px)] overflow-y-auto shadow-sm">
          <h5 class="text-[10px] font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500 mb-4">{t('blog.toc')}</h5>
          <nav class="space-y-2.5 text-[13px]">
            {headings.filter(h => h.depth <= 3).map(h => (
              <a 
                href={`#${h.slug}`} 
                class={`block text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-white transition-colors duration-150 py-0.5 leading-relaxed ${h.depth === 3 ? 'pl-4 text-xs' : 'font-bold'}`}
              >
                {h.text}
              </a>
            ))}
          </nav>
        </aside>
      )}
    </div>

    <!-- Prev / Next Navigation -->
    {(prevPost || nextPost) && (
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 my-16 pt-12 border-t border-slate-200 dark:border-white/10">
        {prevPost ? (
          <a 
            href={`/${lang}/blog/${prevPost.id.split('/').pop()}/`} 
            class="group flex flex-col p-6 rounded-[2rem] border border-slate-200/60 dark:border-white/5 bg-slate-50/30 dark:bg-slate-900/20 hover:border-slate-300 dark:hover:border-white/10 transition-all duration-300 shadow-sm"
          >
            <span class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest mb-1.5">{t('blog.prev')}</span>
            <h4 class="text-sm font-bold text-slate-700 dark:text-slate-200 group-hover:text-slate-950 dark:group-hover:text-white transition-colors line-clamp-2 leading-snug">{prevPost.data.title}</h4>
          </a>
        ) : (
          <div class="hidden sm:block"></div>
        )}
        
        {nextPost && (
          <a 
            href={`/${lang}/blog/${nextPost.id.split('/').pop()}/`} 
            class="group flex flex-col p-6 rounded-[2rem] border border-slate-200/60 dark:border-white/5 bg-slate-50/30 dark:bg-slate-900/20 hover:border-slate-300 dark:hover:border-white/10 transition-all duration-300 shadow-sm text-right"
          >
            <span class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest mb-1.5">{t('blog.next')}</span>
            <h4 class="text-sm font-bold text-slate-700 dark:text-slate-200 group-hover:text-slate-950 dark:group-hover:text-white transition-colors line-clamp-2 leading-snug">{nextPost.data.title}</h4>
          </a>
        )}
      </div>
    )}
 
    <!-- Legal Disclaimer Section -->
    <div class="my-10 p-5 rounded-[1.5rem] border border-slate-200/80 bg-slate-50/50 dark:border-white/5 dark:bg-slate-900/20 shadow-sm backdrop-blur-sm">
      <div class="flex items-center gap-2 mb-2 text-slate-500 dark:text-slate-400">
        <span class="text-base">⚖️</span>
        <h5 class="text-xs font-bold uppercase tracking-wider m-0">
          {t('blog.disclaimer.title')}
        </h5>
      </div>
      <p class="text-[11px] md:text-xs text-slate-500/80 dark:text-slate-400/80 m-0 leading-relaxed font-medium">
        {app === 'buildself' ? t('blog.disclaimer.buildself.desc') : app === 'petself' ? t('blog.disclaimer.petself.desc') : t('blog.disclaimer.desc')}
      </p>
    </div>

    <!-- App Promotion CTA Banner -->
    <div class="pt-10 border-t border-slate-200 dark:border-white/10">
      {(app === 'freshsnap' || app === 'freshself') ? (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <BlogAppCta lang={lang as string} app="freshsnap" />
          <BlogAppCta lang={lang as string} app="freshself" />
        </div>
      ) : (
        <div class="space-y-4">
          <BlogAppCta lang={lang as string} app={app} />
        </div>
      )}
    </div>
  </main>

  {heroImage && (
    <!-- Lightbox Modal (Premium UI with blur and transition) -->
    <div 
      id="lightbox-modal" 
      class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/90 backdrop-blur-md opacity-0 transition-opacity duration-300 cursor-zoom-out"
      aria-modal="true"
      role="dialog"
    >
      <div class="relative max-w-[90vw] max-h-[90vh] flex items-center justify-center pointer-events-none">
        <button 
          id="lightbox-close" 
          class="absolute top-[-3rem] right-0 md:right-[-3rem] text-white/70 hover:text-white text-3xl font-light transition-colors p-2 pointer-events-auto cursor-pointer"
          aria-label="Close Lightbox"
        >
          &times;
        </button>
        <img 
          id="lightbox-image" 
          src={heroImage} 
          alt={title} 
          class="max-w-full max-h-[80vh] md:max-h-[85vh] object-contain rounded-2xl shadow-2xl pointer-events-auto bg-slate-950"
        />
      </div>
    </div>
  )}

  <!-- Back to Top Button -->
  <button 
    id="back-to-top" 
    class="fixed bottom-6 right-6 z-40 p-3.5 rounded-full bg-slate-900 text-white dark:bg-white dark:text-slate-900 shadow-xl border border-white/10 dark:border-black/5 opacity-0 translate-y-4 pointer-events-none transition-all duration-300 hover:scale-110 active:scale-95 cursor-pointer"
    aria-label="Back to Top"
  >
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18" />
    </svg>
  </button>
</Layout>

<script src="../../../utils/blogDetail.ts"></script>

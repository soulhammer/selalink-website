    ]
  },
  'how-to-store-garlic': {
    ko: [
      { name: "용기 바닥 설탕 제습제 세팅", text: "밀폐용기 바닥에 설탕을 깔고 키친타월을 2~3장 덮은 뒤 깐 마늘을 올려 습기를 완벽 차단합니다." },
      { name: "통마늘은 상온 망사 보관", text: "껍질째 있는 통마늘은 냉장 보관 시 싹이 트고 썩으므로 바람이 통하는 그늘에 매달아 보관합니다." },
      { name: "다진 마늘 얼음틀 소분", text: "다량의 마늘은 다져서 실리콘 큐브 틀에 소분해 냉동실에 얼려두고 요리 시 한 블록씩 꺼내 씁니다." }
    ],
    en: [
      { name: "Set Sugar Dehumidifier at Bottom", text: "Spread sugar and cover with paper towels at the container bottom, placing peeled garlic on top." },
      { name: "Hang Whole Garlic in a Net", text: "Store unpeeled whole garlic in a hanging net in a dry, dark, well-ventilated space." },
      { name: "Freeze Minced Garlic in Trays", text: "Freeze minced garlic in silicone ice trays to pop out convenient single-use cubes." }
    ]
  },
  'how-to-store-watermelon': {
    ko: [
      { name: "비닐 랩 포장 절대 금지", text: "반 자른 수박에 비닐 랩만 씌우면 세균이 하루 만에 3,000배 증식하므로 절대 그대로 보관하지 않습니다." },
      { name: "속살만 깍둑썰기 보관", text: "수박 껍질을 잘라내고 붉은 속살만 조각내어 유리 또는 플라스틱 밀폐용기에 청결하게 보관합니다." },
      { name: "냉장실 깊숙이 안쪽 보관", text: "수분이 많아 쉽게 상하므로 온도 변화가 잦은 문 쪽을 피해 차가운 야채칸 안쪽에 밀폐 보관합니다." }
    ],
    en: [
      { name: "Never Use Wrap Only", text: "Plastic film wrapping traps bacteria, leading to a massive germ spike. Avoid wrap-only refrigeration." },
      { name: "Cut into Cubes and Store", text: "Remove the rind, cut the red flesh into cubes, and store in an airtight container for hygiene." },
      { name: "Keep Deep Inside Refrigerator", text: "Store the container in the coldest section (0-4°C) away from the door to prevent fermentation." }
    ]
  },
  'how-to-store-bread': {
    ko: [
      { name: "냉장 보관 절대 금지", text: "냉장고 온도(1~6℃)는 빵 속 전분을 가장 빨리 결정화(노화)시켜 질기고 푸석하게 만들므로 절대 피합니다." },
      { name: "한 장씩 랩으로 개별 포장", text: "공기 노출과 냉동실 성에로 인한 수분 손실을 막기 위해 빵을 한 장씩 식품용 랩으로 밀착 포장합니다." },
      { name: "지퍼백 이중 밀봉 후 즉시 냉동", text: "포장한 빵을 지퍼백에 한 번 더 밀봉해 즉시 냉동실로 보낸 뒤 먹을 때 자연해동하거나 구워 먹습니다." }
    ],
    en: [
      { name: "Never Refrigerate Bread", text: "Fridge temperatures cause starch retrogradation, making bread crumb stale and hard." },
      { name: "Wrap Slices Individually", text: "Wrap each slice tightly in plastic cling wrap to lock in the moisture and prevent freezer burn." },
      { name: "Double Bag and Freeze", text: "Store wrapped slices in a freezer zip-top bag and freeze instantly. Toast directly from frozen." }
    ]
  },
  'how-to-store-spinach': {
    ko: [
      { name: "씻지 않고 신문지 래핑", text: "물기가 닿으면 쉽게 물러지므로 세척하지 않고 마른 신문지나 키친타월에 둘둘 말아 보관합니다." },
      { name: "뿌리가 아래로 가게 수직 정렬", text: "눕혀두면 식물이 위로 자라려는 스트레스로 쉽게 에너지를 잃고 썩으므로 컵 등에 세워서 냉장 보관합니다." },
      { name: "사과나 바나나 등과 격리", text: "에틸렌 가스에 의해 시금치 잎의 엽록소가 파괴되어 누렇게 뜨므로 에틸렌 방출 과일과 차단 보관합니다." }
    ],
    en: [
      { name: "Wrap with Paper Without Washing", text: "Do not wash before storing. Wrap gently in paper towels or newspaper to regulate humidity." },
      { name: "Store Spinach Vertically Roots Down", text: "Keep spinach upright in the fridge drawer to prevent horizontal gravity stress and wilting." },
      { name: "Isolate from Ethylene Emitters", text: "Store away from apples, bananas, and ripe tomatoes to prevent quick yellowing of leaves." }
    ]
  },
  'how-to-store-mushrooms': {
    ko: [
      { name: "보관 전 물 세척 금지", text: "버섯은 스펀지 구조로 물을 흡수하면 금방 조직이 뭉개지고 진액이 나므로 씻지 않고 보관합니다." },
      { name: "종이봉투나 키친타월 밀봉", text: "비닐 밀봉 시 호흡으로 인해 결로가 생겨 상하므로 수분을 머금어주는 종이봉투나 타월로 감쌉니다." },
      { name: "눌림 없이 야채칸 상단 보관", text: "조직이 연해 무거운 식품 아래 깔리면 세포벽이 터져 검게 변하므로 맨 위나 눌리지 않는 곳에 둡니다." }
    ],
    en: [
      { name: "Never Wash Before Storing", text: "Mushrooms act like sponges. Surface water causes slimy textures and swift decay. Dry wipe only." },
      { name: "Wrap in a Paper Bag", text: "Wrap in a brown paper bag or paper towels instead of plastic to keep them aerated and dry." },
      { name: "Place on Top Shelf Without Compression", text: "Keep on a top shelf where they won't be crushed by heavy items, protecting cellular structure." }
    ]
  }
};

// 접속 포스트 ID에 맞추어 매칭되는 HowTo 구조화 스키마를 동적으로 렌더링
const matchedHowToKey = Object.keys(howToData).find(key => post.id.includes(key));
if (matchedHowToKey) {
  const steps = howToData[matchedHowToKey][lang === 'ko' ? 'ko' : 'en'] || howToData[matchedHowToKey]['en'];
  structuredDataList.push({
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": title,
    "description": description,
    "image": heroImage ? new URL(heroImage, Astro.site).href : undefined,
    "step": steps.map((step, idx) => ({
      "@type": "HowToStep",
      "name": step.name,
      "text": step.text,
      "url": `${formattedUrl}#step-${idx + 1}`
    }))
  });
}

const formattedDate = new Date(pubDate).toLocaleDateString(lang === 'ko' ? 'ko-KR' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

// 앱 타입별 테마 스타일링 바인딩
const themeAccents = {
  storeself: 'prose-a:text-emerald-600 dark:prose-a:text-emerald-400 hover:prose-a:text-emerald-700 dark:hover:prose-a:text-emerald-300 border-emerald-500/10 dark:border-emerald-500/20 bg-emerald-500/5',
  freshself: 'prose-a:text-purple-600 dark:prose-a:text-purple-400 hover:prose-a:text-purple-700 dark:hover:prose-a:text-purple-300 border-purple-500/10 dark:border-purple-500/20 bg-purple-500/5',
  buildself: 'prose-a:text-indigo-600 dark:prose-a:text-indigo-400 hover:prose-a:text-indigo-700 dark:hover:prose-a:text-indigo-300 border-indigo-500/10 dark:border-indigo-500/20 bg-indigo-500/5',
  general: 'prose-a:text-teal-600 dark:prose-a:text-teal-400 hover:prose-a:text-teal-700 dark:hover:prose-a:text-teal-300 border-teal-500/10 dark:border-teal-500/20 bg-teal-500/5'
};
const activeAccent = themeAccents[app] || themeAccents.general;
---

<Layout 
  title={title} 
  lang={lang as string} 
  description={description} 
  appId={app} 
  image={heroImage}
  ogType="website"
  structuredData={structuredDataList}
>
  <main class="max-w-[760px] mx-auto px-6 py-12 md:py-20">
    <!-- Breadcrumb -->
    <nav class="flex text-xs font-semibold text-slate-500 mb-8" aria-label="Breadcrumb">
      <ol class="inline-flex items-center space-x-1 md:space-x-2">
        <li class="inline-flex items-center">
          <a href={`/${lang}/`} class="hover:text-slate-900 dark:hover:text-white transition-colors">Home</a>
        </li>
        <li>
          <div class="flex items-center">
            <span class="mx-2 text-slate-400 dark:text-slate-700">/</span>
            <a href={`/${lang}/blog/`} class="hover:text-slate-900 dark:hover:text-white transition-colors">Blog</a>
          </div>
        </li>
        <li aria-current="page">
          <div class="flex items-center">
            <span class="mx-2 text-slate-400 dark:text-slate-700">/</span>
            <span class="text-slate-400 dark:text-slate-500 max-w-[200px] md:max-w-xs truncate">{title}</span>
          </div>
        </li>
      </ol>
    </nav>

    <!-- Article Header -->
    <header class="space-y-6 mb-12">
      <div class="space-y-3">
        <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-tight">
          {title}
        </h1>
        <div class="flex items-center gap-4 text-xs font-bold text-slate-400 dark:text-slate-500 pt-1">
          <time datetime={new Date(pubDate).toISOString()}>{formattedDate}</time>
          <span>•</span>
          <span class="capitalize tracking-widest text-emerald-600 dark:text-emerald-400">{app}</span>
        </div>
      </div>

      {heroImage && (
        <div class="relative rounded-[2rem] overflow-hidden border border-slate-200/80 dark:border-white/10 bg-slate-100 dark:bg-slate-950/20 shadow-xl dark:shadow-2xl max-h-[420px] md:max-h-[480px] aspect-video flex items-center justify-center">
          {/* Blurred background shadow for aesthetic depth */}
          <img 
            src={heroImage} 
            alt=""
            class="absolute inset-0 w-full h-full object-cover blur-3xl opacity-25 dark:opacity-35 pointer-events-none scale-105"
            aria-hidden="true"
          />
          {/* Main Contain Image to prevent cutting */}
          <img 
            src={heroImage} 
            alt={title}
            class="relative z-10 max-h-[420px] md:max-h-[480px] w-auto object-contain mx-auto"
          />
        </div>
      )}
    </header>

    <!-- YouTube Shorts Embed Section (Interactive & Cinematic) -->
    {youtubeId && (
      <div class={`p-6 md:p-8 rounded-[2rem] border ${activeAccent} mb-12 flex flex-col md:flex-row items-center gap-8 justify-between shadow-sm dark:shadow-none`}>
        <div class="space-y-4 max-w-sm text-center md:text-left">
          <span class="px-2.5 py-1 rounded-full bg-red-600 text-white font-bold text-[10px] tracking-widest uppercase">YOUTUBE SHORTS</span>
          <h4 class="text-xl font-extrabold text-slate-900 dark:text-white leading-snug tracking-tight">
            {lang === 'ko' ? '1분 영상 꿀팁으로 크게 보기 🎬' : 'Watch the 1-Min Quick Tip in HD! 🎬'}
          </h4>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed font-medium">
            {lang === 'ko' 
              ? '바나나 보관 꿀팁의 전체 과정을 요약한 공식 쇼츠 영상입니다. 이미지를 클릭하시면 선명한 전체 화면으로 감상하실 수 있습니다.' 
              : 'Official shorts summarizing the quick banana hacks. Click the card to open in cinematic full screen!'}
          </p>
        </div>
        <div class="w-full md:w-auto flex justify-center shrink-0">
          <YoutubeEmbed id={youtubeId} title={title} isShorts={true} app={app} />
        </div>
      </div>
    )}

    <!-- Article Body (Refined Premium Typography) -->
    <article class={`prose prose-slate dark:prose-invert max-w-none mb-16 tracking-tight text-slate-800/95 dark:text-slate-200/95 ${themeAccents[app] || ''}
      prose-headings:text-slate-900 dark:prose-headings:text-white prose-headings:font-extrabold prose-headings:tracking-tight
      prose-h2:text-2xl prose-h2:md:text-3xl prose-h2:mt-14 prose-h2:mb-6 prose-h2:pb-3.5 prose-h2:border-b prose-h2:border-slate-200/80 dark:prose-h2:border-white/5
      prose-h3:text-lg prose-h3:md:text-xl prose-h3:mt-10 prose-h3:mb-4
      prose-p:my-5 prose-p:text-[16px] prose-p:md:text-[17px] prose-p:leading-[1.75] prose-p:text-slate-700 dark:prose-p:text-slate-300
      prose-strong:text-slate-900 dark:prose-strong:text-white prose-strong:font-extrabold
      prose-hr:my-12 prose-hr:border-slate-200 dark:prose-hr:border-white/5
      prose-ul:list-none prose-ul:pl-0 prose-ul:my-6
      prose-li:relative prose-li:pl-7 prose-li:my-3 prose-li:text-[15px] prose-li:md:text-[16px] prose-li:text-slate-700 dark:prose-li:text-slate-300
      prose-li:before:content-["•"] prose-li:before:absolute prose-li:before:left-2 prose-li:before:text-emerald-500 prose-li:before:font-extrabold prose-li:before:text-lg
      prose-blockquote:border-l-4 prose-blockquote:border-emerald-500 prose-blockquote:bg-emerald-500/5 prose-blockquote:py-5 prose-blockquote:px-7 prose-blockquote:rounded-r-3xl prose-blockquote:my-8 prose-blockquote:text-slate-700 dark:prose-blockquote:text-slate-300 prose-blockquote:not-italic`}>
      <Content />
    </article>

    <!-- App Promotion CTA Banner -->
    <div class="pt-10 border-t border-slate-200 dark:border-white/10 space-y-4">
      <BlogAppCta lang={lang as string} app={app} />
      {app === 'storeself' && (
        <BlogAppCta lang={lang as string} app="freshself" />
      )}
    </div>
  </main>

  <!-- Shared Popup Modal Component (Rule 5 compliance) -->
  <ShortsPlayerModal lang={lang} />
</Layout>

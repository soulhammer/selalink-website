    ]
  },
  'how-to-store-green-onions': {
    ko: [
      { name: "씻지 않은 대파 세워 보관", text: "물기를 건조하게 유지하기 위해 신문지에 감싸 뿌리가 밑으로 향하게 그늘에 세워서 보관합니다." },
      { name: "밀폐용기 바닥 키친타월 활용", text: "세척한 대파는 물기를 완벽히 말린 후 꼭지가 아래로 가게 통에 담고 밑에 키친타월을 깔어 냉장 보관합니다." },
      { name: "장기 보관 시 냉동 소분", text: "썰어서 물기를 완전히 말린 후 지퍼백에 밀봉해 얼려두고 요리 시 바로 꺼내 씁니다." }
    ],
    en: [
      { name: "Store Unwashed Green Onions Upright", text: "Wrap in newspaper and store upright with roots down in a cool place to reduce stress." },
      { name: "Keep in Container with Paper Towels", text: "For washed onions, dry them completely, lay a paper towel in a bin, and store them standing upright." },

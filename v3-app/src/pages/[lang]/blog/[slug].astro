    en: [
      { name: "Wrap Individually Without Washing", text: "Wrap each unwashed apple tightly with plastic wrap to prevent moisture loss and block ethylene." },
      { name: "Store at Low Temperature", text: "Store wrapped apples in the refrigerator crisper drawer (0-4°C) to delay respiration and aging." },

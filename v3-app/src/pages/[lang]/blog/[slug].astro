      { name: "뾰족한 쪽을 아래로 정렬", text: "둥근 쪽에 기실(공기주머니)이 있어 숨을 쉴 수 있도록 둥근 부위를 위로, 뾰족한 부위를 아래로 하여 세워 둡니다." },
      { name: "냉장실 안쪽 보관", text: "온도 변화가 잦고 충격이 있는 냉장실 문 쪽을 피하고 본체 안쪽 깊숙한 선반에 보관합니다." }
    ],
    en: [
      { name: "Never Wash Eggs", text: "Washing strips the protective cuticle layer, letting salmonella enter. Wipe dirt with a dry cloth." },
      { name: "Pointy End Downward", text: "Keep the round end containing the air pocket upward so the egg can breathe and stay centered." },
      { name: "Store on Inside Fridge Shelf", text: "Place eggs in their carton on a stable inner shelf to avoid temperature shifts from the door." }
    ]
  },
  'how-to-store-onions': {
    ko: [
      { name: "껍질째 통풍망에 보관", text: "수분을 방지하고 공기 순환을 돕기 위해 그물망이나 스타킹에 넣어 서늘한 그늘에 매달아 보관합니다." },
      { name: "깐 양파는 물기 말려 랩핑", text: "손질된 양파는 표면 물기를 완벽히 건조시킨 뒤 식품용 랩으로 개별 밀봉해 냉장 야채칸에 보관합니다." },
      { name: "감자와 완벽 격리 보관", text: "감자의 수분과 양파의 에틸렌 가스가 서로를 썩게 하므로 절대 같은 상자나 가까이 두지 않습니다." }
    ],
    en: [
      { name: "Store in a Well-Ventilated Net", text: "Keep whole unpeeled onions in a hanging mesh bag in a dry, dark pantry to ensure air flow." },
      { name: "Dry and Wrap Peeled Onions", text: "Wipe surface moisture off peeled onions and wrap tightly in cling wrap before refrigerating." },
      { name: "Isolate from Potatoes", text: "Never store together as potato moisture and onion ethylene gas accelerate mutual rotting." }
    ]
  },
  'how-to-store-tomatoes': {
    ko: [
      { name: "완숙 전 상온 그늘 보관", text: "설익은 토마토를 냉장하면 풍미 성분이 파괴되므로 15~20℃ 통풍이 잘되는 상온 그늘에서 후숙시킵니다." },
      { name: "보관 전 꼭지 떼어내기", text: "초록색 꼭지 부위는 습기가 차고 곰팡이가 쉽게 발생하므로 보관하기 전에 꼭지를 미리 뗍니다." },
      { name: "완숙 토마토만 야채칸 냉장", text: "완전한 적색으로 익은 토마토만 서로 닿지 않게 종이나 랩으로 감싸 냉장고 야채칸에 보관합니다." }
    ],
    en: [
      { name: "Store at Room Temp Before Ripe", text: "Keep firm or green tomatoes at room temperature to let lycopene and sugars mature naturally." },
      { name: "Remove Green Stems", text: "Remove the green stems before storing to prevent mold from developing on the damp stem base." },

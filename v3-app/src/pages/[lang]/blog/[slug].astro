    en: [
      { name: "Wrap Potatoes Individually", text: "Wrap each unwashed potato in newspaper or paper bags to control humidity and block light." },
      { name: "Store with 1 Apple", text: "Put one apple inside the potato box to let ethylene gas suppress potato sprouting hormones." },

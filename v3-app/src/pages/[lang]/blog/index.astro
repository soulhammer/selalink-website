---
import Layout from '../../../layouts/Layout.astro';
import BlogPostCard from '../../../components/BlogPostCard.astro';
import { getCollection } from 'astro:content';
import { useTranslations, languages } from '../../../i18n/ui';

// 식재료 데이터 임포트
import { condimentIngredients } from '../../../data/ingredients/condiment';
import { dairyIngredients } from '../../../data/ingredients/dairy';
import { etcIngredients } from '../../../data/ingredients/etc';
import { fruitIngredients } from '../../../data/ingredients/fruit';
import { grainIngredients } from '../../../data/ingredients/grain';
import { meatIngredients } from '../../../data/ingredients/meat';
import { seafoodIngredients } from '../../../data/ingredients/seafood';
import { vegetableIngredients } from '../../../data/ingredients/vegetable';

const allIngredients = [
  ...condimentIngredients,
  ...dairyIngredients,
  ...etcIngredients,
  ...fruitIngredients,
  ...grainIngredients,
  ...meatIngredients,
  ...seafoodIngredients,
  ...vegetableIngredients,
];

const blogToIngMap: Record<string, string> = {
  'how-to-store-apples': 'apple',
  'how-to-store-avocado': 'avocado',
  'how-to-store-bananas': 'banana',
  'how-to-store-beef': 'beef',
  'how-to-store-bread': 'bread',
  'how-to-store-chicken': 'chicken',
  'how-to-store-eggs': 'egg',
  'how-to-store-garlic': 'garlic',
  'how-to-store-green-onions': 'green-onion',
  'how-to-store-milk': 'milk',
  'how-to-store-mushrooms': 'mushroom',
  'how-to-store-nuts': 'nuts',
  'how-to-store-olive-oil': 'olive-oil',
  'how-to-store-onions': 'onion',
  'how-to-store-perilla-oil': 'perilla-oil',
  'how-to-store-potatoes': 'potato',
  'how-to-store-salmon': 'salmon',
  'how-to-store-spinach': 'spinach',
  'how-to-store-squid': 'squid',
  'how-to-store-tofu': 'tofu',
  'how-to-store-tomatoes': 'tomato',
  'how-to-store-watermelon': 'watermelon'
};

const getIngredientName = (postId: string, lang: string) => {
  const slug = postId.split('/').pop() || '';
  const ingId = blogToIngMap[slug];
  if (!ingId) return '';
  const ing = allIngredients.find((i) => i.id === ingId);
  if (!ing) return '';
  return ing.names[lang as any] || ing.names['en'] || '';
};

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
const normalizedLang = lang as string;
const t = useTranslations(normalizedLang as any);

// 전체 블로그 로드 및 언어 필터링
const allPosts = await getCollection('blog');
const filteredPosts = allPosts
  .filter((post) => {
    // id가 'ko/how-to-store-bananas' 형태이므로 앞 폴더명으로 언어 구별
    return post.id.startsWith(normalizedLang + '/');
  })
  .sort((a, b) => {
    const dateA = a.data.updatedDate ? new Date(a.data.updatedDate).getTime() : new Date(a.data.pubDate).getTime();
    const dateB = b.data.updatedDate ? new Date(b.data.updatedDate).getTime() : new Date(b.data.pubDate).getTime();
    return dateB - dateA;
  });

const title = t('blog.title');
const description = t('blog.desc');

const loadMoreTranslations: Record<string, string> = {
  ko: "더보기",
  ja: "もっと見る",
  zh: "加载更多",
  en: "Load More",
  es: "Cargar más",
  fr: "Charger plus",
  de: "Mehr laden",
  pt: "Carregar mais",
  id: "Muat lebih banyak"
};
const loadMoreText = loadMoreTranslations[normalizedLang] || loadMoreTranslations['en'];
---

<Layout title={title} lang={normalizedLang} description={description} appId="studio">
  <main class="max-w-[1200px] mx-auto px-6 py-16 md:py-24">
    <div class="space-y-4 text-center max-w-2xl mx-auto mb-12 md:mb-16">
      <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-[11px] font-bold bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border border-indigo-500/20 tracking-wider uppercase">
        ✨ {t('blog.badge.lifestyle')}
      </span>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        {t('blog.heading')}
      </h1>
      <p class="text-slate-600 dark:text-slate-400 text-base md:text-lg leading-relaxed max-w-xl mx-auto">
        {description}
      </p>
    </div>

    {filteredPosts.length > 0 ? (
      <>
        {/* 카테고리 필터 탭 */}
        <div class="flex flex-wrap items-center justify-center gap-2.5 mb-8">
          <button 
            type="button"
            data-filter="all" 
            class="filter-btn px-6 py-2.5 rounded-full text-xs font-bold border transition-all duration-300 shadow-sm cursor-pointer bg-slate-900 border-slate-900 text-white dark:bg-white dark:border-white dark:text-slate-900"
          >
            ✨ {t('blog.filter.all')}
          </button>
          <button 
            type="button"
            data-filter="freshsnap" 
            class="filter-btn px-6 py-2.5 rounded-full text-xs font-bold border border-slate-200 bg-white/50 text-slate-600 hover:border-emerald-500/30 hover:bg-emerald-500/5 hover:text-emerald-600 dark:border-white/5 dark:bg-slate-900/40 dark:text-slate-300 dark:hover:border-emerald-500/30 dark:hover:bg-emerald-500/10 dark:hover:text-emerald-400 transition-all duration-300 shadow-sm cursor-pointer"
          >
            🥬 {t('blog.filter.freshsnap')}
          </button>
          <button 
            type="button"
            class="filter-btn px-5 py-2.5 rounded-full text-xs font-bold border border-slate-200 bg-white/50 text-slate-700 hover:border-teal-500/30 hover:bg-teal-500/5 hover:text-teal-600 dark:border-white/5 dark:bg-slate-950/40 dark:text-slate-400 dark:hover:border-teal-500/30 dark:hover:bg-teal-500/10 dark:hover:text-teal-400 transition-all duration-300 shadow-sm cursor-pointer"
            data-filter="buildself"
          >
            🏆 {t('blog.filter.buildself')}
          </button>
          <button 
            type="button"
            class="filter-btn px-5 py-2.5 rounded-full text-xs font-bold border border-slate-200 bg-white/50 text-slate-700 hover:border-rose-500/30 hover:bg-rose-500/5 hover:text-rose-600 dark:border-white/5 dark:bg-slate-950/40 dark:text-slate-400 dark:hover:border-rose-500/30 dark:hover:bg-rose-500/10 dark:hover:text-rose-400 transition-all duration-300 shadow-sm cursor-pointer"
            data-filter="petself"
          >
            🐾 {t('blog.filter.petself')}
          </button>
        </div>

        {/* 세련된 Glassmorphism 검색 제어 패널 */}
        <div class="mb-6 p-5 rounded-[2rem] border border-slate-200/60 bg-white/60 dark:border-white/5 dark:bg-slate-900/40 backdrop-blur-md flex flex-col sm:flex-row gap-4 items-center justify-between shadow-sm">
          {/* 검색어 입력 */}
          <div class="relative w-full sm:max-w-md animate-focus-container">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400 dark:text-slate-500">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
            <input 
              type="text" 
              id="blog-search-input"
              placeholder={t('blog.search.placeholder')}
              class="w-full pl-11 pr-10 py-3 rounded-2xl border border-slate-200 bg-white/50 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-500/20 focus:border-slate-500 dark:border-white/10 dark:bg-slate-950/40 dark:text-white dark:placeholder-slate-500 dark:focus:ring-slate-500/20 transition-all duration-200 text-sm"
            />
            <button 
              id="blog-search-clear" 
              type="button"
              class="hidden absolute inset-y-0 right-0 pr-4 flex items-center text-slate-400 hover:text-slate-600 dark:text-slate-500 dark:hover:text-slate-300 cursor-pointer"
            >
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>

          {/* 정렬 드롭다운 */}
          <div class="relative w-full sm:w-auto min-w-[160px]">
            <select 
              id="blog-sort-select"
              class="w-full appearance-none pl-4 pr-10 py-3 rounded-2xl border border-slate-200 bg-white/50 text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-500/20 focus:border-slate-500 dark:border-white/10 dark:bg-slate-950/40 dark:text-white dark:focus:ring-slate-500/20 transition-all duration-200 text-sm font-medium cursor-pointer"
            >
              <option value="latest">{t('blog.sort.latest')}</option>
              <option value="oldest">{t('blog.sort.oldest')}</option>
            </select>
            <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none text-slate-400 dark:text-slate-500">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </div>
        </div>

        {/* 결과 개수 표시 메타 정보 */}
        <div class="mb-6 px-2 flex items-center justify-between">
          <span id="blog-search-count" class="text-xs font-semibold text-slate-500 dark:text-slate-400 tracking-wide"></span>
        </div>

        <div id="blog-posts-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {filteredPosts.map((post) => {
            const ingName = getIngredientName(post.id, normalizedLang);
            return <BlogPostCard post={post} lang={normalizedLang} ingredientName={ingName} />;
          })}
        </div>

        {/* 더보기 버튼 */}
        <div id="blog-load-more-container" class="mt-12 flex justify-center">
          <button
            id="blog-load-more-btn"
            type="button"
            class="px-8 py-3.5 rounded-full text-sm font-bold border border-slate-200 bg-white/50 text-slate-700 hover:border-indigo-500/30 hover:bg-indigo-500/5 hover:text-indigo-600 dark:border-white/5 dark:bg-slate-900/40 dark:text-slate-300 dark:hover:border-indigo-500/30 dark:hover:bg-indigo-500/10 dark:hover:text-indigo-400 transition-all duration-300 shadow-sm cursor-pointer"
          >
            {loadMoreText}
          </button>
        </div>

        {/* 검색 결과 없음 Empty State */}
        <div id="blog-empty-state" class="hidden text-center py-24 border border-slate-200/60 dark:border-white/5 rounded-3xl bg-slate-500/5 dark:bg-slate-900/10">
          <span class="text-4xl mb-4 block">🔍</span>
          <p class="text-slate-500 dark:text-slate-400 font-medium">
            {t('blog.empty')}
          </p>
        </div>
      </>
    ) : (
      <div class="text-center py-24 border border-slate-200/60 dark:border-white/5 rounded-3xl bg-slate-500/5 dark:bg-slate-900/10">
        <span class="text-4xl mb-4 block">📭</span>
        <p class="text-slate-500 dark:text-slate-400 font-medium">
          {t('blog.empty')}
        </p>
      </div>
    )}
  </main>
</Layout>

<script src="../../../utils/blogIndex.ts"></script>

<style is:global>
  .blog-card-transition {
    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    opacity: 1;
    transform: scale(1);
  }
  .blog-card-hidden {
    opacity: 0 !important;
    transform: scale(0.95) !important;
    pointer-events: none !important;
    position: absolute !important;
    width: 0 !important;
    height: 0 !important;
    overflow: hidden !important;
    margin: 0 !important;
    padding: 0 !important;
    border: none !important;
  }
</style>

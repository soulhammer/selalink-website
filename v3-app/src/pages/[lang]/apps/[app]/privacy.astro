---
import Layout from '../../../../layouts/Layout.astro';
import { useTranslations, languages } from '../../../../i18n/ui';
import { appsLegalData } from '../../../../data/appsLegalData';

export function getStaticPaths() {
  const locales = Object.keys(languages);
  const apps = Object.keys(appsLegalData);
  
  return locales.flatMap((lang) => 
    apps.map((app) => ({
      params: { lang, app }
    }))
  );
}

const { lang, app } = Astro.params;
const t = useTranslations(lang as keyof typeof languages);

const appData = appsLegalData[app as string];
if (!appData) {
  return Astro.redirect('/404');
}

const isKo = lang === 'ko';
const title = isKo ? appData.privacy.title.ko : appData.privacy.title.en;
const privacyHtml = isKo ? appData.privacy.contentKo : appData.privacy.contentEn;

// 앱별 동적 테마 컬러 설정
const themeAccents: Record<string, string> = {
  buildself: '#0D9488', // Teal
  freshself: '#8B5CF6', // Purple
  logself: '#6366F1',   // Indigo
  general: '#14B8A6'
};
const accentColor = themeAccents[app as string] || themeAccents.general;

// 앱별 텍스트 컬러 스타일 클래스
const textColors: Record<string, string> = {
  buildself: 'text-[var(--theme-accent,#0D9488)]',
  freshself: 'text-[var(--theme-accent,#8B5CF6)]',
  logself: 'text-[var(--theme-accent,#6366F1)]'
};
const activeTextColor = textColors[app as string] || 'text-teal-600';
---

<Layout 
  title={`${title} | ${app}`} 
  lang={lang as string} 
  robots="noindex, follow" 
  appId={app === 'general' ? undefined : app}
>
  <main class="w-full min-h-screen pt-32 pb-24 px-6">
    <div class="max-w-3xl mx-auto flex flex-col items-start gap-8">
      <a href={`/${lang}/apps/${app}`} class={`group inline-flex items-center space-x-2 ${activeTextColor} hover:opacity-80 transition-opacity duration-300`}>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:-translate-x-1 transition-transform">
          <path d="m15 18-6-6 6-6"/>
        </svg>
        <span class="text-sm font-medium tracking-wide">{appData.privacy.backToText}</span>
      </a>
      
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        {title}
      </h1>
      
      <div class="w-full h-px bg-slate-200 dark:bg-slate-800 mt-4 mb-4"></div>
      
      <div 
        class="privacy-content max-w-none w-full leading-relaxed font-light text-[0.95rem] space-y-4"
        style={`--theme-accent: ${accentColor};`}
      >
        <Fragment set:html={privacyHtml} />
      </div>
    </div>
  </main>
</Layout>

<style is:global>
  /* 라이트 모드 (기본) */
  .privacy-content p,
  .privacy-content li {
    color: #44403c !important; /* stone-700 */
    margin-bottom: 0.5rem;
  }
  .privacy-content strong {
    color: #1c1917 !important; /* stone-900 */
    font-weight: 700 !important;
    display: inline-block;
    margin-top: 1rem;
    margin-bottom: 0.25rem;
  }
  .privacy-content strong:first-of-type {
    margin-top: 0;
  }
  .privacy-content a {
    color: var(--theme-accent, #059669) !important;
    text-decoration: underline;
  }
  .privacy-content ul {
    list-style-type: disc !important;
    padding-left: 1.5rem !important;
    margin-bottom: 1rem !important;
    margin-top: 0.5rem !important;
  }

  /* 다크 모드 */
  html.dark .privacy-content p,
  html.dark .privacy-content li {
    color: #d6d3d1 !important; /* stone-300 */
  }
  html.dark .privacy-content strong {
    color: #fafaf9 !important; /* stone-50 */
    font-weight: 700 !important;
  }
  html.dark .privacy-content a {
    color: var(--theme-accent, #34d399) !important;
  }
</style>

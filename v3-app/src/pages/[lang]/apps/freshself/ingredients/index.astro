const t = (key: string) => {
  return localTranslations[currentLang]?.[key] || localTranslations['en']?.[key] || key;
};

// 공식 출처 다국어 번역 사전 (검색 인덱스 확장을 위함)
const sourceTranslations: Record<string, Record<string, string>> = {
  ko: {
    'source.MFDS': '식품의약품안전처 식약처',
    'source.RDA': '농촌진흥청 농진청',
    'source.USDA': '미국 농무부 USDA',
    'source.EFSA': '유럽식품안전청 EFSA',
    'source.FSA': '영국 식품기준청 FSA',
    'source.CDC': '미국 질병통제예방센터 CDC',
    'source.KCA': '한국소비자원 소비자원',
    'source.NIFS': '국립수산과학원 수산과학원',
    'source.WHO': '세계보건기구 WHO FAO'
  },
  en: {
    'source.MFDS': 'MFDS Ministry of Food and Drug Safety',
    'source.RDA': 'RDA Rural Development Administration',
    'source.USDA': 'USDA U.S. Department of Agriculture',
    'source.EFSA': 'EFSA European Food Safety Authority',
    'source.FSA': 'FSA Food Standards Agency',
    'source.CDC': 'CDC Centers for Disease Control and Prevention',
    'source.KCA': 'KCA Korea Consumer Agency',
    'source.NIFS': 'NIFS National Institute of Fisheries Science',
    'source.WHO': 'WHO World Health Organization FAO'
  }
};

// 현재 로케일에 최적화된 식재료 정보 생성
const localizedIngredients = ingredients.map((item) => {
  const localName = item.names[currentLang] || item.names['en'];
  
  // 추천 보관 방식 결정 (상세 페이지와 동일)
  const getRecommendedMethod = () => {
    if (item.storage.fridge && item.storage.fridge.durationDays > 0) return 'fridge';
    if (item.storage.room && item.storage.room.durationDays > 0) return 'room';
    if (item.storage.freezer && item.storage.freezer.durationDays > 0) return 'freezer';
    return item.storage.fridge ? 'fridge' : (item.storage.room ? 'room' : 'freezer');
  };
  
  const recommendedMethod = getRecommendedMethod();
  const guide = item.storage[recommendedMethod];
  const sources = guide?.sources || [];
  
  // 검색 인덱스에 출처 다국어 명칭 및 약어 추가 (기획안 C)
  let sourceKeywords = sources.join(' ');
  sources.forEach((src) => {
    const koText = sourceTranslations['ko']?.[`source.${src}`] || '';
    const enText = sourceTranslations['en']?.[`source.${src}`] || '';
    sourceKeywords += ` ${koText} ${enText}`;
  });
  
  return {
    ...item,
    localName,
    recommendedMethod,
    sources,
    // 검색 인덱스를 위한 키워드 결합
    searchIndex: `${localName.toLowerCase()} ${item.id} ${item.category} ${item.searchKeywords?.join(' ') || ''} ${sourceKeywords.toLowerCase()}`
  };
});

const categories = [
  'all',
  'vegetable',
  'fruit',
  'dairy',
  'meat',
  'seafood',
  'grain',
  'condiment',
  'etc'
];

const categoryCounts = categories.reduce((acc, cat) => {
  if (cat === 'all') {
    acc[cat] = ingredients.length;
  } else {
    acc[cat] = ingredients.filter((item) => item.category === cat).length;
  }
  return acc;
}, {} as Record<string, number>);
---

<Layout 
  title={`${t('util.title')} | FreshSelf`} 
  lang={currentLang}
  description={t('util.subtitle')}
  canonicalUrl={`https://selalink.net/${currentLang}/apps/freshself/ingredients/`}
  ogType="website"
  image="/assets/images/og/freshself.png"
  appId="freshself"
>
  <main class="max-w-[1200px] mx-auto px-6 py-12 md:py-24">
    <!-- Hero Section -->
    <div class="text-center mb-12 md:mb-20">
      <h1 class="text-3xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-6 bg-gradient-to-r from-purple-600 to-indigo-600 dark:from-purple-400 dark:to-indigo-400 bg-clip-text text-transparent">
        {t('util.title')}
      </h1>
      <p class="text-lg md:text-xl text-slate-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed">
        {t('util.subtitle')}
      </p>

      <!-- 글로벌 신뢰성 뱃지 그룹 (Trust Badges - 기획안 B) -->
      <div class="flex flex-col items-center gap-3 mt-8 select-none">
        <div class="flex flex-wrap justify-center gap-1.5 max-w-xl">
          {['WHO / FAO', 'EFSA (EU)', 'USDA (U.S.)', 'FSA (UK)', 'MFDS (KR)'].map((org) => (
            <span class="text-[10px] md:text-xs font-bold uppercase tracking-wider bg-slate-100/80 dark:bg-slate-800/40 text-slate-500 dark:text-slate-400 px-3 py-1.5 rounded-full border border-slate-200/40 dark:border-slate-700/40 hover:border-purple-500/30 dark:hover:border-purple-400/30 transition-colors duration-300">
              {org}
            </span>
          ))}
        </div>
        <p class="text-[11px] md:text-xs text-slate-400 dark:text-slate-500 font-medium tracking-tight">
          {t('util.trust.sub')}
        </p>
      </div>
    </div>

    <!-- Search Input & Filters Bento Group -->
    <div class="bento-card p-6 md:p-8 mb-8" style="--glow-color: rgba(139,92,246,0.15);">
      <!-- Search Input Container -->
      <div class="relative max-w-2xl mx-auto mb-6">
        <span class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400 text-lg">
          🔍
        </span>
        <input 
          type="text" 
          id="searchInput" 
          placeholder={t('util.search.placeholder')}
          class="w-full pl-12 pr-4 py-4 rounded-2xl bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/80 text-base md:text-lg focus:outline-none focus:ring-2 focus:ring-purple-500 transition-all font-medium text-slate-800 dark:text-slate-100"
        />
      </div>

      <!-- Categories Filter Slider -->
      <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none scroll-smooth">
        {categories.map((cat) => (
          <button
            data-category={cat}
            class={`category-btn flex items-center gap-1.5 px-4 py-2 rounded-xl text-sm font-semibold cursor-pointer whitespace-nowrap transition-all duration-300 border ${
              cat === 'all' 
                ? 'bg-purple-600 border-purple-600 text-white shadow-md shadow-purple-600/20' 
                : 'bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 hover:border-purple-500 dark:hover:border-purple-500'
            }`}
          >
            <span>{t(`util.category.${cat}`)}</span>
            <span class={`count-badge px-1.5 py-0.5 text-[11px] rounded-md transition-colors ${
              cat === 'all'
                ? 'bg-purple-700/50 text-purple-100'
                : 'bg-slate-100 dark:bg-slate-800/80 text-slate-500 dark:text-slate-400'
            }`}>
              {categoryCounts[cat]}
            </span>
          </button>
        ))}
      </div>
    </div>

    <!-- Grid Container -->
    <div 
      id="ingredientsGrid" 
      class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6 transition-opacity duration-300"
    >
      {localizedIngredients.map((item) => (
        <a 
          href={`/${currentLang}/apps/freshself/ingredients/${item.id}/`}
          data-item-category={item.category}
          data-search-index={item.searchIndex}
          class="ingredient-item bento-card p-5 flex flex-col justify-between group overflow-hidden" 
          style="--glow-color: rgba(139,92,246,0.12);"
        >
          <div class="flex flex-col gap-3">
            {item.iconImage ? (
              <img 
                src={item.iconImage} 
                alt={item.localName}
                class="w-[52px] h-[52px] sm:w-[58px] sm:h-[58px] object-contain group-hover:scale-110 transition-transform duration-300 select-none block"
                loading="lazy"
              />
            ) : (
              <span class="text-4xl sm:text-5xl group-hover:scale-110 transition-transform duration-300 select-none block w-fit">
                {item.emoji}
              </span>
            )}
            <div class="mt-1">
              <h2 class="text-lg md:text-xl font-bold text-slate-800 dark:text-slate-100 group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
                {item.localName}
              </h2>
              <span class="text-xs font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500">
                {t(`util.category.${item.category}`).split(' ').slice(1).join(' ') || t(`util.category.${item.category}`)}
              </span>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-100 dark:border-slate-800/80 flex flex-col gap-2">
            <!-- Storage Durations Badge List & Micro Sources -->
            <div class="flex items-center justify-between gap-1">
              <div class="flex flex-wrap gap-1 text-[11px] font-semibold text-slate-600 dark:text-slate-400">
                {item.storage.room && (
                  <span class="bg-amber-100/60 dark:bg-amber-950/40 text-amber-800 dark:text-amber-300 px-2 py-0.5 rounded-md">
                    {t('util.card.room')} {item.storage.room.durationDays}{t('util.card.days')}
                  </span>
                )}
                {item.storage.fridge && (
                  <span class="bg-emerald-100/60 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300 px-2 py-0.5 rounded-md">
                    {t('util.card.fridge')} {item.storage.fridge.durationDays}{t('util.card.days')}
                  </span>
                )}
                {item.storage.freezer && (
                  <span class="bg-blue-100/60 dark:bg-blue-950/40 text-blue-800 dark:text-blue-300 px-2 py-0.5 rounded-md">
                    {t('util.card.freezer')} {item.storage.freezer.durationDays}{t('util.card.days')}
                  </span>
                )}
              </div>
              
              <!-- 마이크로 출처 뱃지 (평소 opacity-30, 호버 시 opacity-100 및 부드러운 하이라이트 - 기획안 A) -->
              {item.sources && item.sources.length > 0 && (
                <div class="flex gap-0.5 opacity-30 group-hover:opacity-100 transition-opacity duration-300 select-none shrink-0">
                  {item.sources.slice(0, 2).map((src) => (
                    <span class="text-[9px] font-extrabold uppercase tracking-tight bg-slate-100 dark:bg-slate-800/80 text-slate-400 dark:text-slate-500 group-hover:text-purple-600 dark:group-hover:text-purple-400 group-hover:border-purple-500/20 px-1.5 py-0.5 rounded border border-slate-200/20 dark:border-slate-700/20 transition-colors duration-300">
                      {src}
                    </span>
                  ))}
                </div>
              )}
            </div>
            
            <div class="text-xs font-bold text-purple-600 dark:text-purple-400 flex items-center gap-1 mt-1 opacity-0 group-hover:opacity-100 translate-x-[-5px] group-hover:translate-x-0 transition-all duration-300">
              {t('util.card.view')}
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Empty State -->
    <div id="emptyState" class="hidden text-center py-16">
      <span class="text-5xl block mb-4">🫙</span>
      <p class="text-lg text-slate-500 dark:text-slate-400">{t('util.no_results')}</p>
    </div>

    <!-- Legal Disclaimer (법적 면책 조항 고지) -->
    <div class="mt-16 p-6 rounded-2xl bg-slate-100/50 dark:bg-slate-900/30 border border-slate-200/50 dark:border-slate-800/50 max-w-3xl mx-auto flex items-start gap-3 select-none">
      <span class="text-base text-slate-400 dark:text-slate-500 shrink-0">ℹ️</span>
      <p class="text-xs md:text-sm text-slate-500 dark:text-slate-400 leading-relaxed text-left">
        {t('util.disclaimer')}
      </p>
    </div>
  </main>

  <script>
    // Client-side search and filtering logic
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    const categoryButtons = document.querySelectorAll('.category-btn');
    const ingredientItems = document.querySelectorAll('.ingredient-item') as NodeListOf<HTMLElement>;
    const emptyState = document.getElementById('emptyState') as HTMLElement;
    const grid = document.getElementById('ingredientsGrid') as HTMLElement;

    let activeCategory = 'all';
    let searchQuery = '';

    const filterIngredients = () => {
      let visibleCount = 0;

      ingredientItems.forEach((item) => {
        const cat = item.getAttribute('data-item-category') || '';
        const searchIndex = item.getAttribute('data-search-index') || '';
        
        const matchesCategory = activeCategory === 'all' || cat === activeCategory;
        const matchesSearch = searchIndex.includes(searchQuery);

        if (matchesCategory && matchesSearch) {
          item.classList.remove('hidden');
          visibleCount++;
        } else {
          item.classList.add('hidden');
        }
      });

      if (visibleCount === 0) {
        emptyState.classList.remove('hidden');
        grid.classList.add('opacity-0');
        setTimeout(() => {
          if (document.getElementById('emptyState')?.classList.contains('hidden') === false) {
            grid.classList.add('hidden');
          }
        }, 150);
      } else {
        emptyState.classList.add('hidden');
        grid.classList.remove('hidden', 'opacity-0');
      }
    };

    // Search Input Event
    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
      filterIngredients();
    });

    // Category Button Click Events
    categoryButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        // Toggle active states
        categoryButtons.forEach((b) => {
          b.classList.remove('bg-purple-600', 'border-purple-600', 'text-white', 'shadow-md', 'shadow-purple-600/20');
          b.classList.add('bg-white', 'dark:bg-slate-900', 'border-slate-200', 'dark:border-slate-800', 'text-slate-700', 'dark:text-slate-300');
        });

        btn.classList.remove('bg-white', 'dark:bg-slate-900', 'border-slate-200', 'dark:border-slate-800', 'text-slate-700', 'dark:text-slate-300');
        btn.classList.add('bg-purple-600', 'border-purple-600', 'text-white', 'shadow-md', 'shadow-purple-600/20');

        activeCategory = btn.getAttribute('data-category') || 'all';
        filterIngredients();
      });
    });

    // Spatial Glow hydration logic for dynamically updated layouts
    document.querySelectorAll('.bento-card').forEach((card) => {
      let glow = card.querySelector('.bento-glow');
      if (!glow) {
        glow = document.createElement('div');
        glow.className = 'bento-glow';
        card.prepend(glow);
      }
      
      card.addEventListener('mousemove', (e: any) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        (glow as HTMLElement).style.setProperty('--mouse-x', `${x}px`);
        (glow as HTMLElement).style.setProperty('--mouse-y', `${y}px`);
      });
    });
  </script>
</Layout>

<style>
  /* Hide scrollbar for category filter slider */
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-none {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }
  
  /* Active state for badge inside active button */
  .category-btn.bg-purple-600 .count-badge {
    background-color: rgba(255, 255, 255, 0.2) !important;
    color: #ffffff !important;
  }
</style>

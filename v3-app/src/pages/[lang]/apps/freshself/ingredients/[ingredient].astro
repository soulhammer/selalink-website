    'source.KCA': '한국소비자원',
    'source.NIFS': '국립수산과학원',
    'source.WHO': '세계보건기구 (WHO/FAO)',
    'detail.source.label': '공식 정보 출처'
  },
  en: {
    'source.MFDS': 'MFDS (Korea)',
    'source.RDA': 'RDA (Korea)',
    'source.USDA': 'USDA (U.S.)',
    'source.EFSA': 'EFSA (EU)',
    'source.FSA': 'FSA (UK)',
    'source.CDC': 'CDC (U.S.)',
    'source.KCA': 'KCA (Korea)',
    'source.NIFS': 'NIFS (Korea)',
    'source.WHO': 'WHO / FAO',
    'detail.source.label': 'Official Reference Source'
  },
  ja: {
    'source.MFDS': '韓国食品医薬品安全処',
    'source.RDA': '韓国農村振興庁',
    'source.USDA': '米国農務省 (USDA)',
    'source.EFSA': '欧州食品安全機関 (EFSA)',
    'source.FSA': '英国食品基準庁 (FSA)',
    'source.CDC': '米国疾病予防管理センター (CDC)',

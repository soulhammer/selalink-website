    'detail.source.label': '公式情報源'
  },
  zh: {
    'source.MFDS': '韩国食品医药品安全处',
    'source.RDA': '韩国农村振兴厅',
    'source.USDA': '美国农业部 (USDA)',
    'source.EFSA': '欧洲食品安全局 (EFSA)',
    'source.FSA': '英国食品标准局 (FSA)',
    'source.CDC': '美国疾病控制与预防中心 (CDC)',
    'source.KCA': '韩国消费者院',
    'source.NIFS': '韩国国立水产科学研究院',
    'source.WHO': '世界卫生组织 (WHO/FAO)',
    'detail.source.label': '官方信息来源'
  }
};

const tSource = (key: string) => {
  return sourceTranslations[currentLang]?.[key] || sourceTranslations['en']?.[key] || key;
};

// 추천 보관 방식 결정 우선순위: 냉장 -> 실온 -> 냉동 (기간이 0인 비권장 보관법은 후순위 제외)
const getRecommendedMethod = () => {
  if (currentItem.storage.fridge && currentItem.storage.fridge.durationDays > 0) return 'fridge';
  if (currentItem.storage.room && currentItem.storage.room.durationDays > 0) return 'room';
  if (currentItem.storage.freezer && currentItem.storage.freezer.durationDays > 0) return 'freezer';
  
  // 모두 0일이거나 특수 상황일 때는 구조상 정의된 방식을 반환
  if (currentItem.storage.fridge) return 'fridge';
  if (currentItem.storage.room) return 'room';
  return 'freezer';
};

const recommendedMethod = getRecommendedMethod();
const initialGuide = currentItem.storage[recommendedMethod];
const initialDays = initialGuide?.durationDays || 0;
---

<Layout 
  title={`${localName} - ${t('detail.storage.type')} & ${t('detail.recommend.days')} | FreshSelf`} 
  lang={currentLang}
  description={`${localName}의 올바른 보관 방법과 권장 일수를 확인해보세요.`}
  canonicalUrl={`https://selalink.net/${currentLang}/apps/freshself/ingredients/${currentItem.id}/`}
  ogType="website"
  image="/assets/images/og/freshself.png"
  appId="freshself"
>
  <main class="max-w-[900px] mx-auto px-6 py-12 md:py-20">
    <!-- Back button -->
    <a 
      href={`/${currentLang}/apps/freshself/ingredients/`} 
      class="inline-flex items-center gap-2 text-sm font-semibold text-slate-500 hover:text-purple-600 dark:text-slate-400 dark:hover:text-purple-400 mb-8 transition-colors duration-300"
    >
      {t('detail.back')}
    </a>

    <!-- Bento Header: Ingredient Name -->
    <div class="bento-card p-8 mb-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6" style="--glow-color: rgba(139,92,246,0.15);">
      <div class="flex items-center gap-5">
        {currentItem.iconImage ? (
          <img 
            src={currentItem.iconImage} 
            alt={localName}
            class="w-[76px] h-[76px] sm:w-[92px] sm:h-[92px] object-contain select-none"
            id="ingredientImage"
          />
        ) : (
          <span class="text-6xl sm:text-7xl select-none" id="ingredientEmoji">{currentItem.emoji}</span>
        )}
        <div>
          <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-800 dark:text-slate-100 mb-1" id="ingredientName">
            {localName}
          </h1>
          <span class="text-xs font-bold uppercase tracking-widest bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 px-3 py-1 rounded-full border border-slate-200/50 dark:border-slate-700/50">
            {currentItem.id.replace(/-/g, ' ')}
          </span>
        </div>
      </div>
      
      <!-- App Store Link Icon -->
      <a 
        href={`https://play.google.com/store/apps/details?id=com.selalink.freshself&hl=${currentLang}`}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2.5 bg-purple-600/10 hover:bg-purple-600/20 text-purple-600 dark:text-purple-400 px-4 py-2.5 rounded-2xl font-bold text-sm transition-all duration-300"
      >
        <span>App Download</span> 📲
      </a>
    </div>

    <!-- Storage Method Selection & Duration Gauge Bento Card -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      <!-- 1. Selection Tab (Vertical styled) -->
      <div class="bento-card p-5 md:col-span-1 flex flex-col gap-2.5" style="--glow-color: rgba(139,92,246,0.12);">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">{t('detail.storage.type')}</span>
        
        {['room', 'fridge', 'freezer'].map((method) => {
          const hasMethod = !!currentItem.storage[method as keyof typeof currentItem.storage];
          const isRecommended = recommendedMethod === method;
          
          return (
            <button
              id={`tab-${method}`}
              data-method={method}
              disabled={!hasMethod}
              class={`method-tab w-full p-4 rounded-xl font-bold flex items-center justify-between text-left transition-all duration-300 border ${
                !hasMethod 
                  ? 'opacity-40 cursor-not-allowed border-transparent bg-slate-50/50 dark:bg-slate-900/30 text-slate-400' 
                  : isRecommended
                    ? 'active-tab bg-purple-600 text-white border-purple-600 shadow-md shadow-purple-600/15'
                    : 'bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 hover:border-purple-500/50 cursor-pointer'
              }`}
            >
              <span>{t(`detail.storage.${method}`)}</span>
              {isRecommended && hasMethod && (
                <span class="text-[9px] bg-white/20 text-white px-2 py-0.5 rounded font-black tracking-tighter uppercase">
                  {t('detail.recommended.badge')}
                </span>
              )}
            </button>
          );
        })}
      </div>

      <!-- 2. Gauge Bar Display & Expiration days -->
      <div class="bento-card p-6 md:col-span-2 flex flex-col justify-between" style="--glow-color: rgba(139,92,246,0.12);">
        <div>
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-2">{t('detail.recommend.days')}</span>
          <div class="flex items-baseline gap-2">
            <span id="daysCount" class="text-5xl font-black text-purple-600 dark:text-purple-400 font-outfit">{initialDays}</span>
            <span id="daysUnit" class="text-lg font-bold text-slate-500 dark:text-slate-400">
              {initialDays === 1 ? t('detail.days') : t('detail.days.plural')}
            </span>
          </div>
        </div>

        <!-- Animated Gauge Bar Container -->
        <div class="my-6">
          <div class="h-3 w-full bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden">
            <div 
              id="gaugeFill" 
              class="h-full bg-gradient-to-r from-purple-500 to-indigo-500 rounded-full transition-all duration-700 ease-out"
              style={`width: ${Math.min(100, (initialDays / 45) * 100)}%`}
            ></div>
          </div>
          <div class="flex justify-between text-[10px] text-slate-400 font-bold mt-2">
            <span>0</span>
            <span>15</span>
            <span>30</span>
            <span>45+ {t('detail.days.plural')}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Storage Tips Guide Bento Card -->
    <div class="bento-card p-6 md:p-8 mb-8" style="--glow-color: rgba(139,92,246,0.15);">
      <h2 class="text-xl font-bold text-slate-800 dark:text-slate-100 mb-6 flex items-center gap-2">
        💡 {t('detail.guide.title')}
      </h2>
      <div id="tipsContainer" class="text-base leading-relaxed text-slate-600 dark:text-slate-300 space-y-4">
        {/* Initial Tip load in SSR */}
        {initialGuide && (
          <div class="p-5 rounded-2xl bg-purple-50/50 dark:bg-purple-950/10 border border-purple-500/10 transition-opacity duration-300">
            <p class="font-medium text-slate-700 dark:text-slate-200">
              {initialGuide.tips[currentLang] || initialGuide.tips['en']}
            </p>
          </div>
        )}
      </div>

      <!-- Sources display area -->
      <div id="sourcesContainer" class="mt-6 pt-4 border-t border-slate-100 dark:border-slate-800 text-xs text-slate-400 dark:text-slate-500">
        {initialGuide && initialGuide.sources && initialGuide.sources.length > 0 && (
          <div class="flex flex-wrap items-center gap-2">
            <span class="font-bold mr-1">{tSource('detail.source.label')}:</span>
            {initialGuide.sources.map(src => (
              <span class="bg-slate-50 dark:bg-slate-900 border border-slate-200/50 dark:border-slate-800 px-2 py-0.5 rounded-md font-medium text-slate-500 dark:text-slate-400">
                {tSource(`source.${src}`)}
              </span>
            ))}
          </div>
        )}
      </div>
    </div>

    <!-- D-Day Interactive Calculator Bento Card -->
    <div class="bento-card p-6 md:p-8 mb-8" style="--glow-color: rgba(139,92,246,0.15);">
      <h2 class="text-xl font-bold text-slate-800 dark:text-slate-100 mb-6">
        {t('detail.calc.title')}
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-5 gap-6 items-center">
        <!-- Input buying date -->
        <div class="sm:col-span-2 flex flex-col gap-2">
          <label for="buyDate" class="text-sm font-bold text-slate-500 dark:text-slate-400">
            {t('detail.calc.buy_date')}
          </label>
          <input 
            type="date" 
            id="buyDate" 
            class="px-4 py-3 rounded-xl bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-slate-800 dark:text-slate-100 font-bold focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
          />
        </div>
        
        <!-- Live result feedback bubble -->
        <div class="sm:col-span-3 p-5 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/50 dark:border-slate-800/80">
          <p id="calcEatUntil" class="text-sm font-semibold text-slate-500 dark:text-slate-400 mb-1.5"></p>
          <p id="calcDDay" class="text-lg font-bold text-purple-600 dark:text-purple-400 leading-snug"></p>
        </div>
      </div>
    </div>

    <!-- App Installation Promotional CTA (Different copywriting based on item type) -->
    <div class="bento-card p-8 md:p-12 relative overflow-hidden" style="--glow-color: rgba(139,92,246,0.22); border-color: rgba(139,92,246,0.25);">
      <!-- Subtle spatial gradient -->
      <div class="absolute -right-24 -bottom-24 w-80 h-80 bg-purple-600/10 rounded-full blur-[100px] pointer-events-none"></div>
      
      <div class="max-w-2xl relative z-10">
        <span class="text-xs font-black uppercase tracking-widest text-purple-600 dark:text-purple-400 bg-purple-100 dark:bg-purple-950/40 px-3 py-1 rounded-full">
          {t('detail.promo.sub')}
        </span>
        
        <h2 class="text-2xl md:text-3xl font-extrabold text-slate-800 dark:text-slate-100 mt-4 mb-4">
          {currentItem.isProcessed ? t('detail.promo.title.processed') : t('detail.promo.title.fresh')}
        </h2>
        
        <p class="text-base text-slate-600 dark:text-slate-300 leading-relaxed mb-8">
          {currentItem.isProcessed ? t('detail.promo.processed') : t('detail.promo.fresh')}
        </p>

        <!-- Downloader buttons -->
        <div class="flex flex-col sm:flex-row gap-4 items-stretch sm:items-center">
          <a 
            href={`https://play.google.com/store/apps/details?id=com.selalink.freshself&hl=${currentLang}`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-3 bg-purple-600 hover:bg-purple-500 text-white px-6 py-3.5 rounded-xl font-bold text-base cursor-pointer shadow-lg shadow-purple-600/20 hover:scale-[1.02] active:scale-[0.98] transition-all duration-300"
          >
            <span>Google Play Store</span> 📲
          </a>
          <a 
            href="https://apps.apple.com/app/id6499446487"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-3 bg-slate-900 dark:bg-white text-white dark:text-slate-900 px-6 py-3.5 rounded-xl font-bold text-base cursor-pointer hover:scale-[1.02] active:scale-[0.98] transition-all duration-300"
          >
            <span>iOS App Store</span> 🍏
          </a>
        </div>
      </div>
    </div>

    <!-- Legal Disclaimer (법적 면책 조항 고지) -->
    <div class="mt-16 pt-8 border-t border-slate-200/40 dark:border-slate-800/60 text-center">
      <p class="text-[11px] md:text-xs text-slate-400 dark:text-slate-500 max-w-3xl mx-auto leading-relaxed select-none">
        {t('detail.disclaimer')}
      </p>
    </div>
  </main>

  <script define:vars={{ currentItem, currentLang, localTranslations, sourceTranslations }}>
    // Client-side Tab and Slider calculation scripts
    let storageDuration = 0;

    const tabs = document.querySelectorAll('.method-tab');
    const daysCount = document.getElementById('daysCount');
    const daysUnit = document.getElementById('daysUnit');
    const gaugeFill = document.getElementById('gaugeFill');
    const tipsContainer = document.getElementById('tipsContainer');
    const buyDateInput = document.getElementById('buyDate');

    // Set initial buying date to today
    const todayStr = new Date().toISOString().split('T')[0];
    if (buyDateInput) buyDateInput.value = todayStr;

    // Helper functions for translation
    const translate = (key, variables = {}) => {
      let text = localTranslations[currentLang]?.[key] || localTranslations['en']?.[key] || key;
      Object.entries(variables).forEach(([k, val]) => {
        text = text.replace(`{${k}}`, val);
      });
      return text;
    };

    const translateSource = (key) => {
      return sourceTranslations[currentLang]?.[key] || sourceTranslations['en']?.[key] || key;
    };

    const getDaysTranslation = (days) => {
      return days === 1 ? translate('detail.days') : translate('detail.days.plural');
    };

    const updateDDayCalculator = () => {
      if (!buyDateInput || !buyDateInput.value) return;

      const calcEatUntil = document.getElementById('calcEatUntil');
      const calcDDay = document.getElementById('calcDDay');

      // 보관 권장 기간이 0인 경우 (비권장 보관법)
      if (storageDuration === 0) {
        if (calcEatUntil) calcEatUntil.textContent = '';
        if (calcDDay) {
          calcDDay.textContent = translate('detail.not_recommended');
          calcDDay.className = 'text-base font-bold text-rose-600 dark:text-rose-400 leading-snug';
        }
        return;
      }

      const buyDate = new Date(buyDateInput.value);
      const expireDate = new Date(buyDate);
      expireDate.setDate(buyDate.getDate() + storageDuration);

      // Expiry Date string rendering
      const expireDateStr = expireDate.toLocaleDateString(currentLang, {
        year: 'numeric',
        month: 'long',
        day: 'numeric'
      });
      
      if (calcEatUntil) {
        calcEatUntil.textContent = translate('detail.calc.eat_until', { date: expireDateStr });
      }

      // Calculate D-day
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      expireDate.setHours(0, 0, 0, 0);

      const timeDiff = expireDate.getTime() - today.getTime();
      const diffDays = Math.ceil(timeDiff / (1000 * 3600 * 24));

      if (calcDDay) {
        if (diffDays > 0) {
          calcDDay.textContent = translate('detail.calc.dday', { dday: `D-${diffDays}` });
          calcDDay.className = 'text-lg font-bold text-emerald-600 dark:text-emerald-400 leading-snug';
        } else if (diffDays < 0) {
          calcDDay.textContent = translate('detail.calc.dday_minus', { dday: `${Math.abs(diffDays)}${getDaysTranslation(Math.abs(diffDays))}` });
          calcDDay.className = 'text-lg font-bold text-rose-600 dark:text-rose-400 leading-snug';
        } else {
          calcDDay.textContent = translate('detail.calc.dday_today');
          calcDDay.className = 'text-lg font-bold text-amber-600 dark:text-amber-400 leading-snug';
        }
      }
    };

    const switchMethod = (method) => {
      const guide = currentItem.storage[method];
      storageDuration = guide?.durationDays || 0;

      // Update Active Tab styles
      tabs.forEach((tab) => {
        if (tab.getAttribute('data-method') === method) {
          tab.classList.add('active-tab', 'bg-purple-600', 'text-white', 'border-purple-600', 'shadow-md', 'shadow-purple-600/15');
          tab.classList.remove('bg-white', 'dark:bg-slate-900', 'border-slate-200', 'dark:border-slate-800', 'text-slate-700', 'dark:text-slate-300');
        } else {
          tab.classList.remove('active-tab', 'bg-purple-600', 'text-white', 'border-purple-600', 'shadow-md', 'shadow-purple-600/15');
          const isDisabled = tab.hasAttribute('disabled');
          if (!isDisabled) {
            tab.classList.add('bg-white', 'dark:bg-slate-900', 'border-slate-200', 'dark:border-slate-800', 'text-slate-700', 'dark:text-slate-300');
          }
        }
      });

      // Update days counters & Gauge
      if (daysCount) daysCount.textContent = String(storageDuration);
      if (daysUnit) daysUnit.textContent = getDaysTranslation(storageDuration);
      
      if (gaugeFill) {
        const percentage = Math.min(100, (storageDuration / 45) * 100);
        gaugeFill.style.width = `${percentage}%`;
      }

      // Update tips description
      if (tipsContainer && guide) {
        const tipText = guide.tips[currentLang] || guide.tips['en'];
        tipsContainer.innerHTML = `
          <div class="p-5 rounded-2xl bg-purple-50/50 dark:bg-purple-950/10 border border-purple-500/10 opacity-0 transition-opacity duration-300" id="tipTextWrapper">
            <p class="font-medium text-slate-700 dark:text-slate-200">${tipText}</p>
          </div>
        `;
        setTimeout(() => {
          const wrapper = document.getElementById('tipTextWrapper');
          if (wrapper) wrapper.classList.replace('opacity-0', 'opacity-100');
        }, 50);
      }

      // Update sources list
      const sourcesContainer = document.getElementById('sourcesContainer');
      if (sourcesContainer) {
        if (guide && guide.sources && guide.sources.length > 0) {
          const sourceLabels = guide.sources.map(src => {
            return `<span class="bg-slate-50 dark:bg-slate-900 border border-slate-200/50 dark:border-slate-800 px-2 py-0.5 rounded-md font-medium text-slate-500 dark:text-slate-400">${translateSource('source.' + src)}</span>`;
          }).join('');
          sourcesContainer.innerHTML = `
            <div class="flex flex-wrap items-center gap-2">
              <span class="font-bold mr-1">${translateSource('detail.source.label')}:</span>
              ${sourceLabels}
            </div>
          `;
          sourcesContainer.style.display = 'block';
        } else {
          sourcesContainer.style.display = 'none';
          sourcesContainer.innerHTML = '';
        }
      }

      // Recalculate D-day
      updateDDayCalculator();
    };

    // Initialize state
    const getInitialMethod = () => {
      if (currentItem.storage.fridge && currentItem.storage.fridge.durationDays > 0) return 'fridge';
      if (currentItem.storage.room && currentItem.storage.room.durationDays > 0) return 'room';
      if (currentItem.storage.freezer && currentItem.storage.freezer.durationDays > 0) return 'freezer';
      return currentItem.storage.fridge ? 'fridge' : (currentItem.storage.room ? 'room' : 'freezer');
    };
    const initialRecMethod = getInitialMethod();
    switchMethod(initialRecMethod);

    // Event listeners
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-method') || '';
        if (target) switchMethod(target);
      });
    });

    buyDateInput?.addEventListener('input', updateDDayCalculator);

    // Spatial Glow effect
    document.querySelectorAll('.bento-card').forEach((card) => {
      let glow = card.querySelector('.bento-glow');
      if (!glow) {
        glow = document.createElement('div');
        glow.className = 'bento-glow';
        card.prepend(glow);
      }
      
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        glow.style.setProperty('--mouse-x', `${x}px`);
        glow.style.setProperty('--mouse-y', `${y}px`);
      });
    });
  </script>
</Layout>

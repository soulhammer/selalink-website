import Layout from '../../../../../layouts/Layout.astro';
import { languages } from '../../../../../i18n/ui';
import { ingredients } from '../../../../../data/ingredients';

export function getStaticPaths() {
  const paths = [];
  const langKeys = Object.keys(languages);
  for (const lang of langKeys) {
    for (const item of ingredients) {
      paths.push({
        params: { lang, ingredient: item.id }
      });
    }
  }
  return paths;
}

const { lang, ingredient } = Astro.params;
const currentLang = (lang as string) || 'en';
const currentItem = ingredients.find((item) => item.id === ingredient);

if (!currentItem) {
  return Astro.redirect(`/${currentLang}/apps/freshself/ingredients/`);
}

const localName = currentItem.names[currentLang] || currentItem.names['en'];


---
import Layout from '../../../../layouts/Layout.astro';
import { useTranslations, languages } from '../../../../i18n/ui';
import ShortsGallery from '../../../../components/ShortsGallery.astro';
import ShortsPlayerModal from '../../../../components/ShortsPlayerModal.astro';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as keyof typeof languages);

const isKo = lang === 'ko';
const qrTitle = t('app.qr.title');
const qrDesc = t('app.qr.desc');
const toastTitle = t('app.toast.ios.title');
const toastDesc = t('app.toast.ios.desc');
const floatingBadge = t('app.freshself.badge.all_fresh');
const imgBase = isKo ? '/assets/images/apps/freshself/ko' : '/assets/images/apps/freshself/en';

---

<Layout
  title={t("app.freshself.meta.title")}
  lang={lang as string}
  description={t('app.freshself.meta.desc')}
  ogType="software"
  canonicalUrl={`https://selalink.net/${lang}/apps/freshself/`}
  image="/assets/images/og/freshself.png"
  appId="freshself"
>
  <style>
    :root {
      --fs-primary: #8B5CF6;
      --fs-secondary: #10B981;
      --fs-primary-glow: rgba(139, 92, 246, 0.25);
      --fs-secondary-glow: rgba(16, 185, 129, 0.25);
    }
    
    .font-jakarta-all {
      font-family: 'Plus Jakarta Sans', 'Pretendard', sans-serif;
    }

    .screenshot-card {
      transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
      border: 1px solid rgba(139, 92, 246, 0.1);
    }
    .screenshot-card:hover {
      transform: translateY(-8px) scale(1.03);
      box-shadow: 0 30px 60px -15px var(--fs-primary-glow), 0 0 30px -5px var(--fs-secondary-glow);
      border-color: rgba(16, 185, 129, 0.3);
    }

    /* Shelf Grid System for FreshSelf Hero */
    .shelf-container {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      align-items: center;
      perspective: 1200px;
    }
    @media (max-width: 768px) {
      .shelf-container {
        grid-template-columns: 1fr;
        gap: 2rem;
      }
    }
    .shelf-item-left {
      transform: rotateY(12deg) rotateX(4deg) translateZ(0);
      transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .shelf-item-center {
      transform: translateZ(25px) scale(1.04);
      z-index: 20;
      transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .shelf-item-right {
      transform: rotateY(-12deg) rotateX(4deg) translateZ(0);
      transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .shelf-item-left:hover {
      transform: rotateY(3deg) scale(1.02) translateY(-5px);
    }
    .shelf-item-center:hover {
      transform: translateZ(40px) scale(1.07) translateY(-8px);
    }
    .shelf-item-right:hover {
      transform: rotateY(-3deg) scale(1.02) translateY(-5px);
    }

    .leaf-logo {
      animation: gentle-wave 4s ease-in-out infinite alternate;
    }

    @keyframes gentle-wave {
      0% { transform: rotate(-6deg) translateY(0px) scale(0.95); }
      100% { transform: rotate(6deg) translateY(-5px) scale(1.05); }
    }

    /* Neon Bento Card variant for FreshSelf */
    .fresh-bento-card {
      border: 1px solid rgba(139, 92, 246, 0.15) !important;
      transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .fresh-bento-card:hover {
      border-color: rgba(16, 185, 129, 0.4) !important;
      box-shadow: 0 25px 50px -12px rgba(139, 92, 246, 0.25), 0 0 30px rgba(16, 185, 129, 0.15) !important;
    }
  </style>

  <main class="w-full font-jakarta-all bg-slate-50 dark:bg-[#0B0F19] min-h-screen text-slate-900 dark:text-slate-100 overflow-hidden transition-colors duration-500">
    <!-- Fluid Decorative Blurs -->
    <div class="fixed inset-0 z-0 opacity-40 pointer-events-none">
      <div class="absolute top-[-10%] right-[-10%] w-[50%] h-[50%] bg-purple-500/10 dark:bg-purple-600/5 rounded-full filter blur-[120px]"></div>
      <div class="absolute bottom-[-20%] left-[-10%] w-[60%] h-[60%] bg-emerald-500/10 dark:bg-emerald-600/5 rounded-full filter blur-[130px]"></div>
    </div>

    <!-- Header / Navigation Back -->
    <div class="relative z-10 w-full max-w-7xl mx-auto px-6 pt-10 md:pt-16 pb-2 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <a href={`/${lang}/`} class="group inline-flex items-center space-x-2 text-purple-600 dark:text-purple-400 hover:text-purple-800 dark:hover:text-purple-300 transition-colors duration-300">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m15 18-6-6 6-6"/>
        </svg>
        <span class="text-sm font-semibold tracking-wide">Back to SelaLink Studio</span>
      </a>
    </div>

    <!-- Hero Section (5:7 개편 및 Shelf Layout 도입) -->
    <section class="relative z-10 w-full max-w-7xl mx-auto px-6 py-6 lg:py-16 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <!-- Title & CTA (lg:col-span-5) -->
      <div class="lg:col-span-5 flex flex-col items-start space-y-6 md:space-y-8 text-left">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-purple-50 dark:bg-purple-950/30 border border-purple-200 dark:border-purple-900/50 shadow-sm">
          <span class="w-2 h-2 rounded-full bg-purple-500 animate-pulse"></span>
          <span class="text-xs font-bold text-purple-700 dark:text-purple-400 tracking-wider uppercase">{t('fs.hero.subtitle')}</span>
        </div>
        
        <h1 class="text-3xl sm:text-5xl md:text-5xl lg:text-6xl font-black tracking-tight leading-[1.15] text-slate-900 dark:text-white whitespace-pre-wrap">
          {t('fs.hero.title')}
        </h1>
        
        <p class="text-base md:text-lg text-slate-600 dark:text-slate-300 font-medium leading-relaxed max-w-xl">
          {t('app.freshself.desc')}
        </p>

        <!-- CTAs / Store Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto pt-2 relative z-20">
          <button id="iosDownloadBtn" class="flex items-center justify-center gap-3 bg-slate-200/50 dark:bg-slate-800/50 border border-slate-300 dark:border-slate-700 text-slate-500 dark:text-slate-400 px-6 py-3 rounded-xl font-bold text-base opacity-70 cursor-pointer w-full sm:w-auto transition-all duration-300 hover:scale-[1.01]">
            <svg class="w-5 h-5 opacity-70" fill="currentColor" viewBox="0 0 24 24"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.253 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.04 2.26-.79 3.59-.76 2.6.04 4.19 1.45 4.8 1.8-3.1 1.76-2.58 5.86.37 6.94-1.04 2.45-2.51 3.5-3.84 4.19zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
            <div class="flex flex-col items-start leading-tight">
              <span class="text-[10px] text-slate-400 font-medium uppercase tracking-wider">App Store</span>
              <span class="text-xs font-bold text-slate-500">Coming Soon</span>
            </div>
          </button>
          
          <a href={`https://play.google.com/store/apps/details?id=com.selalink.freshself&hl=${lang}`} target="_blank" rel="noopener noreferrer" class="group/btn flex items-center justify-center gap-3 bg-purple-600 hover:bg-purple-500 text-white px-6 py-3 rounded-xl font-bold text-base cursor-pointer shadow-lg shadow-purple-600/20 hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 w-full sm:w-auto">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M3 20.5v-17c0-.83.67-1.5 1.5-1.5.34 0 .66.12.92.33l13.62 10.15c.67.5.76 1.45.19 2.06l-13.62 10.15a1.5 1.5 0 01-2.42-1.2v-1.92z"/></svg>
            <div class="flex flex-col items-start leading-tight">
              <span class="text-[10px] text-purple-200 font-medium uppercase tracking-wider">Google Play</span>
              <span class="text-xs font-bold text-white">{t('fs.hero.cta')}</span>
            </div>
          </a>
        </div>

        <!-- Frictionless QR Code Card (Desktop Only) -->
        <div class="hidden md:flex items-center gap-4 p-3 rounded-xl bg-white/70 dark:bg-slate-900/50 backdrop-blur-2xl border border-white/80 dark:border-white/10 shadow-md w-max mt-4 relative z-20">
          <div class="w-32 h-32 bg-white dark:bg-white p-3 rounded-2xl border border-slate-200 flex items-center justify-center shadow-inner">
            <img src="/assets/images/qr/qr_freshself.svg" alt="FreshSelf Play Store QR Code" class="w-full h-full object-contain" />
          </div>
          <div class="flex flex-col text-left">
            <span class="text-xs font-bold text-slate-800 dark:text-slate-200">{qrTitle}</span>
            <span class="text-[9px] text-slate-500 dark:text-slate-400 font-medium mt-0.5 leading-tight" set:html={qrDesc}></span>
          </div>
        </div>
      </div>

      <!-- Shelf-Inspired 3D 3-Column Display (lg:col-span-7) -->
      <div class="lg:col-span-7 relative w-full h-auto min-h-[480px] flex items-center justify-center mt-12 lg:mt-0">
        <!-- Leaf Floating Logo Background -->
        <div class="absolute top-0 right-1/4 w-32 h-32 opacity-15 dark:opacity-25 leaf-logo pointer-events-none">
          <img src="/freshself/invite/icon.png" alt="FreshSelf Leaf Symbol" class="w-full h-full object-contain" />
        </div>

        <!-- Shelf Container -->
        <div class="shelf-container w-full max-w-[680px]">
          <!-- Shelf Item 1: Login/Setup (Left) -->
          <div class="shelf-item-left screenshot-card rounded-[2rem] p-1 bg-white/40 dark:bg-slate-800/30 backdrop-blur-xl border border-white/50 dark:border-white/10 shadow-lg">
            <img src={`${imgBase}/1_freshself_phone_screen.jpg`} alt="FreshSelf Login Interface" class="w-full h-auto rounded-[1.8rem] object-cover" loading="eager" />
          </div>

          <!-- Shelf Item 2: Main Shelf (Center - Prominent) -->
          <div class="shelf-item-center relative screenshot-card rounded-[2.2rem] p-1.5 bg-white/80 dark:bg-slate-800/80 backdrop-blur-2xl border border-white/80 dark:border-white/20 shadow-2xl">
            <img src={`${imgBase}/2_freshself_phone_screen.jpg`} alt="FreshSelf Main Locker" class="w-full h-auto rounded-[2rem] object-cover" loading="eager" />
            <!-- Floating Status Glass Badge -->
            <div class="absolute -right-2 top-16 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md px-3 py-2 rounded-xl border border-slate-100 dark:border-slate-800 shadow-xl flex items-center gap-1.5 transform rotate-6 z-20">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              <span class="text-[10px] font-bold text-slate-800 dark:text-slate-200">{floatingBadge}</span>
            </div>
          </div>

          <!-- Shelf Item 3: Analytics/Report (Right) -->
          <div class="shelf-item-right screenshot-card rounded-[2rem] p-1 bg-white/40 dark:bg-slate-800/30 backdrop-blur-xl border border-white/50 dark:border-white/10 shadow-lg">
            <img src={`${imgBase}/4_freshself_phone_screen.jpg`} alt="FreshSelf Analytics Interface" class="w-full h-auto rounded-[1.8rem] object-cover" loading="eager" />
          </div>
        </div>
      </div>
    </section>



    <!-- Detailed Feature Section 1: Space Sharing -->
    <section class="relative z-10 w-full max-w-7xl mx-auto px-6 py-10 md:py-16 border-t border-slate-200/50 dark:border-slate-800/40">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-center">
        
        <!-- Left Graphics (Space List & Members overlap) -->
        <div class="lg:col-span-5 order-2 lg:order-1 relative w-full h-[450px] sm:h-[500px] flex items-center justify-center pointer-events-none">
          <!-- Back Stack (Space Member Invitation list) -->
          <div class="absolute left-8 bottom-6 w-[70%] max-w-[190px] rounded-[2rem] p-1 bg-white/30 dark:bg-slate-800/30 backdrop-blur-xl border border-white/40 dark:border-white/10 shadow-xl transform rotate-6 translate-x-[20px] translate-y-[-10px] opacity-80">
            <img src={`${imgBase}/6_freshself_phone_screen.jpg`} alt="FreshSelf Space Settings" class="w-full h-auto rounded-[1.8rem] object-cover shadow-inner" loading="lazy" />
          </div>
          <!-- Front Stack (Space Group List) -->
          <div class="screenshot-card relative w-[75%] max-w-[210px] rounded-[2.5rem] p-1.5 bg-white/70 dark:bg-slate-700/60 backdrop-blur-2xl border border-white/80 dark:border-white/20 shadow-[-10px_10px_40px_rgba(0,0,0,0.1)] dark:shadow-[-20px_20px_60px_rgba(0,0,0,0.5)] transform -rotate-3 z-10">
            <img src={`${imgBase}/3_freshself_phone_screen.jpg`} alt="FreshSelf Space Selection" class="w-full h-auto rounded-[2.2rem] object-cover shadow-sm" loading="lazy" />
          </div>
        </div>

        <!-- Right Copy -->
        <div class="lg:col-span-7 order-1 lg:order-2 space-y-6">
          <div class="w-12 h-12 rounded-2xl bg-purple-100 dark:bg-purple-950/40 border border-purple-200 dark:border-purple-900/50 flex items-center justify-center text-purple-600 dark:text-purple-400 shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h2 class="text-xl sm:text-3xl lg:text-4xl font-black tracking-tight text-slate-900 dark:text-white leading-tight">
            {t('fs.feature1.title')}
          </h2>
          <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 font-medium leading-relaxed">
            {t('fs.feature1.desc')}
          </p>
        </div>

      </div>
    </section>

    <!-- Detailed Feature Section 2: Timeline & Feedback -->
    <section class="relative z-10 w-full max-w-7xl mx-auto px-6 py-10 md:py-16 border-t border-slate-200/50 dark:border-slate-800/40">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-center">
        
        <!-- Left Copy -->
        <div class="lg:col-span-7 space-y-6">
          <div class="w-12 h-12 rounded-2xl bg-emerald-100 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-900/50 flex items-center justify-center text-emerald-600 dark:text-emerald-400 shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h2 class="text-xl sm:text-3xl lg:text-4xl font-black tracking-tight text-slate-900 dark:text-white leading-tight">
            {t('fs.feature2.title')}
          </h2>
          <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 font-medium leading-relaxed">
            {t('fs.feature2.desc')}
          </p>
        </div>

        <!-- Right Graphics (Timeline Details overlap) -->
        <div class="lg:col-span-5 relative w-full h-[450px] sm:h-[500px] flex items-center justify-center pointer-events-none">
          <!-- Back Stack (Timeline detail log) -->
          <div class="absolute right-8 bottom-6 w-[70%] max-w-[190px] rounded-[2rem] p-1 bg-white/30 dark:bg-slate-800/30 backdrop-blur-xl border border-white/40 dark:border-white/10 shadow-xl transform -rotate-6 translate-x-[-20px] translate-y-[-10px] opacity-80">
            <img src={`${imgBase}/8_freshself_phone_screen.jpg`} alt="FreshSelf Timeline Detail" class="w-full h-auto rounded-[1.8rem] object-cover shadow-inner" loading="lazy" />
          </div>
          <!-- Front Stack (Overall history list) -->
          <div class="screenshot-card relative w-[75%] max-w-[210px] rounded-[2.5rem] p-1.5 bg-white/70 dark:bg-slate-700/60 backdrop-blur-2xl border border-white/80 dark:border-white/20 shadow-[-10px_10px_40px_rgba(0,0,0,0.15)] dark:shadow-[-20px_20px_60px_rgba(0,0,0,0.5)] transform rotate-3 z-10">
            <img src={`${imgBase}/7_freshself_phone_screen.jpg`} alt="FreshSelf History List" class="w-full h-auto rounded-[2.2rem] object-cover shadow-sm" loading="lazy" />
          </div>
        </div>

      </div>
    </section>



    <!-- Bento Section 3: Smart Report Analysis -->
    <section class="relative z-10 w-full max-w-5xl mx-auto px-6 py-12 md:py-16 border-t border-slate-200/50 dark:border-slate-800/40 text-center">
      <div class="max-w-3xl mx-auto mb-16 space-y-4">
        <h2 class="text-xl sm:text-3xl lg:text-4xl font-black text-slate-900 dark:text-white tracking-tight">{t('fs.bento.header.title')}</h2>
        <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 font-medium">{t('fs.bento.header.desc')}</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center bg-white dark:bg-slate-900/40 fresh-bento-card border border-slate-200/60 dark:border-slate-800/80 p-8 sm:p-12 rounded-[2.5rem] backdrop-blur-xl shadow-xl">
        <!-- Graphic -->
        <div class="md:col-span-5 flex justify-center pointer-events-none">
          <div class="screenshot-card relative w-[80%] max-w-[260px] rounded-[2rem] p-1.5 bg-white dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700 shadow-2xl">
            <img src={`${imgBase}/4_freshself_phone_screen.jpg`} alt="FreshSelf Analytics Chart" class="w-full h-auto rounded-[1.7rem] object-cover" loading="lazy" />
          </div>
        </div>
        
        <!-- Explanation -->
        <div class="md:col-span-7 text-left space-y-6">
          <div class="space-y-2">
            <h3 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white">{t('fs.bento.body.title')}</h3>
            <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 font-medium">{t('fs.bento.body.desc')}</p>
          </div>
          
          <div class="space-y-4 font-medium text-slate-700 dark:text-slate-300 text-sm">
            <div class="flex items-center gap-3">
              <span class="w-6 h-6 rounded-full bg-purple-100 dark:bg-purple-950/40 text-purple-600 dark:text-purple-400 flex items-center justify-center font-bold text-xs">✓</span>
              <span>{t('fs.bento.body.check1')}</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-6 h-6 rounded-full bg-purple-100 dark:bg-purple-950/40 text-purple-600 dark:text-purple-400 flex items-center justify-center font-bold text-xs">✓</span>
              <span>{t('fs.bento.body.check2')}</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-6 h-6 rounded-full bg-purple-100 dark:bg-purple-950/40 text-purple-600 dark:text-purple-400 flex items-center justify-center font-bold text-xs">✓</span>
              <span>{t('fs.bento.body.check3')}</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- New Section 1: Expiry OCR & Barcode Scan (실제 기능: 유효기간 OCR 및 바코드 조회) -->
    <section class="relative z-10 w-full max-w-5xl mx-auto px-6 py-12 md:py-16 border-t border-slate-200/50 dark:border-slate-800/40">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 dark:text-white tracking-tight">
          {t('fs.impact.title')}
        </h2>
        <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 font-medium">
          {t('fs.impact.desc')}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
        <!-- Card 1: Expiry OCR -->
        <div class="p-8 rounded-3xl bg-white/50 dark:bg-slate-900/30 border border-slate-200/60 dark:border-slate-800/50 backdrop-blur-xl flex flex-col items-start text-left group hover:border-purple-500/30 transition-all duration-500 shadow-sm">
          <div class="w-12 h-12 rounded-2xl bg-purple-50 dark:bg-purple-950/30 text-purple-600 dark:text-purple-400 flex items-center justify-center mb-6 font-bold text-xl">📷</div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3">{t('fs.impact.card1.title')}</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed font-medium">{t('fs.impact.card1.desc')}</p>
        </div>
        <!-- Card 2: Barcode Scan -->
        <div class="p-8 rounded-3xl bg-white/50 dark:bg-slate-900/30 border border-slate-200/60 dark:border-slate-800/50 backdrop-blur-xl flex flex-col items-start text-left group hover:border-emerald-500/30 transition-all duration-500 shadow-sm">
          <div class="w-12 h-12 rounded-2xl bg-emerald-50 dark:bg-emerald-950/30 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mb-6 font-bold text-xl">🔍</div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3">{t('fs.impact.card2.title')}</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed font-medium">{t('fs.impact.card2.desc')}</p>
        </div>
        <!-- Card 3: Batch Action -->
        <div class="p-8 rounded-3xl bg-white/50 dark:bg-slate-900/30 border border-slate-200/60 dark:border-slate-800/50 backdrop-blur-xl flex flex-col items-start text-left group hover:border-purple-500/30 transition-all duration-500 shadow-sm">
          <div class="w-12 h-12 rounded-2xl bg-purple-50 dark:bg-purple-950/30 text-purple-600 dark:text-purple-400 flex items-center justify-center mb-6 font-bold text-xl">⚡</div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3">{t('fs.impact.card3.title')}</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed font-medium">{t('fs.impact.card3.desc')}</p>
        </div>
      </div>
    </section>

    <!-- New Section 2: Rescue Level & Expiry Reports (실제 기능: 구출 레벨 시스템) -->
    <section class="relative z-10 w-full max-w-5xl mx-auto px-6 py-12 md:py-16 border-t border-slate-200/50 dark:border-slate-800/40">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 dark:text-white tracking-tight">
          {t('fs.push.title')}
        </h2>
        <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 font-medium">
          {t('fs.push.desc')}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 max-w-4xl mx-auto">
        {([
          { id: 'd7', titleKey: 'fs.push.d7.title', bodyKey: 'fs.push.d7.body', icon: '🛡️', color: 'border-l-purple-500' },
          { id: 'd3', titleKey: 'fs.push.d3.title', bodyKey: 'fs.push.d3.body', icon: '🌟', color: 'border-l-emerald-500' },
          { id: 'd1', titleKey: 'fs.push.d1.title', bodyKey: 'fs.push.d1.body', icon: '🏆', color: 'border-l-amber-500' }
        ] as const).map((level) => (
          <div class={`flex flex-col p-6 rounded-2xl bg-white/75 dark:bg-slate-900/80 backdrop-blur-xl border border-slate-200/50 dark:border-slate-800/80 border-l-4 ${level.color} shadow-md text-left group hover:scale-[1.03] transition-all duration-300`}>
            <div class="flex items-center gap-2 mb-3">
              <span class="text-xl">{level.icon}</span>
              <span class="text-sm font-black text-slate-900 dark:text-white">{t(level.titleKey)}</span>
            </div>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 font-medium leading-relaxed">{t(level.bodyKey)}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- FreshSelf Promo Shorts Gallery (최하단 배치 및 가로 정렬 래퍼 추가) -->
    <div class="relative z-10 w-full max-w-7xl mx-auto px-6 pb-24">
      <ShortsGallery lang={lang} appType="freshself" />
    </div>
  </main>

  <!-- Toast Notification Popover -->
  <div id="toastNotification" class="fixed bottom-6 right-6 z-50 bg-slate-900/95 dark:bg-white/95 text-white dark:text-slate-900 px-6 py-4 rounded-2xl shadow-[0_20px_50px_rgba(0,0,0,0.3)] border border-white/10 dark:border-slate-200/50 backdrop-blur-xl flex items-center gap-3 transform translate-y-20 opacity-0 invisible transition-all duration-500 ease-out">
    <span class="text-xl">🍏</span>
    <div class="flex flex-col text-left">
      <span class="text-sm font-bold">{toastTitle}</span>
      <span class="text-xs text-slate-400 dark:text-slate-600 mt-0.5">{toastDesc}</span>
    </div>
  </div>

  <script>
    const iosBtn = document.getElementById('iosDownloadBtn');
    const toast = document.getElementById('toastNotification');
    
    if (iosBtn && toast) {
      iosBtn.addEventListener('click', (e) => {
        e.preventDefault();
        // Show toast
        toast.classList.remove('translate-y-20', 'opacity-0', 'invisible');
        toast.classList.add('translate-y-0', 'opacity-100', 'visible');
        
        // Hide after 3.5s
        setTimeout(() => {
          toast.classList.remove('translate-y-0', 'opacity-100', 'visible');
          toast.classList.add('translate-y-20', 'opacity-0', 'invisible');
        }, 3500);
      });
    }
  </script>
  
  <ShortsPlayerModal lang={lang} />
</Layout>

---
import Layout from '../../../../layouts/Layout.astro';
import { useTranslations, languages } from '../../../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
// Force DeepMood to always render Korean strings regardless of URL path
const contentLang = 'ko';
const t = useTranslations(contentLang);
---

<Layout
  title={`${t("app.deepmood.title")} | SelaLink Studio`}
  lang={lang as string}
  description={t('app.deepmood.desc')}
  ogType="software"
  canonicalUrl={`https://selalink.net/${lang}/apps/deepmood/`}
  image="/assets/images/og/deepmood.png"
  appId="deepmood"
>
  <main class="w-full bg-stone-50 dark:bg-[#1C1917] min-h-screen font-sans text-stone-900 dark:text-[#FAFAF9] overflow-hidden transition-colors duration-500">
    <!-- Fluid Gradient Ambient Background -->
    <div class="fixed inset-0 z-0 opacity-40 pointer-events-none">
      <div class="absolute top-[-10%] left-[-10%] w-[50%] h-[50%] bg-[#CA8A04]/40 dark:bg-[#CA8A04] rounded-full mix-blend-multiply dark:mix-blend-screen filter blur-[120px] animate-blob transition-all duration-700"></div>
      <div class="absolute top-[20%] right-[-10%] w-[40%] h-[40%] bg-amber-700/30 dark:bg-amber-900 rounded-full mix-blend-multiply dark:mix-blend-screen filter blur-[100px] animate-blob animation-delay-2000 transition-all duration-700"></div>
      <div class="absolute bottom-[-20%] left-[20%] w-[60%] h-[60%] bg-stone-400/40 dark:bg-[#44403C] rounded-full mix-blend-multiply dark:mix-blend-screen filter blur-[130px] animate-blob animation-delay-4000 transition-all duration-700"></div>
    </div>

    <!-- Navigation / Header Breadcrumb -->
    <div class="relative z-10 w-full max-w-7xl mx-auto px-6 pt-32 pb-8 flex flex-col md:flex-row items-start md:items-center justify-between">
      <a href={`/${lang}/`} class="group inline-flex items-center space-x-2 text-amber-700 dark:text-[#CA8A04] hover:text-amber-900 dark:hover:text-yellow-400 transition-colors duration-300">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="m15 18-6-6 6-6"/>
        </svg>
        <span class="text-sm font-medium tracking-wide">Back to SelaLink Studio</span>
      </a>
      
      {lang !== 'ko' && (
        <div class="mt-4 md:mt-0 flex items-center space-x-2 px-4 py-2 rounded-full border border-red-500/30 dark:border-red-500/20 bg-red-50 dark:bg-red-500/10 text-red-600 dark:text-red-400 text-xs tracking-wider backdrop-blur-md">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
          <span>{t("app.deepmood.warning")}</span>
        </div>
      )}
    </div>

    <!-- Hero Section -->
    <section class="relative z-10 w-full max-w-7xl mx-auto px-6 py-12 md:py-24 grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-8 items-center">
      <!-- Typography & CTA -->
      <div class="flex flex-col items-start space-y-8">
        <div class="inline-flex items-center space-x-2 px-3 py-1 md:px-4 md:py-1.5 rounded-full bg-amber-100 dark:bg-[#CA8A04]/10 border border-amber-200 dark:border-[#CA8A04]/30 shadow-sm dark:shadow-none">
          <span class="w-1.5 h-1.5 md:w-2 md:h-2 rounded-full bg-amber-600 dark:bg-[#CA8A04] animate-pulse"></span>
          <span class="text-[10px] md:text-xs font-medium text-amber-700 dark:text-[#CA8A04] tracking-widest uppercase">{t('dm.hero.subtitle')}</span>
        </div>
        
        <h1 class="text-4xl md:text-6xl lg:text-7xl font-serif tracking-tight leading-[1.15] text-stone-900 dark:text-white transition-colors duration-500" style="font-family: 'Bodoni Moda', serif;">
          {t('dm.hero.title')}
        </h1>
        
        <p class="text-base md:text-xl text-stone-600 dark:text-[#FAFAF9]/60 max-w-lg font-light leading-relaxed transition-colors duration-500">
          {t('app.deepmood.desc')}
        </p>

        <button class="group mt-4 relative inline-flex h-14 items-center justify-center overflow-hidden rounded-full bg-[#CA8A04] px-8 font-medium text-white dark:text-[#1C1917] transition-all hover:bg-amber-500 dark:hover:bg-yellow-400 hover:scale-105 active:scale-95 shadow-lg shadow-amber-900/20 dark:shadow-none">
          <span class="mr-2 tracking-wide">{t('dm.hero.cta')}</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </button>
      </div>

      <!-- Conceptual UI Element: Liquid Glass Chat Bubbles -->
      <div class="relative w-full h-[500px] flex items-center justify-center pointer-events-none">
        <!-- Floating Glass Container representing the Private Vault -->
        <div class="soft-spatial-card absolute w-[80%] max-w-[360px] h-[480px] rounded-[2.5rem] flex flex-col p-6 overflow-hidden 
                    transform rotate-2 hover:rotate-0 transition-all duration-700 ease-out">
          
          <!-- Inner Chat UI Elements -->
          <div class="w-full h-full flex flex-col space-y-6 pt-4">
            <!-- Message received -->
             <div class="flex self-end w-3/4">
               <div class="p-4 rounded-2xl rounded-tr-sm bg-amber-50 dark:bg-[#CA8A04]/20 border border-amber-200 dark:border-[#CA8A04]/30 backdrop-blur-md shadow-sm dark:shadow-inner text-sm text-stone-800 dark:text-[#FAFAF9]/90 font-serif leading-relaxed transition-colors duration-300">
                  "It rained all day. I felt an inexplicable heavy sadness."
               </div>
             </div>
             
             <!-- AI Parsing / Vectorizing element -->
             <div class="flex flex-col items-center justify-center py-4 space-y-3 opacity-90 dark:opacity-80">
                <div class="flex items-center space-x-2 text-amber-600 dark:text-[#CA8A04]">
                  <svg class="animate-spin h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                  <span class="text-xs uppercase tracking-widest font-semibold dark:font-normal">Qwen3 Local Processing</span>
                </div>
                <!-- Mini visualization of multidimensional vectors -->
                <div class="flex space-x-1 h-8 items-end gap-[2px]">
                   <div class="w-1.5 bg-amber-500 dark:bg-[#CA8A04] rounded-t-sm animate-pulse h-full"></div>
                   <div class="w-1.5 bg-amber-400 dark:bg-[#CA8A04]/60 rounded-t-sm animate-pulse h-2/3 delay-75"></div>
                   <div class="w-1.5 bg-amber-300 dark:bg-[#CA8A04]/80 rounded-t-sm animate-pulse h-4/5 delay-150"></div>
                   <div class="w-1.5 bg-stone-300 dark:bg-white/40 rounded-t-sm animate-pulse h-1/2 delay-300"></div>
                   <div class="w-1.5 bg-stone-200 dark:bg-white/20 rounded-t-sm animate-pulse h-1/3 delay-500"></div>
                </div>
             </div>
             
             <!-- Semantic Output -->
             <div class="flex self-start w-4/5 mt-auto">
               <div class="p-4 rounded-2xl rounded-tl-sm bg-white dark:bg-[#44403C]/40 border border-stone-100 dark:border-[#44403C]/60 backdrop-blur-md text-sm text-stone-800 dark:text-[#FAFAF9] font-light shadow-md dark:shadow-lg transition-colors duration-300">
                  <span class="font-bold text-amber-600 dark:text-[#CA8A04] block mb-1">AI Daily Deepmood</span>
                  You seem to be experiencing Melancholy. I've safely encrypted this memory vector.
               </div>
             </div>
          </div>
          
          <!-- Bottom home indicator piece -->
          <div class="absolute bottom-2 left-1/2 -translate-x-1/2 w-1/3 h-1.5 bg-stone-300 dark:bg-white/20 rounded-full transition-colors duration-300"></div>
        </div>
      </div>
    </section>

    <!-- Features Bento Grid -->
    <section class="relative z-10 w-full max-w-7xl mx-auto px-6 py-24">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- Privacy Feature -->
        <div class="group soft-spatial-card relative overflow-hidden rounded-[1.5rem] md:rounded-[2rem] p-6 md:p-10 transition-all duration-500">
          <div class="absolute -right-10 -top-10 w-32 h-32 md:w-40 md:h-40 bg-amber-200/50 dark:bg-[#CA8A04]/20 rounded-full blur-3xl group-hover:bg-amber-300/60 dark:group-hover:bg-[#CA8A04]/40 transition-all duration-700"></div>
          <div class="relative z-10 flex flex-col h-full space-y-6 md:space-y-8">
            <div class="w-12 h-12 md:w-14 md:h-14 rounded-xl md:rounded-2xl bg-amber-50 dark:bg-[#44403C]/80 border border-amber-100 dark:border-white/10 flex items-center justify-center text-amber-600 dark:text-[#CA8A04] shadow-sm dark:shadow-inner transition-colors duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" class="md:w-6 md:h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </div>
            <div class="mt-auto">
              <h3 class="text-xl md:text-2xl font-serif text-stone-900 dark:text-white mb-2 md:mb-3 transition-colors duration-300" style="font-family: 'Bodoni Moda', serif;">{t('dm.feature1.title')}</h3>
              <p class="text-sm md:text-base text-stone-600 dark:text-[#FAFAF9]/60 leading-relaxed font-light transition-colors duration-300">{t('dm.feature1.desc')}</p>
            </div>
          </div>
        </div>

        <!-- Semantic Search Feature -->
        <div class="group soft-spatial-card relative overflow-hidden rounded-[1.5rem] md:rounded-[2rem] p-6 md:p-10 transition-all duration-500">
          <div class="absolute -right-10 -bottom-10 w-32 h-32 md:w-40 md:h-40 bg-blue-200/50 dark:bg-blue-500/10 rounded-full blur-3xl group-hover:bg-blue-300/60 dark:group-hover:bg-blue-500/30 transition-all duration-700"></div>
          <div class="relative z-10 flex flex-col h-full space-y-6 md:space-y-8">
            <div class="w-12 h-12 md:w-14 md:h-14 rounded-xl md:rounded-2xl bg-blue-50 dark:bg-[#44403C]/80 border border-blue-100 dark:border-white/10 flex items-center justify-center text-blue-500 dark:text-blue-400 shadow-sm dark:shadow-inner transition-colors duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" class="md:w-6 md:h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><path d="m13 13-4-4"/></svg>
            </div>
            <div class="mt-auto">
              <h3 class="text-xl md:text-2xl font-serif text-stone-900 dark:text-white mb-2 md:mb-3 transition-colors duration-300" style="font-family: 'Bodoni Moda', serif;">{t('dm.feature2.title')}</h3>
              <p class="text-sm md:text-base text-stone-600 dark:text-[#FAFAF9]/60 leading-relaxed font-light transition-colors duration-300">{t('dm.feature2.desc')}</p>
            </div>
          </div>
        </div>

      </div>
    </section>

  </main>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Bodoni+Moda:wght@400;500;600;700&display=swap');
    
    /* DeepMood Soft Spatial Cards (Border-free glass) */
    .soft-spatial-card {
      border: none !important;
      background: rgba(255, 255, 255, 0.4) !important;
      backdrop-filter: blur(40px) !important;
      -webkit-backdrop-filter: blur(40px) !important;
      box-shadow: 0 30px 70px -10px rgba(202, 138, 4, 0.08), 0 15px 30px -15px rgba(0, 0, 0, 0.05) !important;
      transition: all 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }
    html.dark .soft-spatial-card {
      background: rgba(28, 25, 23, 0.3) !important;
      box-shadow: 0 40px 90px -15px rgba(0, 0, 0, 0.5), 0 0 50px -10px rgba(202, 138, 4, 0.05) !important;
    }
    .soft-spatial-card:hover {
      transform: translateY(-6px) scale(1.01);
      background: rgba(255, 255, 255, 0.5) !important;
      box-shadow: 0 45px 100px -10px rgba(202, 138, 4, 0.12), 0 20px 40px -20px rgba(0, 0, 0, 0.08) !important;
    }
    html.dark .soft-spatial-card:hover {
      background: rgba(44, 40, 60, 0.15) !important;
      box-shadow: 0 55px 120px -10px rgba(0, 0, 0, 0.7), 0 0 60px -5px rgba(202, 138, 4, 0.1) !important;
    }

    @keyframes blob {
      0% { transform: translate(0px, 0px) scale(1); filter: blur(120px); }
      33% { transform: translate(45px, -70px) scale(1.2); filter: blur(140px); }
      66% { transform: translate(-30px, 35px) scale(0.85); filter: blur(100px); }
      100% { transform: translate(0px, 0px) scale(1); filter: blur(120px); }
    }
    .animate-blob {
      animation: blob 20s infinite alternate ease-in-out;
    }
    .animation-delay-2000 {
      animation-delay: 3s;
    }
    .animation-delay-4000 {
      animation-delay: 6s;
    }
  </style>
</Layout>

---
import Layout from '../../../../layouts/Layout.astro';
import { languages } from '../../../../i18n/ui';
import { ingredients } from '../../../../data/ingredients';
import BackToStudioButton from '../../../../components/BackToStudioButton.astro';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
const currentLang = (lang as string) || 'en';

import { 
  localTranslations, 
  categories, 
  getLocalizedIngredients, 
  getCategoryCounts 
} from '../../../../utils/freshsnap/indexHelper';

const t = (key: string) => {
  return localTranslations[currentLang]?.[key] || localTranslations['en']?.[key] || key;
};

// 현재 로케일에 최적화된 식재료 정보 생성
const localizedIngredients = getLocalizedIngredients(ingredients, currentLang);

const categoryCounts = getCategoryCounts(ingredients);
---

<Layout 
  title={t('util.title')} 
  lang={currentLang}
  description={t('util.subtitle')}
  canonicalUrl={`https://selalink.net/${currentLang}/apps/freshsnap/`}
  ogType="software"
  image="/assets/images/og/freshself.png"
  appId="freshsnap"
>
  <main class="max-w-[1200px] mx-auto px-4 pt-24 pb-8 md:pt-28 md:pb-16">
    <!-- Navigation / Header Breadcrumb -->
    <BackToStudioButton lang={currentLang} theme="emerald" class="mb-6" />

    <!-- Hero Section (모바일 세로 높이 최소화 설계) -->
    <div class="text-center mb-6 md:mb-12">
      <h1 class="text-2xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-2 md:mb-4 bg-gradient-to-r from-emerald-600 to-teal-600 dark:from-emerald-400 dark:to-teal-400 bg-clip-text text-transparent">
        {t('util.title')}
      </h1>
      <p class="hidden md:block text-base md:text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed">
        {t('util.subtitle')}
      </p>

      <!-- 글로벌 신뢰성 뱃지 그룹 (모바일에서 팝오버로 전환) -->
      <div class="flex flex-col items-center gap-2 mt-4 md:mt-6 select-none relative">
        <div 
          id="trustBadgeContainer" 
          class="hidden md:flex flex-wrap justify-center gap-1.5 max-w-xl transition-all duration-300"
        >
          {[
            'WHO / FAO',
            'EFSA (EU)',
            'USDA (U.S.)',
            'FSA (UK)',
            'CDC (U.S.)',
            'MFDS (KR)',
            'RDA (KR)',
            'NIFS (KR)',
            'KCA (KR)'
          ].map((org) => (
            <span class="text-[10px] md:text-xs font-bold uppercase tracking-wider bg-slate-200/50 dark:bg-slate-800/80 text-slate-700 dark:text-slate-200 px-3 py-1.5 rounded-full border border-slate-300/80 dark:border-slate-700/80 hover:border-emerald-500 dark:hover:border-emerald-400 transition-colors duration-300">
              {org}
            </span>
          ))}
        </div>

        <!-- 모바일 전용 콤팩트 라벨 (신뢰 기관 토글 버튼) -->
        <button 
          type="button"
          id="mobileTrustTrigger" 
          class="flex md:hidden items-center gap-1.5 bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-750 px-3 py-2 rounded-xl text-[10px] font-extrabold text-slate-600 dark:text-slate-400 hover:border-emerald-500/50 dark:hover:border-emerald-400/50 transition-all cursor-pointer select-none active:scale-95"
        >
          <span>{t('util.trust.mobile')}</span>
          <span id="mobileTrustArrow" class="text-[8px] text-slate-400 inline-block transition-transform duration-300">▼</span>
        </button>

        <p class="hidden md:block text-[11px] md:text-xs text-slate-500 dark:text-slate-400 font-semibold tracking-tight">
          {t('util.trust.sub')}
        </p>
      </div>
    </div>

    <div 
      class="app-card-neon p-4 md:p-6 mb-6" 
      style="--theme-color-light: rgba(16, 185, 129, 0.15); --theme-color-brand: #10B981; --theme-color-glow: rgba(16, 185, 129, 0.15); --theme-color-glow-secondary: rgba(16, 185, 129, 0.05);"
    >
      <!-- Search Input Container with Ambient Glow -->
      <div class="relative max-w-2xl mx-auto mb-5 group/search">
        <div class="absolute -inset-0.5 bg-gradient-to-r from-emerald-500 to-teal-500 rounded-2xl blur-md opacity-0 group-focus-within/search:opacity-20 dark:group-focus-within/search:opacity-30 transition duration-500"></div>
        <div class="relative">
          <span class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400 text-lg">
            🔍
          </span>
          <input 
            type="text" 
            id="searchInput" 
            placeholder={t('util.search.placeholder')}
            class="w-full pl-12 pr-4 py-3.5 rounded-2xl bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/80 text-base focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-all font-semibold text-slate-800 dark:text-slate-100"
          />
        </div>
      </div>

      <!-- Categories Filter Slider -->
      <div class="flex items-center gap-2 overflow-x-auto pb-3.5 scrollbar-none scroll-smooth border-b border-slate-200/50 dark:border-slate-800/50">
        {categories.map((cat) => (
          <button
            data-category={cat}
            class={`category-btn flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs sm:text-sm font-semibold cursor-pointer whitespace-nowrap transition-all duration-300 border ${
              cat === 'all' 
                ? 'bg-emerald-600 border-emerald-600 text-white shadow-md shadow-emerald-600/20' 
                : 'bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 hover:border-emerald-500 dark:hover:border-emerald-500'
            }`}
          >
            <span>{t(`util.category.${cat}`)}</span>
            <span class={`count-badge px-1.5 py-0.5 text-[10px] rounded-md transition-colors ${
              cat === 'all'
                ? 'bg-emerald-700/50 text-emerald-100'
                : 'bg-slate-100 dark:bg-slate-800/80 text-slate-500 dark:text-slate-400'
            }`}>
              {categoryCounts[cat]}
            </span>
          </button>
        ))}
      </div>

      <!-- 3rd Row: Advanced Filters & Layout Controls -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mt-4">
        <div class="flex flex-wrap items-center gap-3">
          <!-- Storage Method Filter -->
          <div id="methodFilterContainer" class="flex bg-slate-100 dark:bg-slate-800/80 p-0.5 rounded-xl border border-slate-200 dark:border-slate-700/60 select-none">
            <button data-method-filter="all" class="method-filter-btn active px-3 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer">
              {t('util.filter.method.all')}
            </button>
            <button data-method-filter="room" class="method-filter-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200">
              {t('util.card.room')} 🟡
            </button>
            <button data-method-filter="fridge" class="method-filter-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200">
              {t('util.card.fridge')} 🟢
            </button>
            <button data-method-filter="freezer" class="method-filter-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200">
              {t('util.card.freezer')} 🔵
            </button>
          </div>

        </div>

        <div class="flex items-center gap-3 justify-end md:justify-start">
          <!-- Layout View Toggle -->
          <div class="flex bg-slate-100 dark:bg-slate-800/80 p-0.5 rounded-xl border border-slate-200 dark:border-slate-700/60 select-none">
            <button id="viewGridBtn" class="view-toggle-btn active px-3 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer flex items-center gap-1.5" title={t('util.view.grid')}>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 shrink-0"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
              <span class="hidden sm:inline">{t('util.view.grid')}</span>
            </button>
            <button id="viewFridgeBtn" class="view-toggle-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 flex items-center gap-1.5" title={t('util.view.fridge')}>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 shrink-0"><path d="M5 10h14M5 15h14M5 20h14"></path><rect x="3" y="3" width="18" height="18" rx="2"></rect></svg>
              <span class="hidden sm:inline">{t('util.view.fridge')}</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Grid Container with Bento Layout -->
    <div 
      id="ingredientsGrid" 
      class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-5 transition-all duration-300"
    >
      {localizedIngredients.map((item) => {
        const isFeatured = false; // 모든 식재료 카드를 1칸(col-span-1) 크기로 통일
        return (
          <div class="ingredient-item-wrapper relative group select-none col-span-1">
            <a 
              href={`/${currentLang}/apps/freshsnap/${item.id}/`}
              data-item-id={item.id}
              data-item-category={item.category}
              data-search-index={item.searchIndex}
              data-has-room={item.storage.room ? "true" : "false"}
              data-has-fridge={item.storage.fridge ? "true" : "false"}
              data-has-freezer={item.storage.freezer ? "true" : "false"}
              data-duration-room={item.storage.room?.durationDays || 0}
              data-duration-fridge={item.storage.fridge?.durationDays || 0}
              data-duration-freezer={item.storage.freezer?.durationDays || 0}
              data-recommended-method={item.recommendedMethod}
              data-recommended-label={t(`util.card.${item.recommendedMethod}.recommended`)}
              class={`ingredient-item app-card-interactive p-4 sm:p-5 w-full flex justify-between group overflow-hidden transition-all duration-300 ${
                isFeatured 
                  ? 'flex-row items-center gap-4 sm:gap-6' 
                  : 'flex-col gap-4'
              }`}
              style="--theme-color-light: rgba(16, 185, 129, 0.1); --theme-color-glow: rgba(16, 185, 129, 0.25); --theme-color-border-hover: rgba(16, 185, 129, 0.3);"
            >
              <div class={`flex gap-3 ${isFeatured ? 'flex-row items-center' : 'flex-col'}`}>
                {item.iconImage ? (
                  <img 
                    src={item.iconImage} 
                    alt={item.localName}
                    class={`${isFeatured ? 'w-[56px] h-[56px] sm:w-[64px] sm:h-[64px]' : 'w-[48px] h-[48px] sm:w-[54px] sm:h-[54px]'} object-contain group-hover:scale-105 transition-transform duration-300 select-none block`}
                    loading="lazy"
                  />
                ) : (
                  <span class={`${isFeatured ? 'text-5xl sm:text-6xl' : 'text-4xl sm:text-5xl'} group-hover:scale-105 transition-transform duration-300 select-none block w-fit`}>
                    {item.emoji}
                  </span>
                )}
                <div>
                  <h2 class="text-base sm:text-lg font-bold text-slate-800 dark:text-slate-100 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                    {item.localName}
                  </h2>
                  <span class="text-[10px] sm:text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">
                    {t(`util.category.${item.category}`).split(' ').slice(1).join(' ') || t(`util.category.${item.category}`)}
                  </span>
                </div>
              </div>

              <div class={`flex flex-col gap-2 ${isFeatured ? 'items-end shrink-0 text-right border-t-0 pt-0' : 'mt-2 pt-3 border-t border-slate-100 dark:border-slate-800/80'}`}>
                <!-- Storage Durations Badge List & Micro Sources -->
                <div class={`flex gap-2 ${isFeatured ? 'flex-col items-end' : 'items-center justify-between'}`}>
                  <div class="flex flex-wrap gap-1 text-[10px] sm:text-[11px] font-bold text-slate-600 dark:text-slate-400 justify-end duration-badges">
                    {item.storage.room && (
                      <span data-badge-method="room" class="room-badge bg-amber-50 dark:bg-amber-950/30 text-amber-800 dark:text-amber-300 px-2 py-0.5 rounded-md border border-amber-200/60 dark:border-amber-900/40 transition-all">
                        {t('util.card.room')}{' '}
                        <strong class="badge-days font-black text-amber-950 dark:text-amber-100">
                          {item.storage.room.durationDays === 9999 ? t('util.card.infinite') : item.storage.room.durationDays}
                        </strong>
                        {item.storage.room.durationDays !== 9999 && t('util.card.days')}
                      </span>
                    )}
                    {item.storage.fridge && (
                      <span data-badge-method="fridge" class="fridge-badge bg-emerald-50 dark:bg-emerald-950/30 text-emerald-800 dark:text-emerald-300 px-2 py-0.5 rounded-md border border-emerald-200/60 dark:border-emerald-900/40 transition-all">
                        {t('util.card.fridge')}{' '}
                        <strong class="badge-days font-black text-emerald-950 dark:text-emerald-100">
                          {item.storage.fridge.durationDays === 9999 ? t('util.card.infinite') : item.storage.fridge.durationDays}
                        </strong>
                        {item.storage.fridge.durationDays !== 9999 && t('util.card.days')}
                      </span>
                    )}
                    {item.storage.freezer && (
                      <span data-badge-method="freezer" class="freezer-badge bg-blue-50 dark:bg-blue-950/30 text-blue-800 dark:text-blue-300 px-2 py-0.5 rounded-md border border-blue-200/60 dark:border-blue-900/40 transition-all">
                        {t('util.card.freezer')}{' '}
                        <strong class="badge-days font-black text-blue-950 dark:text-blue-100">
                          {item.storage.freezer.durationDays === 9999 ? t('util.card.infinite') : item.storage.freezer.durationDays}
                        </strong>
                        {item.storage.freezer.durationDays !== 9999 && t('util.card.days')}
                      </span>
                    )}
                  </div>
                  
                  <!-- 마이크로 출처 뱃지 -->
                  {item.sources && item.sources.length > 0 && (
                    <div class="flex gap-0.5 opacity-80 group-hover:opacity-100 transition-opacity duration-300 select-none shrink-0">
                      {item.sources.slice(0, 2).map((src: string) => (
                        <span class="text-[9px] font-extrabold uppercase tracking-tight bg-slate-100 dark:bg-slate-800/80 text-slate-500 dark:text-slate-400 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 group-hover:border-emerald-500/20 px-1.5 py-0.5 rounded border border-slate-200 dark:border-slate-700/80 transition-colors duration-300">
                          {src}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
                
                <div class="text-[11px] sm:text-xs font-bold text-emerald-600 dark:text-emerald-400 flex items-center gap-1 mt-0.5 opacity-0 group-hover:opacity-100 translate-x-[-5px] group-hover:translate-x-0 transition-all duration-300 justify-end">
                  {t('util.card.view')}
                </div>
              </div>
            </a>
          </div>
        );
      })}
    </div>

    <!-- Refrigerator Info Banner (Hidden by default, shown in fridge view) -->
    <div id="fridgeViewInfoBanner" class="hidden max-w-4xl mx-auto mb-5 p-4 rounded-2xl bg-emerald-500/5 dark:bg-emerald-500/10 border border-emerald-500/15 text-emerald-800 dark:text-emerald-300 text-xs sm:text-sm font-semibold leading-relaxed flex items-start gap-2.5 shadow-sm">
      <span class="shrink-0 text-sm">💡</span>
      <p>{t('util.view.fridge_info')}</p>
    </div>

    <!-- Refrigerator Interior View Layout (Hidden by default) -->
    <div id="refrigeratorView" class="hidden flex flex-col gap-6 w-full max-w-4xl mx-auto transition-all duration-300">
      <!-- 1. Room Shelf (🟡 Amber Theme) -->
      <div class="refrigerator-shelf p-5 rounded-3xl border border-dashed border-amber-500/30 bg-amber-500/5 dark:bg-amber-950/5">
        <div class="flex items-center gap-2 mb-4 select-none">
          <span class="text-lg">🟡</span>
          <h3 class="text-sm sm:text-base font-bold text-amber-800 dark:text-amber-400">{t('util.view.room_shelf')}</h3>
        </div>
        <div id="roomShelfGrid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
          <!-- Room item nodes hydrated by script -->
        </div>
      </div>

      <!-- 2. Fridge Shelf (🟢 Emerald Theme) -->
      <div class="refrigerator-shelf p-5 rounded-3xl border border-dashed border-emerald-500/30 bg-emerald-500/5 dark:bg-emerald-950/5">
        <div class="flex items-center gap-2 mb-4 select-none">
          <span class="text-lg">🟢</span>
          <h3 class="text-sm sm:text-base font-bold text-emerald-800 dark:text-emerald-400">{t('util.view.fridge_shelf')}</h3>
        </div>
        <div id="fridgeShelfGrid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
          <!-- Fridge item nodes hydrated by script -->
        </div>
      </div>

      <!-- 3. Freezer Shelf (🔵 Blue Theme) -->
      <div class="refrigerator-shelf p-5 rounded-3xl border border-dashed border-blue-500/30 bg-blue-500/5 dark:bg-blue-950/5">
        <div class="flex items-center gap-2 mb-4 select-none">
          <span class="text-lg">🔵</span>
          <h3 class="text-sm sm:text-base font-bold text-blue-800 dark:text-blue-400">{t('util.view.freezer_shelf')}</h3>
        </div>
        <div id="freezerShelfGrid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
          <!-- Freezer item nodes hydrated by script -->
        </div>
      </div>
    </div>

    <!-- Empty State -->
    <div id="emptyState" class="hidden text-center py-12">
      <span class="text-4xl block mb-3">🫙</span>
      <p class="text-base text-slate-500 dark:text-slate-400">{t('util.no_results')}</p>
    </div>

    <!-- Legal Disclaimer -->
    <div class="mt-12 p-5 rounded-2xl bg-slate-100/50 dark:bg-slate-900/30 border border-slate-200/50 dark:border-slate-800/50 max-w-3xl mx-auto flex items-start gap-3 select-none">
      <span class="text-base text-slate-400 dark:text-slate-500 shrink-0">ℹ️</span>
      <p class="text-[11px] md:text-xs text-slate-500 dark:text-slate-400 leading-relaxed text-left">
        {t('util.disclaimer')}
      </p>
    </div>
  </main>

  <script src="../../../../utils/freshsnapIndex.ts"></script>
</Layout>

<style>
  /* Hide scrollbar for category filter slider */
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-none {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }
  
  /* Active state for badge inside active button */
  .category-btn.bg-emerald-600 .count-badge {
    background-color: rgba(255, 255, 255, 0.2) !important;
    color: #ffffff !important;
  }

  /* Active states for segment controls */
  .method-filter-btn.active, .view-toggle-btn.active {
    background-color: var(--theme-accent, #10B981) !important;
    color: #ffffff !important;
    box-shadow: 0 2px 8px rgba(16, 185, 129, 0.25);
  }

  /* Dimmed items and highlighted items when storage filter is active */
  .ingredient-item.dimmed {
    opacity: 0.35;
    transform: scale(0.97);
  }
  .ingredient-item.highlighted {
    border-color: var(--theme-accent, #10B981) !important;
    box-shadow: 0 10px 25px rgba(16, 185, 129, 0.12) !important;
  }
</style>

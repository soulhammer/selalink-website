---
import Layout from '../../../../layouts/Layout.astro';
import { useTranslations, languages } from '../../../../i18n/ui';

// New Sub-components
import LogSelfHero from '../../../../components/logself/LogSelfHero.astro';
import LogSelfFeatures from '../../../../components/logself/LogSelfFeatures.astro';
import LogSelfSecurity from '../../../../components/logself/LogSelfSecurity.astro';
import LogSelfInsights from '../../../../components/logself/LogSelfInsights.astro';
import LogSelfTemplates from '../../../../components/logself/LogSelfTemplates.astro';
import LogSelfThemes from '../../../../components/logself/LogSelfThemes.astro';
import BackToStudioButton from '../../../../components/BackToStudioButton.astro';
import AppBackgroundBlurs from '../../../../components/AppBackgroundBlurs.astro';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as keyof typeof languages);

const isKo = lang === 'ko';
---

<Layout title={t('app.logself.meta.title')} lang={lang} description={t('app.logself.desc')} ogType="software" appId="logself">
	<div class="bg-slate-50 dark:bg-slate-900 min-h-screen pt-4 md:pt-10 pb-20 overflow-hidden relative">
		<!-- Background decorative elements -->
		<AppBackgroundBlurs appId="logself" />

		<main class="max-w-[1240px] mx-auto px-6 relative z-10">
			<!-- Header Action -->
			<BackToStudioButton lang={lang} theme="indigo" class="mb-8" />

			<!-- Hero Section -->
			<LogSelfHero lang={lang} />

			<!-- Features Section -->
			<LogSelfFeatures lang={lang} />

			<!-- Security Section -->
			<LogSelfSecurity lang={lang} />

			<!-- Insights Section -->
			<LogSelfInsights lang={lang} />

			<!-- Templates Section -->
			<LogSelfTemplates lang={lang} />

			<!-- Themes Section -->
			<LogSelfThemes lang={lang} />

			<!-- Store Legal Links Section -->
			<section class="mt-12 pt-8 border-t border-slate-200 dark:border-slate-800 text-center text-xs text-slate-500 dark:text-slate-400 space-x-6">
				<a href={`/${lang}/apps/logself/privacy`} class="hover:text-indigo-500 dark:hover:text-indigo-400 transition-colors font-semibold">{isKo ? '개인정보처리방침' : 'Privacy Policy'}</a>
				<span class="text-slate-300 dark:text-slate-700">•</span>
				<a href={`/${lang}/apps/logself/terms`} class="hover:text-indigo-500 dark:hover:text-indigo-400 transition-colors font-semibold">{isKo ? '서비스 이용약관' : 'Terms of Service'}</a>
				<span class="text-slate-300 dark:text-slate-700">•</span>
				<a href={`/${lang}/apps/logself/data-deletion`} class="hover:text-indigo-500 dark:hover:text-indigo-400 transition-colors font-semibold">{isKo ? '데이터 삭제 안내' : 'Data Deletion'}</a>
			</section>
		</main>
	</div>
</Layout>

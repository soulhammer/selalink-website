---
import Layout from '../../../../layouts/Layout.astro';
import { useTranslations, languages } from '../../../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as keyof typeof languages);
---
<Layout title={`BuildSelf - ${languages[lang]}`} lang={lang} description={t('app.buildself.desc')} ogType="software">
	<!-- Override default dark bg constraint if we want this page uniquely themed -->
	<style>
		:root {
			--bs-primary: #0D9488;
			--bs-secondary: #14B8A6;
			--bs-cta: #F97316;
		}
		
		/* BuildSelf specific animations */
		.footprint-card {
			transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
		}
		.footprint-card:hover {
			transform: scale(1.02) translateY(-4px);
			box-shadow: 0 20px 40px -10px rgba(13, 148, 136, 0.15);
		}
		
		.app-button {
			transition: all 0.3s ease;
		}
		.app-button:hover {
			transform: translateY(-2px);
			box-shadow: 0 10px 25px -5px var(--bs-primary);
		}
	</style>

	<div class="bg-slate-50 dark:bg-slate-900 min-h-screen pt-20 pb-32 overflow-hidden relative">
		<!-- Background decorative elements -->
		<div class="absolute top-0 right-0 -mr-40 -mt-40 w-96 h-96 rounded-full bg-teal-400/20 dark:bg-teal-600/10 blur-3xl pointer-events-none"></div>
		<div class="absolute bottom-40 left-0 -ml-40 w-80 h-80 rounded-full bg-orange-400/10 dark:bg-orange-600/10 blur-3xl pointer-events-none"></div>

		<main class="max-w-[1240px] mx-auto px-6 relative z-10">
			<!-- Header Action -->
			<div class="mb-16">
				<a href={`/${lang}/`} class="inline-flex items-center text-sm font-semibold text-teal-600 dark:text-teal-400 hover:text-teal-800 dark:hover:text-teal-300 transition-colors">
					<svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
					Back to SelaLink Studio
				</a>
			</div>

			<!-- Hero Section - Spatial Design Integration -->
			<section class="flex flex-col lg:flex-row items-center justify-between gap-8 lg:gap-20 mb-20 md:mb-32">
				<div class="flex-1 space-y-6 md:space-y-8 w-full max-w-2xl lg:max-w-xl z-20 text-center lg:text-left">
					<!-- Ultra-Clean Localized Badge -->
					<div class="inline-flex items-center px-4 py-2 rounded-full bg-orange-50 dark:bg-orange-500/10 border border-orange-200 dark:border-orange-500/30 shadow-sm mx-auto lg:mx-0 w-max">
						<div class="flex items-center gap-2">
							<span class="w-1.5 md:w-2 h-1.5 md:h-2 rounded-full bg-orange-500 animate-pulse"></span>
							<span class="text-base leading-none">🌍</span>
						</div>
						<div class="w-[1px] h-4 bg-orange-300 dark:bg-orange-500/50 mx-3"></div>
						<span class="font-bold text-orange-600 dark:text-orange-400 text-sm tracking-tight">{t('app.buildself.supported')}</span>
					</div>
					<h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black text-slate-900 dark:text-white leading-[1.1] tracking-tight whitespace-pre-line mx-auto lg:mx-0">
						{t('bs.hero.title')}
					</h1>
					<p class="text-lg md:text-xl text-slate-600 dark:text-slate-400 leading-relaxed font-medium mx-auto lg:mx-0">
						{t('app.buildself.desc')}
					</p>
					
					<div class="flex flex-col sm:flex-row gap-3 md:gap-4 pt-4 md:pt-6 justify-center lg:justify-start w-full">
						<button disabled class="flex items-center justify-center gap-3 bg-slate-200/50 dark:bg-slate-800/50 border border-slate-300 dark:border-slate-700 text-slate-500 dark:text-slate-400 px-6 md:px-8 py-3 md:py-4 rounded-xl md:rounded-2xl font-bold text-base md:text-lg opacity-70 cursor-not-allowed backdrop-blur-sm w-full sm:w-auto">
							<svg class="w-5 h-5 md:w-6 md:h-6 opacity-70" fill="currentColor" viewBox="0 0 24 24"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.253 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.04 2.26-.79 3.59-.76 2.6.04 4.19 1.45 4.8 1.8-3.1 1.76-2.58 5.86.37 6.94-1.04 2.45-2.51 3.5-3.84 4.19zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
							<div class="flex flex-col items-start leading-tight">
								<span>{t('bs.download.appstore')}</span>
								<span class="text-[9px] md:text-[10px] font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400 mt-0.5">Coming Soon</span>
							</div>
						</button>
						<a href="https://play.google.com/store/apps/details?id=com.selalink.buildself" target="_blank" rel="noopener noreferrer" class="app-button flex items-center justify-center gap-3 bg-teal-600 hover:bg-teal-500 text-white px-6 md:px-8 py-3 md:py-4 rounded-xl md:rounded-2xl font-bold text-base md:text-lg cursor-pointer shadow-xl shadow-teal-600/30 w-full sm:w-auto">
							<svg class="w-5 h-5 md:w-6 md:h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M3 20.5v-17c0-.83.67-1.5 1.5-1.5.34 0 .66.12.92.33l13.62 10.15c.67.5.76 1.45.19 2.06l-13.62 10.15a1.5 1.5 0 01-2.42-1.2v-1.92z"/></svg>
							{t('bs.download.playstore')}
						</a>
					</div>
				</div>

				<!-- Premium 3D Glassmorphism Image Stack -->
				<div class="flex-1 w-full h-auto lg:h-[650px] relative flex flex-col items-center justify-center perspective-[1200px] mt-12 lg:mt-0 z-10 pointer-events-none">
					<!-- Back Image (Analytics/Consistency) - Hidden on mobile/tablet for clarity -->
					<div class="hidden lg:block absolute right-4 top-10 w-[70%] max-w-[320px] rounded-[2.5rem] p-1.5 bg-white/30 dark:bg-slate-800/30 backdrop-blur-xl border border-white/40 dark:border-white/10 shadow-2xl transform rotate-6 hover:rotate-3 transition-all duration-700 opacity-90">
						<img src="/assets/images/4.jpeg" alt="BuildSelf Consistency Tracking" class="w-full h-auto rounded-[2.2rem] shadow-inner object-cover" loading="lazy" />
					</div>
					
					<!-- Front Image (Daily Routine) - Relative and centered on mobile/tablet -->
					<div class="relative lg:absolute lg:left-4 lg:bottom-10 w-[85%] sm:w-[60%] lg:w-[75%] max-w-[340px] rounded-[2rem] lg:rounded-[2.5rem] p-1.5 lg:p-2 bg-white/70 dark:bg-slate-700/60 backdrop-blur-2xl border border-white/80 dark:border-white/20 shadow-[-10px_10px_40px_rgba(0,0,0,0.15)] lg:shadow-[-20px_20px_60px_rgba(0,0,0,0.15)] dark:shadow-[-20px_30px_70px_rgba(0,0,0,0.6)] transform -rotate-3 hover:transform-none transition-all duration-700 z-10 footprint-card mx-auto lg:mx-0">
						<img src="/assets/images/1.jpeg" alt="Daily Routine Check Main UI" class="w-full h-auto rounded-[1.8rem] lg:rounded-[2rem] shadow-sm object-cover" loading="eager" />
						
						<!-- Floating Glass Chip -->
						<div class="absolute -left-2 lg:-left-6 top-16 lg:top-20 bg-white/90 dark:bg-slate-800/90 backdrop-blur-md px-3 lg:px-4 py-2 lg:py-3 rounded-xl lg:rounded-2xl border border-slate-100 dark:border-slate-700 shadow-xl flex items-center gap-2 lg:gap-3 transform -rotate-6 z-10">
							<div class="w-6 h-6 lg:w-8 lg:h-8 rounded-full bg-teal-100 dark:bg-teal-500/20 flex items-center justify-center text-teal-600 dark:text-teal-400 text-xs lg:text-base">✓</div>
							<div class="text-xs lg:text-sm font-bold text-slate-800 dark:text-slate-200 shadow-sm lg:shadow-none bg-slate-100 dark:bg-slate-700 lg:bg-transparent lg:dark:bg-transparent rounded-full lg:rounded-none px-2.5 py-1 lg:p-0">{t('bs.demo.drink')}</div>
						</div>

						<!-- Sleek Live Translation Pill (Static, Elegant) -->
						<div class="absolute -right-2 lg:-right-8 top-32 lg:top-1/3 bg-white/95 dark:bg-slate-800/95 backdrop-blur-xl px-4 py-3 rounded-full border border-slate-200/80 dark:border-slate-700/80 shadow-[0_15px_30px_rgba(0,0,0,0.12)] dark:shadow-[0_15px_30px_rgba(0,0,0,0.6)] flex items-center gap-3 transform rotate-2 hover:-rotate-1 hover:scale-105 transition-all duration-500 z-20 tooltip-hover-group group">
							<!-- Glowing Translator Icon -->
							<div class="w-7 h-7 rounded-full bg-gradient-to-br from-orange-100 to-orange-50 dark:from-orange-500/20 dark:to-orange-500/5 flex items-center justify-center text-orange-600 dark:text-orange-400 border border-orange-200/50 dark:border-orange-500/20 shadow-inner group-hover:scale-110 transition-transform">
								<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 6C11.642 9.073 9.4 12 7 12m0 0a17.964 17.964 0 01-4-1.5"/></svg>
							</div>
							
							<!-- Static Text Container -->
							<div class="text-sm font-bold text-slate-800 dark:text-slate-200 tracking-tight text-left flex items-center font-sans tracking-wide">
								{t('bs.demo.complete')}
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- 2026 Bento Image Grid Section -->
			<section class="mb-32">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
					
					<!-- Feature 1: Anti-Streak (Bottom Half Image) -->
					<div class="footprint-card flex flex-col pt-8 md:pt-12 px-6 md:px-10 items-center bg-white dark:bg-slate-800/60 rounded-[2rem] md:rounded-[3rem] border border-slate-200/80 dark:border-slate-700/80 shadow-2xl shadow-slate-200/50 dark:shadow-none relative overflow-hidden backdrop-blur-xl group">
						<div class="w-12 h-12 md:w-16 md:h-16 bg-gradient-to-br from-orange-100 to-orange-50 dark:from-orange-500/20 dark:to-orange-500/5 text-orange-600 dark:text-orange-400 rounded-full flex items-center justify-center mb-6 md:mb-8 self-start border border-orange-200 dark:border-orange-500/20 shadow-inner">
							<svg class="w-6 h-6 md:w-8 md:h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
						</div>
						<div class="flex-1 w-full flex flex-col items-start min-h-[160px] md:min-h-0">
							<h3 class="text-2xl md:text-3xl font-black text-slate-900 dark:text-white mb-3 md:mb-4 tracking-tight">{t('bs.feature1.title')}</h3>
							<p class="text-base md:text-lg text-slate-600 dark:text-slate-400 leading-relaxed font-medium mb-8 md:mb-12 max-w-sm">{t('bs.feature1.desc')}</p>
						</div>
						
						<div class="w-full mt-auto relative rounded-[1.5rem] md:rounded-t-[2rem] overflow-hidden border border-slate-200 dark:border-slate-600 shadow-[0_-10px_40px_rgba(0,0,0,0.08)] transform group-hover:translate-y-0 md:group-hover:translate-y-2 transition-transform duration-500 mb-6 md:mb-0">
							<div class="aspect-[4/3] w-full">
								<img src="/assets/images/3.jpeg" alt="Detailed Habit Log" class="w-full h-full object-cover object-top hover:scale-105 transition-transform duration-700" loading="lazy" />
							</div>
							<div class="absolute inset-x-0 bottom-0 h-16 md:h-24 bg-gradient-to-t from-white dark:from-slate-800 to-transparent pointer-events-none rounded-b-[1.5rem] md:rounded-none"></div>
						</div>
					</div>

					<!-- Feature 2: Flexibility Organizer (Dark Vibrant Teal Card) -->
					<div class="footprint-card flex flex-col pt-8 md:pt-12 px-6 md:px-10 items-center bg-gradient-to-b from-teal-600 to-teal-800 dark:from-teal-700 dark:to-teal-900 rounded-[2rem] md:rounded-[3rem] border border-teal-500 dark:border-teal-600 shadow-2xl shadow-teal-600/30 text-white relative overflow-hidden group">
						<div class="absolute -bottom-10 md:-bottom-20 -right-10 md:-right-20 w-64 md:w-80 h-64 md:h-80 bg-teal-400/40 rounded-full blur-3xl pointer-events-none"></div>
						<div class="absolute top-0 right-0 w-48 md:w-64 h-48 md:h-64 bg-teal-500/30 rounded-full blur-3xl pointer-events-none"></div>
						
						<div class="w-12 h-12 md:w-16 md:h-16 bg-white/20 text-white rounded-full flex items-center justify-center mb-6 md:mb-8 self-start backdrop-blur-md border border-white/20 shadow-inner z-10">
							<svg class="w-6 h-6 md:w-8 md:h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
						</div>
						<div class="flex-1 w-full flex flex-col items-start z-10 min-h-[160px] md:min-h-0">
							<h3 class="text-2xl md:text-3xl font-black mb-3 md:mb-4 tracking-tight">{t('bs.feature2.title')}</h3>
							<p class="text-base md:text-lg text-teal-50 leading-relaxed font-medium mb-8 md:mb-12 max-w-sm">{t('bs.feature2.desc')}</p>
						</div>
						
						<div class="w-[95%] md:w-full mt-auto relative flex justify-center rounded-[1.5rem] md:rounded-t-[2rem] overflow-hidden shadow-[0_-15px_50px_rgba(0,0,0,0.2)] border border-teal-400/30 transform group-hover:translate-y-0 md:group-hover:translate-y-2 transition-transform duration-500 z-10 mb-6 md:mb-0">
							<div class="aspect-[4/3] w-full">
								<img src="/assets/images/2.jpeg" alt="Flexible Organizer Tags" class="w-full h-full object-cover object-top hover:scale-105 transition-transform duration-700" loading="lazy" />
							</div>
						</div>
					</div>
				</div>
			</section>
		</main>
	</div>
</Layout>

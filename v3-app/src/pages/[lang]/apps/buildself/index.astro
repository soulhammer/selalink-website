---
import Layout from '../../../../layouts/Layout.astro';
import { useTranslations, languages } from '../../../../i18n/ui';
import ShortsGallery from '../../../../components/ShortsGallery.astro';
import MentorMarquee from '../../../../components/MentorMarquee.astro';

// New Sub-components
import BuildSelfHero from '../../../../components/buildself/BuildSelfHero.astro';
import BuildSelfFeatures from '../../../../components/buildself/BuildSelfFeatures.astro';
import BuildSelfMentors from '../../../../components/buildself/BuildSelfMentors.astro';
import BuildSelfCalendar from '../../../../components/buildself/BuildSelfCalendar.astro';
import BackToStudioButton from '../../../../components/BackToStudioButton.astro';
import AppBackgroundBlurs from '../../../../components/AppBackgroundBlurs.astro';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as keyof typeof languages);
---
<Layout title={t('app.buildself.meta.title')} lang={lang} description={t('app.buildself.desc')} ogType="software" image="/assets/images/og/buildself.png" appId="buildself">
	<div class="bg-slate-50 dark:bg-slate-900 min-h-screen pt-4 md:pt-10 pb-20 overflow-hidden relative">
		<!-- Background decorative elements -->
		<AppBackgroundBlurs appId="buildself" />

		<main class="max-w-[1240px] mx-auto px-6 relative z-10">
			<!-- Header Action -->
			<BackToStudioButton lang={lang} theme="teal" class="mb-8" />

			<!-- Hero Section -->
			<BuildSelfHero lang={lang} />

			<!-- Features Section -->
			<BuildSelfFeatures lang={lang} />

			<!-- Mentors Section -->
			<BuildSelfMentors lang={lang} />

			<!-- Calendar Section -->
			<BuildSelfCalendar lang={lang} />

			<!-- Premium Mentor Marquee Section -->
			<MentorMarquee lang={lang} />

			<!-- Full Shorts Gallery -->
			<ShortsGallery lang={lang} />
		</main>
	</div>
</Layout>

<Layout 
  title={t('util.title')} 
  lang={currentLang}
  description={t('util.subtitle')}
  canonicalUrl={`https://selalink.net/${currentLang}/apps/storeself/`}
  ogType="website"
  image="/assets/images/og/freshself.png"
  appId="storeself"
>
  <main class="max-w-[1200px] mx-auto px-4 pt-24 pb-8 md:pt-28 md:pb-16">
    <!-- Navigation / Header Breadcrumb -->
    <div class="mb-6 flex flex-col md:flex-row items-start md:items-center justify-between">
      <a href={`/${currentLang}/`} class="group inline-flex items-center space-x-2 text-emerald-600 dark:text-emerald-400 hover:text-emerald-800 dark:hover:text-emerald-300 transition-colors duration-300">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:-translate-x-1">
          <path d="m15 18-6-6 6-6"/>
        </svg>
        <span class="text-sm font-medium tracking-wide">Back to SelaLink Studio</span>
      </a>
    </div>

    <!-- Hero Section -->
    <div class="text-center mb-8 md:mb-14">
      <h1 class="text-3xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-4 bg-gradient-to-r from-emerald-600 to-teal-600 dark:from-emerald-400 dark:to-teal-400 bg-clip-text text-transparent">
        {t('util.title')}
      </h1>
      <p class="text-base md:text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed">
        {t('util.subtitle')}
      </p>

      <!-- 글로벌 신뢰성 뱃지 그룹 (대비 대폭 개선) -->
      <div class="flex flex-col items-center gap-2 mt-6 select-none">
        <div class="flex flex-wrap justify-center gap-1.5 max-w-xl">
          {[
            'WHO / FAO',
            'EFSA (EU)',
            'USDA (U.S.)',
            'FSA (UK)',
            'CDC (U.S.)',
            'MFDS (KR)',
            'RDA (KR)',
            'NIFS (KR)',
            'KCA (KR)'
          ].map((org) => (
            <span class="text-[10px] md:text-xs font-bold uppercase tracking-wider bg-slate-200/50 dark:bg-slate-800/80 text-slate-700 dark:text-slate-200 px-3 py-1.5 rounded-full border border-slate-300/80 dark:border-slate-700/80 hover:border-emerald-500 dark:hover:border-emerald-400 transition-colors duration-300">
              {org}
            </span>
          ))}
        </div>
        <p class="text-[11px] md:text-xs text-slate-500 dark:text-slate-400 font-semibold tracking-tight">
          {t('util.trust.sub')}
        </p>
      </div>
    </div>

    <!-- Search Input & Filters Bento Group -->
    <div class="bento-card p-4 md:p-6 mb-6" style="--glow-color: rgba(16,185,129,0.15);">
      <!-- Search Input Container with Ambient Glow -->
      <div class="relative max-w-2xl mx-auto mb-5 group/search">
        <div class="absolute -inset-0.5 bg-gradient-to-r from-emerald-500 to-teal-500 rounded-2xl blur-md opacity-0 group-focus-within/search:opacity-20 dark:group-focus-within/search:opacity-30 transition duration-500"></div>
        <div class="relative">
          <span class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400 text-lg">
            🔍
          </span>
          <input 
            type="text" 
            id="searchInput" 
            placeholder={t('util.search.placeholder')}
            class="w-full pl-12 pr-4 py-3.5 rounded-2xl bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/80 text-base focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-all font-semibold text-slate-800 dark:text-slate-100"
          />
        </div>
      </div>

      <!-- Categories Filter Slider -->
      <div class="flex items-center gap-2 overflow-x-auto pb-1.5 scrollbar-none scroll-smooth">
        {categories.map((cat) => (
          <button
            data-category={cat}
            class={`category-btn flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs sm:text-sm font-semibold cursor-pointer whitespace-nowrap transition-all duration-300 border ${
              cat === 'all' 
                ? 'bg-emerald-600 border-emerald-600 text-white shadow-md shadow-emerald-600/20' 
                : 'bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 hover:border-emerald-500 dark:hover:border-emerald-500'
            }`}
          >
            <span>{t(`util.category.${cat}`)}</span>
            <span class={`count-badge px-1.5 py-0.5 text-[10px] rounded-md transition-colors ${
              cat === 'all'
                ? 'bg-emerald-700/50 text-emerald-100'
                : 'bg-slate-100 dark:bg-slate-800/80 text-slate-500 dark:text-slate-400'
            }`}>
              {categoryCounts[cat]}
            </span>
          </button>
        ))}
      </div>
    </div>

    <!-- Grid Container with Bento Layout -->
    <div 
      id="ingredientsGrid" 
      class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-5 transition-opacity duration-300"
    >
      {localizedIngredients.map((item) => {
        const isFeatured = ['green-onion', 'onion', 'milk'].includes(item.id);
        return (
          <a 
            href={`/${currentLang}/apps/storeself/${item.id}/`}
            data-item-category={item.category}
            data-search-index={item.searchIndex}
            class={`ingredient-item bento-card p-4 sm:p-5 flex justify-between group overflow-hidden transition-all duration-300 ${
              isFeatured 
                ? 'col-span-2 row-span-1 flex-row items-center gap-4 sm:gap-6' 
                : 'flex-col col-span-1 gap-4'
            }`}
            style="--glow-color: rgba(16,185,129,0.12);"
          >
            <div class={`flex gap-3 ${isFeatured ? 'flex-row items-center' : 'flex-col'}`}>
              {item.iconImage ? (
                <img 
                  src={item.iconImage} 
                  alt={item.localName}
                  class={`${isFeatured ? 'w-[56px] h-[56px] sm:w-[64px] sm:h-[64px]' : 'w-[48px] h-[48px] sm:w-[54px] sm:h-[54px]'} object-contain group-hover:scale-105 transition-transform duration-300 select-none block`}
                  loading="lazy"
                />
              ) : (
                <span class={`${isFeatured ? 'text-5xl sm:text-6xl' : 'text-4xl sm:text-5xl'} group-hover:scale-105 transition-transform duration-300 select-none block w-fit`}>
                  {item.emoji}
                </span>
              )}
              <div>
                <h2 class="text-base sm:text-lg font-bold text-slate-800 dark:text-slate-100 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                  {item.localName}
                </h2>
                <span class="text-[10px] sm:text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">
                  {t(`util.category.${item.category}`).split(' ').slice(1).join(' ') || t(`util.category.${item.category}`)}
                </span>
              </div>
            </div>

            <div class={`flex flex-col gap-2 ${isFeatured ? 'items-end shrink-0 text-right border-t-0 pt-0' : 'mt-2 pt-3 border-t border-slate-100 dark:border-slate-800/80'}`}>
              <!-- Storage Durations Badge List & Micro Sources -->
              <div class={`flex gap-2 ${isFeatured ? 'flex-col items-end' : 'items-center justify-between'}`}>
                <div class="flex flex-wrap gap-1 text-[10px] sm:text-[11px] font-bold text-slate-600 dark:text-slate-400 justify-end">
                  {item.storage.room && (
                    <span class="bg-amber-100/60 dark:bg-amber-950/40 text-amber-800 dark:text-amber-300 px-2 py-0.5 rounded-md border border-amber-200/20 dark:border-amber-900/20">
                      {t('util.card.room')} {item.storage.room.durationDays}{t('util.card.days')}
                    </span>
                  )}
                  {item.storage.fridge && (
                    <span class="bg-emerald-100/60 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300 px-2 py-0.5 rounded-md border border-emerald-200/20 dark:border-emerald-900/20">
                      {t('util.card.fridge')} {item.storage.fridge.durationDays}{t('util.card.days')}
                    </span>
                  )}
                  {item.storage.freezer && (
                    <span class="bg-blue-100/60 dark:bg-blue-950/40 text-blue-800 dark:text-blue-300 px-2 py-0.5 rounded-md border border-blue-200/20 dark:border-blue-900/20">
                      {t('util.card.freezer')} {item.storage.freezer.durationDays}{t('util.card.days')}
                    </span>
                  )}
                </div>
                
                <!-- 마이크로 출처 뱃지 (가독성 확보를 위해 opacity 상향 조정 및 선명한 보더 라인 추가) -->
                {item.sources && item.sources.length > 0 && (
                  <div class="flex gap-0.5 opacity-80 group-hover:opacity-100 transition-opacity duration-300 select-none shrink-0">
                    {item.sources.slice(0, 2).map((src) => (
                      <span class="text-[9px] font-extrabold uppercase tracking-tight bg-slate-100 dark:bg-slate-800/80 text-slate-500 dark:text-slate-400 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 group-hover:border-emerald-500/20 px-1.5 py-0.5 rounded border border-slate-200 dark:border-slate-700/80 transition-colors duration-300">
                        {src}
                      </span>
                    ))}
                  </div>
                )}
              </div>
              
              <div class="text-[11px] sm:text-xs font-bold text-emerald-600 dark:text-emerald-400 flex items-center gap-1 mt-0.5 opacity-0 group-hover:opacity-100 translate-x-[-5px] group-hover:translate-x-0 transition-all duration-300 justify-end">
                {t('util.card.view')}
              </div>
            </div>
          </a>
        );
      })}
    </div>

    <!-- Empty State -->
    <div id="emptyState" class="hidden text-center py-12">
      <span class="text-4xl block mb-3">🫙</span>
      <p class="text-base text-slate-500 dark:text-slate-400">{t('util.no_results')}</p>
    </div>

    <!-- Legal Disclaimer -->
    <div class="mt-12 p-5 rounded-2xl bg-slate-100/50 dark:bg-slate-900/30 border border-slate-200/50 dark:border-slate-800/50 max-w-3xl mx-auto flex items-start gap-3 select-none">
      <span class="text-base text-slate-400 dark:text-slate-500 shrink-0">ℹ️</span>
      <p class="text-[11px] md:text-xs text-slate-500 dark:text-slate-400 leading-relaxed text-left">
        {t('util.disclaimer')}
      </p>
    </div>
  </main>

  <script>
    // Client-side search and filtering logic
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    const categoryButtons = document.querySelectorAll('.category-btn');
    const ingredientItems = document.querySelectorAll('.ingredient-item') as NodeListOf<HTMLElement>;
    const emptyState = document.getElementById('emptyState') as HTMLElement;
    const grid = document.getElementById('ingredientsGrid') as HTMLElement;

    let activeCategory = 'all';
    let searchQuery = '';

    const filterIngredients = () => {
      let visibleCount = 0;

      ingredientItems.forEach((item) => {
        const cat = item.getAttribute('data-item-category') || '';
        const searchIndex = item.getAttribute('data-search-index') || '';
        
        const matchesCategory = activeCategory === 'all' || cat === activeCategory;
        const matchesSearch = searchIndex.includes(searchQuery);

        if (matchesCategory && matchesSearch) {
          item.classList.remove('hidden');
          visibleCount++;
        } else {
          item.classList.add('hidden');
        }
      });

      if (visibleCount === 0) {
        emptyState.classList.remove('hidden');
        grid.classList.add('opacity-0');
        setTimeout(() => {
          if (document.getElementById('emptyState')?.classList.contains('hidden') === false) {
            grid.classList.add('hidden');
          }
        }, 150);
      } else {
        emptyState.classList.add('hidden');
        grid.classList.remove('hidden', 'opacity-0');
      }
    };

    // Search Input Event
    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
      filterIngredients();
    });

    // Category Button Click Events
    categoryButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        // Toggle active states
        categoryButtons.forEach((b) => {
          b.classList.remove('bg-emerald-600', 'border-emerald-600', 'text-white', 'shadow-md', 'shadow-emerald-600/20');
          b.classList.add('bg-white', 'dark:bg-slate-900', 'border-slate-200', 'dark:border-slate-800', 'text-slate-700', 'dark:text-slate-300');
        });

        btn.classList.remove('bg-white', 'dark:bg-slate-900', 'border-slate-200', 'dark:border-slate-800', 'text-slate-700', 'dark:text-slate-300');
        btn.classList.add('bg-emerald-600', 'border-emerald-600', 'text-white', 'shadow-md', 'shadow-emerald-600/20');

        activeCategory = btn.getAttribute('data-category') || 'all';
        filterIngredients();
      });
    });

    // Spatial Glow hydration logic for dynamically updated layouts
    document.querySelectorAll('.bento-card').forEach((card) => {
      let glow = card.querySelector('.bento-glow');
      if (!glow) {
        glow = document.createElement('div');
        glow.className = 'bento-glow';
        card.prepend(glow);
      }
      
      card.addEventListener('mousemove', (e: any) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        (glow as HTMLElement).style.setProperty('--mouse-x', `${x}px`);
        (glow as HTMLElement).style.setProperty('--mouse-y', `${y}px`);
      });
    });
  </script>
</Layout>

<style>
  /* Hide scrollbar for category filter slider */
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-none {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }
  
  /* Active state for badge inside active button */
  .category-btn.bg-emerald-600 .count-badge {
    background-color: rgba(255, 255, 255, 0.2) !important;
    color: #ffffff !important;
  }
</style>

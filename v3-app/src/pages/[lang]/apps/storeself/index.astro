  }
};

const t = (key: string) => {
  return localTranslations[currentLang]?.[key] || localTranslations['en']?.[key] || key;
};

// 공식 출처 다국어 번역 사전 (검색 인덱스 확장을 위함)
const sourceTranslations: Record<string, Record<string, string>> = {
  ko: {
    'source.MFDS': '식품의약품안전처 식약처',
    'source.RDA': '농촌진흥청 농진청',
    'source.USDA': '미국 농무부 USDA',
    'source.EFSA': '유럽식품안전청 EFSA',
    'source.FSA': '영국 식품기준청 FSA',
    'source.CDC': '미국 질병통제예방센터 CDC',
    'source.KCA': '한국소비자원 소비자원',
    'source.NIFS': '국립수산과학원 수산과학원',
    'source.WHO': '세계보건기구 WHO FAO'
  },
  en: {
    'source.MFDS': 'MFDS Ministry of Food and Drug Safety',
    'source.RDA': 'RDA Rural Development Administration',
    'source.USDA': 'USDA U.S. Department of Agriculture',
    'source.EFSA': 'EFSA European Food Safety Authority',
    'source.FSA': 'FSA Food Standards Agency',
    'source.CDC': 'CDC Centers for Disease Control and Prevention',
    'source.KCA': 'KCA Korea Consumer Agency',
    'source.NIFS': 'NIFS National Institute of Fisheries Science',
    'source.WHO': 'WHO World Health Organization FAO'
  }
};

// 현재 로케일에 최적화된 식재료 정보 생성
const localizedIngredients = ingredients.map((item) => {
  const localName = item.names[currentLang] || item.names['en'];
  
  // 추천 보관 방식 결정 (상세 페이지와 동일)
  const getRecommendedMethod = () => {
    if (item.storage.fridge && item.storage.fridge.durationDays > 0) return 'fridge';
    if (item.storage.room && item.storage.room.durationDays > 0) return 'room';
    if (item.storage.freezer && item.storage.freezer.durationDays > 0) return 'freezer';
    return item.storage.fridge ? 'fridge' : (item.storage.room ? 'room' : 'freezer');
  };
  
  const recommendedMethod = getRecommendedMethod();
  const guide = item.storage[recommendedMethod];
  const sources = guide?.sources || [];
  
  // 검색 인덱스에 출처 다국어 명칭 및 약어 추가 (기획안 C)
  let sourceKeywords = sources.join(' ');
  sources.forEach((src) => {
    const koText = sourceTranslations['ko']?.[`source.${src}`] || '';
    const enText = sourceTranslations['en']?.[`source.${src}`] || '';
    sourceKeywords += ` ${koText} ${enText}`;
  });

  const localSearchKeywords = item.searchKeywords?.[currentLang] || item.searchKeywords?.['en'] || [];
  
  return {
    ...item,
    localName,
    recommendedMethod,
    sources,
    // 검색 인덱스를 위한 키워드 결합 (다국어 동의어 대응)
    searchIndex: `${localName.toLowerCase()} ${item.id} ${item.category} ${localSearchKeywords.join(' ').toLowerCase()} ${sourceKeywords.toLowerCase()}`
  };
});

const categories = [
  'all',
  'vegetable',
  'fruit',
  'dairy',
  'meat',
  'seafood',
  'grain',
  'condiment',
  'etc'
];

const categoryCounts = categories.reduce((acc, cat) => {
  if (cat === 'all') {
    acc[cat] = ingredients.length;
  } else {
    acc[cat] = ingredients.filter((item) => item.category === cat).length;
  }
  return acc;
}, {} as Record<string, number>);

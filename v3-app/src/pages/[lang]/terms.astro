---
import Layout from '../../layouts/Layout.astro';
import { useTranslations, languages } from '../../i18n/ui';

export function getStaticPaths() {
  const locales = Object.keys(languages);
  return locales.map((lang) => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as keyof typeof languages);

const isKo = lang === 'ko';
const title = isKo ? "SelaLink Studio 서비스 이용약관" : "SelaLink Studio Terms of Service";
---

<Layout 
  title={title} 
  lang={lang as string} 
  robots="noindex, follow"
>
  <main class="w-full min-h-screen pt-32 pb-24 px-6">
    <div class="max-w-3xl mx-auto flex flex-col items-start gap-8">
      <a href={`/${lang}/`} class="group inline-flex items-center space-x-2 text-teal-600 dark:text-teal-400 hover:opacity-80 transition-opacity duration-300">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:-translate-x-1 transition-transform">
          <path d="m15 18-6-6 6-6"/>
        </svg>
        <span class="text-sm font-medium tracking-wide">{isKo ? "홈으로 돌아가기" : "Back to Home"}</span>
      </a>
      
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        {title}
      </h1>
      
      <div class="w-full h-px bg-slate-200 dark:bg-slate-800 mt-4 mb-4"></div>
      
      <div class="policy-content max-w-none w-full leading-relaxed font-light text-[0.95rem] space-y-6 text-slate-700 dark:text-slate-300">
        {isKo ? (
          <>
            <p><strong>시행일:</strong> 2026년 7월 2일</p>
            <p>SelaLink Studio의 서비스에 오신 것을 환영합니다. 본 약관은 회사가 제공하는 웹사이트 및 애플리케이션(BuildSelf, FreshSelf, logSelf, StoreSelf)의 이용 조건과 권리 관계를 정의합니다.</p>
            
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mt-8 mb-2">1. 서비스의 이용</h3>
            <ul class="list-disc pl-6 space-y-2">
              <li>회원은 본인의 디바이스 및 소셜 계정 보안에 대한 책임을 집니다.</li>
              <li>기기 내부 오프라인 저장 방식인 logSelf 등의 서비스는 회사 서버에 백업을 저장하지 않습니다. 따라서 앱 삭제 또는 기기 교체 시 발생하는 데이터 유실에 대한 책임은 회원에게 있습니다.</li>
            </ul>

            <h3 class="text-xl font-bold text-slate-900 dark:text-white mt-8 mb-2">2. 면책조항 및 책임의 한계</h3>
            <ul class="list-disc pl-6 space-y-2">
              <li>SelaLink 서비스 내에서 제공되는 건강 습관(루틴), 반려동물 가이드, 식재료 보관 기한 등 모든 정보는 일반적인 참고용입니다. 이는 전문의나 행동학 전문가의 소견을 대체할 수 없습니다.</li>
              <li>서비스는 "있는 그대로" 제공되며, 서비스 이용 중 발생한 건강 문제, 데이터 유실, 손실에 대해 회사는 법적 책임을 지지 않습니다.</li>
            </ul>

            <h3 class="text-xl font-bold text-slate-900 dark:text-white mt-8 mb-2">3. 문의사항</h3>
            <p>이용약관 및 제안 사항은 <a href="mailto:support@selalink.net" class="text-teal-600 dark:text-teal-400 underline">support@selalink.net</a>으로 언제든지 문의해 주시기 바랍니다.</p>
          </>
        ) : (
          <>
            <p><strong>Effective Date:</strong> July 2, 2026</p>
            <p>Welcome to SelaLink Studio. By accessing our website or using our mobile and web applications (BuildSelf, FreshSelf, logSelf, and StoreSelf), you agree to be bound by these Terms of Service.</p>
            
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mt-8 mb-2">1. Use of Services</h3>
            <ul class="list-disc pl-6 space-y-2">
              <li>You are responsible for maintaining the security of your device and accounts.</li>
              <li>For local-only applications (like logSelf), we do not store backups on our servers. You acknowledge that uninstalling the app or replacing your device without manual export may result in permanent data loss.</li>
            </ul>

            <h3 class="text-xl font-bold text-slate-900 dark:text-white mt-8 mb-2">2. Disclaimers & Limitation of Liability</h3>
            <ul class="list-disc pl-6 space-y-2">
              <li>All information, routines, food storage D-days, and guides provided across SelaLink products are for general reference only. They do not substitute for professional medical, behavioral, or veterinary advice.</li>
              <li>Our services are provided "as-is." We disclaim all warranties and will not be liable for any data loss, health incidents, or damages resulting from the use of our applications.</li>
            </ul>

            <h3 class="text-xl font-bold text-slate-900 dark:text-white mt-8 mb-2">3. Contact Us</h3>
            <p>For any inquiries regarding these terms, please contact us at <a href="mailto:support@selalink.net" class="text-teal-600 dark:text-teal-400 underline">support@selalink.net</a>.</p>
          </>
        )}
      </div>
    </div>
  </main>
</Layout>

<style is:global>
  /* 라이트 모드 (기본) */
  .policy-content p,
  .policy-content li {
    color: #44403c !important; /* stone-700 */
    margin-bottom: 0.5rem;
  }
  .policy-content strong {
    color: #1c1917 !important; /* stone-900 */
    font-weight: 700 !important;
  }
  .policy-content a {
    color: #0d9488 !important; /* teal-600 */
    text-decoration: underline;
  }
  .policy-content ul {
    list-style-type: disc !important;
    padding-left: 1.5rem !important;
    margin-bottom: 1rem !important;
    margin-top: 0.5rem !important;
  }

  /* 다크 모드 */
  html.dark .policy-content p,
  html.dark .policy-content li {
    color: #d6d3d1 !important; /* stone-300 */
  }
  html.dark .policy-content strong {
    color: #fafaf9 !important; /* stone-50 */
    font-weight: 700 !important;
  }
  html.dark .policy-content a {
    color: #2dd4bf !important; /* teal-400 */
  }
</style>

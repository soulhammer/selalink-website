---
import Layout from '../../layouts/Layout.astro';
import { useTranslations, languages } from '../../i18n/ui';
import AppStories from '../../components/AppStories.astro';
import { getCollection } from 'astro:content';
import BlogPostCard from '../../components/BlogPostCard.astro';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as keyof typeof languages);
const isKo = lang === 'ko';
const imgBase = isKo ? '/assets/images/apps/freshself/ko' : '/assets/images/apps/freshself/en';

// 다국어 블로그 포스트 중에서 현재 언어 경로에 속하는 최신 3개 글 조회
const allPosts = await getCollection('blog');
const langPosts = allPosts
  .filter((post) => post.id.startsWith(`${lang}/`))
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 3);
---
<Layout title={`SelaLink Studio | ${t('hero.title')}`} description={t('hero.meta.desc')} lang={lang} image="/assets/images/og/selalink_studio.png">
	<main class="max-w-[1400px] mx-auto px-6 py-8 min-h-screen">
		
		<!-- Hero -->
		<section class="mb-10 md:mb-16 mt-4 md:mt-8 text-center md:text-left">
			<h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black tracking-tighter leading-[1.15] md:leading-[1.1] mb-4 md:mb-6 whitespace-pre-wrap text-slate-900 dark:text-white">{t('hero.title')}</h1>
			<p class="text-lg md:text-xl lg:text-2xl text-slate-600 dark:text-slate-300 font-medium tracking-tight max-w-2xl mx-auto md:mx-0 mb-8">{t('hero.desc')}</p>
			
			<!-- Category Quick Chips -->
			<div class="flex flex-wrap justify-center md:justify-start gap-2.5">
				<span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-emerald-100 text-emerald-800 border-emerald-200/50 dark:bg-emerald-500/10 dark:text-emerald-400 dark:border-emerald-500/20 text-xs md:text-sm font-semibold shadow-sm backdrop-blur-md">
					<span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>{t('blog.filter.buildself')}
				</span>
				<span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-purple-100 text-purple-800 border-purple-200/50 dark:bg-purple-500/10 dark:text-purple-400 dark:border-purple-500/20 text-xs md:text-sm font-semibold shadow-sm backdrop-blur-md">
					<span class="w-1.5 h-1.5 rounded-full bg-purple-500 animate-pulse"></span>{t('blog.filter.storeself')} / {t('app.freshself.title')}
				</span>
				<span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-indigo-100 text-indigo-800 border-indigo-200/50 dark:bg-indigo-500/10 dark:text-indigo-400 dark:border-indigo-500/20 text-xs md:text-sm font-semibold shadow-sm backdrop-blur-md">
					<span class="w-1.5 h-1.5 rounded-full bg-indigo-500 animate-pulse"></span>{t('blog.filter.logself')}
				</span>
				<span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-rose-100 text-rose-800 border-rose-200/50 dark:bg-rose-500/10 dark:text-rose-400 dark:border-rose-500/20 text-xs md:text-sm font-semibold shadow-sm backdrop-blur-md">
					<span class="w-1.5 h-1.5 rounded-full bg-rose-500 animate-pulse"></span>{t('blog.filter.petself')} ({t('app.logself.status')})
				</span>
			</div>
		</section>

		<!-- Dynamic App Stories (Full Screen Shorts Hook) -->
		<AppStories lang={lang} />

		<!-- Bento Grid 2.0 -->
		<section class="grid grid-cols-1 md:grid-cols-2 gap-6 auto-rows-[230px] md:auto-rows-[350px]">
			
			<!-- FreshSelf Card (Horizontal Bento - Z-10) -->
			<a href={`/${lang}/apps/freshself/`} aria-label={t('app.freshself.title')} class="bento-card col-span-1 md:col-span-2 row-span-2 p-5 sm:p-8 md:p-12 flex flex-col justify-between group overflow-hidden relative" style="--glow-color: rgba(139,92,246,0.15);">
				<div class="bento-glow top-0 left-0"></div>

				<!-- Left Side Content (Z-20) -->
				<div class="z-20 relative max-w-md lg:max-w-xl xl:max-w-2xl space-y-6 dark:drop-shadow-[0_2px_8px_rgba(0,0,0,0.85)]">
				<div class="flex flex-wrap gap-2 mb-4 md:mb-6">
					<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-100 text-purple-700 dark:bg-purple-500/20 dark:text-purple-400 text-xs md:text-sm font-semibold border border-purple-500/20 shadow-sm backdrop-blur-md">
						<span class="w-1.5 h-1.5 rounded-full bg-purple-500 animate-pulse"></span>{t('app.freshself.status')}
					</div>
					<div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/60 dark:bg-white/10 text-slate-800 dark:text-slate-300 text-xs md:text-sm font-semibold border border-white/40 dark:border-white/10 shadow-sm backdrop-blur-md">
						{t('platform.mobile')}
					</div>
				</div>
					<div class="space-y-4">
						<h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black mb-2 text-slate-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors drop-shadow-sm flex items-center gap-3">
							<img src="/freshself/invite/icon.png" alt="FreshSelf Logo" class="w-10 h-10 sm:w-12 sm:h-12 object-contain rounded-xl shadow-sm border border-purple-500/10" />
							{t('app.freshself.title')}
						</h2>
						<p class="text-base sm:text-lg md:text-xl lg:text-2xl text-slate-800 dark:text-slate-200 font-medium leading-relaxed max-w-xl">{t('app.freshself.desc')}</p>
					</div>
				</div>

				<!-- Right Side 3D Spatial Mockup (Z-10) -->
				<div class="absolute bottom-[-20px] lg:bottom-[-20px] right-[-15px] sm:right-[-15px] lg:right-[5%] w-[60%] sm:w-[40%] lg:w-[35%] h-[240px] sm:h-[260px] lg:h-[95%] z-10 pointer-events-none perspective-[1000px] flex items-end justify-end self-end lg:self-auto mt-8 lg:mt-0 opacity-50 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700">
					<!-- Back Left Image -->
					<div class="absolute right-[35%] bottom-2 w-[55%] rounded-2xl p-1.5 bg-white/20 dark:bg-slate-800/40 backdrop-blur-sm border border-white/30 dark:border-white/10 shadow-xl transform -rotate-12 translate-y-4 group-hover:-translate-x-4 group-hover:-translate-y-2 group-hover:-rotate-16 transition-all duration-700">
						<img src={`${imgBase}/4_freshself_phone_screen.jpg`} alt="FreshSelf Report Screen" class="w-full h-auto rounded-[1rem] object-cover" loading="lazy" />
					</div>
					<!-- Front Right Image -->
					<div class="relative right-0 bottom-4 w-[60%] rounded-2xl p-2 bg-white/80 dark:bg-slate-800/80 backdrop-blur-xl border border-white/60 dark:border-white/20 shadow-[0_20px_50px_rgba(0,0,0,0.25)] transform rotate-[-4deg] group-hover:rotate-0 transition-all duration-700 z-20">
						<img src={`${imgBase}/2_freshself_phone_screen.jpg`} alt="FreshSelf Main Screen" class="w-full h-auto rounded-[1rem] shadow-inner object-cover" loading="lazy" />
					</div>
				</div>

				<div class="z-20 relative flex justify-between items-end transition-transform mt-auto pt-8">
					<div class="text-sm font-bold text-slate-800 dark:text-slate-200 bg-white/70 dark:bg-black/50 px-4 py-2 rounded-full backdrop-blur-xl border border-white/50 dark:border-white/10 shadow-lg">
						{t('app.freshself.supported')}
					</div>
					<div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-slate-900 text-white dark:bg-white dark:text-slate-900 flex items-center justify-center group-hover:scale-110 group-hover:bg-purple-600 dark:group-hover:bg-purple-400 group-hover:text-white dark:group-hover:text-black transition-all duration-500 shadow-[0_0_30px_rgba(0,0,0,0.1)] dark:shadow-[0_0_30px_rgba(255,255,255,0.3)]">
						<svg class="w-6 h-6 sm:w-8 sm:h-8 transform group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25"/></svg>
					</div>
				</div>

				<!-- Purple Light Bloom Effect -->
				<div class="absolute -bottom-32 -right-32 w-[500px] h-[500px] bg-purple-400/10 dark:bg-purple-600/10 blur-[100px] rounded-full group-hover:bg-purple-400/20 dark:group-hover:bg-purple-500/15 transition-colors duration-700 z-0 pointer-events-none"></div>
			</a>

			<!-- logSelf Card (Encrypted Personal Log) -->
			<a href={`/${lang}/apps/logself/`} aria-label={t('app.logself.title')} class="bento-card col-span-1 md:col-span-1 row-span-2 p-5 sm:p-8 md:p-12 flex flex-col justify-between group overflow-hidden relative" style="--glow-color: rgba(99,102,241,0.2);">
				<div class="bento-glow top-0 left-0"></div>
				
				<!-- Top Content (Z-20) -->
				<div class="z-20 relative dark:drop-shadow-[0_2px_8px_rgba(0,0,0,0.85)]">
					<div class="flex flex-wrap gap-2 mb-4 md:mb-6">
						<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-100 text-indigo-700 dark:bg-indigo-500/20 dark:text-indigo-400 text-xs md:text-sm font-semibold border border-indigo-500/20 shadow-sm backdrop-blur-md">
							<span class="w-1.5 h-1.5 rounded-full bg-indigo-500 animate-pulse"></span>{t('app.logself.status')}
						</div>
						<div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/60 dark:bg-white/10 text-slate-800 dark:text-slate-300 text-xs md:text-sm font-semibold border border-white/40 dark:border-white/10 shadow-sm backdrop-blur-md">
							{t('platform.mobile')}
						</div>
					</div>
					<h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black mb-3 md:mb-4 text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors drop-shadow-sm flex items-center gap-3">
						<img src="/images/logself/icon.png" alt="logSelf Logo" class="w-10 h-10 sm:w-12 sm:h-12 object-contain rounded-xl shadow-sm border border-indigo-500/10" />
						{t('app.logself.title')}
					</h2>
					<p class="text-base sm:text-lg md:text-xl text-slate-800 dark:text-slate-200 font-medium leading-relaxed max-w-sm drop-shadow-md relative z-20">{t('app.logself.desc')}</p>
				</div>
                
				<!-- Spatial 3D Collage Mock (Z-10) - Matches FreshSelf/BuildSelf style -->
				<div class="absolute bottom-[-10%] sm:bottom-[-10%] md:bottom-[-15%] lg:bottom-[-20%] right-[-10%] sm:right-[-8%] md:right-[-3%] lg:right-[0%] w-[60%] sm:w-[40%] md:w-[65%] lg:w-[60%] h-[55%] sm:h-[55%] md:h-[80%] lg:h-[85%] z-10 pointer-events-none perspective-[1200px] flex items-end justify-end opacity-45 group-hover:opacity-100 transition-all duration-700">
					<!-- Back Left Image (High transparency for readability) -->
					<div class="absolute left-[5%] sm:left-[0%] bottom-[20%] w-[55%] rounded-3xl p-1.5 bg-white/20 dark:bg-slate-800/40 backdrop-blur-sm border border-white/30 dark:border-white/10 shadow-xl transform -rotate-12 translate-y-4 group-hover:-translate-x-4 group-hover:-translate-y-2 group-hover:-rotate-16 transition-all duration-700 opacity-45 sm:opacity-55 dark:opacity-30">
						<img src={`/images/logself/${isKo ? 'ko' : 'en'}/3.jpeg`} alt="logSelf Stats Screen" class="w-full h-auto rounded-[1rem] object-cover" loading="lazy" />
					</div>
					<!-- Front Right Image -->
					<div class="relative w-[65%] sm:w-[55%] mb-2 sm:mb-8 mr-6 sm:mr-12 rounded-3xl p-2 bg-white/80 dark:bg-slate-800/80 backdrop-blur-xl border border-white/60 dark:border-white/20 shadow-[0_20px_50px_rgba(0,0,0,0.25)] transform rotate-[-4deg] group-hover:rotate-0 group-hover:scale-105 group-hover:-translate-y-2 transition-all duration-700 z-20 opacity-90 dark:opacity-85">
						<img src={`/images/logself/${isKo ? 'ko' : 'en'}/1.jpeg`} alt="logSelf Main Screen" class="w-full h-auto rounded-[1rem] shadow-inner object-cover" loading="lazy" />
					</div>
				</div>

				<div class="z-20 relative flex justify-between items-end transition-transform mt-auto pt-8">
					<div class="text-sm font-bold text-slate-800 dark:text-slate-200 bg-white/70 dark:bg-black/50 px-4 py-2 rounded-full backdrop-blur-xl border border-white/50 dark:border-white/10 shadow-lg">
						{t('app.logself.supported')}
					</div>
					<div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-slate-900 text-white dark:bg-white dark:text-slate-900 flex items-center justify-center group-hover:scale-110 group-hover:bg-indigo-600 dark:group-hover:bg-indigo-400 group-hover:text-white dark:group-hover:text-black transition-all duration-500 shadow-[0_0_30px_rgba(0,0,0,0.1)] dark:shadow-[0_0_30px_rgba(255,255,255,0.3)]">
						<svg class="w-6 h-6 sm:w-8 sm:h-8 transform group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25"/></svg>
					</div>
				</div>
				<!-- Background Gradient Effect -->
				<div class="absolute -bottom-32 -right-32 w-[600px] h-[600px] bg-indigo-300/20 dark:bg-indigo-700/20 blur-[120px] rounded-full group-hover:bg-indigo-400/30 dark:group-hover:bg-indigo-500/20 transition-colors duration-700 z-0 pointer-events-none"></div>
			</a>

			<!-- BuildSelf Card (Large Spatial Canvas) -->
			<a href={`/${lang}/apps/buildself/`} aria-label={t('app.buildself.title')} class="bento-card col-span-1 md:col-span-1 row-span-2 p-5 sm:p-8 md:p-12 flex flex-col justify-between group overflow-hidden relative" style="--glow-color: rgba(16,185,129,0.2);">
				<div class="bento-glow top-0 left-0"></div>
				
				<!-- Top Content (Z-20) -->
				<div class="z-20 relative dark:drop-shadow-[0_2px_8px_rgba(0,0,0,0.85)]">
					<div class="flex flex-wrap gap-2 mb-4 md:mb-6">
						<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-100 text-emerald-700 dark:bg-emerald-500/20 dark:text-emerald-400 text-xs md:text-sm font-semibold border border-emerald-500/20 shadow-sm backdrop-blur-md">
							<span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>{t('app.buildself.status')}
						</div>
						<div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/60 dark:bg-white/10 text-slate-800 dark:text-slate-300 text-xs md:text-sm font-semibold border border-white/40 dark:border-white/10 shadow-sm backdrop-blur-md">
							{t('platform.mobile')}
						</div>
					</div>
					<h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black mb-3 md:mb-4 text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors drop-shadow-sm flex items-center gap-3">
						<img src="/images/buildself/icon.png" alt="BuildSelf Logo" class="w-10 h-10 sm:w-12 sm:h-12 object-contain rounded-xl shadow-sm border border-emerald-500/10" />
						{t('app.buildself.title')}
					</h2>
					<p class="text-base sm:text-lg md:text-xl text-slate-800 dark:text-slate-200 font-medium leading-relaxed max-w-sm drop-shadow-md relative z-20">{t('app.buildself.desc')}</p>
				</div>
                
				<!-- Spatial 3D Collage (Active Grid - Z-10) -->
				<div class="absolute bottom-[-10%] sm:bottom-[-10%] md:bottom-[-15%] lg:bottom-[-20%] right-[-10%] sm:right-[-10%] md:right-[-5%] lg:right-[-5%] w-[60%] sm:w-[45%] md:w-[70%] lg:w-[65%] h-[55%] sm:h-[55%] md:h-[80%] lg:h-[85%] z-10 pointer-events-none perspective-[1200px] flex items-end justify-end opacity-45 group-hover:opacity-100 transition-all duration-700">
					<!-- Back Left Image -->
					<div class="absolute left-[5%] sm:left-[0%] bottom-[20%] w-[55%] rounded-[1.2rem] lg:rounded-3xl p-1 bg-white/20 dark:bg-slate-800/40 backdrop-blur-sm border border-white/30 dark:border-white/10 shadow-xl transform -rotate-12 translate-y-4 group-hover:-translate-x-4 group-hover:-translate-y-2 group-hover:-rotate-16 transition-all duration-700 opacity-50 sm:opacity-60 dark:opacity-40">
						<img src="/assets/images/apps/buildself/2_buildself_phone_screen.jpeg" alt="BuildSelf Habit List" class="w-full h-auto rounded-[1rem] lg:rounded-[1.5rem] object-cover" loading="lazy" />
					</div>
					<!-- Back Right Image -->
					<div class="absolute right-[5%] sm:right-[0%] bottom-[25%] w-[50%] rounded-[1.2rem] lg:rounded-3xl p-1 bg-white/20 dark:bg-slate-800/40 backdrop-blur-sm border border-white/30 dark:border-white/10 shadow-2xl transform rotate-12 translate-y-2 group-hover:translate-x-4 group-hover:-translate-y-3 lg:group-hover:-translate-y-6 group-hover:rotate-16 transition-all duration-700 opacity-70 lg:opacity-80 dark:opacity-60">
						<img src="/assets/images/apps/buildself/4_buildself_phone_screen.jpeg" alt="BuildSelf Analytics" class="w-full h-auto rounded-[1rem] lg:rounded-[1.5rem] object-cover" loading="lazy" />
					</div>
					<!-- Front Main Image -->
					<div class="relative w-[65%] sm:w-[55%] mb-2 sm:mb-8 mr-6 sm:mr-12 rounded-[1.5rem] lg:rounded-[2rem] p-1.5 bg-white/80 dark:bg-slate-800/80 backdrop-blur-xl border border-white/60 dark:border-white/20 shadow-[0_20px_60px_-15px_rgba(0,0,0,0.3)] dark:shadow-[0_20px_60px_-15px_rgba(0,0,0,0.7)] transform rotate-[-4deg] group-hover:rotate-0 group-hover:scale-[1.03] lg:group-hover:scale-105 group-hover:-translate-y-2 lg:group-hover:-translate-y-4 transition-all duration-700 z-20 mx-auto sm:mx-0">
						<img src="/assets/images/apps/buildself/1_buildself_phone_screen.jpeg" alt="BuildSelf Main UI" class="w-full h-auto rounded-[1.3rem] lg:rounded-[1.7rem] shadow-inner object-cover" loading="eager" />
					</div>
				</div>

				<div class="z-20 relative flex justify-between items-end transition-transform mt-auto pt-8">
					<div class="text-sm font-bold text-slate-800 dark:text-slate-200 bg-white/70 dark:bg-black/50 px-4 py-2 rounded-full backdrop-blur-xl border border-white/50 dark:border-white/10 shadow-lg">
						{t('app.buildself.supported')}
					</div>
					<div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-slate-900 text-white dark:bg-white dark:text-slate-900 flex items-center justify-center group-hover:scale-110 group-hover:bg-emerald-600 dark:group-hover:bg-emerald-400 group-hover:text-white dark:group-hover:text-black transition-all duration-500 shadow-[0_0_30px_rgba(0,0,0,0.1)] dark:shadow-[0_0_30px_rgba(255,255,255,0.3)]">
						<svg class="w-6 h-6 sm:w-8 sm:h-8 transform group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25"/></svg>
					</div>
				</div>
				<!-- Background Gradient Effect -->
				<div class="absolute -bottom-32 -right-32 w-[600px] h-[600px] bg-emerald-300/20 dark:bg-emerald-700/20 blur-[120px] rounded-full group-hover:bg-emerald-400/30 dark:group-hover:bg-emerald-500/20 transition-colors duration-700 z-0 pointer-events-none"></div>
			</a>

			<!-- StoreSelf Card (Free Web Utility) -->
			<a href={`/${lang}/apps/storeself/`} aria-label={t('app.storeself.title')} class="bento-card col-span-1 md:col-span-2 row-span-2 p-5 sm:p-8 md:p-12 flex flex-col justify-between group overflow-hidden relative" style="--glow-color: rgba(16,185,129,0.25);">
				<div class="bento-glow top-0 right-0"></div>
				
				<!-- Top Content -->
				<div class="z-20 relative dark:drop-shadow-[0_2px_8px_rgba(0,0,0,0.85)]">
				<div class="flex flex-wrap gap-2 mb-4 md:mb-6">
					<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-100 text-emerald-700 dark:bg-emerald-500/20 dark:text-emerald-400 text-xs md:text-sm font-semibold border border-emerald-500/20 shadow-sm backdrop-blur-md">
						<span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>{t('app.storeself.status')}
					</div>
					<div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/60 dark:bg-white/10 text-slate-800 dark:text-slate-300 text-xs md:text-sm font-semibold border border-white/40 dark:border-white/10 shadow-sm backdrop-blur-md">
						{t('platform.web')}
					</div>
				</div>
					<h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black mb-3 md:mb-4 text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors drop-shadow-sm flex items-center gap-3">
						<div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-emerald-100 dark:bg-emerald-500/20 flex items-center justify-center text-emerald-600 dark:text-emerald-400 shadow-sm border border-emerald-500/10">
							<svg class="w-6 h-6 sm:w-7 sm:h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
								<path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
							</svg>
						</div>
						{t('app.storeself.title')}
					</h2>
					<p class="text-base sm:text-lg md:text-xl text-slate-800 dark:text-slate-200 font-medium leading-relaxed max-w-sm drop-shadow-md relative z-20">
						{t('app.storeself.desc')}
					</p>
				</div>
                
				<!-- Interactive Web Visual (Desktop Browser Mockup) -->
				<div class="absolute bottom-[18%] sm:bottom-[-10%] md:bottom-[-12%] lg:bottom-[-15%] right-[-10%] sm:right-[-5%] md:right-[-2%] lg:right-[-2%] w-[85%] sm:w-[65%] md:w-[60%] lg:w-[58%] h-[55%] sm:h-[60%] md:h-[75%] lg:h-[80%] z-10 pointer-events-none perspective-[1200px] flex items-end justify-end opacity-45 group-hover:opacity-100 transition-all duration-700">
					<div class="relative w-[95%] sm:w-[90%] mb-4 sm:mb-8 mr-4 sm:mr-8 rounded-[1.2rem] lg:rounded-[1.8rem] p-1 bg-white/80 dark:bg-slate-800/80 backdrop-blur-xl border border-white/60 dark:border-white/20 shadow-[0_20px_50px_rgba(0,0,0,0.25)] dark:shadow-[0_20px_50px_rgba(0,0,0,0.6)] transform rotate-[-3deg] group-hover:rotate-0 group-hover:scale-[1.03] lg:group-hover:scale-105 group-hover:-translate-y-2 transition-all duration-700 z-20">
						<img src={`/assets/images/apps/storeself/storeself_browser_${lang}.png`} alt="StoreSelf Web App" class="w-full h-auto rounded-[1rem] lg:rounded-[1.5rem] shadow-inner object-cover" loading="lazy" />
					</div>
				</div>
                
				<div class="z-20 relative mt-auto pt-8 flex justify-between items-end">
					<div class="text-sm font-bold text-slate-800 dark:text-slate-200 bg-white/70 dark:bg-black/50 px-4 py-2 rounded-full backdrop-blur-xl border border-white/50 dark:border-white/10 shadow-lg">
						{t('app.storeself.supported')}
					</div>
					<div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-slate-900 text-white dark:bg-white dark:text-slate-900 flex items-center justify-center group-hover:scale-110 group-hover:bg-emerald-600 dark:group-hover:bg-emerald-400 group-hover:text-white dark:group-hover:text-black transition-all duration-500 shadow-[0_0_30px_rgba(0,0,0,0.1)] dark:shadow-[0_0_30px_rgba(255,255,255,0.3)]">
						<svg class="w-6 h-6 sm:w-8 sm:h-8 transform group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25"/></svg>
					</div>
				</div>
				<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[350px] h-[350px] bg-emerald-400/15 dark:bg-emerald-600/15 blur-[90px] rounded-full group-hover:bg-emerald-500/25 dark:group-hover:bg-emerald-500/20 transition-colors duration-700 pointer-events-none z-0"></div>
			</a>

		</section>

		<!-- 최신 라이프 스토리 (블로그 피드) -->
		{langPosts.length > 0 && (
			<section class="mt-24 md:mt-32 relative z-20">
				<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8 md:mb-12">
					<div>
						<h2 class="text-3xl md:text-4xl lg:text-5xl font-black tracking-tighter text-slate-900 dark:text-white mb-2 md:mb-3">
							{t('blog.heading')}
						</h2>
						<p class="text-sm md:text-base text-slate-600 dark:text-slate-400 max-w-xl font-medium">
							{t('blog.desc')}
						</p>
					</div>
					<a href={`/${lang}/blog/`} class="text-sm font-bold text-[var(--theme-accent,#0D9488)] hover:opacity-80 transition-opacity border-b-2 border-[var(--theme-accent,#0D9488)] pb-1 shrink-0">
						{t('blog.filter.all')} →
					</a>
				</div>
				
				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
					{langPosts.map((post) => (
						<BlogPostCard post={post} lang={lang} />
					))}
				</div>
			</section>
		)}
		
		<!-- Footer -->
		<footer class="mt-32 pt-8 border-t border-slate-200 dark:border-white/5 flex flex-col sm:flex-row justify-between items-center gap-4 sm:gap-0 text-sm text-slate-500 dark:text-slate-600 font-mono">
			<span>&copy; 2026 SelaLink Global.</span>
			<div class="flex items-center gap-4">
				<a href="mailto:support@selalink.net" class="hover:text-slate-800 dark:hover:text-slate-300 transition-colors">support@selalink.net</a>
				<span class="opacity-30">|</span>
				<a href="#" class="hover:text-slate-800 dark:hover:text-slate-300">Privacy & Terms</a>
			</div>
		</footer>
	</main>
</Layout>

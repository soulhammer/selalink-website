---
// Language-neutral redirect page for FreshSelf Privacy Policy
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, follow" />
  <!-- Fallback meta refresh for crawlers/AI bots with JS disabled -->
  <meta http-equiv="refresh" content="0;url=/en/apps/freshself/privacy/" />
  <title>Redirecting...</title>
</head>
<body>
  <script is:inline>
    (function() {
      var validLangs = ['en', 'ko', 'ja', 'zh', 'es', 'fr', 'de', 'pt', 'id'];
      var lang = navigator.language || navigator.userLanguage || "en";
      lang = lang.split('-')[0]; // ko-KR -> ko
      
      var searchParams = window.location.search || "";
      var hash = window.location.hash || "";
      
      var targetLang = validLangs.indexOf(lang) !== -1 ? lang : "en";
      var targetUrl = '/' + targetLang + '/apps/freshself/privacy/' + searchParams + hash;
      
      window.location.replace(targetUrl);
    })();
  </script>
</body>
</html>

---
import '../styles/global.css';
import { useTranslations, languages } from '../i18n/ui';

export interface Props {
	title: string;
	lang: string;
	description?: string;
	supportedLanguages?: string[];
	forceTheme?: 'dark' | 'light';
	image?: string;
	ogType?: 'website' | 'software';
	canonicalUrl?: string;
}

const { 
	title, 
	lang, 
	description = "Break the cycle. You are already great, you just lacked the right tool.", 
	supportedLanguages, 
	forceTheme, 
	image, 
	ogType = 'website',
	canonicalUrl
} = Astro.props;

const currentPath = Astro.url.pathname;
const getPathForLang = (targetLang: string) => {
    // Current path usually starts with /lang/ (e.g. /ko/apps/buildself)
    const regex = new RegExp(`^/${lang}(/|$)`);
    if (regex.test(currentPath)) {
        return currentPath.replace(regex, `/${targetLang}$1`);
    } else {
        return `/${targetLang}${currentPath}`;
    }
};
---
<!doctype html>
<html lang={lang} class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		
		<!-- Mobile Theme & Color Optimization -->
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#f8fafc" />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b0c10" />
		
		<!-- Local Search Keywords Backup -->
		<meta name="keywords" content="SelaLink, 셀라링크, BuildSelf, 빌드셀프, DeepMood, 딥무드, 습관형성, 감정일기, habit tracker, mood tracker, productivity" />
		
		<!-- Search Engine Verification -->
		<meta name="naver-site-verification" content="1060c1abc665f9d239ecdc584674b5fbac97f34d" />

		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/favicon.png" />
		<link href="https://fonts.googleapis.com/css2?family=Pretendard:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
		<title>{title}</title>
		
		<!-- SEO / Open Graph Setup -->
		<meta property="og:site_name" content="SelaLink Studio" />
		<meta property="og:type" content={ogType || 'website'} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={Astro.url.href} />
		{image && <meta property="og:image" content={new URL(image, Astro.site).href} />}
		
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{image && <meta name="twitter:image" content={new URL(image, Astro.site).href} />}
		
		<!-- Canonical URL -->
		<link rel="canonical" href={canonicalUrl || Astro.url.href.replace(/\/$/, '')} />
		
		<!-- Hreflang SEO for Global Reach -->
		{Object.keys(languages).map((code) => {
			if (supportedLanguages && !supportedLanguages.includes(code)) return null;
			return <link rel="alternate" hreflang={code} href={new URL(getPathForLang(code), Astro.site).href.replace(/\/$/, '')} />;
		})}
		<link rel="alternate" hreflang="x-default" href={new URL(getPathForLang(supportedLanguages && supportedLanguages.length > 0 ? supportedLanguages[0] : 'en'), Astro.site).href.replace(/\/$/, '')} />

		<!-- AI & Semantic SEO Rules -->
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		<meta name="author" content="SelaLink Studio" />
		
		<!-- Comprehensive JSON-LD Structured Data for AI Search -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": ogType === 'software' ? "SoftwareApplication" : "Organization",
			"name": ogType === 'software' && title.includes('BuildSelf') ? "BuildSelf" : (ogType === 'software' && title.includes('DeepMood') ? "DeepMood" : "SelaLink Studio"),
			"url": canonicalUrl || Astro.url.href.replace(/\/$/, ''),
			"description": description,
			...(ogType === 'software' ? {
				"applicationCategory": title.includes('DeepMood') ? "LifestyleApplication" : "HealthApplication",
				"operatingSystem": "iOS, Android",
				"offers": {
					"@type": "Offer",
					"price": "0",
					"priceCurrency": "USD"
				}
			} : {}),
			...(title.includes('BuildSelf') ? {
				"sameAs": ["https://play.google.com/store/apps/details?id=com.selalink.buildself"]
			} : {})
		})} />
		
		<style is:global>
			body {
				font-family: 'Space Grotesk', 'Pretendard', sans-serif;
				transition: background-color 0.5s ease, color 0.5s ease;
				overflow-x: hidden;
			}
			/* Global Typography Polish for Korean */
			html[lang="ko"] body {
				word-break: keep-all;
			}
			
			/* LIGHT MODE DEFAULT */
			body {
				background-color: #f8fafc; /* slate-50 */
				color: #0f172a; /* slate-900 */
			}
			.bento-card {
				background: rgba(255, 255, 255, 0.7);
				backdrop-filter: blur(24px);
				-webkit-backdrop-filter: blur(24px);
				border: 1px solid rgba(0, 0, 0, 0.05);
				border-radius: 32px;
				transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
				box-shadow: 0 4px 30px rgba(0, 0, 0, 0.03);
				position: relative;
				overflow: hidden;
			}
			.bento-card:hover {
				transform: translateY(-4px) scale(1.01);
				background: rgba(255, 255, 255, 0.9);
				border-color: rgba(0, 0, 0, 0.1);
				box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
				z-index: 10;
			}
            
			/* DARK MODE SPATIAL */
			html.dark body {
				background-color: #0b0c10;
				color: #ffffff;
			}
			html.dark .bento-card {
				background: rgba(30, 33, 40, 0.4);
				border: 1px solid rgba(255, 255, 255, 0.05);
				box-shadow: 0 4px 30px rgba(0, 0, 0, 0.3);
			}
			html.dark .bento-card:hover {
				background: rgba(40, 44, 52, 0.5);
				border-color: rgba(255, 255, 255, 0.1);
				box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
			}
            
			/* GLOW EFFECT */
			.bento-glow {
				position: absolute;
				width: 300px;
				height: 300px;
				background: radial-gradient(circle, var(--glow-color, rgba(255,255,255,0.1)) 0%, transparent 70%);
				opacity: 0;
				transition: opacity 0.5s;
				pointer-events: none;
				border-radius: 50%;
			}
			.bento-card:hover .bento-glow {
				opacity: 1;
			}
		</style>
		
		<script is:inline define:vars={{ forceTheme }}>
			const theme = (() => {
				if (forceTheme) return forceTheme;
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'dark'; // Always default to dark for SelaLink Spatial aesthetic
			})();
			if (theme === 'light') {
				document.documentElement.classList.remove('dark');
			} else {
				document.documentElement.classList.add('dark');
			}
			if (!forceTheme) {
				window.localStorage.setItem('theme', theme);
			}
		</script>
	</head>
	<body class="antialiased selection:bg-black selection:text-white dark:selection:bg-white dark:selection:text-black">
		<!-- Navigation Bar with Lang & Theme Switches -->
		<header class="max-w-[1400px] mx-auto px-6 pt-12 flex justify-between items-center relative z-50">
			<a href={`/${lang}`} class="text-2xl font-bold tracking-tighter">SelaLink.</a>
			<div class="flex items-center gap-6">
				<!-- Language Dropdown -->
				<div class="relative" id="langWrapper">
					<button 
						id="langButton" 
						aria-label="Select Language" 
						disabled={supportedLanguages?.length === 1}
						title={supportedLanguages?.length === 1 ? "Language is locked (Content restricted)" : "Select Language"}
						class={`flex items-center gap-1 text-sm font-medium uppercase focus:outline-none focus:ring-2 focus:ring-slate-400 dark:focus:ring-slate-600 rounded-md px-2 py-1 ${supportedLanguages?.length === 1 ? 'opacity-50 cursor-not-allowed' : 'hover:opacity-70 transition-opacity'}`}
					>
						{supportedLanguages?.length === 1 ? supportedLanguages[0] : lang} {supportedLanguages?.length === 1 ? '' : '▼'}
					</button>
					<div id="langMenu" class="absolute right-0 top-full mt-2 w-48 bg-white dark:bg-slate-800 rounded-xl shadow-xl flex flex-col py-2 opacity-0 invisible transition-all transform origin-top-right scale-95 z-50 pointer-events-none">
						{Object.entries(languages).map(([code, label]) => {
							const isSupported = !supportedLanguages || supportedLanguages.includes(code);
							
							if (!isSupported) {
								return (
									<div class="px-4 py-2 text-sm text-slate-400 dark:text-slate-500 cursor-not-allowed flex justify-between items-center group">
										<span>{code.toUpperCase()} - {label}</span>
										<span class="text-[10px] hidden group-hover:inline-block text-red-500/80 font-bold uppercase tracking-wider">Only {supportedLanguages.join(', ').toUpperCase()}</span>
									</div>
								);
							}

							return (
								<a href={getPathForLang(code)} class="px-4 py-2 text-sm text-slate-800 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
									{code.toUpperCase()} - {label}
								</a>
							);
						})}
					</div>
				</div>
				<!-- Theme Toggle -->
				{!forceTheme && (
					<button id="themeToggle" aria-label="Toggle Dark Mode" class="w-10 h-10 rounded-full flex items-center justify-center bg-slate-200 dark:bg-slate-800 hover:scale-110 transition-transform focus:outline-none focus:ring-2 focus:ring-slate-400 dark:focus:ring-slate-600">
						<span class="dark:hidden">🌙</span>
						<span class="hidden dark:block">☀️</span>
					</button>
				)}
			</div>
		</header>
		
		<slot />
		
		<script>
            // Theme toggle logic
			document.getElementById('themeToggle')?.addEventListener('click', () => {
				const isDark = document.documentElement.classList.contains('dark');
				localStorage.setItem('theme', isDark ? 'light' : 'dark');
				document.documentElement.classList.toggle('dark');
			});

            // Language Dropdown toggle logic
            const langBtn = document.getElementById('langButton');
            const langMenu = document.getElementById('langMenu');
            
            langBtn?.addEventListener('click', (e) => {
                e.stopPropagation();
                langMenu.classList.toggle('opacity-0');
                langMenu.classList.toggle('invisible');
                langMenu.classList.toggle('scale-95');
                langMenu.classList.toggle('scale-100');
                langMenu.classList.toggle('pointer-events-none');
            });

            // Close dropdown when clicking outside
            document.addEventListener('click', (e) => {
                if (langMenu && !langMenu.classList.contains('opacity-0')) {
                    langMenu.classList.add('opacity-0', 'invisible', 'scale-95', 'pointer-events-none');
                    langMenu.classList.remove('scale-100');
                }
            });
		</script>
	</body>
</html>

---
import '../styles/global.css';
import { useTranslations, languages } from '../i18n/ui';
import AppToast from '../components/AppToast.astro';
import ShortsPlayerModal from '../components/ShortsPlayerModal.astro';

export interface Props {
	title: string;
	lang: string;
	description?: string;
	supportedLanguages?: string[];
	forceTheme?: 'dark' | 'light';
	image?: string;
	ogType?: 'website' | 'software';
	canonicalUrl?: string;
	robots?: string;
	appId?: 'buildself' | 'freshself' | 'storeself' | 'studio' | 'logself';
	structuredData?: Record<string, any> | Record<string, any>[];
	keywords?: string;
}

const { 
	title, 
	lang, 
	description = "Break the cycle. You are already great, you just lacked the right tool.", 
	supportedLanguages, 
	forceTheme, 
	image, 
	ogType = 'website',
	canonicalUrl,
	robots,
	appId = 'studio',
	structuredData,
	keywords
} = Astro.props;

// appId에 따른 테마 색상 및 서체 지정
const themeColors = {
	studio: '#0D9488', // Teal
	buildself: '#0D9488',
	freshself: '#8B5CF6',
	storeself: '#10B981', // Pistachio Mint
	logself: '#6366F1'
};
const themeFonts = {
	studio: "'Space Grotesk', 'Pretendard', sans-serif",
	buildself: "'Outfit', 'Space Grotesk', 'Pretendard', sans-serif",
	freshself: "'Plus Jakarta Sans', 'Pretendard', 'PingFang SC', 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', 'Microsoft YaHei', 'Meiryo', sans-serif",
	storeself: "'Plus Jakarta Sans', 'Pretendard', 'PingFang SC', 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', 'Microsoft YaHei', 'Meiryo', sans-serif",
	logself: "'Outfit', 'Space Grotesk', 'Pretendard', sans-serif"
};

const currentAccent = themeColors[appId];
const currentFont = themeFonts[appId];

const currentPath = Astro.url.pathname;
const getPathForLang = (targetLang: string) => {
    // Current path usually starts with /lang/ (e.g. /ko/apps/buildself)
    const regex = new RegExp(`^/${lang}(/|$)`);
    if (regex.test(currentPath)) {
        return currentPath.replace(regex, `/${targetLang}$1`);
    } else {
        return `/${targetLang}${currentPath}`;
    }
};

const t = useTranslations(lang as any);
---
<!doctype html>
<html lang={lang} class="dark" style={`--theme-accent: ${currentAccent}; --theme-font-family: ${currentFont};`}>
	<head>
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-F045X42F26"></script>
		<script is:inline>
		  window.dataLayer = window.dataLayer || [];
		  function gtag(){dataLayer.push(arguments);}
		  gtag('js', new Date());

		  gtag('config', 'G-F045X42F26');
		</script>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		
		<!-- Mobile Theme & Color Optimization -->
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#f8fafc" />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b0c10" />
		
		<!-- Local Search Keywords Backup -->
		{(() => {
			const t = useTranslations(lang as any);
			const isBuildSelf = Astro.url.pathname.includes('/apps/buildself') || appId === 'buildself';
			const isFreshSelf = (Astro.url.pathname.includes('/apps/freshself') && !Astro.url.pathname.includes('/apps/storeself')) || appId === 'freshself';
			const isStoreSelf = Astro.url.pathname.includes('/apps/storeself') || appId === 'storeself';
			const isLogSelf = Astro.url.pathname.includes('/apps/logself') || appId === 'logself';

			let fallbackKeywords = keywords;
			if (!fallbackKeywords) {
				if (isBuildSelf) fallbackKeywords = t('app.buildself.meta.keywords');
				else if (isFreshSelf) fallbackKeywords = t('app.freshself.meta.keywords');
				else if (isStoreSelf) fallbackKeywords = t('app.storeself.meta.keywords');
				else if (isLogSelf) fallbackKeywords = t('app.logself.meta.keywords');
				else fallbackKeywords = t('meta.keywords');
			}
			return <meta name="keywords" content={fallbackKeywords} />;
		})()}
		
		<!-- Search Engine Verification -->
		<meta name="naver-site-verification" content="1060c1abc665f9d239ecdc584674b5fbac97f34d" />

		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/favicon.png" />
		<link href="https://fonts.googleapis.com/css2?family=Pretendard:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
		<title>{title}</title>
		
		<!-- SEO / Open Graph Setup -->
		<meta property="og:site_name" content="SelaLink Studio" />
		<meta property="og:type" content={ogType || 'website'} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={Astro.url.href} />
		{image && <meta property="og:image" content={new URL(image, Astro.site).href} />}
		
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{image && <meta name="twitter:image" content={new URL(image, Astro.site).href} />}
		
		<!-- Canonical URL -->
		<link rel="canonical" href={canonicalUrl || (Astro.url.href.endsWith('/') ? Astro.url.href : Astro.url.href + '/')} />
		
		<!-- Sitemap Link -->
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		
		<!-- Hreflang SEO for Global Reach -->
		{Object.keys(languages).map((code) => {
			if (supportedLanguages && !supportedLanguages.includes(code)) return null;
			const rawUrl = new URL(getPathForLang(code), Astro.site).href;
			const formattedUrl = rawUrl.endsWith('/') ? rawUrl : rawUrl + '/';
			return <link rel="alternate" hreflang={code} href={formattedUrl} />;
		})}
		{(() => {
			const defaultCode = supportedLanguages && supportedLanguages.length > 0 ? supportedLanguages[0] : 'en';
			const rawDefaultUrl = new URL(getPathForLang(defaultCode), Astro.site).href;
			const formattedDefaultUrl = rawDefaultUrl.endsWith('/') ? rawDefaultUrl : rawDefaultUrl + '/';
			return <link rel="alternate" hreflang="x-default" href={formattedDefaultUrl} />;
		})()}

		<!-- AI & Semantic SEO Rules -->
		<meta name="robots" content={robots || "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
		<meta name="author" content="SelaLink Studio" />
		
		<!-- Comprehensive JSON-LD Structured Data for AI Search -->
		{(() => {
			const isBuildSelf = Astro.url.pathname.includes('/apps/buildself') || appId === 'buildself';
			const isFreshSelf = (Astro.url.pathname.includes('/apps/freshself') && !Astro.url.pathname.includes('/apps/storeself')) || appId === 'freshself';
			const isStoreSelf = Astro.url.pathname.includes('/apps/storeself') || appId === 'storeself';
			const isLogSelf = Astro.url.pathname.includes('/apps/logself') || appId === 'logself';
			
			const appName = isBuildSelf ? "BuildSelf" : (isStoreSelf ? "StoreSelf" : (isFreshSelf ? "FreshSelf" : (isLogSelf ? "logSelf" : "SelaLink Studio")));
			const appCategory = isStoreSelf ? "LifestyleApplication" : (isFreshSelf || isLogSelf ? "LifestyleApplication" : "HealthApplication");
			
			const rawUrl = canonicalUrl || Astro.url.href;
			const formattedUrl = rawUrl.endsWith('/') ? rawUrl : rawUrl + '/';
			
			const sameAsLinks = [];
			if (isBuildSelf) {
				sameAsLinks.push("https://play.google.com/store/apps/details?id=com.selalink.buildself");
			} else if (isFreshSelf || isStoreSelf) {
				sameAsLinks.push("https://play.google.com/store/apps/details?id=com.selalink.freshself");
			} else if (isLogSelf) {
				sameAsLinks.push("https://play.google.com/store/apps/details?id=com.selalink.logself");
			} else {
				// 메인/기타 페이지일 때 공식 유튜브 채널 바인딩
				sameAsLinks.push("https://www.youtube.com/channel/UChmmgdbcjP5PnVE-WGUspgA");
			}

			const t = useTranslations(lang as any);
			
			const alternateNames = [];
			if (isBuildSelf) {
				alternateNames.push(t('app.buildself.title'), "빌드셀프", "BuildSelf");
			} else if (isFreshSelf) {
				alternateNames.push(t('app.freshself.title'), "프레시셀프", "프레쉬셀프", "FreshSelf");
			} else if (isStoreSelf) {
				alternateNames.push(t('app.storeself.title'), "스토어셀프", "StoreSelf");
			} else if (isLogSelf) {
				alternateNames.push(t('app.logself.title'), "로그셀프", "logSelf");
			}
			
			let appFeatures: string[] = [];
			if (isBuildSelf) {
				appFeatures = (t('app.buildself.meta.features') || '').split(',');
			} else if (isFreshSelf) {
				appFeatures = (t('app.freshself.meta.features') || '').split(',');
			} else if (isStoreSelf) {
				appFeatures = (t('app.storeself.meta.features') || '').split(',');
			} else if (isLogSelf) {
				appFeatures = (t('app.logself.meta.features') || '').split(',');
			}
			
			let pageKeywords = keywords;
			if (!pageKeywords) {
				if (isBuildSelf) pageKeywords = t('app.buildself.meta.keywords');
				else if (isFreshSelf) pageKeywords = t('app.freshself.meta.keywords');
				else if (isStoreSelf) pageKeywords = t('app.storeself.meta.keywords');
				else if (isLogSelf) pageKeywords = t('app.logself.meta.keywords');
				else pageKeywords = t('meta.keywords');
			}
			
			return (
				<script type="application/ld+json" set:html={JSON.stringify({
					"@context": "https://schema.org",
					"@type": ogType === 'software' ? "SoftwareApplication" : "Organization",
					"name": ogType === 'software' ? appName : "SelaLink Studio",
					"alternateName": alternateNames.length > 0 ? alternateNames : undefined,
					"url": formattedUrl,
					"description": description,
					"keywords": pageKeywords,
					...(ogType === 'software' ? {
						"applicationCategory": appCategory,
						"operatingSystem": "iOS, Android",
						"featureList": appFeatures.length > 0 ? appFeatures : undefined,
						"offers": {
							"@type": "Offer",
							"price": "0",
							"priceCurrency": "USD"
						},
						"publisher": {
							"@type": "Organization",
							"name": "SelaLink Studio",
							"url": "https://selalink.net/"
						}
					} : {}),
					...(sameAsLinks.length > 0 ? {
						"sameAs": sameAsLinks
					} : {})
				})} />
			);
		})()}
		
		{structuredData && (
			Array.isArray(structuredData) ? (
				structuredData.map((sd) => (
					<script type="application/ld+json" set:html={JSON.stringify(sd)} />
				))
			) : (
				<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
			)
		)}
		
		<style is:global>
			body {
				font-family: var(--theme-font-family, 'Space Grotesk', 'Pretendard', sans-serif);
				transition: background-color 0.5s ease, color 0.5s ease;
				overflow-x: hidden;
			}
			/* Global Typography Polish for Korean */
			html[lang="ko"] body {
				word-break: keep-all;
			}
			
			/* Font Helpers */
			.font-outfit {
				font-family: 'Outfit', 'Space Grotesk', 'Pretendard', sans-serif;
			}
			.font-jakarta {
				font-family: 'Plus Jakarta Sans', 'Pretendard', sans-serif;
			}
			
			/* LIGHT MODE DEFAULT */
			body {
				background-color: #f8fafc; /* slate-50 */
				color: #0f172a; /* slate-900 */
				transition: background-color 0.5s ease-in-out, color 0.5s ease-in-out;
			}
			
			/* Dynamic Accent UI Links */
			#langButton {
				transition: color 0.3s ease;
			}
			#langButton:hover {
				color: var(--theme-accent) !important;
			}
			.bento-card {
				background: rgba(255, 255, 255, 0.85);
				backdrop-filter: blur(40px);
				-webkit-backdrop-filter: blur(40px);
				border: 1px solid rgba(0, 0, 0, 0.08);
				border-radius: 32px;
				transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.5s ease-in-out, border-color 0.5s ease-in-out;
				box-shadow: 0 4px 30px rgba(0, 0, 0, 0.03);
				position: relative;
				overflow: hidden;
			}
			.bento-card:hover {
				transform: translateY(-4px) scale(1.01);
				background: rgba(255, 255, 255, 0.95);
				border-color: rgba(0, 0, 0, 0.12);
				box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
				z-index: 10;
			}
            
			/* DARK MODE SPATIAL */
			html.dark body {
				background-color: #0b0c10;
				color: #ffffff;
			}
			html.dark .bento-card {
				background: rgba(15, 17, 23, 0.7);
				border: 1px solid rgba(255, 255, 255, 0.08);
				box-shadow: 0 4px 30px rgba(0, 0, 0, 0.45);
			}
			html.dark .bento-card:hover {
				background: rgba(25, 28, 36, 0.85);
				border-color: rgba(255, 255, 255, 0.15);
				box-shadow: 0 20px 40px rgba(0, 0, 0, 0.7);
			}
            
			/* GLOW EFFECT */
			.bento-glow {
				position: absolute;
				width: 400px;
				height: 400px;
				background: radial-gradient(circle 220px at var(--mouse-x, 50%) var(--mouse-y, 50%), var(--glow-color, rgba(255,255,255,0.08)) 0%, transparent 75%);
				opacity: 0;
				transition: opacity 0.5s ease;
				pointer-events: none;
				border-radius: 50%;
				transform: translate(-50%, -50%);
			}
			.bento-card:hover .bento-glow {
				opacity: 1;
			}
		</style>
		
		<script is:inline define:vars={{ forceTheme }}>
			const theme = (() => {
				if (forceTheme) return forceTheme;
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'dark'; // Always default to dark for SelaLink Spatial aesthetic
			})();
			if (theme === 'light') {
				document.documentElement.classList.remove('dark');
			} else {
				document.documentElement.classList.add('dark');
			}
			if (!forceTheme) {
				window.localStorage.setItem('theme', theme);
			}
		</script>
	</head>
	<body class="antialiased selection:bg-black selection:text-white dark:selection:bg-white dark:selection:text-black">
		<!-- Navigation Bar with Lang & Theme Switches -->
		<header class="max-w-[1400px] mx-auto px-6 pt-6 md:pt-12 flex flex-col sm:flex-row justify-between items-center gap-4 sm:gap-0 relative z-50">
			<a href={`/${lang}`} class="text-xl sm:text-2xl font-bold tracking-tighter flex items-center transition-all duration-300 hover:opacity-80">
				<span>SelaLink.</span>
				{appId === 'buildself' && (
					<span class="text-teal-600 dark:text-teal-400 font-extrabold ml-1.5 font-outfit text-lg sm:text-xl tracking-tight animate-fade-in">BuildSelf</span>
				)}
				{appId === 'freshself' && (
					<span class="text-purple-600 dark:text-purple-400 font-bold ml-1.5 font-jakarta text-lg sm:text-xl tracking-normal animate-fade-in">FreshSelf</span>
				)}
				{appId === 'storeself' && (
					<span class="text-emerald-600 dark:text-emerald-400 font-bold ml-1.5 font-jakarta text-lg sm:text-xl tracking-normal animate-fade-in">StoreSelf</span>
				)}

				{appId === 'logself' && (
					<span class="text-indigo-600 dark:text-indigo-400 font-extrabold ml-1.5 font-outfit text-lg sm:text-xl tracking-tight animate-fade-in">logSelf</span>
				)}
			</a>
			<div class="flex items-center gap-4 sm:gap-6">
				<!-- Blog Link -->
				<a href={`/${lang}/blog/`} class="text-sm font-semibold transition-all duration-300 hover:text-[var(--theme-accent,#0D9488)]">
					{t('nav.blog')}
				</a>
				<!-- Language Dropdown -->
				<div class="relative" id="langWrapper">
					<button 
						id="langButton" 
						aria-label="Select Language" 
						aria-disabled={supportedLanguages?.length === 1 ? "true" : "false"}
						title={supportedLanguages?.length === 1 ? "Language is locked (Content restricted)" : "Select Language"}
						class={`flex items-center gap-1.5 text-sm font-semibold uppercase focus:outline-none focus:ring-2 focus:ring-slate-400 dark:focus:ring-slate-600 rounded-md px-2.5 py-1 ${supportedLanguages?.length === 1 ? 'opacity-50 cursor-default' : 'hover:opacity-70 transition-opacity'} text-slate-800 dark:text-slate-200`}
					>
						<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
						<span>{supportedLanguages?.length === 1 ? supportedLanguages[0] : lang}</span>
						{supportedLanguages?.length !== 1 && (
							<svg class="w-3.5 h-3.5 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
						)}
					</button>
					
					{supportedLanguages?.length === 1 && (
						<div id="langLockTooltip" class="absolute right-0 top-full mt-2 w-56 bg-orange-600 text-white rounded-xl shadow-xl p-3 text-xs font-bold leading-normal transition-all transform origin-top-right scale-95 opacity-0 invisible z-50 pointer-events-none border border-orange-500/20">
							{t('nav.lang.locked')}
						</div>
					)}
					
					<div id="langMenu" class="absolute right-0 top-full mt-2 w-48 bg-white dark:bg-slate-800 rounded-xl shadow-xl flex flex-col py-2 opacity-0 invisible transition-all transform origin-top-right scale-95 z-50 pointer-events-none">
						{Object.entries(languages).map(([code, label]) => {
							const isSupported = !supportedLanguages || supportedLanguages.includes(code);
							
							if (!isSupported) {
								return (
									<div class="px-4 py-2 text-sm text-slate-400 dark:text-slate-500 cursor-not-allowed flex justify-between items-center group">
										<span>{code.toUpperCase()} - {label}</span>
										<span class="text-[10px] hidden group-hover:inline-block text-red-500/80 font-bold uppercase tracking-wider">Only {supportedLanguages.join(', ').toUpperCase()}</span>
									</div>
								);
							}

							return (
								<a href={getPathForLang(code)} class="px-4 py-2 text-sm text-slate-800 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
									{code.toUpperCase()} - {label}
								</a>
							);
						})}
					</div>
				</div>
				<!-- Theme Toggle -->
				{!forceTheme && (
					<button id="themeToggle" aria-label="Toggle Dark Mode" class="w-10 h-10 rounded-full flex items-center justify-center bg-slate-200 dark:bg-slate-800 hover:scale-110 transition-transform focus:outline-none focus:ring-2 focus:ring-slate-400 dark:focus:ring-slate-600 text-slate-800 dark:text-slate-200">
						<svg class="w-5 h-5 dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
						<svg class="w-5 h-5 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
					</button>
				)}
			</div>
		</header>
		
		<slot />
		
		<script>
            // Theme toggle logic
			document.getElementById('themeToggle')?.addEventListener('click', () => {
				const isDark = document.documentElement.classList.contains('dark');
				localStorage.setItem('theme', isDark ? 'light' : 'dark');
				document.documentElement.classList.toggle('dark');
			});

            // Language Dropdown toggle logic
            const langBtn = document.getElementById('langButton');
            const langMenu = document.getElementById('langMenu');
            const lockTooltip = document.getElementById('langLockTooltip');
            const isLocked = langBtn?.getAttribute('aria-disabled') === 'true';
            
            if (isLocked && lockTooltip) {
                const showTooltip = () => {
                    lockTooltip.classList.remove('opacity-0', 'invisible', 'scale-95', 'pointer-events-none');
                    lockTooltip.classList.add('opacity-100', 'visible', 'scale-100');
                };
                const hideTooltip = () => {
                    lockTooltip.classList.add('opacity-0', 'invisible', 'scale-95', 'pointer-events-none');
                    lockTooltip.classList.remove('opacity-100', 'visible', 'scale-100');
                };

                langBtn?.addEventListener('mouseenter', showTooltip);
                langBtn?.addEventListener('mouseleave', hideTooltip);
                langBtn?.addEventListener('focus', showTooltip);
                langBtn?.addEventListener('blur', hideTooltip);
                langBtn?.addEventListener('click', (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    showTooltip();
                    setTimeout(hideTooltip, 2500);
                });
            } else {
                langBtn?.addEventListener('click', (e) => {
                    e.stopPropagation();
                    if (langMenu) {
                        langMenu.classList.toggle('opacity-0');
                        langMenu.classList.toggle('invisible');
                        langMenu.classList.toggle('scale-95');
                        langMenu.classList.toggle('scale-100');
                        langMenu.classList.toggle('pointer-events-none');
                    }
                });
            }

            // Close dropdown when clicking outside
            document.addEventListener('click', (e) => {
                if (langMenu && !langMenu.classList.contains('opacity-0')) {
                    langMenu.classList.add('opacity-0', 'invisible', 'scale-95', 'pointer-events-none');
                    langMenu.classList.remove('scale-100');
                }
            });

			// Interactive Radial Glow logic
			document.querySelectorAll('.bento-card').forEach((card) => {
				// Create glow element inside if not present (Astro hydration safeguard)
				let glow = card.querySelector('.bento-glow');
				if (!glow) {
					glow = document.createElement('div');
					glow.className = 'bento-glow';
					card.prepend(glow);
				}
				
				card.addEventListener('mousemove', (e: any) => {
					const rect = card.getBoundingClientRect();
					const x = e.clientX - rect.left;
					const y = e.clientY - rect.top;
					(glow as HTMLElement).style.setProperty('--mouse-x', `${x}px`);
					(glow as HTMLElement).style.setProperty('--mouse-y', `${y}px`);
				});
			});
		</script>

		<ShortsPlayerModal lang={lang} />

		{appId === 'buildself' && (
			<AppToast lang={lang} triggerId="bsIosDownloadBtn" toastId="bsToastNotification" />
		)}
		{appId === 'logself' && (
			<AppToast lang={lang} triggerId="lsIosDownloadBtn" toastId="lsToastNotification" />
		)}
		{appId === 'freshself' && (
			<AppToast lang={lang} triggerId="iosDownloadBtn" toastId="toastNotification" />
		)}
		{appId === 'storeself' && (
			<AppToast lang={lang} triggerId="iosDownloadBtn" toastId="toastNotification" title={t('app.toast.ios.title')} desc={t('app.toast.ios.desc')} />
		)}
	</body>
</html>

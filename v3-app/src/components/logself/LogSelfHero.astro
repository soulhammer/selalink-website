---
import { useTranslations, languages } from '../../i18n/ui';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang as keyof typeof languages);

const isKo = lang === 'ko';
const qrTitle = t('app.qr.title');
const qrDesc = t('app.qr.desc');
---

<!-- Hero Section - Spatial Design Integration -->
<section class="flex flex-col lg:flex-row items-center justify-between gap-8 lg:gap-20 mb-12 md:mb-20">
	<div class="flex-1 space-y-6 md:space-y-8 w-full max-w-2xl lg:max-w-xl z-20 text-center lg:text-left">
		<!-- Badge -->
		<div class="inline-flex items-center px-4 py-2 rounded-full bg-indigo-50 dark:bg-indigo-500/10 border border-indigo-200 dark:border-indigo-500/30 shadow-sm mx-auto lg:mx-0 w-max">
			<div class="flex items-center gap-2">
				<span class="w-1.5 md:w-2 h-1.5 md:h-2 rounded-full bg-indigo-500 animate-pulse"></span>
				<span class="text-base leading-none">🔒</span>
			</div>
			<div class="w-[1px] h-4 bg-indigo-300 dark:bg-indigo-500/50 mx-3"></div>
			<span class="font-bold text-indigo-600 dark:text-indigo-400 text-sm tracking-tight">{t('app.logself.supported')}</span>
		</div>
		<h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black text-slate-900 dark:text-white leading-[1.1] tracking-tight whitespace-pre-line mx-auto lg:mx-0">
			{t('ls.hero.title')}
		</h1>
		<p class="text-lg md:text-xl text-slate-600 dark:text-slate-400 leading-relaxed font-medium mx-auto lg:mx-0">
			{t('app.logself.desc')}
		</p>
		
		<div class="flex flex-col sm:flex-row gap-3 md:gap-4 pt-4 md:pt-6 justify-center lg:justify-start w-full relative z-20">
			<button id="lsIosDownloadBtn" class="flex items-center justify-center gap-3 bg-slate-200/50 dark:bg-slate-800/50 border border-slate-300 dark:border-slate-700 text-slate-500 dark:text-slate-400 px-6 md:px-8 py-3 md:py-4 rounded-xl md:rounded-2xl font-bold text-base md:text-lg opacity-70 cursor-pointer w-full sm:w-auto transition-all duration-300 hover:scale-[1.01] app-button">
				<svg class="w-5 h-5 md:w-6 md:h-6 opacity-70" fill="currentColor" viewBox="0 0 24 24"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.253 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.04 2.26-.79 3.59-.76 2.6.04 4.19 1.45 4.8 1.8-3.1 1.76-2.58 5.86.37 6.94-1.04 2.45-2.51 3.5-3.84 4.19zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
				<div class="flex flex-col items-start leading-tight">
					<span class="text-xs text-slate-400 font-medium uppercase tracking-wider">App Store</span>
					<span class="text-sm font-bold text-slate-500">Coming Soon</span>
				</div>
			</button>
			
			<a href={`https://play.google.com/store/apps/details?id=com.selalink.logself&hl=${lang}`} target="_blank" rel="noopener noreferrer" class="group/btn flex items-center justify-center gap-3 bg-indigo-600 hover:bg-indigo-500 text-white px-8 py-4 rounded-2xl font-bold text-lg cursor-pointer shadow-lg shadow-indigo-600/20 hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 w-full sm:w-auto">
				<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M3 20.5v-17c0-.83.67-1.5 1.5-1.5.34 0 .66.12.92.33l13.62 10.15c.67.5.76 1.45.19 2.06l-13.62 10.15a1.5 1.5 0 01-2.42-1.2v-1.92z"/></svg>
				<div class="flex flex-col items-start leading-tight">
					<span class="text-xs text-indigo-200 font-medium uppercase tracking-wider">Google Play</span>
					<span class="text-sm font-bold text-white">{t('ls.hero.cta')}</span>
				</div>
			</a>
		</div>

		<!-- Frictionless QR Code Card (Desktop Only) -->
		<div class="hidden md:flex items-center gap-4 p-4 rounded-2xl bg-white/70 dark:bg-slate-900/50 backdrop-blur-2xl border border-white/80 dark:border-white/10 shadow-md w-max mt-6 relative z-20">
			<div class="w-32 h-32 bg-white dark:bg-white p-3 rounded-2xl border border-slate-200 flex items-center justify-center shadow-inner">
				<img src="/assets/images/qr/qr_logself.svg" alt="logSelf Play Store QR Code" class="w-full h-full object-contain" />
			</div>
			<div class="flex flex-col text-left font-sans">
				<span class="text-xs font-bold text-slate-800 dark:text-slate-200">{qrTitle}</span>
				<span class="text-[10px] text-slate-500 dark:text-slate-400 font-medium mt-0.5 leading-tight" set:html={qrDesc}></span>
			</div>
		</div>
	</div>

	<!-- Premium 3D Glassmorphism Image Stack -->
	<div class="flex-1 w-full h-auto lg:h-[600px] relative flex flex-col items-center justify-center perspective-[1200px] mt-12 lg:mt-0 z-10 pointer-events-none">
		<!-- Back Image (Analytics/Stats) - Hidden on mobile/tablet for clarity -->
		<div class="hidden lg:block absolute right-4 top-10 w-[70%] max-w-[320px] rounded-[2.5rem] p-1.5 bg-white/30 dark:bg-slate-800/30 backdrop-blur-xl border border-white/40 dark:border-white/10 shadow-2xl transform rotate-6 hover:rotate-3 transition-all duration-700 opacity-90">
			<img src={`/images/logself/${isKo ? 'ko' : 'en'}/3.jpeg`} alt="logSelf Analytics" class="w-full h-auto rounded-[2.2rem] shadow-inner object-cover" loading="lazy" />
		</div>
		
		<!-- Front Image (Main Timeline) - Relative and centered on mobile/tablet -->
		<div class="relative lg:absolute lg:left-4 lg:bottom-10 w-[68%] sm:w-[60%] lg:w-[75%] max-w-[340px] rounded-[2rem] lg:rounded-[2.5rem] p-1.5 lg:p-2 bg-white/70 dark:bg-slate-700/60 backdrop-blur-2xl border border-white/80 dark:border-white/20 shadow-[-10px_10px_40px_rgba(0,0,0,0.15)] lg:shadow-[-20px_20px_60px_rgba(0,0,0,0.15)] dark:shadow-[0_20px_30px_70px_rgba(0,0,0,0.6)] transform -rotate-3 hover:transform-none transition-all duration-700 z-10 footprint-card mx-auto lg:mx-0">
			<img src={`/images/logself/${isKo ? 'ko' : 'en'}/1.jpeg`} alt="logSelf Main Timeline" class="w-full h-auto rounded-[1.8rem] lg:rounded-[2rem] shadow-sm object-cover" loading="eager" />
			
			<!-- Floating Glass Chip: SQLCipher Active -->
			<div class="absolute -left-2 lg:-left-6 top-16 lg:top-20 bg-white/90 dark:bg-slate-800/90 backdrop-blur-md px-3 lg:px-4 py-2 lg:py-3 rounded-xl lg:rounded-2xl border border-slate-100 dark:border-slate-700 shadow-xl flex items-center gap-2 lg:gap-3 transform -rotate-6 z-20">
				<div class="w-6 h-6 lg:w-8 lg:h-8 rounded-full bg-emerald-100 dark:bg-emerald-500/20 flex items-center justify-center text-emerald-600 dark:text-emerald-400 text-xs lg:text-base">✓</div>
				<div class="text-xs lg:text-sm font-bold text-slate-800 dark:text-slate-200 shadow-sm lg:shadow-none bg-slate-100 dark:bg-slate-700 lg:bg-slate-100/50 lg:dark:bg-slate-800/50 rounded-full lg:rounded-lg px-2.5 py-1 lg:px-2 lg:py-0.5">SQLCipher Active</div>
			</div>

			<!-- Sleek Live Tag Pill -->
			<div class="absolute -right-2 lg:-right-8 top-32 lg:top-1/3 bg-white/95 dark:bg-slate-800/95 backdrop-blur-xl px-4 py-3 rounded-full border border-slate-200/80 dark:border-slate-700/80 shadow-[0_15px_30px_rgba(0,0,0,0.12)] dark:shadow-[0_15px_30px_rgba(0,0,0,0.6)] flex items-center gap-3 transform rotate-2 hover:-rotate-1 hover:scale-105 transition-all duration-500 z-20 tooltip-hover-group group">
				<div class="w-7 h-7 rounded-full bg-gradient-to-br from-indigo-100 to-indigo-50 dark:from-indigo-500/20 dark:to-indigo-500/5 flex items-center justify-center text-indigo-600 dark:text-indigo-400 border border-indigo-200/50 dark:border-indigo-500/20 shadow-inner group-hover:scale-110 transition-transform">
					<span class="text-xs font-bold">#</span>
				</div>
				<div class="text-sm font-bold text-slate-800 dark:text-slate-200 tracking-tight text-left flex items-center font-sans tracking-wide">
					{isKo ? '오늘의 생각' : 'today_thought'}
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.footprint-card {
		transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
		border: 1px solid rgba(99, 102, 241, 0.1);
	}
	.footprint-card:hover {
		transform: scale(1.02) translateY(-6px);
		box-shadow: 0 30px 60px -15px rgba(99, 102, 241, 0.25), 0 0 0 1px rgba(99, 102, 241, 0.2);
		border-color: rgba(99, 102, 241, 0.3);
	}
	.app-button {
		transition: all 0.3s ease;
	}
	.app-button:hover {
		transform: translateY(-2px);
		box-shadow: 0 10px 25px -5px #6366F1;
	}
</style>

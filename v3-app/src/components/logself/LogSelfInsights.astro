---
import { useTranslations, languages } from '../../i18n/ui';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang as keyof typeof languages);

const isKo = lang === 'ko';
---

<!-- Self-Reflection & Insights Section -->
<section class="mb-20 md:mb-28">
	<div class="text-center max-w-2xl mx-auto mb-12">
		<h2 class="text-3xl md:text-4xl font-black text-slate-900 dark:text-white tracking-tight mb-4">
			{t('ls.insights.title')}
		</h2>
		<p class="text-slate-600 dark:text-slate-400 font-medium px-4">
			{t('ls.insights.desc')}
		</p>
	</div>
	<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
		<!-- Card 1: Mood Calendar -->
		<div 
			class="app-card-neon flex flex-col pt-8 px-6 items-center rounded-3xl relative overflow-hidden backdrop-blur-xl group"
			style="--theme-color-light: rgba(99, 102, 241, 0.15); --theme-color-brand: #6366F1; --theme-color-glow: rgba(99, 102, 241, 0.15); --theme-color-glow-secondary: rgba(99, 102, 241, 0.05);"
		>
			<div class="flex-1 w-full flex flex-col items-start text-left">
				<span class="text-2xl mb-4">📅</span>
				<h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">{t('ls.insights.card1.title')}</h3>
				<p class="text-xs md:text-sm text-slate-650 dark:text-slate-455 leading-relaxed font-medium mb-6">{t('ls.insights.card1.desc')}</p>
			</div>
			<div class="w-full mt-auto relative rounded-t-2xl overflow-hidden border border-slate-200 dark:border-slate-800 shadow-lg bg-white/50 dark:bg-slate-900/50">
				<div class="aspect-[4/3] w-full overflow-hidden flex justify-center items-start">
					<img src={`/images/logself/${isKo ? 'ko' : 'en'}/4.jpeg`} alt="logSelf Mood Calendar" class="w-full h-full object-cover object-[center_62%] scale-[1.02] hover:scale-[1.05] transition-transform duration-700" loading="lazy" />
				</div>
			</div>
		</div>
		<!-- Card 2: Photo & Link Gallery -->
		<div 
			class="app-card-neon flex flex-col pt-8 px-6 items-center rounded-3xl relative overflow-hidden backdrop-blur-xl group"
			style="--theme-color-light: rgba(99, 102, 241, 0.15); --theme-color-brand: #6366F1; --theme-color-glow: rgba(99, 102, 241, 0.15); --theme-color-glow-secondary: rgba(99, 102, 241, 0.05);"
		>
			<div class="flex-1 w-full flex flex-col items-start text-left">
				<span class="text-2xl mb-4">🖼️</span>
				<h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">{t('ls.insights.card2.title')}</h3>
				<p class="text-xs md:text-sm text-slate-650 dark:text-slate-455 leading-relaxed font-medium mb-6">{t('ls.insights.card2.desc')}</p>
			</div>
			<div class="w-full mt-auto relative rounded-t-2xl overflow-hidden border border-slate-200 dark:border-slate-800 shadow-lg bg-white/50 dark:bg-slate-900/50">
				<div class="aspect-[4/3] w-full overflow-hidden flex justify-center items-start">
					<img src={`/images/logself/${isKo ? 'ko' : 'en'}/5.jpeg`} alt="logSelf Media Gallery" class="w-full h-full object-cover object-[center_12%] scale-[1.02] hover:scale-[1.05] transition-transform duration-700" loading="lazy" />
				</div>
			</div>
		</div>
		<!-- Card 3: Chronicle Insights -->
		<div 
			class="app-card-neon flex flex-col pt-8 px-6 items-center rounded-3xl relative overflow-hidden backdrop-blur-xl group"
			style="--theme-color-light: rgba(99, 102, 241, 0.15); --theme-color-brand: #6366F1; --theme-color-glow: rgba(99, 102, 241, 0.15); --theme-color-glow-secondary: rgba(99, 102, 241, 0.05);"
		>
			<div class="flex-1 w-full flex flex-col items-start text-left">
				<span class="text-2xl mb-4">📊</span>
				<h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">{t('ls.insights.card3.title')}</h3>
				<p class="text-xs md:text-sm text-slate-650 dark:text-slate-455 leading-relaxed font-medium mb-6">{t('ls.insights.card3.desc')}</p>
			</div>
			<div class="w-full mt-auto relative rounded-t-2xl overflow-hidden border border-slate-200 dark:border-slate-800 shadow-lg bg-white/50 dark:bg-slate-900/50">
				<div class="aspect-[4/3] w-full overflow-hidden flex justify-center items-start">
					<img src={`/images/logself/${isKo ? 'ko' : 'en'}/6.jpeg`} alt="logSelf Chronicle Insights" class="w-full h-full object-cover object-[center_12%] scale-[1.02] hover:scale-[1.05] transition-transform duration-700" loading="lazy" />
				</div>
			</div>
		</div>
	</div>
</section>

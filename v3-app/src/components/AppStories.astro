---
import { useTranslations } from '../i18n/ui';
import shortsData from '../data/shorts.json';

export interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang as any);

const buildselfData = shortsData.buildself as Record<string, any>;
const freshselfData = shortsData.freshself as Record<string, any>;

// 안전하게 BuildSelf 및 FreshSelf 데이터 파싱 및 appType 매핑
const bsShorts = (buildselfData[lang] || buildselfData['en'] || []).map((s: any) => ({
  ...s,
  appType: 'buildself',
  label: 'BuildSelf'
}));

const fsShorts = (freshselfData[lang] || freshselfData['en'] || []).map((s: any) => ({
  ...s,
  appType: 'freshself',
  label: 'FreshSelf'
}));
---

<div class="flex items-center gap-4 md:gap-6 pt-4 pb-2 overflow-x-auto w-full max-w-[1400px] mx-auto hide-scrollbar px-6" id="app-stories-container">
  <!-- 2:2 extracted & shuffled final 4 items will be inserted via Client JS -->
</div>

<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script define:vars={{ bsShorts, fsShorts }}>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('app-stories-container');
    if (!container || !bsShorts || !fsShorts) return;

    // 1. Extract 2 random items from BuildSelf
    const shuffledBs = [...bsShorts].sort(() => 0.5 - Math.random());
    const selectedBs = shuffledBs.slice(0, 2);

    // 2. Extract 2 random items from FreshSelf
    const shuffledFs = [...fsShorts].sort(() => 0.5 - Math.random());
    const selectedFs = shuffledFs.slice(0, 2);

    // 3. Combine the selected 4 items
    const combined = [...selectedBs, ...selectedFs];

    // 4. Randomly shuffle the 4 items (Fisher-Yates)
    for (let i = combined.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [combined[i], combined[j]] = [combined[j], combined[i]];
    }

    // 5. Dynamically render the 4 shuffled stories
    combined.forEach((story, index) => {
      const numLabel = `0${index + 1}`;
      
      // Brand theme colors (Rule 3 compliant)
      const gradientClass = story.appType === 'buildself'
        ? 'from-teal-500 via-teal-400 to-indigo-500 shadow-[0_10px_30px_rgba(20,184,166,0.2)] hover:shadow-[0_10px_40px_rgba(20,184,166,0.4)]' // BuildSelf: Mint
        : 'from-purple-600 via-purple-400 to-pink-500 shadow-[0_10px_30px_rgba(139,92,246,0.2)] hover:shadow-[0_10px_40px_rgba(139,92,246,0.4)]'; // FreshSelf: Purple/Pink
        
      const hoverTextColor = story.appType === 'buildself'
        ? 'group-hover:text-teal-600 dark:group-hover:text-teal-400'
        : 'group-hover:text-purple-600 dark:group-hover:text-purple-400';

      const storyTitle = story.appType === 'buildself'
        ? `BuildSelf ${numLabel}`
        : `FreshSelf ${numLabel}`;

      const button = document.createElement('button');
      button.className = "group flex flex-col items-center gap-2.5 flex-shrink-0 focus:outline-none";
      button.onclick = () => window.openShortsModal(story.id, story.appType);
      
      button.innerHTML = `
        <div class="relative w-[80px] h-[80px] md:w-[96px] md:h-[96px] rounded-full p-[3px] bg-gradient-to-tr ${gradientClass} transition-all animate-[spin_8s_linear_infinite]">
          <div class="absolute inset-0 bg-white dark:bg-slate-900 rounded-full m-[3px]"></div>
          <div class="relative w-full h-full rounded-full overflow-hidden border-2 border-white dark:border-slate-900 animate-[spin_8s_linear_infinite_reverse]">
            <img 
              src="https://img.youtube.com/vi/${story.id}/hqdefault.jpg" 
              alt="${story.label} Highlight ${numLabel}" 
              class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-500 bg-slate-200 dark:bg-slate-800" 
            />
            <div class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
               <svg class="w-8 h-8 text-white ml-1" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            </div>
          </div>
        </div>
        <span class="text-[12px] md:text-[13px] font-bold text-slate-800 dark:text-slate-200 tracking-tight transition-colors ${hoverTextColor} mt-1 uppercase">
          ${storyTitle}
        </span>
      `;
      
      container.appendChild(button);
    });
  });
</script>

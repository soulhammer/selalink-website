---
import { useTranslations } from '../i18n/ui';
import shortsData from '../data/shorts.json';

const { lang } = Astro.props;
const t = useTranslations(lang);

// 다국어 폴백: 해당 언어가 없으면 'en' 데이터 모음 사용
const availableShorts = shortsData.buildself[lang] || shortsData.buildself['en'];
const shortsIds = availableShorts.map(s => s.id);
---

<div class="flex items-center gap-4 md:gap-6 pt-10 pb-6 overflow-x-auto w-full max-w-[1400px] mx-auto hide-scrollbar px-6" id="app-stories-container">
  <!-- Story items will be generated here by client-side JS -->
</div>

<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script define:vars={{ shortsIds }}>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('app-stories-container');
    if (!container || !shortsIds || shortsIds.length === 0) return;

    // 무작위로 섞은 뒤 최대 3개 선택 (English는 4개 중 3개, Korean은 5개 중 3개)
    const shuffled = [...shortsIds].sort(() => 0.5 - Math.random());
    const displayCount = Math.min(3, shuffled.length);
    const selectedIds = shuffled.slice(0, displayCount);

    selectedIds.forEach((id, index) => {
      const numLabel = `0${index + 1}`;
      
      const button = document.createElement('button');
      button.className = "group flex flex-col items-center gap-2.5 flex-shrink-0 focus:outline-none";
      button.onclick = () => window.openShortsModal(id);
      
      button.innerHTML = `
        <div class="relative w-[80px] h-[80px] md:w-[96px] md:h-[96px] rounded-full p-[3px] bg-gradient-to-tr from-brand-500 via-teal-400 to-indigo-500 shadow-[0_10px_30px_rgba(20,184,166,0.2)] hover:shadow-[0_10px_40px_rgba(20,184,166,0.4)] transition-all animate-[spin_8s_linear_infinite]">
          <div class="absolute inset-0 bg-white dark:bg-slate-900 rounded-full m-[3px]"></div>
          <div class="relative w-full h-full rounded-full overflow-hidden border-2 border-white dark:border-slate-900 animate-[spin_8s_linear_infinite_reverse]">
            <img 
              src="https://img.youtube.com/vi/${id}/hqdefault.jpg" 
              alt="BuildSelf Highlight ${numLabel}" 
              class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-500 bg-slate-200 dark:bg-slate-800" 
            />
            <div class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
               <svg class="w-8 h-8 text-white ml-1" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            </div>
          </div>
        </div>
        <span class="text-[12px] md:text-[13px] font-black text-slate-800 dark:text-slate-200 tracking-tight transition-colors group-hover:text-teal-600 dark:group-hover:text-teal-400 mt-1 uppercase">
          BuildSelf ${numLabel}
        </span>
      `;
      
      container.appendChild(button);
    });
  });
</script>

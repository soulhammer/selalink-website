---
interface Props {
  id: string;
  title?: string;
  isShorts?: boolean;
  app?: 'storeself' | 'freshself' | 'buildself' | 'general';
}

const { id, title = "YouTube Video", isShorts = true, app = 'storeself' } = Astro.props;

// 고화질 썸네일 URL 추출
const thumbnailUrls = [
  `https://img.youtube.com/vi/${id}/maxresdefault.jpg`,
  `https://img.youtube.com/vi/${id}/hqdefault.jpg`
];
---

<div class="my-6 flex flex-col items-center w-full">
  <!-- Interactive Thumbnail Card (Triggers full screen modal) -->
  <button 
    onclick={`if (window.openShortsModal) { window.openShortsModal('${id}', '${app}'); } else { window.open('https://youtube.com/shorts/${id}', '_blank'); }`}
    class="group relative w-full max-w-[280px] sm:max-w-[320px] aspect-[9/16] rounded-[2rem] overflow-hidden shadow-xl dark:shadow-2xl border border-slate-200/80 dark:border-white/10 bg-slate-100 dark:bg-slate-900 transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_20px_40px_rgba(16,185,129,0.15)] dark:hover:shadow-[0_20px_40px_rgba(16,185,129,0.3)] focus:outline-none focus:ring-4 focus:ring-emerald-500/20 cursor-pointer"
  >
    <!-- Background Thumbnail Image -->
    <img 
      src={thumbnailUrls[0]} 
      alt={title}
      onerror={`this.onerror=null; this.src='${thumbnailUrls[1]}';`}
      class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
      loading="lazy"
    />
    
    <!-- Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-slate-950/20 to-slate-950/40 group-hover:via-slate-950/30 transition-all duration-300"></div>

    <!-- Play Button Ripple Ring Overlay -->
    <div class="absolute inset-0 flex flex-col items-center justify-center gap-4 z-10">
      <div class="relative w-16 h-16 flex items-center justify-center rounded-full bg-white/20 dark:bg-white/10 border border-white/30 backdrop-blur-md shadow-2xl transition-all duration-300 group-hover:scale-110 group-hover:bg-white group-hover:border-white group-hover:text-emerald-600 text-white">
        <!-- SVG Play Icon -->
        <svg class="w-6 h-6 ml-1 transition-colors" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z" />
        </svg>
      </div>
      <span class="text-xs font-bold text-white/90 tracking-widest uppercase drop-shadow-md group-hover:text-white transition-colors duration-200">
        Click to Play
      </span>
    </div>

    <!-- App Identity Badge -->
    <div class="absolute bottom-6 left-6 right-6 z-10 flex justify-between items-center">
      <span class="text-[10px] font-bold bg-white/10 dark:bg-white/5 border border-white/20 text-white px-2.5 py-1 rounded-full backdrop-blur-sm uppercase tracking-widest">
        {app} shorts
      </span>
    </div>
  </button>
  
  <p class="mt-4 text-[11px] font-bold tracking-wider text-slate-400 dark:text-slate-500 uppercase flex items-center gap-1">
    <span>📺</span> Click for Cinematic Full Screen
  </p>
</div>

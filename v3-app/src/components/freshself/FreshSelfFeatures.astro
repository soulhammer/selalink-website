---
import { useTranslations, languages } from '../../i18n/ui';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang as keyof typeof languages);

const isKo = lang === 'ko';
const imgBase = isKo ? '/assets/images/apps/freshself/ko' : '/assets/images/apps/freshself/en';
---

<!-- Detailed Feature Section 1: Space Sharing -->
<section class="relative z-10 w-full max-w-7xl mx-auto px-6 py-10 md:py-16 border-t border-slate-200/50 dark:border-slate-800/40">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-center">
	
	<!-- Left Graphics (Space List & Members overlap) -->
	<div class="lg:col-span-5 order-2 lg:order-1 relative w-full h-[450px] sm:h-[500px] flex items-center justify-center pointer-events-none">
	  <!-- Back Stack (Space Member Invitation list) -->
	  <div 
	  	class="absolute left-8 bottom-6 w-[70%] max-w-[190px] rounded-[2rem] p-1 bg-white/30 dark:bg-slate-800/30 backdrop-blur-xl border border-white/40 dark:border-white/10 shadow-xl transform rotate-6 translate-x-[20px] translate-y-[-10px] opacity-80"
	  	style="--theme-color-light: rgba(139, 92, 246, 0.1); --theme-color-glow: rgba(139, 92, 246, 0.25); --theme-color-border-hover: rgba(139, 92, 246, 0.3);"
	  >
		<img src={`${imgBase}/6_freshself_phone_screen.jpg`} alt="FreshSelf Space Settings" class="w-full h-auto rounded-[1.8rem] object-cover shadow-inner" loading="lazy" />
	  </div>
	  <!-- Front Stack (Space Group List) -->
	  <div 
	  	class="app-card-interactive relative w-[75%] max-w-[210px] rounded-[2.5rem] p-1.5 bg-white/70 dark:bg-slate-700/60 backdrop-blur-2xl border border-white/80 dark:border-white/20 shadow-[-10px_10px_40px_rgba(0,0,0,0.1)] dark:shadow-[-20px_20px_60px_rgba(0,0,0,0.5)] transform -rotate-3 z-10"
	  	style="--theme-color-light: rgba(139, 92, 246, 0.15); --theme-color-glow: rgba(139, 92, 246, 0.25); --theme-color-border-hover: rgba(16, 185, 129, 0.3);"
	  >
		<img src={`${imgBase}/3_freshself_phone_screen.jpg`} alt="FreshSelf Space Selection" class="w-full h-auto rounded-[2.2rem] object-cover shadow-sm" loading="lazy" />
	  </div>
	</div>

	<!-- Right Copy -->
	<div class="lg:col-span-7 order-1 lg:order-2 space-y-6">
	  <div class="w-12 h-12 rounded-2xl bg-purple-100 dark:bg-purple-950/40 border border-purple-200 dark:border-purple-900/50 flex items-center justify-center text-purple-600 dark:text-purple-400 shadow-sm">
		<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
		  <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
		</svg>
	  </div>
	  <h2 class="text-xl sm:text-3xl lg:text-4xl font-black tracking-tight text-slate-900 dark:text-white leading-tight">
		{t('fs.feature1.title')}
	</h2>
	  <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 font-medium leading-relaxed">
		{t('fs.feature1.desc')}
	  </p>
	</div>

  </div>
</section>

<!-- Detailed Feature Section 2: Timeline & Feedback -->
<section class="relative z-10 w-full max-w-7xl mx-auto px-6 py-10 md:py-16 border-t border-slate-200/50 dark:border-slate-800/40">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-center">
	
	<!-- Left Copy -->
	<div class="lg:col-span-7 space-y-6">
	  <div class="w-12 h-12 rounded-2xl bg-emerald-100 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-900/50 flex items-center justify-center text-emerald-600 dark:text-emerald-400 shadow-sm">
		<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
		  <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
		</svg>
	  </div>
	  <h2 class="text-xl sm:text-3xl lg:text-4xl font-black tracking-tight text-slate-900 dark:text-white leading-tight">
		{t('fs.feature2.title')}
	  </h2>
	  <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 font-medium leading-relaxed">
		{t('fs.feature2.desc')}
	  </p>
	</div>

	<!-- Right Graphics (Timeline Details overlap) -->
	<div class="lg:col-span-5 relative w-full h-[450px] sm:h-[500px] flex items-center justify-center pointer-events-none">
	  <!-- Back Stack (Timeline detail log) -->
	  <div 
	  	class="absolute right-8 bottom-6 w-[70%] max-w-[190px] rounded-[2rem] p-1 bg-white/30 dark:bg-slate-800/30 backdrop-blur-xl border border-white/40 dark:border-white/10 shadow-xl transform -rotate-6 translate-x-[-20px] translate-y-[-10px] opacity-80"
	  	style="--theme-color-light: rgba(139, 92, 246, 0.1); --theme-color-glow: rgba(139, 92, 246, 0.25); --theme-color-border-hover: rgba(139, 92, 246, 0.3);"
	  >
		<img src={`${imgBase}/8_freshself_phone_screen.jpg`} alt="FreshSelf Timeline Detail" class="w-full h-auto rounded-[1.8rem] object-cover shadow-inner" loading="lazy" />
	  </div>
	  <!-- Front Stack (Overall history list) -->
	  <div 
	  	class="app-card-interactive relative w-[75%] max-w-[210px] rounded-[2.5rem] p-1.5 bg-white/70 dark:bg-slate-700/60 backdrop-blur-2xl border border-white/80 dark:border-white/20 shadow-[-10px_10px_40px_rgba(0,0,0,0.15)] dark:shadow-[-20px_20px_60px_rgba(0,0,0,0.5)] transform rotate-3 z-10"
	  	style="--theme-color-light: rgba(139, 92, 246, 0.15); --theme-color-glow: rgba(139, 92, 246, 0.25); --theme-color-border-hover: rgba(16, 185, 129, 0.3);"
	  >
		<img src={`${imgBase}/7_freshself_phone_screen.jpg`} alt="FreshSelf History List" class="w-full h-auto rounded-[2.2rem] object-cover shadow-sm" loading="lazy" />
	  </div>
	</div>

  </div>
</section>

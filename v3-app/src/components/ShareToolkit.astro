---
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang as any);
---

<div class="share-toolkit-container my-8 p-4 md:p-6 rounded-[2rem] border border-slate-200/50 dark:border-white/5 bg-slate-500/5 dark:bg-slate-900/10 backdrop-blur-sm shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4">
  <div class="flex items-center gap-2">
    <svg class="w-5 h-5 text-[var(--theme-accent,#0D9488)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
      <path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186l5.302-2.892m0 0a2.25 2.25 0 103.935-2.186 2.25 2.25 0 00-3.935 2.186zm0 2.186l-5.302 2.892m0 0a2.25 2.25 0 101.533 2.193m-1.533-2.193l5.302 2.892m0 0a2.25 2.25 0 103.933 2.193 2.25 2.25 0 00-3.933-2.193z" />
    </svg>
    <span class="text-sm font-bold text-slate-800 dark:text-slate-200 tracking-tight">{t('share.title')}</span>
  </div>

  <!-- Web Share API 전용 통합 버튼 -->
  <button id="webShareBtn" class="hidden items-center gap-2 px-5 py-2.5 rounded-2xl bg-[var(--theme-accent,#0D9488)] hover:brightness-105 text-white font-bold text-sm shadow-sm transition-all active:scale-[0.98] cursor-pointer">
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
    </svg>
    <span>{t('share.title')}</span>
  </button>

  <!-- 개별 SNS 공유 버튼 (데스크톱/미지원용) -->
  <div id="fallbackShareList" class="flex flex-wrap gap-2 items-center">
    <!-- Naver Blog (한국어 전용) -->
    {lang === 'ko' && (
      <a href="#" id="shareNaver" title="Naver Blog" class="share-chip hover:bg-[#2DB400]/10 hover:border-[#2DB400]/30 hover:text-[#2DB400] dark:hover:text-[#2DB400]">
        <span class="text-[11px] font-black font-sans w-3 h-3 bg-current text-white dark:text-slate-900 rounded-sm flex items-center justify-center pt-[0.5px]">N</span>
        <span class="text-xs font-bold">블로그</span>
      </a>
    )}

    <!-- LINE (아시아권 전용) -->
    {['ko', 'ja', 'zh', 'id'].includes(lang) && (
      <a href="#" id="shareLine" title="LINE" class="share-chip hover:bg-[#06C755]/10 hover:border-[#06C755]/30 hover:text-[#06C755] dark:hover:text-[#06C755]">
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M24 10.3c0-4.8-5.4-8.8-12-8.8S0 5.5 0 10.3c0 4.3 4.3 7.9 10.1 8.7.4.1.9.4 1 .9.1.5-.1 1.2-.2 1.6l-.3 1.9c-.1.5-.5 2.1 1.8 1.1 2.3-1 12.3-7.2 12.3-14.2zM7.1 13.9H5.5c-.3 0-.6-.3-.6-.6V7.7c0-.3.3-.6.6-.6h.5c.3 0 .6.3.6.6v5.1c0 .3-.3.5-.6.5zm4.8-.6c0 .3-.3.6-.6.6h-2c-.3 0-.6-.3-.6-.6V7.7c0-.3.3-.6.6-.6h.5c.3 0 .6.3.6.6v4.5h1.3c.3 0 .6.3.6.6v.5zm2.7-.6c0 .3-.3.6-.6.6h-.5c-.3 0-.6-.3-.6-.6V7.7c0-.3.3-.6.6-.6h.5c.3 0 .6.3.6.6v5.4zm5.5 0c0 .3-.3.6-.6.6h-2c-.3 0-.6-.3-.6-.6V7.7c0-.3.3-.6.6-.6h1.9c.3 0 .6.3.6.6v.5c0 .3-.3.6-.6.6h-1.3v1.1h1.3c.3 0 .6.3.6.6v.5c0 .3-.3.6-.6.6h-1.3V12h1.3c.3 0 .6.3.6.6v.6z"/>
        </svg>
        <span class="text-xs font-bold">LINE</span>
      </a>
    )}

    <!-- X (Twitter) -->
    <a href="#" id="shareX" title="X (Twitter)" class="share-chip hover:bg-black/10 hover:border-black/30 dark:hover:bg-white/10 dark:hover:border-white/30 dark:hover:text-white">
      <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
      </svg>
      <span class="text-xs font-bold">X</span>
    </a>

    <!-- Facebook -->
    <a href="#" id="shareFB" title="Facebook" class="share-chip hover:bg-[#1877F2]/10 hover:border-[#1877F2]/30 hover:text-[#1877F2] dark:hover:text-[#1877F2]">
      <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c4.56-.93 8-4.96 8-9.75z"/>
      </svg>
      <span class="text-xs font-bold">Facebook</span>
    </a>

    <!-- Reddit -->
    <a href="#" id="shareReddit" title="Reddit" class="share-chip hover:bg-[#FF4500]/10 hover:border-[#FF4500]/30 hover:text-[#FF4500] dark:hover:text-[#FF4500]">
      <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M24 11.5c0-1.65-1.35-3-3-3-.96 0-1.86.48-2.42 1.24-1.64-1-3.85-1.64-6.24-1.72l1.32-4.16 3.6 1.15c.08.77.73 1.37 1.5 1.37 1.65 0 3-1.35 3-3s-1.35-3-3-3c-.77 0-1.42.6-1.5 1.37l-3.85-1.23c-.22-.07-.46.05-.53.27l-1.5 4.73c-2.47.04-4.73.68-6.4 1.7-.56-.74-1.46-1.22-2.42-1.22-1.65 0-3 1.35-3 3 0 1.2.7 2.23 1.73 2.73-.08.35-.13.72-.13 1.1 0 3.86 4.49 7 10 7s10-3.14 10-7c0-.38-.05-.75-.13-1.1 1.03-.5 1.73-1.53 1.73-2.73zM7 13c0-1.1.9-2 2-2s2 .9 2 2-.9 2-2 2-2-.9-2-2zm12 5.5c-1.8 1.8-6.14 1.8-7.9 0-.2-.2-.2-.5 0-.7.2-.2.5-.2.7 0 1.3 1.3 5.14 1.3 6.5 0 .2-.2.5-.2.7 0 .2.5.2.7.2v.5zm-5.5-3.5c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"/>
      </svg>
      <span class="text-xs font-bold">Reddit</span>
    </a>

    <!-- WhatsApp (글로벌 전용) -->
    {lang !== 'ko' && (
      <a href="#" id="shareWhatsApp" title="WhatsApp" class="share-chip hover:bg-[#25D366]/10 hover:border-[#25D366]/30 hover:text-[#25D366] dark:hover:text-[#25D366]">
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12.01 2c-5.52 0-9.99 4.47-9.99 9.99 0 2.38.84 4.6 2.4 6.35L3 21l2.79-1.34c1.72 1.39 3.89 2.18 6.22 2.18 5.52 0 9.99-4.47 9.99-9.99S17.53 2 12.01 2zm0 18.25c-2.07 0-4-.75-5.5-2.01l-.36-.3-2.28 1.09 1.11-2.21-.33-.39c-1.42-1.65-2.25-3.83-2.25-6.14 0-4.96 4.04-9 9-9s9 4.04 9 9-4.04 9-9 9z"/>
        </svg>
        <span class="text-xs font-bold">WhatsApp</span>
      </a>
    )}

    <!-- Copy Link -->
    <button id="shareCopyLink" class="share-chip hover:bg-teal-500/10 hover:border-teal-500/30 hover:text-teal-600 dark:hover:text-teal-400 cursor-pointer">
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
      </svg>
      <span class="text-xs font-bold" id="copyText">{t('share.copied').split(' ')[0]}</span>
    </button>
  </div>
</div>

<!-- Micro-Toast Notification -->
<div id="shareToast" class="fixed bottom-6 left-1/2 -translate-x-1/2 px-5 py-3 rounded-2xl bg-slate-900/90 text-white dark:bg-white/95 dark:text-slate-900 text-xs font-bold shadow-xl border border-white/10 dark:border-black/5 backdrop-blur-md opacity-0 scale-95 pointer-events-none transition-all duration-300 z-50">
  {t('share.copied')}
</div>

<style>
  .share-chip {
    display: inline-flex;
    align-items: center;
    gap: 1.5-ch;
    padding: 0.5rem 1rem;
    border-radius: 1rem;
    border: 1px solid rgba(148, 163, 184, 0.15); /* slate-400 15% */
    background-color: rgba(255, 255, 255, 0.03);
    color: rgba(148, 163, 184, 0.85);
    font-size: 0.75rem;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
    text-decoration: none;
  }
  
  :global(.dark) .share-chip {
    border-color: rgba(255, 255, 255, 0.05);
    background-color: rgba(0, 0, 0, 0.1);
  }

  .share-chip:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px -2px rgba(0, 0, 0, 0.05);
  }

  .share-chip:active {
    transform: translateY(0);
  }
</style>

<script>
  // DOMContentLoaded/Page transitions safe script
  function initShareToolkit() {
    const webShareBtn = document.getElementById('webShareBtn');
    const fallbackShareList = document.getElementById('fallbackShareList');
    const copyBtn = document.getElementById('shareCopyLink');
    const toast = document.getElementById('shareToast');

    const shareUrl = window.location.href;
    const shareTitle = document.title;

    // 1. Web Share API 지원 감지 및 토글
    if (navigator.share) {
      if (webShareBtn) webShareBtn.classList.remove('hidden');
      if (webShareBtn) webShareBtn.classList.add('flex');
      if (fallbackShareList) fallbackShareList.classList.add('hidden');

      webShareBtn?.addEventListener('click', async () => {
        try {
          await navigator.share({
            title: shareTitle,
            url: shareUrl
          });
        } catch (err) {
          console.log('Share cancelled or failed', err);
        }
      });
    }

    // 2. SNS별 공유 처리 (데스크톱 / Web Share 미지원 대응)
    const shareLinks = {
      shareNaver: `https://share.naver.com/web/shareView?url=${encodeURIComponent(shareUrl)}&title=${encodeURIComponent(shareTitle)}`,
      shareLine: `https://social-plugins.line.me/lineit/share?url=${encodeURIComponent(shareUrl)}`,
      shareX: `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareTitle)}&url=${encodeURIComponent(shareUrl)}`,
      shareFB: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`,
      shareReddit: `https://www.reddit.com/submit?url=${encodeURIComponent(shareUrl)}&title=${encodeURIComponent(shareTitle)}`,
      shareWhatsApp: `https://api.whatsapp.com/send?text=${encodeURIComponent(shareTitle + ' ' + shareUrl)}`
    };

    Object.entries(shareLinks).forEach(([id, url]) => {
      const el = document.getElementById(id);
      if (el) {
        el.setAttribute('href', url);
        el.setAttribute('target', '_blank');
        el.setAttribute('rel', 'noopener noreferrer');
      }
    });

    // 3. 클립보드 링크 복사
    copyBtn?.addEventListener('click', async (e) => {
      e.preventDefault();
      try {
        await navigator.clipboard.writeText(shareUrl);
        
        // Show Toast
        if (toast) {
          toast.classList.remove('opacity-0', 'scale-95', 'pointer-events-none');
          toast.classList.add('opacity-100', 'scale-100');
          
          setTimeout(() => {
            toast.classList.remove('opacity-100', 'scale-100');
            toast.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
          }, 2500);
        }
      } catch (err) {
        console.error('Failed to copy link', err);
      }
    });
  }

  // Running on initial load
  initShareToolkit();

  // Astro page swap / navigation support
  document.addEventListener('astro:after-swap', initShareToolkit);
</script>

---
import { useTranslations, languages } from '../../i18n/ui';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang as keyof typeof languages);
---

<!-- Gamified Habit Loop & Heatmap (습관 복리 루프) -->
<section 
	class="mb-20 md:mb-28 p-8 md:p-12 rounded-[2.5rem] bg-gradient-to-r from-teal-955/40 to-slate-900/60 backdrop-blur-xl text-white relative overflow-hidden group app-card-neon"
	style="--theme-color-light: rgba(13, 148, 136, 0.15); --theme-color-brand: #14B8A6; --theme-color-glow: rgba(13, 148, 136, 0.15); --theme-color-glow-secondary: rgba(13, 148, 136, 0.05);"
>
	<div class="absolute -top-32 -left-32 w-96 h-96 bg-teal-500/10 rounded-full blur-[100px] pointer-events-none"></div>
	<div class="relative z-10 flex flex-col lg:flex-row items-center justify-between gap-12 text-left">
		<div class="max-w-xl space-y-4">
			<span class="text-[11px] uppercase tracking-wider font-bold bg-teal-500/20 text-teal-300 px-3 py-1 rounded-full">{t('bs.gamified.title')}</span>
			<h2 class="text-2xl md:text-4xl font-black tracking-tight leading-tight">{t('bs.gamified.title')}</h2>
			<p class="text-sm md:text-base text-teal-200/90 leading-relaxed font-medium">{t('bs.gamified.desc')}</p>
		</div>
		
		<!-- Monthly Donut-Ring Footprint Calendar (Astro/CSS) -->
		<div 
			class="flex flex-col gap-3 p-5 rounded-2xl bg-slate-955/80 border border-slate-800/80 shadow-2xl backdrop-blur-md max-w-sm sm:max-w-md w-full app-card-interactive"
			style="--theme-color-light: rgba(13, 148, 136, 0.1); --theme-color-glow: rgba(13, 148, 136, 0.25); --theme-color-border-hover: rgba(13, 148, 136, 0.3);"
		>
			<!-- Calendar Header -->
			<div class="flex items-center justify-between border-b border-slate-800/60 pb-3">
				<div class="flex flex-col text-left">
					<span class="text-[10px] text-teal-400 font-mono font-bold tracking-wider uppercase">Footprint Calendar</span>
					<span class="text-sm font-black text-white font-sans mt-0.5">March 2026</span>
				</div>
				<div class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-teal-500/10 border border-teal-500/20 text-[10px] text-teal-300 font-bold">
					<span class="w-1.5 h-1.5 rounded-full bg-teal-400 animate-pulse"></span>
					<span>Monthly Score: 92%</span>
				</div>
			</div>

			<!-- Weekday Headers -->
			<div class="grid grid-cols-7 gap-1 text-center text-[10px] text-slate-500 font-bold tracking-wider uppercase">
				<span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span>
			</div>

			<!-- Calendar Days Grid (March 2026: starts on Sunday, 31 days) -->
			<div class="grid grid-cols-7 gap-1.5 w-full aspect-[7/5] min-h-[160px]">
				{(() => {
					const totalDays = 31;
					const daysArray = Array.from({ length: 35 }, (_, i) => {
						const dayNum = i + 1;
						return totalDays >= dayNum ? dayNum : null;
					});

					return daysArray.map((day) => {
						if (!day) {
							return <div class="w-full h-full opacity-0 pointer-events-none" />;
						}

						// Define completion rate styles (SVG stroke-dasharray based on 2 * pi * r where r=14, circumference ~ 88)
						// 0: None, 1: 30%, 2: 65%, 3: 100%
						const rates = [
							{ dash: "0 88", color: "text-slate-800/30" }, // 0%
							{ dash: "26 88", color: "text-amber-500" },   // 30% (Warning/Partial)
							{ dash: "57 88", color: "text-teal-400/80" }, // 65% (Good)
							{ dash: "88 88", color: "text-teal-400" }     // 100% (Perfect)
						];
						
						let rateIdx = 3;
						if (day % 7 === 0) rateIdx = 0;
						else if (day % 5 === 0) rateIdx = 1;
						else if (day % 3 === 0) rateIdx = 2;
						
						const rate = rates[rateIdx];
						const isToday = day === 29;

						return (
							<div class="relative w-full h-full aspect-square flex items-center justify-center rounded-xl bg-slate-900/60 border border-slate-800/40 hover:border-teal-500/50 hover:scale-110 hover:z-10 transition-all duration-300 cursor-pointer group">
								<!-- SVG Donut Ring -->
								<svg class="absolute w-[90%] h-[90%] -rotate-90 transform" viewBox="0 0 36 36">
									{/* Outer ring track */}
									<circle cx="18" cy="18" r="14" fill="none" stroke="currentColor" stroke-width="3" class="text-slate-850/50 dark:text-slate-850/60" />
									{/* Progress segment */}
									{rateIdx > 0 && (
										<circle 
											cx="18" 
											cy="18" 
											r="14" 
											fill="none" 
											stroke="currentColor" 
											stroke-width="3" 
											class={`${rate.color} transition-all duration-300 group-hover:drop-shadow-[0_0_4px_rgba(45,212,191,0.5)]`}
											stroke-dasharray={rate.dash}
											stroke-linecap="round"
										/>
									)}
								</svg>

								{/* Today Highlight Indicator */}
								{isToday && (
									<span class="absolute inset-0.5 rounded-[10px] border border-teal-400/80 animate-pulse pointer-events-none" />
								)}

								{/* Day Number */}
								<span class={`relative z-10 text-[10px] sm:text-xs font-mono font-bold ${isToday ? 'text-teal-400' : 'text-slate-350 group-hover:text-white'}`}>
									{day}
								</span>
							</div>
						);
					});
				})()}
			</div>
		</div>
	</div>
</section>

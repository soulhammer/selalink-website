---
import { useTranslations, languages } from '../../i18n/ui';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang as keyof typeof languages);
---

<!-- Mentor & Media Bento Image Grid Section -->
<section class="mb-16 md:mb-24">
	<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
		
		<!-- Feature 1: Mentor Journey (Amber/Gold Glowing Card) -->
		<div class="footprint-card neon-accent-card flex flex-col pt-8 md:pt-12 px-6 md:px-10 items-center rounded-[2rem] md:rounded-[3rem] relative overflow-hidden backdrop-blur-xl group">
			<!-- Ambient Gold Glow in Dark Mode -->
			<div class="absolute inset-0 bg-gradient-to-b from-amber-50/50 to-transparent dark:from-amber-900/20 dark:to-transparent pointer-events-none"></div>
			<div class="absolute -top-32 -left-32 w-96 h-96 bg-amber-400/20 dark:bg-amber-500/10 rounded-full blur-[100px] pointer-events-none group-hover:scale-110 transition-transform duration-1000"></div>
			
			<!-- Star Mentor Icon -->
			<div class="w-12 h-12 md:w-16 md:h-16 bg-gradient-to-br from-amber-100 to-amber-50 dark:from-amber-500/20 dark:to-amber-500/5 text-amber-600 dark:text-amber-400 rounded-full flex items-center justify-center mb-6 md:mb-8 self-start border border-amber-200 dark:border-amber-500/20 shadow-inner z-10 transition-transform duration-500 group-hover:rotate-12 group-hover:scale-110">
				<svg class="w-6 h-6 md:w-8 md:h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
			</div>
			
			<!-- Card Copy -->
			<div class="flex-1 w-full flex flex-col items-start z-10 min-h-[160px] md:min-h-0">
				<h3 class="text-2xl md:text-3xl font-black text-slate-900 dark:text-white mb-3 md:mb-4 tracking-tight group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors drop-shadow-sm">{t('bs.feature1.title')}</h3>
				<p class="text-base md:text-lg text-slate-600 dark:text-slate-400 leading-relaxed font-medium mb-8 md:mb-12 max-w-sm">{t('bs.feature1.desc')}</p>
			</div>
			
			<!-- App Screen Base -->
			<div class="w-full mt-auto relative rounded-[1.5rem] md:rounded-t-[2rem] overflow-hidden border border-slate-200 dark:border-slate-700 shadow-[0_-10px_40px_rgba(0,0,0,0.08)] mb-6 md:mb-0 z-10">
				<div class="aspect-[4/3] w-full overflow-hidden flex justify-center items-start bg-slate-50 dark:bg-slate-900 border-t border-white/10">
					<img src="/assets/images/apps/buildself/3_buildself_phone_screen.jpeg" alt="Mentor Journey Interface" class="w-full h-full object-cover object-[center_62%] scale-[1.02] hover:scale-[1.05] transition-transform duration-700 cursor-pointer" loading="lazy" />
				</div>
				<div class="absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-white dark:from-slate-900 to-transparent pointer-events-none rounded-b-[1.5rem] md:rounded-none"></div>
			</div>
		</div>

		<!-- Feature 2: Shorts Integration (Vibrant Crimson/Rose Dark Card) -->
		<div class="footprint-card flex flex-col pt-8 md:pt-12 px-6 md:px-10 items-center bg-gradient-to-b from-rose-600 to-rose-900 dark:from-rose-800 dark:to-slate-900 rounded-[2rem] md:rounded-[3rem] border border-rose-500/50 dark:border-rose-500/30 shadow-2xl shadow-rose-600/20 text-white relative overflow-hidden group">
			<!-- Dynamic Light Meshes -->
			<div class="absolute -bottom-10 md:-bottom-20 -right-10 md:-right-20 w-64 md:w-80 h-64 md:h-80 bg-rose-400/40 rounded-full blur-[80px] pointer-events-none group-hover:scale-125 transition-transform duration-[1.5s]"></div>
			<div class="absolute top-0 right-0 w-48 md:w-64 h-48 md:h-64 bg-orange-500/30 rounded-full blur-[60px] pointer-events-none"></div>
			
			<!-- Analytics Icon -->
			<div class="w-12 h-12 md:w-16 md:h-16 bg-white/20 text-white rounded-full flex items-center justify-center mb-6 md:mb-8 self-start backdrop-blur-md border border-white/30 shadow-[0_0_20px_rgba(255,255,255,0.2)] z-10 transition-transform duration-500 group-hover:scale-110">
				<svg class="w-6 h-6 md:w-8 md:h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
			</div>
			
			<!-- Card Copy -->
			<div class="flex-1 w-full flex flex-col items-start z-10 min-h-[160px] md:min-h-0">
				<h3 class="text-2xl md:text-3xl font-black mb-3 md:mb-4 tracking-tight drop-shadow-md">{t('bs.feature2.title')}</h3>
				<p class="text-base md:text-lg text-rose-50/90 leading-relaxed font-medium mb-8 md:mb-12 max-w-sm drop-shadow-sm">{t('bs.feature2.desc')}</p>
			</div>
			
			<!-- App Screen Extruded -->
			<div class="w-[95%] md:w-full mt-auto relative flex justify-center rounded-[1.5rem] md:rounded-t-[2rem] overflow-hidden shadow-[0_-20px_60px_rgba(0,0,0,0.4)] border border-rose-300/30 z-10 mb-6 md:mb-0">
				<div class="aspect-[4/3] w-full bg-slate-900 absolute inset-0 -z-10 opacity-0 transition-opacity duration-700"></div>
				<div class="aspect-[4/3] w-full overflow-hidden flex justify-center items-start bg-slate-50 dark:bg-slate-900 border-t border-white/10">
					<img src="/assets/images/apps/buildself/6_buildself_phone_screen.jpeg" alt="Insightful Analytics Interface" class="w-full h-full object-cover object-[center_16%] scale-[1.02] hover:scale-[1.05] transition-transform duration-[1.5s] cursor-pointer" loading="lazy" />
				</div>
				<div class="absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-slate-100/5 dark:from-slate-900 to-transparent pointer-events-none rounded-b-[1.5rem] md:rounded-none"></div>
			</div>
		</div>
	</div>
</section>

<style>
	.footprint-card {
		transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
		border: 1px solid rgba(13, 148, 136, 0.1);
	}
	.footprint-card:hover {
		transform: scale(1.02) translateY(-6px);
		box-shadow: 0 30px 60px -15px rgba(13, 148, 136, 0.2), 0 0 0 1px rgba(249, 115, 22, 0.2);
		border-color: rgba(249, 115, 22, 0.3);
	}
	.neon-accent-card {
		border: 1px solid rgba(13, 148, 136, 0.15) !important;
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0.7) 100%);
		transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
	}
	html.dark .neon-accent-card {
		border: 1px solid rgba(13, 148, 136, 0.15) !important;
		background: linear-gradient(180deg, rgba(30, 33, 40, 0.5) 0%, rgba(20, 23, 30, 0.3) 100%) !important;
	}
	.neon-accent-card:hover {
		border-color: #14B8A6 !important;
		box-shadow: 0 20px 40px rgba(13, 148, 136, 0.15), 0 0 25px rgba(249, 115, 22, 0.05) !important;
	}
</style>

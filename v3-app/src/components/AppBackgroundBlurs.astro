---
interface Props {
  appId: 'buildself' | 'logself' | 'freshself' | 'buildsnap';
}

const { appId } = Astro.props;

const config = {
  buildself: {
    containerClass: 'absolute inset-0 z-0 opacity-100 pointer-events-none overflow-hidden',
    topRightClass: 'absolute top-0 right-0 -mr-40 -mt-40 w-96 h-96 rounded-full bg-teal-400/20 dark:bg-teal-600/10 blur-3xl',
    bottomLeftClass: 'absolute bottom-40 left-0 -ml-40 w-80 h-80 rounded-full bg-orange-400/10 dark:bg-orange-600/10 blur-3xl',
  },
  buildsnap: {
    containerClass: 'absolute inset-0 z-0 opacity-100 pointer-events-none overflow-hidden',
    topRightClass: 'absolute top-0 right-0 -mr-40 -mt-40 w-96 h-96 rounded-full bg-violet-400/20 dark:bg-violet-600/10 blur-3xl',
    bottomLeftClass: 'absolute bottom-40 left-0 -ml-40 w-80 h-80 rounded-full bg-indigo-400/15 dark:bg-indigo-600/10 blur-3xl',
  },
  logself: {
    containerClass: 'absolute inset-0 z-0 opacity-100 pointer-events-none overflow-hidden',
    topRightClass: 'absolute top-0 right-0 -mr-40 -mt-40 w-96 h-96 rounded-full bg-indigo-400/20 dark:bg-indigo-600/10 blur-3xl',
    bottomLeftClass: 'absolute bottom-40 left-0 -ml-40 w-80 h-80 rounded-full bg-violet-400/10 dark:bg-violet-600/10 blur-3xl',
  },
  freshself: {
    containerClass: 'fixed inset-0 z-0 opacity-40 pointer-events-none',
    topRightClass: 'absolute top-[-10%] right-[-10%] w-[50%] h-[50%] bg-purple-500/10 dark:bg-purple-600/5 rounded-full filter blur-[120px]',
    bottomLeftClass: 'absolute bottom-[-20%] left-[-10%] w-[60%] h-[60%] bg-emerald-500/10 dark:bg-emerald-600/5 rounded-full filter blur-[130px]',
  }
};

const currentConfig = config[appId];
---

<div class={currentConfig.containerClass}>
  <div class={currentConfig.topRightClass}></div>
  <div class={currentConfig.bottomLeftClass}></div>
</div>
